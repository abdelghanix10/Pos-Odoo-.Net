        </Grid>

        <!-- ======================================================================= -->
        <!-- 6. POS LANDING SCREEN ("Open Register", Screenshot 6)                   -->
        <!-- ======================================================================= -->
        <Grid Panel.ZIndex="900"
              Visibility="{Binding IsPosLandingScreenOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6E4F0" Offset="0.0"/>
                    <GradientStop Color="#EBE9F2" Offset="0.48"/>
                    <GradientStop Color="#DDD9E8" Offset="0.49"/>
                    <GradientStop Color="#E5E2EE" Offset="0.82"/>
                    <GradientStop Color="#D7D3E4" Offset="0.83"/>
                    <GradientStop Color="#DEDAE9" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid VerticalAlignment="Top" Margin="18,16,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="{Binding LandingClockText}"
                               FontSize="22"
                               FontWeight="Normal"
                               Foreground="#1F2937"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LandingDayNameText}" FontSize="9.5" Foreground="#374151"/>
                        <TextBlock Text="{Binding LandingFullDateText}" FontSize="9.5" Foreground="#374151"/>
