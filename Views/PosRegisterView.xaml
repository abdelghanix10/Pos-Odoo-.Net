                            <Button Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="2"/>
                            <Button Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="3"/>
                            <Button Content="+10" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyGreenBrush}" Command="{Binding AddQuickTenderCommand}" CommandParameter="10"/>

                            <Button Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="4"/>
                            <Button Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="5"/>
                            <Button Content="6" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="6"/>
                            <Button Content="+20" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyGreenBrush}" Command="{Binding AddQuickTenderCommand}" CommandParameter="20"/>

                            <Button Content="7" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="7"/>
                            <Button Content="8" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="8"/>
                            <Button Content="9" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="9"/>
                            <Button Content="+50" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyGreenBrush}" Command="{Binding AddQuickTenderCommand}" CommandParameter="50"/>

                            <Button Content="+/-" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyAmberBrush}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="+/-"/>
