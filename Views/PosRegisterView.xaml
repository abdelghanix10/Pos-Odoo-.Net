                    <TextBlock Text="{Binding ConfirmedIntegerPart}"
                               FontSize="186"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding ConfirmedDecimalPart}"
                               FontSize="132"
                               FontWeight="Normal"
