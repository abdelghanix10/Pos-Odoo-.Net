<UserControl x:Class="OdooPosLogin.PaymentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:PaymentsViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="12"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group Header Button Style Matching Screenshot 8 -->
        <Style x:Key="GroupHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table Row Button Style Matching Screenshot 8 -->
        <Style x:Key="TableRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP ODOO 20 CONTROL BAR WITH POS SHOP & SESSION FILTERS              -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync Button & Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncPaymentsCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Command="{Binding CloseDetailCommand}">
                            <TextBlock Text="Payments"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text="  /  " FontSize="17" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedPayment.AmountDisplay}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: SEARCH BAR + POS SHOP FILTER + SESSION FILTER -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Search Pill -->
                    <Border Width="260"
                            Height="34"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="12,0"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2"/>
                                    <Path Data="M 14,14 L 20,20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Grid.Column="1"
                                       Text="Search payments..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Filter by Point of Sale Shop -->
                    <ComboBox ItemsSource="{Binding AvailableShops}"
                              SelectedItem="{Binding SelectedShopFilter, Mode=TwoWay}"
                              Width="165"
                              Height="34"
                              FontSize="12.5"
                              VerticalContentAlignment="Center"
                              Margin="0,0,8,0"
                              ToolTip="Filter Payments by Point of Sale Shop"/>

                    <!-- Filter by Session -->
                    <ComboBox ItemsSource="{Binding AvailableSessions}"
                              SelectedItem="{Binding SelectedSessionFilter, Mode=TwoWay}"
                              Width="185"
                              Height="34"
                              FontSize="12.5"
                              VerticalContentAlignment="Center"
                              ToolTip="Filter Payments by POS Session"/>

                    <!-- Clear Filters Button -->
                    <Button Command="{Binding ClearSessionFilterCommand}"
                            Visibility="{Binding HasActiveFilter, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                            Background="{StaticResource OdooPurpleSoftBrush}"
                            BorderBrush="{StaticResource OdooPurpleBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Height="30"
                            Padding="10,0"
                            Margin="8,0,0,0"
                            ToolTip="Reset Shop &amp; Session Filters">
                        <TextBlock Text="✕ Reset" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- RIGHT: PAGER (< >) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListCounterText}"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding PagerText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding PreviousRecordCommand}"
                            IsEnabled="{Binding HasPreviousRecord}"
                            Margin="0,0,2,0"
                            ToolTip="Previous Payment">
                        <Path Data="M 15,7 L 10,12 L 15,17" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding NextRecordCommand}"
                            IsEnabled="{Binding HasNextRecord}"
                            ToolTip="Next Payment">
                        <Path Data="M 10,7 L 15,12 L 10,17" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. MAIN WORKSPACE AREA                                                  -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">

            <!-- ==================== VIEW 1: GROUPED COLLAPSIBLE LIST VIEW (Screenshot 8) ==================== -->
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                <Border Background="#FFFFFF"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Date" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Payment Method" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Order" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Cashier" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Amount" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- TABLE BODY: GROUPED PAYMENTS -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GroupedPayments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Group Collapsible Header (▾ Cash  7 records ... $ 51.49) -->
                                            <Button Style="{StaticResource GroupHeaderButtonStyle}"
                                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HeaderChevron}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding GroupName}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13.5"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   Margin="0,0,10,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Count, StringFormat='{}{0} records'}"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SubtotalDisplay}"
                                                               FontWeight="Bold"
                                                               FontSize="13.5"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>

                                            <!-- Group Children Rows -->
                                            <ItemsControl ItemsSource="{Binding Payments}"
                                                          Visibility="{Binding IsExpanded, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:PosPaymentRecord}">
                                                        <Button Style="{StaticResource TableRowButtonStyle}"
                                                                Command="{Binding DataContext.SelectPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="1.8*"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="2.5*"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="1.4*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" IsEnabled="False" VerticalAlignment="Center"/>

                                                                <!-- Date (Oct 19, 2:39 PM) -->
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding PaymentDate, StringFormat='{}{0:MMM d, h:mm tt}'}"
                                                                           FontSize="13.5"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Payment Method -->
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding PaymentMethodName}"
                                                                           FontSize="13.5"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Order -->
                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding OrderName}"
                                                                           FontSize="13.5"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Cashier -->
                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding CashierName}"
                                                                           FontSize="13.5"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Amount -->
                                                                <TextBlock Grid.Column="5"
                                                                           Text="{Binding AmountDisplay}"
                                                                           FontSize="13.5"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           TextAlignment="Right"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- EMPTY STATE PLACEHOLDER -->
                <Border Background="#FFFFFF"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="32,28"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Payments Matching Filter" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Click 'Sync from Odoo' to pull POS payment transactions, or reset your Point of Sale / Session filter." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource OdooPrimaryButtonStyle}" Command="{Binding SyncPaymentsCommand}" Content="Sync Payments from Odoo" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== VIEW 2: PAYMENT DETAIL VIEW ==================== -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="36,30"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Payment"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedPayment.AmountDisplay}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,24"/>

                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Session" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.SessionName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Order" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.OrderName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Amount" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.AmountDisplay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Currency" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.CurrencyName}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Payment Method" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="{StaticResource OdooTealSoftBrush}" CornerRadius="10" Padding="12,3">
                                        <TextBlock Text="{Binding SelectedPayment.PaymentMethodName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cashier" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.CashierName}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Payment Date" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.PaymentDateDisplay}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST BANNER -->
        <Border Grid.Row="1"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>