<UserControl x:Class="OdooPosLogin.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:OrdersViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="ActiveGreenSoftBrush" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.05"/>

        <!-- Primary Purple Button Style -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outlined Action Button -->
        <Style x:Key="OdooSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Button Styles -->
        <Style x:Key="OdooTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooActiveTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource OdooPurpleBrush}"
                                BorderThickness="0,0,0,2.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pager Chevron Button Style -->
        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table Row Button Style -->
        <Style x:Key="TableRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Standardized Control Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Content (List View or Detail View) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP STANDARDIZED CONTROL BAR                                         -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Sync Button & Breadcrumb -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Search Bar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Detail Pager (< >) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync from Odoo Button & Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncOrdersCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                            Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStory">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStory"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Viewbox.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumbs -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Command="{Binding CloseDetailCommand}">
                            <TextBlock Text="Orders"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Filter Pill if filtered by Session -->
                        <Border Background="{StaticResource OdooPurpleSoftBrush}"
                                CornerRadius="12"
                                Margin="12,0,0,0"
                                Padding="8,3"
                                Visibility="{Binding SessionFilter, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SessionFilter}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                <Button Background="Transparent" BorderThickness="0" Padding="4,0,0,0" Cursor="Hand" Command="{Binding ClearSessionFilterCommand}">
                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Sub-title if Detail View -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text=" / "
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       Margin="6,0"/>
                            <TextBlock Text="{Binding SelectedOrder.Name}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OdooPurpleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: Clean Search Bar -->
                <Border Grid.Column="1"
                        Background="#F3F4F6"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Height="38"
                        MaxWidth="420"
                        Margin="24,0"
                        HorizontalAlignment="Center">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13"
                                         Stroke="{StaticResource PlaceholderTextBrush}"
                                         StrokeThickness="2.2"/>
                                <Path Data="M 14,14 L 21,21"
                                      Stroke="{StaticResource PlaceholderTextBrush}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 FontSize="13.5"
                                 Foreground="{StaticResource PrimaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- RIGHT: Detail View Pager (< >) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding PagerText}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding PreviousRecordCommand}"
                            IsEnabled="{Binding HasPreviousRecord}"
                            Margin="0,0,4,0"
                            ToolTip="Previous Order">
                        <Path Data="M 17,7 L 11,12 L 17,17"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Button>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding NextRecordCommand}"
                            IsEnabled="{Binding HasNextRecord}"
                            ToolTip="Next Order">
                        <Path Data="M 11,7 L 17,12 L 11,17"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. MAIN WORKSPACE AREA                                                  -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">
            <!-- ==================== VIEW 1: ORDERS LIST VIEW ==================== -->
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"
                  Margin="24,20">
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{StaticResource SubtleCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Table Data Rows -->
                            <RowDefinition Height="*"/>
                            <!-- Table Footer (Grand Total) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Order Ref" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="Session" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="Point of Sale" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="4" Text="Receipt Number" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="5" Text="Order No" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="6" Text="Cashier" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="7" Text="Total" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="8" Text="Status" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- TABLE BODY -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TableRowButtonStyle}"
                                                Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid Opacity="{Binding IsCancelled, Converter={x:Static local:CancelledOpacityConverter.Instance}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Order Ref -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="13.5"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Session -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SessionName}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Date -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DateDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Point of Sale -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding PosConfigName}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Receipt Number -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding PosReference}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Order No -->
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding TrackingNumber}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Cashier -->
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding CashierName}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Total -->
                                                <TextBlock Grid.Column="7"
                                                           Text="{Binding AmountTotalDisplay}"
                                                           FontWeight="Bold"
                                                           FontSize="13.5"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="8"
                                                        HorizontalAlignment="Right"
                                                        Background="{Binding StatusSoftBrush}"
                                                        CornerRadius="12"
                                                        Padding="9,3">
                                                    <TextBlock Text="{Binding StateDisplay}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- TABLE FOOTER: GRAND TOTAL -->
                        <Border Grid.Row="2"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,8,8"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FilteredOrders.Count, StringFormat='Total Records: {0}'}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Total: "
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding GrandTotalText}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== VIEW 2: ORDER DETAIL / FORM VIEW ==================== -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- TOP ACTION & PIPELINE SUB-HEADER BAR -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,12"
                            Margin="0,0,0,16"
                            Effect="{StaticResource SubtleCardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left Actions: Download Receipt & Return Products -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Spacer -->
                                <ColumnDefinition Width="*"/>
                                <!-- Right: Status Segmented Pipeline -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Action Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OdooSecondaryButtonStyle}"
                                        Command="{Binding DownloadReceiptCommand}"
                                        Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Receipt Icon -->
                                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 19,3 H 5 C 3.9,3 3,3.9 3,5 V 19 L 6,17 L 9,19 L 12,17 L 15,19 L 18,17 L 21,19 V 5 C 21,3.9 20.1,3 19,3 Z M 16,8 H 8 M 16,12 H 8"
                                                      Stroke="{StaticResource PrimaryTextBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Download Receipt" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource OdooSecondaryButtonStyle}"
                                        Command="{Binding ReturnProductsCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Return Arrow Icon -->
                                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 9,14 L 4,9 L 9,4 M 4,9 H 15 C 18.3,9 21,11.7 21,15 V 19"
                                                      Stroke="{StaticResource PrimaryTextBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Return Products" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Right: Status Segmented Pipeline (New > Paid > Posted) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- New -->
                                <Border Background="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                        Padding="12,5" CornerRadius="4,0,0,4">
                                    <TextBlock Text="New" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                </Border>
                                <TextBlock Text=" > " Foreground="{StaticResource PlaceholderTextBrush}" VerticalAlignment="Center" Margin="2,0"/>

                                <!-- Paid -->
                                <Border Background="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                        Padding="12,5">
                                    <TextBlock Text="Paid" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                </Border>
                                <TextBlock Text=" > " Foreground="{StaticResource PlaceholderTextBrush}" VerticalAlignment="Center" Margin="2,0"/>

                                <!-- Posted (Done) -->
                                <Border Background="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                        Padding="12,5" CornerRadius="0,4,4,0">
                                    <TextBlock Text="Posted" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN SHEET CARD -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="32,28"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <!-- HEADER: Large Order Ref Title -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Point of Sale Order"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedOrder.Name}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,20"/>

                            <!-- 2-COLUMN INFO GRID (Date, Fiscal Position, Served By, Session, Edited) -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT COLUMN -->
                                <StackPanel Grid.Column="0">
                                    <!-- Date -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.DateDisplay}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Fiscal Position -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fiscal Position" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.FiscalPosition}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- RIGHT COLUMN -->
                                <StackPanel Grid.Column="2">
                                    <!-- Served by (Avatar + Cashier Name) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Served by" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13"
                                                    Background="{StaticResource OdooPurpleSoftBrush}"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SelectedOrder.CashierInitials}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource OdooPurpleBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedOrder.CashierName}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Session -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Session" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.SessionName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                    </Grid>

                                    <!-- Edited (Checkbox) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Edited" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedOrder.IsEdited}" IsEnabled="False" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- TABS STRIP (Products, Payments, Extra Info) -->
                            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Products"
                                            Command="{Binding SelectTabCommand}"
                                            CommandParameter="Products"
                                            Style="{Binding IsProductsTab, Converter={x:Static local:TabStyleConverter.Instance}}"/>
                                    <Button Content="Payments"
                                            Command="{Binding SelectTabCommand}"
                                            CommandParameter="Payments"
                                            Style="{Binding IsPaymentsTab, Converter={x:Static local:TabStyleConverter.Instance}}"/>
                                    <Button Content="Extra Info"
                                            Command="{Binding SelectTabCommand}"
                                            CommandParameter="ExtraInfo"
                                            Style="{Binding IsExtraInfoTab, Converter={x:Static local:TabStyleConverter.Instance}}"/>
                                </StackPanel>
                            </Border>

                            <!-- TAB CONTENT 1: PRODUCTS -->
                            <StackPanel Visibility="{Binding IsProductsTab, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <!-- Products Table -->
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Product" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Edited" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="Quantity" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="Unit Price" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="Disc.%" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="Taxes" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="Tax Excl." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="Tax Incl." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <!-- Rows -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedOrder.Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEdited}" IsEnabled="False" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding QtyDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PriceUnitDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding DiscountDisplay}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="5" HorizontalAlignment="Center" Background="#F3F4F6" CornerRadius="10" Padding="8,2">
                                                                <TextBlock Text="{Binding Taxes}" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="6" Text="{Binding PriceSubtotalDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding PriceSubtotalInclDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- BOTTOM-RIGHT STACKED TOTALS -->
                                <Grid HorizontalAlignment="Right" Width="380" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Taxes -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Taxes:" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.AmountTaxDisplay}" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" Margin="0,4"/>

                                    <!-- Total -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrder.AmountTotalDisplay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" Margin="0,6"/>

                                    <!-- Total Paid (with rounding) -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Paid (with rounding):" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.AmountPaidDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" Margin="0,4"/>

                                    <!-- Margin -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Margin:" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOrder.MarginDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}" TextAlignment="Right" Margin="0,4"/>
                                </Grid>
                            </StackPanel>

                            <!-- TAB CONTENT 2: PAYMENTS -->
                            <StackPanel Visibility="{Binding IsPaymentsTab, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Header -->
                                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Payment Method" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="Amount" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <!-- Rows -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedOrder.Payments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PaymentDateDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding PaymentMethodName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- TAB CONTENT 3: EXTRA INFO -->
                            <StackPanel Visibility="{Binding IsExtraInfoTab, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Company -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.Company}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>

                                    <!-- Pos Reference -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Receipt Ref" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrder.PosReference}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>

                                    <!-- Note -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Notes" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.Note, TargetNullValue='No internal notes recorded.'}" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST BANNER -->
        <Border Grid.Row="1"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="14" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
