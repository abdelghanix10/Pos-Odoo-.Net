<UserControl x:Class="OdooPosLogin.PaymentMethodManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1084" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:PaymentMethodsViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. COMPACT TOP CONTROL BAR (48px) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PosPrimaryButton}" Height="32" Command="{Binding SyncFromOdooCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToListCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText" Text="Payment Methods" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                        <TextBlock Text="  /  " Foreground="{StaticResource MutedTextBrush}" FontSize="15.5"/>
                        <TextBlock Text="{Binding SelectedMethod.Name}" Foreground="{StaticResource OdooPurpleBrush}" FontSize="15.5" FontWeight="Bold" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PosSearchBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="12" Height="12" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#64748B" StrokeThickness="2"/>
                                <Path Data="M 14,14 L 20,20" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="Search methods..." Foreground="{StaticResource PlaceholderTextBrush}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0">
                            <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListCounterText}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding PagerText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding PreviousRecordCommand}" IsEnabled="{Binding HasPreviousRecord}" Margin="0,0,2,0" ToolTip="Previous">
                        <Viewbox Width="7" Height="11"><Path Data="M 7,1 L 1.5,6.5 L 7,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                    </Button>
                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding NextRecordCommand}" IsEnabled="{Binding HasNextRecord}" Margin="0,0,10,0" ToolTip="Next">
                        <Viewbox Width="7" Height="11"><Path Data="M 1.5,1 L 7,6.5 L 1.5,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button Command="{Binding SwitchToListCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="List">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsListView}" Value="True"><Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/></Canvas></Viewbox>
                        </Button>
                        <Button Command="{Binding SwitchToKanbanCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="Kanban">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,1,1,1"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsKanbanView}" Value="True"><Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" Fill="{StaticResource PrimaryTextBrush}"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="10" Fill="{StaticResource PrimaryTextBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <!-- LIST VIEW -->
                <Border Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Method" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Journal" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Company" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Point of Sale" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredMethods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosPaymentMethodRecord}">
                                        <Button Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBdr" Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,8" MinHeight="40">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding JournalName}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding CompanyName}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="4" ItemsSource="{Binding LinkedShopsList}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="8" Padding="8,2" Margin="0,1,5,1"><TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBdr" Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- KANBAN VIEW (3 Cards per row at 1280px) -->
                <ScrollViewer Visibility="{Binding IsKanbanView, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Padding="10">
                    <ItemsControl ItemsSource="{Binding FilteredMethods}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosPaymentMethodRecord}">
                                <Button Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Margin="5" Width="336" Height="110" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder" Style="{StaticResource PosCardBorderStyle}" Padding="14,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding JournalKanbanDisplay, StringFormat='Journal: {0}'}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding CompanyName, StringFormat='Company: {0}'}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                                        <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="4"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <Border Style="{StaticResource PosCardBorderStyle}" Padding="28,24" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Payment Methods Found" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Sync payment methods from Odoo." FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource PosPrimaryButton}" Command="{Binding SyncFromOdooCommand}" Content="Sync Payment Methods from Odoo" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DETAIL VIEW -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel MaxWidth="1020">
                    <Border Style="{StaticResource PosCardBorderStyle}" Padding="24,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Method" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedMethod.Name}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Width="64" Height="64" CornerRadius="10" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Image Source="{Binding SelectedMethod.IconSource}" Stretch="Uniform" Margin="8"/>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Type" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedMethod.MethodTypeDisplay}" FontSize="13" FontWeight="SemiBold"/></Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Journal" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedMethod.JournalName}" FontSize="13"/></Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Company" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedMethod.CompanyName}" FontSize="13"/></Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Currencies" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedMethod.CurrenciesDisplay}" FontSize="13"/></Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Integration" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedMethod.IntegrationDisplay}" FontSize="13"/></Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Point of Sale" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedMethod.LinkedShopsList}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="8" Padding="8,2" Margin="0,1,5,2"><TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST -->
        <Border Grid.Row="1" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Style="{StaticResource PosToastBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>