<UserControl x:Class="OdooPosLogin.PosSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             mc:Ignorable="d"
             d:DesignWidth="1080" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="OdooPurpleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChkBox" Width="18" Height="18" CornerRadius="5"
                                Background="White" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1.5">
                            <Viewbox x:Name="CheckMark" Width="10" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Path Data="M 1,4.5 L 4.2,7.8 L 10.5,1.2" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChkBox" Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter TargetName="ChkBox" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChkBox" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooArrowLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource OdooTealBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP ACTION BAR (POS SETTINGS) -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,9"
                Visibility="{Binding PosSettingsSubTabVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PosPrimaryButton}" Content="Save" Margin="0,0,8,0"/>
                    <Button Command="{Binding DiscardSettingsCommand}" Style="{StaticResource PosSecondaryButton}" Content="Discard" Margin="0,0,16,0"/>

                    <TextBlock Text="Point of Sale:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Style="{StaticResource OdooFilterComboBoxStyle}"
                              ItemsSource="{Binding PosConfigs}"
                              SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="200" Height="34"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource ActiveGreenSoftBrush}"
                        BorderBrush="{StaticResource ActiveGreenBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#065F46"/>
                </Border>
            </Grid>
        </Border>

        <!-- SUB-TAB 1: POINT OF SALE SETTINGS (Fluid 2-Column Layout — Zero Horizontal Overflow at 1280px) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding PosSettingsSubTabVisibility}">
            <StackPanel Margin="20,16,20,32" HorizontalAlignment="Stretch">

                <!-- CARD 1: ODOO SYNCED SETTINGS (READ-ONLY) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Odoo Synced Settings" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource OdooPurpleSoftBrush}" BorderBrush="{StaticResource OdooPurpleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Read-Only • Managed in Odoo" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,18" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. Payment Methods -->
                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="28,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Payment Methods" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Payment methods available on this register" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,8"/>

                                <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,0,6">
                                    <ItemsControl ItemsSource="{Binding SelectedPaymentMethodTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource OdooPurpleSoftBrush}" BorderBrush="{StaticResource OdooPurpleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,2,5,2">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Button Style="{StaticResource OdooArrowLinkButtonStyle}" Command="{Binding OpenPaymentMethodsLinkCommand}" Content="→ Payment Methods"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. One-click Payment -->
                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsOneClickPaymentEnabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Cursor="Arrow"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="One-click Payment" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Shortcut to skip payment screen" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,8"/>

                                    <Grid Visibility="{Binding OneClickPaymentDetailsVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Method:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Height="32" Padding="10,0">
                                            <TextBlock Text="{Binding SelectedOneClickPaymentMethod, FallbackValue=Cash, TargetNullValue=Cash}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3. Restrict Categories -->
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsRestrictCategoriesEnabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Cursor="Arrow"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Restrict Categories" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Pick which product PoS categories are available" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <StackPanel Visibility="{Binding RestrictCategoriesDetailsVisibility}">
                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,0,6">
                                            <ItemsControl ItemsSource="{Binding SelectedCategoryTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource OdooPurpleSoftBrush}" BorderBrush="{StaticResource OdooPurpleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,2,5,2">
                                                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <Button Style="{StaticResource OdooArrowLinkButtonStyle}" Command="{Binding OpenCategoriesLinkCommand}" Content="→ PoS Product Categories"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 4. Variants -->
                        <Grid Grid.Row="2" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsVariantsEnabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Cursor="Arrow"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Variants" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Sell variants of a product using attributes (size, color, etc.)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                    <Button Style="{StaticResource OdooArrowLinkButtonStyle}" Visibility="{Binding VariantsDetailsVisibility}" Command="{Binding OpenAttributesLinkCommand}" Content="→ Attributes"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 5. Automatic Receipt Printing -->
                        <Grid Grid.Row="4" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsAutomaticReceiptPrintingEnabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Cursor="Arrow"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Automatic Receipt Printing" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Print receipts automatically once payment is registered" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2: LOCAL POINT OF SALE SETTINGS (EDITABLE) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Local Point of Sale Settings" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource ActiveGreenSoftBrush}" BorderBrush="{StaticResource ActiveGreenBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Editable in Program" FontSize="11" FontWeight="SemiBold" Foreground="#065F46"/>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hide Opening Cash Control -->
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsHideOpeningCashControlEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Opening Cash Control" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Auto-hide opening cash popup and set cash to the default amount" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HideOpeningCashControlDetailsVisibility}">
                                        <TextBlock Text="Default Cash:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Style="{StaticResource PosInputBorderStyle}" Height="32" Width="120">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrencySymbol}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DefaultOpeningCashAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="82" BorderThickness="0" Background="Transparent" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Prevent Line Merging -->
                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsPreventLineMergingEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Prevent Line Merging" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Always create new order lines instead of merging quantities" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Print Last Receipt -->
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsPrintLastReceiptEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Print Last Receipt" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Enable a button to print the last paid order" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <StackPanel Visibility="{Binding PrintLastReceiptDetailsVisibility}">
                                        <ComboBox Style="{StaticResource OdooFilterComboBoxStyle}" ItemsSource="{Binding ReceiptDesigns}" SelectedItem="{Binding SelectedLastReceiptDesign, Mode=TwoWay}" DisplayMemberPath="Name" Height="32" Margin="0,0,0,4"/>
                                        <Button Style="{StaticResource OdooArrowLinkButtonStyle}" Command="{Binding OpenReceiptDesignsTabCommand}" Content="→ Receipt Designs"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Active Button Print -->
                        <Grid Grid.Row="2" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsPrintButtonEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Active Button Print" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Show the Print button on the payment confirmation (Change) screen" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Custom Order Receipts -->
                        <Grid Grid.Row="4" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsCustomOrderReceiptsEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Custom Order Receipts" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Use custom receipt designs for customer orders" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <StackPanel Visibility="{Binding CustomOrderReceiptsDetailsVisibility}">
                                        <ComboBox Style="{StaticResource OdooFilterComboBoxStyle}" ItemsSource="{Binding ReceiptDesigns}" SelectedItem="{Binding SelectedCustomOrderReceiptDesign, Mode=TwoWay}" DisplayMemberPath="Name" Height="32" Margin="0,0,0,4"/>
                                        <Button Style="{StaticResource OdooArrowLinkButtonStyle}" Command="{Binding OpenReceiptDesignsTabCommand}" Content="→ Receipt Designs"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Second Receipt -->
                        <Grid Grid.Row="4" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsSecondReceiptEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Second Receipt" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Print a second simplified receipt after the main receipt" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <StackPanel Visibility="{Binding SecondReceiptDetailsVisibility}">
                                        <ComboBox Style="{StaticResource OdooFilterComboBoxStyle}" ItemsSource="{Binding ReceiptDesigns}" SelectedItem="{Binding SelectedSecondReceiptDesign, Mode=TwoWay}" DisplayMemberPath="Name" Height="32" Margin="0,0,0,4"/>
                                        <Button Style="{StaticResource OdooArrowLinkButtonStyle}" Command="{Binding OpenReceiptDesignsTabCommand}" Content="→ Receipt Designs"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Hide Closing Register -->
                        <Grid Grid.Row="6" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsHideClosingRegisterEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Closing Register" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Bypass closing cash popup, close directly, and print sales details" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <StackPanel Visibility="{Binding CustomSalesReceiptDetailsVisibility}">
                                        <ComboBox Style="{StaticResource OdooFilterComboBoxStyle}" ItemsSource="{Binding ReceiptDesigns}" SelectedItem="{Binding SelectedCustomSalesReceiptDesign, Mode=TwoWay}" DisplayMemberPath="Name" Height="32" Margin="0,0,0,4"/>
                                        <Button Style="{StaticResource OdooArrowLinkButtonStyle}" Command="{Binding OpenReceiptDesignsTabCommand}" Content="→ Receipt Designs"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Hide Review Orders -->
                        <Grid Grid.Row="6" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding IsHideReviewOrdersEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Review Orders" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Skip the blocking draft-orders warning popup when closing register" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Numbers first, or products -->
                        <Border Grid.Row="8" Grid.Column="0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="28,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Numbers first, or products" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Select products first, or type quantity on numpad before tapping a product" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Products first" IsChecked="{Binding IsProductsFirst, Mode=TwoWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,18,0" Cursor="Hand"/>
                                    <RadioButton Content="Numbers first" IsChecked="{Binding IsNumbersFirst, Mode=TwoWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- POS Register Layout -->
                        <Border Grid.Row="8" Grid.Column="2" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="28,0,0,0">
                            <StackPanel>
                                <TextBlock Text="POS Register Layout" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Standard Odoo layout or Split 4-quadrant layout" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <StackPanel>
                                    <RadioButton Content="Standard (Left Cart / Right Products)" IsChecked="{Binding IsStandardLayoutSelected, Mode=TwoWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6" Cursor="Hand"/>
                                    <RadioButton Content="Split (Top Order &amp; Numpad / Bottom Grid)" IsChecked="{Binding IsSplitLayoutSelected, Mode=TwoWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- POS Payment View Layout -->
                        <Border Grid.Row="10" Grid.Column="0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="28,0,0,0">
                            <StackPanel>
                                <TextBlock Text="POS Payment View Layout" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Standard split payment screen or compact centered layout" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <StackPanel>
                                    <RadioButton Content="Standard Payment (Left Numpad / Right Total)" IsChecked="{Binding IsStandardPaymentLayoutSelected, Mode=TwoWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6" Cursor="Hand"/>
                                    <RadioButton Content="Centered Payment (Compact Single Column)" IsChecked="{Binding IsCenteredPaymentLayoutSelected, Mode=TwoWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Hide Product Price on Product Cards -->
                        <Grid Grid.Row="10" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Style="{StaticResource OdooPurpleCheckBoxStyle}"
                                      IsChecked="{Binding IsHideProductPriceEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="2,0,0,0"
                                    Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hide Product Price"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Hide the product price below the product name on POS product cards"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Show Cash & Change on Order Cards -->
                        <Grid Grid.Row="12" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Style="{StaticResource OdooPurpleCheckBoxStyle}"
                                      IsChecked="{Binding IsShowCashChangeEnabled, Mode=TwoWay}"/>
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="2,0,0,0"
                                    Padding="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Show Cash &amp; Change"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Show cash and change details on POS order cards"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- SUB-TAB 2: RECEIPT DESIGNS EDITOR (3-Column: List | XML Editor | Live Preview) -->
        <Grid Grid.Row="1" Visibility="{Binding ReceiptDesignsSubTabVisibility}" Margin="18,14,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Saved Receipt Designs List -->
            <Border Grid.Column="0" Style="{StaticResource PosCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <TextBlock Text="Receipt Designs" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Command="{Binding NewReceiptDesignCommand}" Style="{StaticResource PosPrimaryButton}" Height="28" Padding="10,0" FontSize="12" Content="+ New"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReceiptDesigns}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectReceiptDesignCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,5">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ItemBd" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding OpenCashDrawerDisplay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Column 2: Design Editor (Design Name + Cash Drawer Toggle + Receipt XML) -->
            <Border Grid.Column="2" Style="{StaticResource PosCardBorderStyle}" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Editor Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveReceiptDesignCommand}" Style="{StaticResource PosPrimaryButton}" Height="32" Content="Save Design" Margin="0,0,8,0"/>
                            <Button Command="{Binding LoadDefaultXmlTemplateCommand}" Style="{StaticResource PosSecondaryButton}" Height="32" Content="Reset Default XML"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding DeleteReceiptDesignCommand}" Style="{StaticResource PosDangerSoftButton}" Height="32" Content="Delete"/>
                    </Grid>

                    <!-- Design Name (Uses Operating Company from General Settings) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Design Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource PosInputBorderStyle}" Height="34">
                            <TextBox Text="{Binding DesignEditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Open Cash Drawer Only -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource OdooPurpleCheckBoxStyle}" IsChecked="{Binding DesignEditorOpenCashDrawerOnly, Mode=TwoWay}" Margin="0,0,8,0"/>
                        <TextBlock Text="Open Cash Drawer Only? (Send kick-out pulse without printing XML)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- XML Editor -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Receipt XML" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <Border Grid.Row="1" Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBox Text="{Binding DesignEditorReceiptXml, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12.5"
                                     Background="Transparent" Foreground="#E2E8F0" CaretBrush="White"
                                     BorderThickness="0" Padding="12"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Column 4: Live Receipt Preview -->
            <Border Grid.Column="4" Style="{StaticResource PosCardBorderStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Live Preview" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding OperatingCompanyDisplay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{StaticResource OdooPurpleSoftBrush}" BorderBrush="{StaticResource OdooPurpleBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,2">
                                <TextBlock Text="{Binding PaperWidthDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Optional XML Syntax Error Banner -->
                    <Border Grid.Row="1"
                            Background="{StaticResource DangerRedSoftBrush}"
                            BorderBrush="{StaticResource DangerRedBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6"
                            Visibility="{Binding HasLivePreviewError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LivePreviewError}" FontSize="11.5" Foreground="{StaticResource DangerRedBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Preview Paper Tray -->
                    <Grid Grid.Row="2" Background="#EEF2F6">
                        <!-- Cash Drawer Only State -->
                        <Border Margin="18"
                                Padding="20,24"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsPreviewCashDrawerOnly, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Cash Drawer Pulse Only" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="No paper receipt will be printed when this design is used." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Thermal Paper Sheet -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsPreviewCashDrawerOnly, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Border Background="#FFFFFF"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,10"
                                    Margin="14,12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Effect="{StaticResource PosSubtleShadow}">
                                <Image Source="{Binding LivePreviewBitmap}"
                                       Width="284"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- TOAST BANNER -->
        <Border Grid.Row="1"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Panel.ZIndex="900"
                Style="{StaticResource PosToastBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
