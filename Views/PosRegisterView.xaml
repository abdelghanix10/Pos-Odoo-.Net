<UserControl x:Class="OdooPosLogin.PosRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="{DynamicResource CairoFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.ClearTypeHint="Enabled"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">

    <UserControl.DataContext>
        <vm:PosRegisterViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Local aliases mapped to Step 1 Design System -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BorderMidBrush" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#6C4663"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#57374F"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F5EEF3"/>
        <SolidColorBrush x:Key="OdooPurpleRowBrush" Color="#F5EEF3"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#0D7A80"/>
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>

        <SolidColorBrush x:Key="KeyAmberBrush" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="KeyPeachBrush" Color="#FCE7D9"/>
        <SolidColorBrush x:Key="KeyCoralBrush" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="KeyGreenBrush" Color="#DCFCE7"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#94A3B8"/>

        <DropShadowEffect x:Key="ModalShadow"
                          BlurRadius="28"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#0F172A"
                          Opacity="0.20"/>

        <SolidColorBrush x:Key="NumpadHoverBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="NumpadAmberHoverBrush" Color="#FDE68A"/>
        <SolidColorBrush x:Key="NumpadPeachHoverBrush" Color="#FCD3B8"/>
        <SolidColorBrush x:Key="NumpadCoralHoverBrush" Color="#FECACA"/>
        <SolidColorBrush x:Key="NumpadGreenHoverBrush" Color="#BBF7D0"/>

        <!-- Modal Close Button Style -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource PosModalCloseButton}"/>

        <!-- Base Register Numpad Button Style (Compact & Crisp for 720p) -->
        <Style x:Key="NumpadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Numbers First Header Chip (Compact 28px) -->
        <Style x:Key="NumpadHeaderChipStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode Button Style: Qty -->
        <Style x:Key="NumpadQtyButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="FontSize" Value="13.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NumpadMode}" Value="Qty">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumpadDiscountButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="FontSize" Value="13.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NumpadMode}" Value="%">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumpadPriceButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="FontSize" Value="13.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NumpadMode}" Value="Price">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Special Key Styles -->
        <Style x:Key="NumpadAmberButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyAmberBrush}"/>
            <Setter Property="Foreground" Value="#92400E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadAmberHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumpadPeachButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyPeachBrush}"/>
            <Setter Property="Foreground" Value="#9A3412"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadPeachHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumpadCoralButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyCoralBrush}"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadCoralHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumpadGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyGreenBrush}"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadGreenHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Payment Numpad Button Styles (kept in place for Step 4) -->
        <Style x:Key="PaymentNumpadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5EEF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#BBF7D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#86EFAC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadAmberButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#FEF3C7"/>
            <Setter Property="Foreground" Value="#92400E"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FDE68A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadPeachButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#FCE7D9"/>
            <Setter Property="Foreground" Value="#9A3412"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FCD3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadCoralButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Purple Action Button -->
        <Style x:Key="PosPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outlined Button -->
        <Style x:Key="PosSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cart Action Strip Button -->
        <Style x:Key="CartActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- Shared Compact Product Card Template (Used in Both Standard & Split Layouts) -->
        <DataTemplate x:Key="PosProductCardTemplate" DataType="{x:Type local:ProductRecord}">
            <Grid Margin="3.5">
                <Border Visibility="{Binding Converter={StaticResource InverseNullToVisibilityConverter}}"
                        IsHitTestVisible="False"/>
                <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="CardGrid" MinHeight="92">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="4"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="CardBdr"
                                        Grid.Row="0"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="9,9,0,0"
                                        ClipToBounds="True"
                                        RenderOptions.ClearTypeHint="Enabled">
                                    <Grid>
                                        <!-- PRODUCT WITH IMAGE -->
                                        <Grid Visibility="{Binding HasImage, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="42"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Height="{Binding DataContext.ProductCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=98}"
                                                    Background="#F8FAFC"
                                                    CornerRadius="8,8,0,0"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Border CornerRadius="8,8,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding ImageBitmap}"
                                                                        Stretch="UniformToFill"
                                                                        AlignmentX="Center"
                                                                        AlignmentY="Center"/>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Quantity Pill Badge (Top-Right) -->
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource OdooPurpleBrush}"
                                                            CornerRadius="10"
                                                            MinWidth="22"
                                                            Height="20"
                                                            Padding="6,0"
                                                            Margin="0,5,5,0"
                                                            Visibility="{Binding HasCartQuantity, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="{Binding CartQuantity}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1" Background="#FFFFFF" Padding="7,3">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding PriceDisplay}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource OdooTealBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding DataContext.IsProductPriceVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- PRODUCT WITHOUT IMAGE -->
                                        <Border Visibility="{Binding HasImage, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"
                                                Background="#FFFFFF"
                                                Padding="8">
                                            <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"
                                                           MaxHeight="42"/>
                                                <TextBlock Text="{Binding PriceDisplay}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource OdooTealBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding DataContext.IsProductPriceVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource OdooPurpleBrush}"
                                                    CornerRadius="10"
                                                    MinWidth="22"
                                                    Height="20"
                                                    Padding="6,0"
                                                    Visibility="{Binding HasCartQuantity, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding CartQuantity}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Slim Category Accent Bar -->
                                <Border Grid.Row="1"
                                        Background="{Binding CategoryColorBrush}"
                                        CornerRadius="0,0,9,9"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardGrid" Property="Opacity" Value="0.86"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid UseLayoutRounding="{Binding IsDefaultZoom}"
          SnapsToDevicePixels="{Binding IsDefaultZoom}"
          RenderOptions.ClearTypeHint="Enabled">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding PosZoomScale}" ScaleY="{Binding PosZoomScale}"/>
        </Grid.LayoutTransform>

        <!-- ======================================================================= -->
        <!-- BASE POS TERMINAL WORKSPACE                                             -->
        <!-- ======================================================================= -->
        <Grid Visibility="{Binding IsPaymentConfirmationOpen, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- =================================================================== -->
            <!-- 1. COMPACT TOP POS HEADER BAR (52px for 1280x720)                   -->
            <!-- =================================================================== -->
            <Border Grid.Row="0"
                    Height="52"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: [Register | Orders] + [+] + Scrollable Draft Order Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Segmented Register / Orders Container -->
                        <Border Background="{StaticResource AppBgBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding TxtRegisterTab}"
                                        Command="{Binding SwitchToRegisterViewCommand}"
                                        Height="32"
                                        Padding="14,0"
                                        FontSize="13.5"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bdr" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="Txt"
                                                           Text="{TemplateBinding Content}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ActivePosView}" Value="Register">
                                                    <Setter TargetName="Bdr" Property="Background" Value="{StaticResource SurfaceWhiteBrush}"/>
                                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="{Binding TxtOrdersTab}"
                                        Command="{Binding SwitchToOrdersViewCommand}"
                                        Height="32"
                                        Padding="14,0"
                                        FontSize="13.5"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bdr" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="Txt"
                                                           Text="{TemplateBinding Content}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ActivePosView}" Value="Orders">
                                                    <Setter TargetName="Bdr" Property="Background" Value="{StaticResource SurfaceWhiteBrush}"/>
                                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- [+] New Draft Order Button -->
                        <Button Command="{Binding CreateNewDraftOrderCommand}"
                                Width="36" Height="36"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                ToolTip="{Binding TxtNewOrderTooltip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8">
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="20" Height="20">
                                                <Path Data="M 4,10 H 16 M 10,4 V 16"
                                                      Stroke="{StaticResource TextPrimaryBrush}"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter TargetName="Bdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="1" Height="24" Background="{StaticResource BorderLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <!-- Draft Order Tabs (Scrollable so many tabs never overflow at 1280px) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      MaxWidth="380"
                                      VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding DraftOrders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosDraftOrder}">
                                        <Button Command="{Binding DataContext.SelectDraftOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Height="34"
                                                MinWidth="46"
                                                Padding="11,0"
                                                Margin="0,0,5,0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="TabBdr"
                                                            Background="{StaticResource SurfaceSubtleBrush}"
                                                            BorderBrush="{StaticResource BorderLightBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="{TemplateBinding Padding}">
                                                        <TextBlock x:Name="TabTxt"
                                                                   Text="{Binding OrderNumber}"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="TabBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                            <Setter TargetName="TabBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                            <Setter TargetName="TabTxt" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                                            <Setter TargetName="TabTxt" Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TabBdr" Property="BorderBrush" Value="{StaticResource BorderMidBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- RIGHT: Unsynced Pill + Print Last Receipt + Search + Cashier + Menu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pending Sync Queue Pill -->
                        <Button Command="{Binding OpenPendingSyncWindowCommand}"
                                Height="30"
                                Padding="10,0"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                ToolTip="View Unsynced POS Transactions Queue"
                                Visibility="{Binding IsUnsyncedButtonVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SyncBdr"
                                            Background="{StaticResource WarningAmberSoftBrush}"
                                            BorderBrush="{StaticResource WarningAmberBrush}"
                                            BorderThickness="1"
                                            CornerRadius="15"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↻ " FontSize="11.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendingSyncBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SyncBdr" Property="Background" Value="#FEF3C7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Print Last Receipt Button -->
                        <Button Command="{Binding PrintLastReceiptCommand}"
                                Style="{StaticResource PosSecondaryButton}"
                                Height="34"
                                Padding="10,0"
                                Margin="0,0,8,0"
                                ToolTip="Print Last Receipt"
                                Visibility="{Binding IsPrintLastReceiptVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖨 " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TxtPrintLastReceipt}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Compact Product Search Input -->
                        <Border Width="210"
                                Height="36"
                                Style="{StaticResource PosSearchBorderStyle}"
                                Margin="0,0,10,0"
                                Visibility="{Binding IsProductSearchVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#64748B" StrokeThickness="2"/>
                                        <Path Data="M 14,14 L 20,20" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TxtSearchProductsPlaceholder}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPlaceholderBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ProductSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                                <Button Grid.Column="2"
                                        Command="{Binding ClearProductSearchCommand}"
                                        Visibility="{Binding ProductSearchText, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Cursor="Hand">
                                    <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Cashier Avatar -->
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="{StaticResource OdooPurpleSoftBrush}"
                                BorderBrush="{StaticResource OdooPurpleBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,8,0"
                                ClipToBounds="True"
                                ToolTip="{Binding CashierName}">
                            <Grid>
                                <Image Source="{Binding CashierAvatarBitmap}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasCashierAvatar, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                <TextBlock Text="{Binding CashierInitials}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasCashierAvatar, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>

                        <!-- Hamburger Menu Button (☰) -->
                        <Button Command="{Binding OpenHamburgerMenuCommand}"
                                Width="36" Height="36"
                                Style="{StaticResource PosGhostButton}"
                                Padding="0"
                                ToolTip="{Binding TxtMenuTooltip}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20"
                                          Stroke="{StaticResource TextPrimaryBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =================================================================== -->
            <!-- 2. MAIN REGISTER VIEW (Standard & Split Layouts — 1280x720 Tuned)   -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsRegisterViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">

                <!-- =============================================================== -->
                <!-- OPTION A: STANDARD LAYOUT (372px Left Cart / 908px Right Grid)  -->
                <!-- =============================================================== -->
                <Grid Visibility="{Binding IsStandardPosLayout, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="372" MaxWidth="390"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT CART & NUMPAD PANEL -->
                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ROW 0: CART ITEMS LIST -->
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentOrder.CartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PosCartItem}">
                                            <Button Command="{Binding DataContext.SelectCartLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="LineBdr"
                                                                Padding="10,7"
                                                                Background="Transparent"
                                                                BorderBrush="#F1F5F9"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Border x:Name="SelAccent"
                                                                        Width="3"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{StaticResource OdooPurpleBrush}"
                                                                        CornerRadius="2"
                                                                        Margin="-10,-7,0,-7"
                                                                        Visibility="Collapsed"/>
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0"
                                                                                Background="{StaticResource SurfaceHoverBrush}"
                                                                                CornerRadius="5"
                                                                                MinWidth="24"
                                                                                Padding="5,1"
                                                                                Margin="0,0,8,0"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding QuantityDisplay}"
                                                                                       FontWeight="Bold"
                                                                                       FontSize="12.5"
                                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                                       HorizontalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding ProductName}"
                                                                                   FontSize="13.5"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,8,0"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding LineTotalDisplay}"
                                                                                   FontWeight="Bold"
                                                                                   FontSize="13.5"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding CustomerNote}"
                                                                               FontSize="11.5"
                                                                               FontStyle="Italic"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Margin="32,2,0,0"
                                                                               Visibility="{Binding HasCustomerNote, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="LineBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                                <Setter TargetName="SelAccent" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="LineBdr" Property="Background" Value="#F8FAFC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- ROW 1: COMPACT TOTAL & TAX SUMMARY -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceSubtleBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0,1,0,1"
                                    Padding="12,8"
                                    Visibility="{Binding HasCurrentOrderItems, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding TxtTotalLabel}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentOrder.TotalDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding TxtTaxesLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentOrder.TaxesDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ROW 2: COMPACT 4x4 TOUCH NUMPAD (184px Height) -->
                            <Border Grid.Row="2"
                                    Margin="8,8,8,6"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    Visibility="{Binding ShowExpandedNumpad, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <!-- Numbers First Pending Quantity Bar -->
                                    <Border Background="{StaticResource OdooPurpleSoftBrush}"
                                            BorderBrush="{StaticResource OdooPurpleBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,5"
                                            Visibility="{Binding CurrentConfig.IsNumbersFirst, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TxtNextQtyShort}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center"/>
                                                <Button Content="⌫" Style="{StaticResource NumpadHeaderChipStyle}"
                                                        Command="{Binding NumpadPendingBackspaceCommand}"
                                                        ToolTip="Backspace the next product quantity"/>
                                                <Button Content="{Binding TxtDeleteKey}" Style="{StaticResource NumpadHeaderChipStyle}"
                                                        Command="{Binding NumpadPendingDeleteCommand}"
                                                        ToolTip="Clear the next product quantity"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="{StaticResource OdooPurpleBrush}" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NumbersFirstDisplayText}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Height="184" Background="{StaticResource BorderLightBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="1"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="2"/>
                                        <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="3"/>
                                        <Button Grid.Row="0" Grid.Column="6" Content="{Binding TxtQtyKey}" Style="{StaticResource NumpadQtyButtonStyle}" Command="{Binding SetNumpadModeCommand}" CommandParameter="Qty"/>

                                        <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="4"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="5"/>
                                        <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="6"/>
                                        <Button Grid.Row="2" Grid.Column="6" Content="+" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="+" FontSize="20"/>

                                        <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="7"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="8"/>
                                        <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="9"/>
                                        <Button Grid.Row="4" Grid.Column="6" Content="-" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="-" FontSize="22"/>

                                        <Button Grid.Row="6" Grid.Column="0" Content="{Binding TxtDeleteKey}" Style="{StaticResource NumpadAmberButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="Delete" FontSize="12.5"/>
                                        <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="0"/>
                                        <Button Grid.Row="6" Grid.Column="4" Content="." Style="{StaticResource NumpadPeachButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="."/>
                                        <Button Grid.Row="6" Grid.Column="6" Style="{StaticResource NumpadCoralButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="⌫">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15"
                                                          Stroke="#B91C1C"
                                                          StrokeThickness="1.9"
                                                          StrokeLineJoin="Round"
                                                          Fill="Transparent"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ROW 3: PAYMENT + OPTIONAL ONE-CLICK PAYMENT (54px Height) -->
                            <Grid Grid.Row="3"
                                  Margin="8,0,8,8"
                                  Height="54"
                                  Visibility="{Binding HasCurrentOrderItems, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">

                                <Button Content="{Binding TxtPaymentBtn}"
                                        Command="{Binding OpenPaymentViewCommand}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="54"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Visibility="{Binding IsOneClickPaymentVisible, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>

                                <Grid Visibility="{Binding IsOneClickPaymentVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="{Binding TxtPaymentBtn}"
                                            Command="{Binding OpenPaymentViewCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Height="54"
                                            FontSize="15.5"
                                            FontWeight="Bold"/>

                                    <Button Grid.Column="2"
                                            Content="{Binding OneClickPaymentButtonLabel}"
                                            Command="{Binding OneClickPayCommand}"
                                            Style="{StaticResource PosTealButton}"
                                            Height="54"
                                            FontSize="15.5"
                                            FontWeight="Bold"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT CATEGORIES & COMPACT VIRTUALIZED PRODUCT GRID -->
                    <Grid Grid.Column="1" Background="{StaticResource AppBgBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Compact Category Pills (44px Tall) -->
                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding Categories}"
                                      Margin="6,6,6,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding GridColumns}" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosCategoryRecord}">
                                    <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="44"
                                            Margin="3"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CatBdr"
                                                        Background="{Binding CategoryButtonBgBrush}"
                                                        CornerRadius="8"
                                                        Padding="6,3"
                                                        BorderThickness="1"
                                                        BorderBrush="Transparent"
                                                        RenderOptions.ClearTypeHint="Enabled">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding CategoryButtonFgBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="CatBdr" Property="BorderThickness" Value="2"/>
                                                        <Setter TargetName="CatBdr" Property="BorderBrush" Value="{Binding CategoryActiveBorderBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CatBdr" Property="BorderBrush" Value="{Binding CategoryActiveBorderBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Virtualized Product Rows -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ProductRows}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6,2,6,8"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 ScrollViewer.PanningDeceleration="0.001"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="2,2"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 SizeChanged="ProductsScrollViewer_SizeChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource PosProductCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- =============================================================== -->
                <!-- OPTION B: SPLIT 4-QUADRANT LAYOUT (Rebalanced for 1280x720)     -->
                <!-- Top: 264px (Order + Numpad) | Bottom: ~404px (Cats + Products)  -->
                <!-- =============================================================== -->
                <Grid Background="{StaticResource AppBgBrush}"
                      Visibility="{Binding IsSplitPosLayout, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="264" MinHeight="240"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP HALF: ORDER LIST (LEFT) + NUMPAD (RIGHT) -->
                    <Grid Grid.Row="0" Background="#FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- TOP-LEFT: ORDER ITEMS TABLE + COMPACT TOTAL FOOTER -->
                        <Grid Grid.Column="0" Background="#FFFFFF">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="44"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.6*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TxtItemColumn}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TxtPriceColumn}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TxtUnitsColumn}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TxtTotalLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentOrder.CartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PosCartItem}">
                                            <Button Command="{Binding DataContext.SelectCartLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="SplitLineBdr" Padding="14,7" Background="#FFFFFF" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2.6*"/>
                                                                        <ColumnDefinition Width="1.1*"/>
                                                                        <ColumnDefinition Width="0.9*"/>
                                                                        <ColumnDefinition Width="1.2*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding UnitPriceDisplay}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                    <Border Grid.Column="2" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="5" Padding="8,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding QuantityDisplay}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="3" Text="{Binding LineTotalDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding CustomerNote}" FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                                           Visibility="{Binding HasCustomerNote, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="SplitLineBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SplitLineBdr" Property="Background" Value="#F8FAFC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TxtTaxesLabel}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentOrder.TaxesDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TxtTotalLabel}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" CornerRadius="6" MinWidth="128" Height="32" Padding="12,0">
                                            <TextBlock Text="{Binding CurrentOrder.TotalDisplay}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Column="1" Background="{StaticResource BorderLightBrush}"/>

                        <!-- TOP-RIGHT: COMPACT NUMPAD + PAYMENT BUTTONS -->
                        <Grid Grid.Column="2" Background="#FFFFFF" Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="46"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource OdooPurpleSoftBrush}" BorderBrush="{StaticResource OdooPurpleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,5"
                                    Visibility="{Binding CurrentConfig.IsNumbersFirst, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TxtNextQtyShort}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center"/>
                                        <Button Content="⌫" Style="{StaticResource NumpadHeaderChipStyle}" Command="{Binding NumpadPendingBackspaceCommand}"/>
                                        <Button Content="{Binding TxtDeleteKey}" Style="{StaticResource NumpadHeaderChipStyle}" Command="{Binding NumpadPendingDeleteCommand}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource OdooPurpleBrush}" CornerRadius="5" MinWidth="36" Height="26" Padding="8,0">
                                        <TextBlock Text="{Binding NumbersFirstDisplayText}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,5" ClipToBounds="True">
                                <Grid Background="{StaticResource BorderLightBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="1"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="2"/>
                                    <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="3"/>
                                    <Button Grid.Row="0" Grid.Column="6" Content="{Binding TxtQtyKey}" Style="{StaticResource NumpadQtyButtonStyle}" Command="{Binding SetNumpadModeCommand}" CommandParameter="Qty"/>
                                    <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="4"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="5"/>
                                    <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="6"/>
                                    <Button Grid.Row="2" Grid.Column="6" Content="+" Style="{StaticResource NumpadButtonStyle}" FontSize="19" Command="{Binding NumpadKeyCommand}" CommandParameter="+"/>
                                    <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="7"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="8"/>
                                    <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="9"/>
                                    <Button Grid.Row="4" Grid.Column="6" Content="-" Style="{StaticResource NumpadButtonStyle}" FontSize="20" Command="{Binding NumpadKeyCommand}" CommandParameter="-"/>
                                    <Button Grid.Row="6" Grid.Column="0" Content="{Binding TxtDeleteKey}" Style="{StaticResource NumpadAmberButtonStyle}" FontSize="12" Command="{Binding NumpadKeyCommand}" CommandParameter="Delete"/>
                                    <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource NumpadButtonStyle}" FontSize="16" Command="{Binding NumpadKeyCommand}" CommandParameter="0"/>
                                    <Button Grid.Row="6" Grid.Column="4" Content="." Style="{StaticResource NumpadPeachButtonStyle}" FontSize="17" Command="{Binding NumpadKeyCommand}" CommandParameter="."/>
                                    <Button Grid.Row="6" Grid.Column="6" Style="{StaticResource NumpadCoralButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="⌫">
                                        <Viewbox Width="17" Height="17">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15" Stroke="#B91C1C" StrokeThickness="1.9" StrokeLineJoin="Round" Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Height="46">
                                <Button Content="{Binding TxtPaymentBtn}" Command="{Binding OpenPaymentViewCommand}" IsEnabled="{Binding HasCurrentOrderItems}" Style="{StaticResource PosPrimaryButtonStyle}" Height="46" FontSize="15" FontWeight="Bold"
                                        Visibility="{Binding IsOneClickPaymentVisible, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                                <Grid Visibility="{Binding IsOneClickPaymentVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding TxtPaymentBtn}" Command="{Binding OpenPaymentViewCommand}" IsEnabled="{Binding HasCurrentOrderItems}" Style="{StaticResource PosPrimaryButtonStyle}" Height="46" FontSize="14.5" FontWeight="Bold"/>
                                    <Button Grid.Column="2" Content="{Binding OneClickPaymentButtonLabel}" Command="{Binding OneClickPayCommand}" IsEnabled="{Binding HasCurrentOrderItems}" Style="{StaticResource PosTealButton}" Height="46" FontSize="14.5" FontWeight="Bold"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource BorderLightBrush}"/>

                    <!-- BOTTOM HALF: COMPACT CATEGORIES COLUMN (188px) + PRODUCTS GRID -->
                    <Grid Grid.Row="2" Background="{StaticResource AppBgBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="188"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                                <StackPanel>
                                    <Button Command="{Binding SelectAllCategoriesCommand}" Height="42" Margin="0,0,0,5" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AllCatBdr" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="8" Padding="10,0" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#475569"/>
                                                                <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#475569"/>
                                                                <Rectangle Canvas.Left="3" Canvas.Top="14" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#475569"/>
                                                                <Rectangle Canvas.Left="13" Canvas.Top="14" Width="8" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#475569"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding TxtAllCategories}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllCategoriesSelected}" Value="True">
                                                        <Setter TargetName="AllCatBdr" Property="BorderThickness" Value="2"/>
                                                        <Setter TargetName="AllCatBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                        <Setter TargetName="AllCatBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <ItemsControl ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PosCategoryRecord}">
                                                <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Height="42" Margin="0,0,0,5" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CatBdr"
                                                                    Background="{Binding CategoryButtonBgBrush}"
                                                                    CornerRadius="8"
                                                                    Padding="10,4"
                                                                    BorderThickness="1"
                                                                    BorderBrush="Transparent"
                                                                    RenderOptions.ClearTypeHint="Enabled">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="6" Height="22" CornerRadius="3" Background="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{Binding CategoryButtonFgBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="CatBdr" Property="BorderThickness" Value="2"/>
                                                                    <Setter TargetName="CatBdr" Property="BorderBrush" Value="{Binding CategoryActiveBorderBrush}"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CatBdr" Property="BorderBrush" Value="{Binding CategoryActiveBorderBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource BorderLightBrush}"/>

                        <ListBox Grid.Column="2"
                                 ItemsSource="{Binding ProductRows}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6,4,6,8"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 ScrollViewer.PanningDeceleration="0.001"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="2,2"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 SizeChanged="ProductsScrollViewer_SizeChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource PosProductCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>

            <!-- =================================================================== -->
            <!-- 3. IN-POS ORDERS VIEW (Clean 1280x720 Paid Session Orders)          -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="{StaticResource AppBgBrush}"
                  Visibility="{Binding IsOrdersViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Compact Search + Counter Bar -->
                <Border Grid.Row="0" Background="#FFFFFF" Padding="14,0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                MaxWidth="440"
                                HorizontalAlignment="Left"
                                Width="380"
                                Style="{StaticResource PosSearchBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#64748B" StrokeThickness="2"/>
                                        <Path Data="M 14,14 L 20,20" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBox Grid.Column="1"
                                         Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TxtSearchPaidOrdersPlaceholder}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPlaceholderBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding OrderSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding OrdersPagerText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Paid Orders Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <ItemsControl ItemsSource="{Binding FilteredInPosOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                <Button Command="{Binding DataContext.SelectInPosOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,8">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="OrdRowBdr"
                                                    Background="#FFFFFF"
                                                    BorderBrush="{StaticResource BorderLightBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    ClipToBounds="True">
                                                <StackPanel>
                                                    <!-- Order Summary Header -->
                                                    <Grid Height="52" Margin="14,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InPosDayDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding InPosTimeDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TrackingNumberDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                            <TextBlock Text="{Binding PosReference}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TotalDisplay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding InPosCashAndChangeSummary}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Visibility="{Binding DataContext.IsShowCashChangeVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding DataContext.PrintOrderReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding DataContext.IsPrintLastReceiptVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                                                                    Margin="0,0,8,0"
                                                                    Cursor="Hand"
                                                                    ToolTip="{Binding InPosPrintReceiptText}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="{StaticResource OdooPurpleSoftBrush}" BorderBrush="{StaticResource OdooPurpleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,4">
                                                                            <TextBlock Text="{Binding InPosPrintReceiptText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#EADCE6"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <Border Background="{StaticResource ActiveGreenSoftBrush}"
                                                                    BorderBrush="{StaticResource ActiveGreenBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="10,2.5"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding InPosPaidText}" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Order Lines & Total Breakdown -->
                                                    <Border Background="{StaticResource SurfaceSubtleBrush}"
                                                            BorderBrush="{StaticResource BorderLightBrush}"
                                                            BorderThickness="0,1,0,0"
                                                            Padding="24,8,16,8">
                                                        <StackPanel>
                                                            <!-- Product Lines Header -->
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DataContext.TxtUnitsColumn, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Units}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding DataContext.TxtItemColumn, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Item}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding DataContext.TxtTotalLabel, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Total}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:PosOrderLineRecord}">
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="30"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding QtyShortDisplay}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding PriceSubtotalInclDisplay}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Total Under Products (Replaces Cash & Change) -->
                                                            <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="0,5,0,0">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding DataContext.InPosTotalLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                                                                    <TextBlock Text="{Binding InPosTotalSummaryDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedInPos}" Value="True">
                                                    <Setter TargetName="OrdRowBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

             <!-- =================================================================== -->
            <!-- 4. PAYMENT VIEW (Standard Split & Compact Centered — Fits 1280x720) -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="{StaticResource AppBgBrush}"
                  Visibility="{Binding IsPaymentViewOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">

                <!-- =============================================================== -->
                <!-- OPTION A: STANDARD SPLIT PAYMENT LAYOUT                         -->
                <!-- =============================================================== -->
                <Grid Visibility="{Binding IsStandardPaymentLayout, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" MaxWidth="410"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: METHODS + QUICK TENDER + NUMPAD + ACTIONS -->
                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="196"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="54"/>
                            </Grid.RowDefinitions>

                            <!-- Scrollable Payment Methods List -->
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding AvailablePaymentMethods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PosPaymentMethodRecord}">
                                            <Button Command="{Binding DataContext.SelectPaymentMethodOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="46"
                                                    Margin="0,0,0,6"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="MthBdr"
                                                                Background="{StaticResource SurfaceSubtleBrush}"
                                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="14,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <Image Source="{Binding IconSource}"
                                                                       Height="22" Width="28"
                                                                       Stretch="Uniform"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="MthBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                                <Setter TargetName="MthBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                                <Setter TargetName="MthBdr" Property="BorderThickness" Value="1.5"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="MthBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Quick Tender Bar (+0.50, +1, +2, +5) -->
                            <Grid Grid.Row="1" Height="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+0.50" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="15" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="0.50"/>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+1" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="15.5" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="1"/>
                                </Border>
                                <Border Grid.Column="4" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+2" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="15.5" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="2"/>
                                </Border>
                                <Border Grid.Column="6" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+5" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="15.5" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="5"/>
                                </Border>
                            </Grid>

                            <!-- 4x4 Touch Numpad (196px) -->
                            <Border Grid.Row="3"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Grid Background="{StaticResource BorderLightBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="1"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="2"/>
                                    <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="3"/>
                                    <Button Grid.Row="0" Grid.Column="6" Content="+10" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="10"/>

                                    <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="4"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="5"/>
                                    <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="6"/>
                                    <Button Grid.Row="2" Grid.Column="6" Content="+20" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="20"/>

                                    <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="7"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="8"/>
                                    <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="9"/>
                                    <Button Grid.Row="4" Grid.Column="6" Content="+50" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="50"/>

                                    <Button Grid.Row="6" Grid.Column="0" Content="{Binding TxtDeleteKey}" FontSize="13.5" FontWeight="Bold" Style="{StaticResource PaymentNumpadAmberButtonStyle}" Command="{Binding ClearPaymentLineCommand}"/>
                                    <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="0"/>
                                    <Button Grid.Row="6" Grid.Column="4" Content="." Style="{StaticResource PaymentNumpadPeachButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="."/>
                                    <Button Grid.Row="6" Grid.Column="6" Style="{StaticResource PaymentNumpadCoralButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="⌫">
                                        <Viewbox Width="18" Height="18">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15"
                                                      Stroke="#B91C1C" StrokeThickness="1.9" StrokeLineJoin="Round" Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Action Buttons [Back] | [Validate] -->
                            <Grid Grid.Row="5" Height="54">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding TxtBackBtn}"
                                        Command="{Binding ClosePaymentViewCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="54" FontSize="15"/>

                                <Button Grid.Column="2"
                                        Content="{Binding TxtValidateBtn}"
                                        Command="{Binding ValidatePaymentCommand}"
                                        IsEnabled="{Binding CanValidatePayment}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="54" FontSize="16" FontWeight="Bold"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT PANEL: FRAMED TOTAL & TENDER SUMMARY CARD -->
                    <Grid Grid.Column="1" Background="{StaticResource AppBgBrush}" Margin="24,20">
                        <Border MaxWidth="660"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PosCardBorderStyle}"
                                Padding="28,26">
                            <StackPanel>
                                <TextBlock Text="{Binding TxtTotalLabel}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="{Binding OrderTotalDisplay}"
                                           FontSize="68"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,22"/>

                                <!-- Active Tendered Payment Pill -->
                                <Border Height="54"
                                        Background="{StaticResource OdooPurpleSoftBrush}"
                                        BorderBrush="{StaticResource OdooPurpleBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="18,0"
                                        Margin="0,0,0,18"
                                        Visibility="{Binding HasPaymentTendered, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedPaymentMethodDisplay, FallbackValue=Cash}"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PaymentLineAmountDisplay}"
                                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <Button Command="{Binding ClearPaymentLineCommand}"
                                                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,0">
                                                <TextBlock Text="×" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Remaining / Change Strip -->
                                <Border Background="{StaticResource SurfaceSubtleBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18,14">
                                    <Grid>
                                        <Grid Visibility="{Binding IsPaymentUnderpaid, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding TxtRemainingLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource DangerRedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RemainingDisplay}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Visibility="{Binding IsPaymentUnderpaid, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding TxtChangeLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ActiveGreenBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ChangeDisplay}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource ActiveGreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- =============================================================== -->
                <!-- OPTION B: COMPACT CENTERED PAYMENT LAYOUT (Zero-Scroll at 720p) -->
                <!-- =============================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsCenteredPaymentLayout, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                    <Border Width="640"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource PosCardBorderStyle}"
                            Padding="20,16"
                            Margin="0,10">
                        <StackPanel>
                            <!-- 1. Top Row: Order Total + Tendered/Change Pill Side-by-Side -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtTotalLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding OrderTotalDisplay}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,-2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <!-- Active Tender Line -->
                                    <Border Height="38"
                                            Background="{StaticResource OdooPurpleSoftBrush}"
                                            BorderBrush="{StaticResource OdooPurpleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,0"
                                            Margin="0,0,0,6"
                                            Visibility="{Binding HasPaymentTendered, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <TextBlock Text="{Binding SelectedPaymentMethodDisplay, FallbackValue=Cash}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PaymentLineAmountDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Command="{Binding ClearPaymentLineCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,0">
                                                    <TextBlock Text="×" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Change / Remaining Compact Bar -->
                                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <Grid>
                                            <Grid Visibility="{Binding IsPaymentUnderpaid, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding TxtRemainingLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RemainingDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Visibility="{Binding IsPaymentUnderpaid, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding TxtChangeLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ActiveGreenBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ChangeDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ActiveGreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Horizontal Single-Row Payment Methods Bar -->
                            <ItemsControl ItemsSource="{Binding AvailablePaymentMethods}" Margin="-3,0,-3,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosPaymentMethodRecord}">
                                        <Button Command="{Binding DataContext.SelectPaymentMethodOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Height="46"
                                                Margin="3,0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MthBdr"
                                                            Background="{StaticResource SurfaceSubtleBrush}"
                                                            BorderBrush="{StaticResource BorderLightBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,0">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Image Source="{Binding IconSource}" Height="20" Width="26" Stretch="Uniform" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="MthBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                            <Setter TargetName="MthBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                            <Setter TargetName="MthBdr" Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MthBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 3. Quick Tender Bar -->
                            <Grid Height="40" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+0.50" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="15.5" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="0.50"/>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+1" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="16" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="1"/>
                                </Border>
                                <Border Grid.Column="4" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+2" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="16" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="2"/>
                                </Border>
                                <Border Grid.Column="6" CornerRadius="7" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Button Content="+5" Style="{StaticResource PaymentNumpadGreenButtonStyle}" FontSize="16" FontWeight="Bold" Command="{Binding AddQuickTenderCommand}" CommandParameter="5"/>
                                </Border>
                            </Grid>

                            <!-- 4. Centered 4x4 Touch Numpad (208px) -->
                            <Border BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,10"
                                    ClipToBounds="True">
                                <Grid Height="208" Background="{StaticResource BorderLightBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="1"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="2"/>
                                    <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="3"/>
                                    <Button Grid.Row="0" Grid.Column="6" Content="+10" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="10"/>

                                    <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="4"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="5"/>
                                    <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="6"/>
                                    <Button Grid.Row="2" Grid.Column="6" Content="+20" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="20"/>

                                    <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="7"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="8"/>
                                    <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="9"/>
                                    <Button Grid.Row="4" Grid.Column="6" Content="+50" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="50"/>

                                    <Button Grid.Row="6" Grid.Column="0" Content="{Binding TxtDeleteKey}" FontSize="14.5" FontWeight="Bold" Style="{StaticResource PaymentNumpadAmberButtonStyle}" Command="{Binding ClearPaymentLineCommand}"/>
                                    <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="0"/>
                                    <Button Grid.Row="6" Grid.Column="4" Content="." Style="{StaticResource PaymentNumpadPeachButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="."/>
                                    <Button Grid.Row="6" Grid.Column="6" Style="{StaticResource PaymentNumpadCoralButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="⌫">
                                        <Viewbox Width="19" Height="19">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15"
                                                      Stroke="#B91C1C" StrokeThickness="1.9" StrokeLineJoin="Round" Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 5. [Back] and [Validate] -->
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding TxtBackBtn}"
                                        Command="{Binding ClosePaymentViewCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="52" FontSize="15.5"/>

                                <Button Grid.Column="2"
                                        Content="{Binding TxtValidateBtn}"
                                        Command="{Binding ValidatePaymentCommand}"
                                        IsEnabled="{Binding CanValidatePayment}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="52" FontSize="16.5" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 5. PAYMENT CONFIRMATION ("Change" Screen — Tuned for 1280x720)          -->
        <!-- ======================================================================= -->
        <Grid Background="{StaticResource AppBgBrush}"
              Cursor="Hand"
              MouseLeftButtonDown="ChangeScreenBackground_MouseLeftButtonDown"
              Visibility="{Binding IsPaymentConfirmationOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="24,18">
                <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="72" Height="72" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Canvas Width="133" Height="133">
                            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="109" Height="109" Fill="{StaticResource ActiveGreenBrush}"/>
                            <Polyline Points="41,70 56,85 92,49"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="{Binding TxtChangeTitle}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrencyPrefixSymbol}"
                                   Visibility="{Binding HasCurrencyPrefix, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                                   FontSize="64"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,10,14"/>
                        <TextBlock Text="{Binding ConfirmedChangeIntegerPart}"
                                   FontSize="132"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding ConfirmedChangeDecimalPart}"
                                   FontSize="76"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding CurrencySuffixSymbol}"
                                   Visibility="{Binding HasCurrencySuffix, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                                   FontSize="52"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="12,0,0,16"/>
                    </StackPanel>

                    <Border Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24,12"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                                <TextBlock Text="{Binding ConfirmedTenderMethodLabel, StringFormat='{}{0}: '}"
                                           FontSize="18" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConfirmedCashDisplay}"
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Width="1" Height="20" Background="{StaticResource BorderLightBrush}" Margin="0,0,28,0"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TxtAmountPaidLabel}"
                                           FontSize="18" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConfirmedPaidDisplay}"
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Viewbox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,28">
                <Button Command="{Binding PrintReceiptCommand}"
                        Visibility="{Binding IsPrintButtonVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Width="190" Height="54" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 19,8 H 5 C 3.34,8 2,9.34 2,11 V 17 H 6 V 21 H 18 V 17 H 22 V 11 C 22,9.34 20.66,8 19,8 Z M 16,19 H 8 V 15 H 16 V 19 Z M 19,12 C 18.45,12 18,11.55 18,11 C 18,10.45 18.45,10 19,10 C 19.55,10 20,10.45 20,11 C 20,11.55 19.55,12 19,12 Z M 18,3 H 6 V 7 H 18 V 3 Z"
                                      Fill="{StaticResource TextPrimaryBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding TxtPrintBtn}" FontSize="15.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ContinueAfterPaymentCommand}"
                        Style="{StaticResource PosPrimaryButtonStyle}"
                        Content="{Binding TxtContinueBtn}"
                        Width="190" Height="54" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 6. POS LANDING SCREEN ("Open Register" / Opening Control — Fits 720p)   -->
        <!-- ======================================================================= -->
        <Grid Panel.ZIndex="900"
              Visibility="{Binding IsPosLandingScreenOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F4F6F9" Offset="0.0"/>
                    <GradientStop Color="#EFEBF4" Offset="0.55"/>
                    <GradientStop Color="#E8E1F0" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header: Clock | Shop Name | Logo (Scaled Cleanly for 1280px) -->
            <Border Grid.Row="0" Padding="28,16,28,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Compact Clock & Date -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding LandingClockText}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LandingDayNameText}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LandingFullDateText}" FontSize="11.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Shop Name -->
                    <Border Grid.Column="1"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="20,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveShopName}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource OdooPurpleBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Right: Company Logo -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Image Source="{Binding CompanyLogoBitmap}"
                               MaxHeight="42"
                               Stretch="Uniform"
                               Visibility="{Binding HasCompanyLogo, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasCompanyLogo, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource OdooPurpleBrush}" Margin="0,0,4,0"/>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource OdooTealBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="odoo POS" FontSize="17" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center Content: Action Tile + Compact Last Session Summary -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Primary Open / Continue Tile -->
                <Button Command="{Binding EnterPosFromLandingCommand}"
                        Width="152" Height="148"
                        HorizontalAlignment="Center"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="#FFFFFF"
                                        CornerRadius="16"
                                        Effect="{StaticResource PosSubtleShadow}"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="CardBdr"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        RenderOptions.ClearTypeHint="Enabled">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="54" Height="54" CornerRadius="14" Background="{StaticResource OdooPurpleSoftBrush}" Margin="0,0,0,12">
                                            <Viewbox Width="28" Height="28">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 8.5,9 L 10.5,3.5 H 13.5 L 15.5,9 M 3,9 H 21 L 18.5,20 H 5.5 Z"
                                                          Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                                    <Ellipse Canvas.Left="10.5" Canvas.Top="13" Width="3" Height="3" Fill="{StaticResource OdooPurpleBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Text="{Binding LandingActionButtonText}"
                                                   FontSize="14.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                    <Setter TargetName="CardBdr" Property="Background" Value="#FDFCFE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Compact 3-Column Last Session Card (Visible when Register is Closed) -->
                <Grid Visibility="{Binding IsRegisterClosedForLanding, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                      Margin="0,18,0,0"
                      Width="560">
                    <Border Background="#FFFFFF"
                            CornerRadius="12"
                            Effect="{StaticResource PosSubtleShadow}"
                            IsHitTestVisible="False"/>
                    <Border Background="#FFFFFF"
                            CornerRadius="12"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            Padding="20,14"
                            RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding TxtLastSessionDetails}"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="5" Padding="8,2">
                                <TextBlock Text="{Binding LastSessionTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="0.85*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{Binding TxtPointOfSaleLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                <TextBlock Text="{Binding LastSessionPosName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{Binding TxtOpeningDateLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                <TextBlock Text="{Binding LastSessionOpeningDateDisplay}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="{Binding TxtOrdersTab}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                <TextBlock Text="{Binding LastSessionOrdersCountDisplay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="{Binding TxtSessionTitleLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                <TextBlock Text="{Binding LastSessionTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="{Binding TxtClosingDateLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                <TextBlock Text="{Binding LastSessionClosingDateDisplay}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <TextBlock Text="{Binding TxtTotalLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                <TextBlock Text="{Binding LastSessionTotalDisplay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ActiveGreenBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

                <!-- Print Last Session Sales Details -->
                <Button Command="{Binding PrintLastSessionSalesDetailsCommand}"
                        Visibility="{Binding IsRegisterClosedForLanding, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                        Style="{StaticResource PosSecondaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Height="36"
                        Padding="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖨 " FontSize="13.5" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding TxtPrintLastSessionSalesDetails}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bottom Backend / Logout Button -->
            <Button Grid.Row="2"
                    Command="{Binding ReturnToBackendCommand}"
                    Content="{Binding LandingBottomButtonText}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,18"
                    Height="34"
                    Padding="18,0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="{StaticResource TextPrimaryBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ======================================================================= -->
        <!-- MODALS & OVERLAYS (All Sized Cleanly for 1280x720)                      -->
        <!-- ======================================================================= -->

        <!-- ==================== MODAL 1: OPENING CONTROL ==================== -->
        <Grid Background="{StaticResource ModalBackdropBrush}"
              Panel.ZIndex="1000"
              Visibility="{Binding IsOpeningControlModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <ContentControl Width="500"
                            Style="{StaticResource PosModalContainerStyle}"
                            Padding="24,22">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding TxtOpeningControlBtn}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Command="{Binding DiscardOpeningControlCommand}" Style="{StaticResource ModalCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding TxtOpeningCashLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                    <Border Style="{StaticResource PosInputBorderStyle}" Height="42" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OpeningCashTextBox"
                                     Grid.Column="0"
                                     Text="{Binding OpeningCashInput, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="15.5"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ClearOpeningCashCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0">
                                <TextBlock Text="✕" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding TxtOpeningNoteLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                    <Border Height="92" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,18">
                        <Grid>
                            <TextBox Text="{Binding OpeningNote, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding TxtOpeningNotePlaceholder}" FontSize="13.5" Foreground="{StaticResource TextPlaceholderBrush}" IsHitTestVisible="False"
                                       Visibility="{Binding OpeningNote, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding TxtOpenRegisterBtn}" Command="{Binding OpenRegisterSubmitCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Height="42" Padding="20,0" Margin="0,0,10,0"/>
                        <Button Content="{Binding TxtDiscardBtn}" Command="{Binding DiscardOpeningControlCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="42" Padding="18,0"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- ==================== MODAL 2: 3-DOTS SESSION MENU ==================== -->
        <Grid Background="{StaticResource ModalBackdropBrush}"
              Panel.ZIndex="1100"
              MouseLeftButtonDown="HamburgerBackdrop_MouseLeftButtonDown"
              Visibility="{Binding IsHamburgerMenuOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <ContentControl Width="400"
                            Style="{StaticResource PosModalContainerStyle}"
                            Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{Binding TxtSessionInfoTitle}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Command="{Binding CloseHamburgerMenuCommand}" Style="{StaticResource ModalCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Session Stats Card -->
                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding TxtSessionHeader}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentSessionDisplayName}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                            <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TxtTotalOrdersHeader}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SessionTotalOrdersDisplay}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding TxtTotalPaymentHeader}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SessionTotalPaymentsDisplay}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Zoom Control -->
                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="{Binding TxtZoomLabel}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource PosSecondaryButton}" Width="32" Height="30" Padding="0" Content="−" FontSize="16"/>
                                <Button Command="{Binding ResetZoomCommand}" Style="{StaticResource PosSecondaryButton}" MinWidth="56" Height="30" Padding="6,0" Margin="4,0" Content="{Binding PosZoomPercentageText}" FontSize="12"/>
                                <Button Command="{Binding ZoomInCommand}" Style="{StaticResource PosSecondaryButton}" Width="32" Height="30" Padding="0" Content="+" FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Command="{Binding OpenOpeningControlModalCommand}"
                            Style="{StaticResource PosSecondaryButton}"
                            Height="42" Margin="0,0,0,8"
                            Content="{Binding TxtOpeningControlBtn}"/>

                    <Button Command="{Binding OpenClosingRegisterWorkflowCommand}"
                            Style="{StaticResource PosDangerButton}"
                            Height="42" Margin="0,0,0,8"
                            Content="{Binding TxtCloseRegisterBtn}"/>

                    <Button Command="{Binding LogoutFromPosCommand}"
                            Style="{StaticResource PosDangerSoftButton}"
                            Height="40"
                            Content="{Binding TxtLogoutBtn}"/>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- ==================== MODAL 3 & 4: CLOSING REGISTER (Scroll-Safe for 720p) ==================== -->
        <Grid Background="{StaticResource ModalBackdropBrush}"
              Panel.ZIndex="1200"
              Visibility="{Binding IsClosingRegisterModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">

            <ContentControl Width="540"
                            MaxHeight="640"
                            Style="{StaticResource PosModalContainerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sticky Header -->
                    <Border Grid.Row="0" Padding="20,14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="{Binding TxtClosingRegisterTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{StaticResource OdooPurpleSoftBrush}" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SessionSummaryText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Scrollable Middle Body (Guarantees Footer is Never Clipped at 720p) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14">
                        <StackPanel>
                            <!-- Cash Breakdown -->
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Cash" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CashCounted, Converter={StaticResource CurrencyValueConverter}}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="2,0,0,0" Margin="4,0,0,10" Padding="10,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,1.5">
                                        <TextBlock Text="{Binding TxtOpeningSubLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CashOpening, Converter={StaticResource CurrencyValueConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1.5">
                                        <TextBlock Text="{Binding TxtPaymentsInCashLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CashPayments, Converter={StaticResource CurrencyValueConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1.5">
                                        <TextBlock Text="{Binding TxtCashInOutLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CashInOut, Converter={StaticResource CurrencyValueConverter}, ConverterParameter='+ '}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1.5">
                                        <TextBlock Text="{Binding TxtCountedLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CashCounted, Converter={StaticResource CurrencyValueConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1.5">
                                        <TextBlock Text="{Binding TxtDifferenceLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CashDifference, Converter={StaticResource CurrencyValueConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card & Customer Account Side-by-Side (Saves Vertical Space) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Card" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding CardTotal, Converter={StaticResource CurrencyValueConverter}}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="{Binding TxtCountedLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CardCounted, Converter={StaticResource CurrencyValueConverter}}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="{Binding TxtDifferenceLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CardDifference, Converter={StaticResource CurrencyValueConverter}}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Customer Account" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CustomerAccountTotal, Converter={StaticResource CurrencyValueConverter}}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="{Binding TxtCountedLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CustomerAccountCounted, Converter={StaticResource CurrencyValueConverter}}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="{Binding TxtDifferenceLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CustomerAccountDifference, Converter={StaticResource CurrencyValueConverter}}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Cash Count Input -->
                            <TextBlock Text="{Binding TxtCashCountLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource PosInputBorderStyle}" Height="38" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ClosingCashCount, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding ClearClosingCashCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0">
                                        <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Closing Note -->
                            <TextBlock Text="{Binding TxtClosingNoteLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Border Height="62" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <Grid>
                                    <TextBox Text="{Binding ClosingNote, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12.5"/>
                                    <TextBlock Text="{Binding TxtClosingNotePlaceholder}" FontSize="12.5" Foreground="{StaticResource TextPlaceholderBrush}" IsHitTestVisible="False"
                                               Visibility="{Binding ClosingNote, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sticky Footer Actions -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="{Binding TxtCloseRegisterBtn}" Command="{Binding SubmitCloseRegisterCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Height="38" Margin="0,0,8,0"/>
                                <Button Content="{Binding TxtDiscardBtn}" Command="{Binding DiscardClosingRegisterCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="38"/>
                            </StackPanel>
                            <Button Content="{Binding TxtDailySaleBtn}" Command="{Binding PrintReceiptCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="38" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </ContentControl>

            <!-- Layered "Oh snap !" Draft Orders Warning -->
            <Grid Background="{StaticResource ModalBackdropBrush}"
                  Visibility="{Binding IsDraftOrdersWarningModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <ContentControl Width="360"
                                Style="{StaticResource PosModalContainerStyle}"
                                Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding TxtOhSnapTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Command="{Binding DismissDraftOrdersWarningCommand}" Style="{StaticResource ModalCloseButtonStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="{Binding TxtDraftOrdersWarningMsg}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding TxtReviewOrdersBtn}" Command="{Binding ReviewDraftOrdersCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Height="38" Margin="0,0,8,0"/>
                            <Button Content="{Binding TxtCancelOrdersBtn}" Command="{Binding CancelDraftOrdersAndCloseCommand}" Style="{StaticResource PosDangerSoftButton}" Height="38"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ==================== MODAL 5: CUSTOMER NOTE DIALOG ==================== -->
        <Grid Background="{StaticResource ModalBackdropBrush}"
              Panel.ZIndex="1300"
              Visibility="{Binding IsNoteModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <ContentControl Width="400" Style="{StaticResource PosModalContainerStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Add Note" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <Border Height="84" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                        <TextBox Text="{Binding NoteInputText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply" Command="{Binding SaveNoteModalCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Height="38" Margin="0,0,8,0"/>
                        <Button Content="{Binding TxtDiscardBtn}" Command="{Binding CloseNoteModalCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="38"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- ==================== MODAL 6: PRODUCT VARIANT SELECTION (Fits 720p) ==================== -->
        <Grid Background="{StaticResource ModalBackdropBrush}"
              Panel.ZIndex="1400"
              Visibility="{Binding IsVariantPopupOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <ContentControl Width="560"
                            MaxHeight="600"
                            Style="{StaticResource PosModalContainerStyle}"
                            Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VariantPopupProductName}" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TxtVariantSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource OdooPurpleSoftBrush}" BorderBrush="{StaticResource OdooPurpleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="{Binding VariantPopupTotalPriceDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                            </Border>

                            <Button Grid.Column="2" Command="{Binding CloseVariantPopupCommand}" Style="{StaticResource ModalCloseButtonStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="390">
                        <ItemsControl ItemsSource="{Binding VariantAttributeGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosVariantAttributeGroup}">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding AttributeName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                        <ItemsControl ItemsSource="{Binding Options}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:PosVariantOptionItem}">
                                                    <Button Command="{Binding DataContext.SelectVariantOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" Margin="0,0,8,8">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="OptBdr" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" MinWidth="66">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Ellipse Width="14" Height="14" Fill="{Binding SwatchBrush}" Stroke="#94A3B8" StrokeThickness="1" Margin="0,0,7,0"
                                                                                 Visibility="{Binding HasColorSwatch, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                                        <TextBlock x:Name="OptTxt" Text="{Binding ValueName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                        <Border Background="{StaticResource ActiveGreenSoftBrush}" BorderBrush="{StaticResource ActiveGreenBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="7,0,0,0"
                                                                                Visibility="{Binding HasExtraPrice, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                                            <TextBlock Text="{Binding ExtraPriceDisplay}" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="OptBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                                        <Setter TargetName="OptBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                                        <Setter TargetName="OptBdr" Property="BorderThickness" Value="2"/>
                                                                        <Setter TargetName="OptTxt" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="OptBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding TxtAddBtn}" Command="{Binding ConfirmVariantSelectionCommand}" Style="{StaticResource PosPrimaryButtonStyle}" MinWidth="104" Height="40" Margin="0,0,10,0"/>
                            <Button Content="{Binding TxtDiscardBtn}" Command="{Binding CloseVariantPopupCommand}" Style="{StaticResource PosSecondaryButtonStyle}" MinWidth="96" Height="40"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ==================== MODAL 7: RECEIPT PREVIEW (Fits 720p) ==================== -->
        <Grid Background="{StaticResource ModalBackdropBrush}"
              Panel.ZIndex="1500"
              Visibility="{Binding IsReceiptPreviewModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <ContentControl Width="480"
                            MaxHeight="620"
                            Style="{StaticResource PosModalContainerStyle}"
                            Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding ReceiptPreviewTitle}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ReceiptPreviewDesignBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding CloseReceiptPreviewModalCommand}" Style="{StaticResource ModalCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                        <StackPanel>
                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                <TextBlock Text="{Binding ReceiptPreviewMainText}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel Visibility="{Binding HasSecondReceiptPreview, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding ReceiptPreviewSecondTitle}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                                <Border Background="{StaticResource WarningAmberSoftBrush}" BorderBrush="{StaticResource WarningAmberBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <TextBlock Text="{Binding ReceiptPreviewSecondText}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Close" Command="{Binding CloseReceiptPreviewModalCommand}" Style="{StaticResource PosPrimaryButtonStyle}" MinWidth="96" Height="36"/>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- POS Toast Notification -->
        <ContentControl Style="{StaticResource PosToastContainerStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,20"
                        Panel.ZIndex="2000"
                        Visibility="{Binding IsPosToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding PosToastMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
        </ContentControl>
    </Grid>
</UserControl>