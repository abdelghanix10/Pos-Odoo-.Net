<UserControl x:Class="OdooPosLogin.ProductTagManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- ==================== COLOR PALETTE ==================== -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>
        
        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>
        
        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>
        
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>
        
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>

        <!-- ==================== SHADOW EFFECTS ==================== -->
        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="12"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <!-- ==================== PRIMARY PURPLE BUTTON ("Sync from Odoo") ==================== -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pager Chevron Button Style -->
        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Control Bar -->
            <RowDefinition Height="68"/>
            <!-- 2. Workspace Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. STANDARDIZED TOP CONTROL BAR                                         -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: "Sync from Odoo" Button + Breadcrumb -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Search Bar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Empty -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: "Sync from Odoo" Button + Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Primary Purple "Sync from Odoo" Button -->
                    <Button x:Name="TopSyncTagsBtn"
                            Style="{StaticResource OdooPrimaryButtonStyle}"
                            Click="SyncTagsBtn_Click"
                            ToolTip="Synchronize product tags from Odoo Online"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="TagSyncIconBox" Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="TagSyncIconRotation" Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="SyncButtonText"
                                       Text="Sync from Odoo"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumb Root: "Product Tags" -->
                    <Button x:Name="BreadcrumbRootButton"
                            Click="BreadcrumbRoot_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText"
                                           Text="Product Tags"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Breadcrumb Sub-Path (when viewing Detail View) -->
                    <StackPanel x:Name="BreadcrumbDetailSubPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock Text="  /  "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BreadcrumbCurrentTagName"
                                   Text="Bestseller"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: SEARCH BAR -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="360" Height="36" VerticalAlignment="Center">
                    <Border Background="#F3F4F6"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Grid Margin="12,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Magnifying Glass Icon -->
                            <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 15.5,14 L 14.71,14 L 14.43,13.73 C 15.41,12.59 16,11.11 16,9.5 C 16,5.91 13.09,3 9.5,3 C 5.91,3 3,5.91 3,9.5 C 3,13.09 5.91,16 9.5,16 C 11.11,16 12.59,15.41 13.73,14.43 L 14,14.71 L 14,15.5 L 19,20.49 L 20.49,19 L 15.5,14 Z M 9.5,14 C 7.01,14 5,11.99 5,9.5 C 5,7.01 7.01,5 9.5,5 C 11.99,5 14,7.01 14,9.5 C 14,11.99 11.99,14 9.5,14 Z"
                                          Fill="{StaticResource PlaceholderTextBrush}"/>
                                </Canvas>
                            </Viewbox>

                            <!-- Placeholder Text -->
                            <TextBlock Grid.Column="1"
                                       x:Name="SearchPlaceholderText"
                                       Text="Search Tags..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <!-- Real Search TextBox -->
                            <TextBox Grid.Column="1"
                                     x:Name="SearchTagsTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchTagsTextBox_TextChanged"/>

                            <!-- Clear Search Button -->
                            <Button Grid.Column="2"
                                    x:Name="ClearSearchButton"
                                    Click="ClearSearchButton_Click"
                                    Visibility="Collapsed"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="18" Height="18"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: DETAIL RECORD SWITCHER (VISIBLE ONLY IN DETAIL VIEW) -->
                <StackPanel x:Name="DetailRecordPagerPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="DetailPagerCounterText"
                               Text="1 / 5"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button x:Name="DetailPrevRecordBtn"
                            Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Click="DetailPrevRecord_Click"
                            ToolTip="Previous tag"
                            Margin="0,0,4,0">
                        <Path Data="M 17,7 L 10,14 L 17,21"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="8" Height="14"
                              Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="DetailNextRecordBtn"
                            Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Click="DetailNextRecord_Click"
                            ToolTip="Next tag">
                        <Path Data="M 10,7 L 17,14 L 10,21"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="8" Height="14"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. WORKSPACE CONTENT AREA                                               -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">
            <!-- =================================================================== -->
            <!-- VIEW 1: PRODUCT TAGS LIST VIEW (TABLE)                              -->
            <!-- =================================================================== -->
            <Grid x:Name="TagListViewContainer" Visibility="Visible" Margin="32,24,32,32">
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{StaticResource SubtleCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header -->
                            <RowDefinition Height="44"/>
                            <!-- Table Data Body -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="20,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Tag Name -->
                                    <ColumnDefinition Width="2.5*"/>
                                    <!-- Color (Badge / Dot) -->
                                    <ColumnDefinition Width="2*"/>
                                    <!-- Linked Products Count -->
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Tag Name Header -->
                                <TextBlock Grid.Column="0"
                                           Text="Tag Name"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>

                                <!-- Column 1: Color Header -->
                                <TextBlock Grid.Column="1"
                                           Text="Color"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>

                                <!-- Column 2: Linked Products Header -->
                                <TextBlock Grid.Column="2"
                                           Text="Linked Products"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- TABLE DATA ROWS -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TagsListItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProductTagRecord}">
                                        <!-- Clickable Table Row Button -->
                                        <Button Click="TagRow_Click"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder"
                                                            Background="#FFFFFF"
                                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="20,13"
                                                            MinHeight="48">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <!-- Tag Name -->
                                                                <ColumnDefinition Width="2.5*"/>
                                                                <!-- Color Badge -->
                                                                <ColumnDefinition Width="2*"/>
                                                                <!-- Linked Products Count -->
                                                                <ColumnDefinition Width="1.5*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Col 0: Tag Name (Bold/Clean text) -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Col 1: Color Pill Badge with Colored Dot -->
                                                            <Border Grid.Column="1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding SoftBackgroundBrush}"
                                                                    BorderBrush="{Binding ColorBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="10,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding ColorBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Col 2: Linked Products Count -->
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding ProductsCountDisplay}"
                                                                       FontSize="13.5"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#F3ECF1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- =================================================================== -->
            <!-- VIEW 2: PRODUCT TAG DETAIL VIEW (STRICTLY READ-ONLY CARD)           -->
            <!-- =================================================================== -->
            <ScrollViewer x:Name="TagDetailViewContainer"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,48">
                    <!-- SLEEK HORIZONTAL WHITE CARD (8px CORNERS, SUBTLE BORDER) -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="32,28"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <!-- TOP BAR: BREADCRUMB / TITLE + SMART PRODUCTS BADGE -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Tag Subtitle & Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Product Tag"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="FormTagNameDisplay"
                                               Text="Bestseller"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>

                                <!-- Right: "Products" Smart Badge Button -->
                                <Border Grid.Column="1"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Product Cube Icon -->
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 12,2 L 21,7 L 21,17 L 12,22 L 3,17 L 3,7 Z"
                                                      Stroke="{StaticResource OdooTealBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round"/>
                                                <Path Data="M 12,2 L 12,12 L 21,7 M 12,12 L 3,7 M 12,12 L 12,22"
                                                      Stroke="{StaticResource OdooTealBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="FormRelatedProductsCountText"
                                                   Text="12 Products"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource OdooTealBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- DETAILS GRID: COLOR INDICATOR & BADGE DISPLAY -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <!-- Color Indicator Column -->
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="48"/>
                                    <!-- Tag Badge Preview Column -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COLOR COLUMN -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tag Color"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="FormColorDot"
                                                 Width="22" Height="22"
                                                 Fill="#EF4444"
                                                 Stroke="{StaticResource SubtleBorderBrush}"
                                                 StrokeThickness="1"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FormColorNameDisplay"
                                                   Text="Color 1"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- BADGE PREVIEW COLUMN -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tag Preview"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border x:Name="FormBadgePreviewBorder"
                                            HorizontalAlignment="Left"
                                            Background="#FEE2E2"
                                            BorderBrush="#EF4444"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="FormBadgePreviewDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="FormBadgePreviewText"
                                                       Text="Bestseller"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#EF4444"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 3. TOAST BANNER NOTIFICATION                                            -->
        <!-- ======================================================================= -->
        <Border x:Name="TagToastBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,32"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="TagToastDot" Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="TagToastText"
                           Text="Tags synchronized successfully."
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
