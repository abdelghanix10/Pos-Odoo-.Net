<UserControl x:Class="OdooPosLogin.PosRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1366" d:DesignHeight="768"
             Background="#EFF1F5"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.DataContext>
        <vm:PosRegisterViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#EFF1F5"/>
        <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BorderMidBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#68598A"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#584878"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#CFCBE2"/>
        <SolidColorBrush x:Key="OdooPurpleRowBrush" Color="#DCD9E8"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#2A9D8F"/>
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#37A447"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#D62849"/>

        <SolidColorBrush x:Key="KeyAmberBrush" Color="#F3DC8B"/>
        <SolidColorBrush x:Key="KeyPeachBrush" Color="#F4D3C4"/>
        <SolidColorBrush x:Key="KeyCoralBrush" Color="#F29C9C"/>
        <SolidColorBrush x:Key="KeyGreenBrush" Color="#BEE8C8"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#9CA3AF"/>

        <DropShadowEffect x:Key="ModalShadow"
                          BlurRadius="24"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.22"/>

        <!-- Numpad Key Style -->
        <Style x:Key="NumpadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Purple Action Button -->
        <Style x:Key="PosPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outlined Button -->
        <Style x:Key="PosSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cart Action Strip Button ([Customer], [Note], [↑], [⋮]) -->
        <Style x:Key="CartActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ======================================================================= -->
        <!-- BASE POS TERMINAL WORKSPACE                                             -->
        <!-- ======================================================================= -->
        <Grid Visibility="{Binding IsPaymentConfirmationOpen, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- =================================================================== -->
            <!-- 1. TOP POS HEADER BAR (Screenshots 1, 2, 3, 4, 5, 7, 9)             -->
            <!-- =================================================================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: [Register | Orders] + [⊕] + | + [2001] [2002] -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Register Button -->
                        <Button Content="Register"
                                Command="{Binding SwitchToRegisterViewCommand}"
                                Height="38"
                                Padding="14,0"
                                FontSize="14"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr"
                                            Background="#F9FAFB"
                                            BorderBrush="{StaticResource BorderMidBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4,0,0,4"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ActivePosView}" Value="Register">
                                            <Setter TargetName="Bdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter TargetName="Bdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Orders Button -->
                        <Button Content="Orders"
                                Command="{Binding SwitchToOrdersViewCommand}"
                                Height="38"
                                Padding="14,0"
                                FontSize="14"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr"
                                            Background="#F9FAFB"
                                            BorderBrush="{StaticResource BorderMidBrush}"
                                            BorderThickness="0,1,1,1"
                                            CornerRadius="0,4,4,0"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ActivePosView}" Value="Orders">
                                            <Setter TargetName="Bdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter TargetName="Bdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                            <Setter TargetName="Bdr" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- [⊕] New Parallel Order Button -->
                        <Button Command="{Binding CreateNewDraftOrderCommand}"
                                Width="38" Height="38"
                                Margin="8,0,8,0"
                                Cursor="Hand"
                                ToolTip="New Order">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr" Background="#F3F4F6" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" CornerRadius="4">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                                <Path Data="M 12,7 V 17 M 7,12 H 17" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Vertical Divider | -->
                        <Border Width="1" Height="22" Background="{StaticResource BorderMidBrush}" Margin="2,0,8,0" VerticalAlignment="Center"/>

                        <!-- Draft Order Tabs -->
                        <ItemsControl ItemsSource="{Binding DraftOrders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosDraftOrder}">
                                    <Button Command="{Binding DataContext.SelectDraftOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="38"
                                            MinWidth="52"
                                            Padding="12,0"
                                            Margin="0,0,6,0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TabBdr"
                                                        Background="#E5E7EB"
                                                        BorderBrush="{StaticResource BorderMidBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="{Binding OrderNumber}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="TabBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                        <Setter TargetName="TabBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- RIGHT: Pending Sync Pill + Search Bar + Barcode Icon + Cashier Avatar + Hamburger -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Live Pending Sync Queue Button (Visible when unsynced transactions exist) -->
                        <Button Command="{Binding OpenPendingSyncWindowCommand}"
                                Height="32"
                                Padding="10,0"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                ToolTip="View Unsynced POS Transactions Queue"
                                Visibility="{Binding HasPendingSync, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SyncBdr"
                                            Background="#FFFBEB"
                                            BorderBrush="#F59E0B"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↻ " FontSize="12" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendingSyncBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SyncBdr" Property="Background" Value="#FEF3C7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Search products... -->
                        <Border Width="210"
                                Height="38"
                                Background="#F3F4F6"
                                BorderBrush="{StaticResource BorderMidBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,0"
                                Margin="0,0,14,0"
                                Visibility="{Binding IsProductSearchVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                        <Path Data="M 14,14 L 20,20" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13.5"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Search products..."
                                           FontSize="13.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ProductSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>

                        <!-- Barcode Icon -->
                        <Viewbox Width="20" Height="18" Margin="0,0,16,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsTopBarcodeVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Canvas Width="24" Height="20">
                                <Rectangle Canvas.Left="1" Canvas.Top="2" Width="2" Height="16" Fill="#111827"/>
                                <Rectangle Canvas.Left="5" Canvas.Top="2" Width="1.5" Height="16" Fill="#111827"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="2" Width="3" Height="16" Fill="#111827"/>
                                <Rectangle Canvas.Left="13" Canvas.Top="2" Width="1.5" Height="16" Fill="#111827"/>
                                <Rectangle Canvas.Left="16" Canvas.Top="2" Width="2" Height="16" Fill="#111827"/>
                                <Rectangle Canvas.Left="20" Canvas.Top="2" Width="3" Height="16" Fill="#111827"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Cashier Avatar Square -->
                        <Border Width="28" Height="28"
                                CornerRadius="4"
                                Background="{StaticResource OdooPurpleSoftBrush}"
                                Margin="0,0,12,0"
                                ClipToBounds="True"
                                ToolTip="{Binding CashierName}">
                            <Grid>
                                <Image Source="{Binding CashierAvatarBitmap}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasCashierAvatar, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                <TextBlock Text="{Binding CashierInitials}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasCashierAvatar, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>

                        <!-- Hamburger Menu Button (☰) -->
                        <Button Command="{Binding OpenHamburgerMenuCommand}"
                                Width="38" Height="38"
                                Cursor="Hand"
                                ToolTip="Menu">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr" Background="#F3F4F6" CornerRadius="4">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 4,7 H 20 M 4,12 H 20 M 4,17 H 20" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =================================================================== -->
            <!-- 2. MAIN REGISTER VIEW (Screenshots 1, 2, 5, 7, 9)                   -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsRegisterViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="396"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT CART & NUMPAD PANEL -->
                <Border Grid.Column="0"
                        Background="#F8F9FA"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ROW 0: CART ITEMS LIST (Button-based for instant click handling) -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CurrentOrder.CartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosCartItem}">
                                        <Button Command="{Binding DataContext.SelectCartLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="LineBdr" Padding="10,7" Background="Transparent">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding QuantityDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding LineTotalDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding CustomerNote}"
                                                                       FontSize="11.5"
                                                                       FontStyle="Italic"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="22,2,0,0"
                                                                       Visibility="{Binding HasCustomerNote, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="LineBdr" Property="Background" Value="{StaticResource OdooPurpleRowBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ROW 1: TAXES & TOTAL -->
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8,8,8,6"
                                Visibility="{Binding HasCurrentOrderItems, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Taxes" FontSize="12.5" Foreground="#4B5563"/>
                                    <TextBlock Text="{Binding CurrentOrder.TaxesDisplay}" FontSize="12.5" Foreground="#4B5563" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Total" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentOrder.TotalDisplay}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ROW 2: ACTION BAR ([Customer] [Note] ... [↑] [⋮]) -->
                        <Border Grid.Row="2" Padding="6,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource CartActionButtonStyle}"
                                            Content="{Binding CurrentOrder.CustomerButtonDisplay, FallbackValue=Customer}"
                                            Command="{Binding OpenCustomerPromptCommand}"
                                            Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource CartActionButtonStyle}"
                                            Content="Note"
                                            Command="{Binding OpenNotePromptCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource CartActionButtonStyle}"
                                            Width="38" Padding="0"
                                            Command="{Binding ParkOrderCommand}"
                                            Margin="0,0,5,0"
                                            ToolTip="Park Ongoing Order">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 12,15 V 4 M 8,8 L 12,4 L 16,8 M 5,19 H 19"
                                                      Stroke="{StaticResource TextPrimaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>

                                    <Button Style="{StaticResource CartActionButtonStyle}"
                                            Width="38" Padding="0"
                                            Command="{Binding ClearCurrentOrderLinesCommand}"
                                            ToolTip="More Actions">
                                        <TextBlock Text="⋮" FontSize="15" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ROW 3: 4x4 TOUCH NUMPAD -->
                        <Border Grid.Row="3"
                                Margin="6,0,6,6"
                                BorderBrush="{StaticResource BorderMidBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Visibility="{Binding ShowExpandedNumpad, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <UniformGrid Rows="4" Columns="4" Height="196">
                                <Button Content="1" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="1"/>
                                <Button Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="2"/>
                                <Button Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="3"/>
                                <Button Content="Qty" Command="{Binding SetNumpadModeCommand}" CommandParameter="Qty">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NumpadMode}" Value="Qty">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="4"/>
                                <Button Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="5"/>
                                <Button Content="6" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="6"/>
                                <Button Content="%" Command="{Binding SetNumpadModeCommand}" CommandParameter="%">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NumpadMode}" Value="%">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="7" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="7"/>
                                <Button Content="8" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="8"/>
                                <Button Content="9" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="9"/>
                                <Button Content="Price" Command="{Binding SetNumpadModeCommand}" CommandParameter="Price">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NumpadMode}" Value="Price">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="+/-" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyAmberBrush}" Command="{Binding NumpadKeyCommand}" CommandParameter="+/-"/>
                                <Button Content="0" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="0"/>
                                <Button Content="." Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyPeachBrush}" Command="{Binding NumpadKeyCommand}" CommandParameter="."/>
                                <Button Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyCoralBrush}" Command="{Binding NumpadKeyCommand}" CommandParameter="⌫">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </UniformGrid>
                        </Border>

                        <!-- ROW 4: FULL-WIDTH PURPLE PAYMENT BUTTON -->
                        <Button Grid.Row="4"
                                Content="Payment"
                                Command="{Binding OpenPaymentViewCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="50"
                                Margin="6,0,6,6"
                                FontSize="15"
                                Visibility="{Binding HasCurrentOrderItems, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                    </Grid>
                </Border>

                <!-- RIGHT CATEGORIES & PRODUCT SELLING GRID -->
                <Grid Grid.Column="1" Background="#EFF1F5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Tiles -->
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="8,8,8,4">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosCategoryRecord}">
                                    <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="148" Height="58"
                                            Margin="0,0,8,0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding ColorBrush}"
                                                        BorderBrush="#5A6275"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Product Cards Grid (Uses <Button> so rapid multi-taps never get dropped as double-clicks) -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4,4,4,12">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ProductRecord}">
                                    <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="148"
                                            Height="134"
                                            Margin="4"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CardBdr"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#D1D5DB"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="30"/>
                                                            <RowDefinition Height="4"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Product Photo -->
                                                        <Grid Grid.Row="0" Background="#EAECEF" ClipToBounds="True">
                                                            <Image Source="{Binding ImageBitmap}"
                                                                   Stretch="UniformToFill"
                                                                   Visibility="{Binding HasImage, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       Margin="8"
                                                                       Visibility="{Binding HasImage, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                                                        </Grid>

                                                        <!-- Label Strip + Black Quantity Pill [ 1 ] -->
                                                        <Border Grid.Row="1" Background="#FFFFFF" Padding="6,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>

                                                                <Border Grid.Column="1"
                                                                        Background="#000000"
                                                                        CornerRadius="4"
                                                                        MinWidth="20"
                                                                        Height="20"
                                                                        Padding="5,0"
                                                                        Margin="4,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasCartQuantity, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                                    <TextBlock Text="{Binding CartQuantity}"
                                                                               FontSize="11.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="#FFFFFF"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Bottom Category Accent Bar -->
                                                        <Border Grid.Row="2" Background="{Binding CategoryColorBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CardBdr" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- =================================================================== -->
            <!-- 3. IN-POS ORDERS VIEW (Screenshot 3)                                -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="#FFFFFF"
                  Visibility="{Binding IsOrdersViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="396"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: ORDERS LIST & SEARCH/FILTER TOOLBAR -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Search + "Active ▾" + Pager Bar -->
                    <Border Grid.Row="0" Padding="8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Height="36"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource BorderMidBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                                        <Viewbox Width="13" Height="13">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                                <Path Data="M 14,14 L 20,20" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="13.5"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Search Orders..."
                                               FontSize="13.5"
                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding OrderSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>

                                    <Button Grid.Column="2"
                                            Command="{Binding CycleOrderStatusFilterCommand}"
                                            Background="#F3F4F6"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1,0,0,0"
                                            Padding="12,0"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OrderStatusFilter}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" ▾" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrdersPagerText}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <Button Width="32" Height="34" Background="#F3F4F6" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" Margin="0,0,2,0">
                                    <TextBlock Text="◀" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Width="32" Height="34" Background="#F3F4F6" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1">
                                    <TextBlock Text="▶" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Orders List Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredInPosOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                    <Button Command="{Binding DataContext.SelectInPosOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="OrdRowBdr"
                                                        Height="54"
                                                        Padding="12,0"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{StaticResource BorderLightBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="260"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InPosDayDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#4C4268"/>
                                                            <TextBlock Text="{Binding InPosTimeDisplay}" FontSize="11.5" Foreground="#6B7280"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TrackingNumberDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#4C4268"/>
                                                            <TextBlock Text="{Binding PosReference}" FontSize="11.5" Foreground="#6B7280"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding TotalDisplay}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="#4C4268"
                                                                   VerticalAlignment="Center"/>

                                                        <Border Grid.Column="4"
                                                                Background="{Binding InPosStatusBackground}"
                                                                CornerRadius="9"
                                                                Padding="12,2.5"
                                                                Margin="0,0,18,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InPosStatusText}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FFFFFF"/>
                                                        </Border>

                                                        <Border Grid.Column="5"
                                                                Width="18" Height="18"
                                                                CornerRadius="9"
                                                                Background="#212529"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Button Grid.Column="6"
                                                                Command="{Binding DataContext.DeleteInPosOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                ToolTip="Delete Ongoing Order"
                                                                Visibility="{Binding IsDraft, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                            <Viewbox Width="15" Height="15">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 4,7 H 20 M 9,7 V 4 H 15 V 7 M 6,7 L 7,20 H 17 L 18,7 M 10,11 V 17 M 14,11 V 17"
                                                                          Stroke="#212529"
                                                                          StrokeThickness="2"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedInPos}" Value="True">
                                                        <Setter TargetName="OrdRowBdr" Property="Background" Value="{StaticResource OdooPurpleRowBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- RIGHT: SELECTED ORDER CART PREVIEW & [Load Order] BUTTON -->
                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10,8">
                            <ItemsControl ItemsSource="{Binding SelectedInPosOrder.Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosOrderLineRecord}">
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding QtyShortDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PriceSubtotalInclDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Taxes" FontSize="12.5" Foreground="#4B5563"/>
                                    <TextBlock Text="{Binding SelectedInPosOrder.TaxDisplay, FallbackValue='$ 0.00'}" FontSize="12.5" Foreground="#4B5563" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Total" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInPosOrder.TotalDisplay, FallbackValue='$ 0.00'}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="2"
                                Content="Load Order"
                                Command="{Binding LoadOrderIntoRegisterCommand}"
                                CommandParameter="{Binding SelectedInPosOrder}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="58"
                                Margin="6"
                                FontSize="15"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- =================================================================== -->
            <!-- 4. PAYMENT SPLIT SCREEN (Screenshot 4)                              -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="#F9FAFB"
                  Visibility="{Binding IsPaymentViewOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: PAYMENT METHODS + CUSTOMER/INVOICE + NUMPAD + BACK/CASH -->
                <Grid Grid.Column="0" Background="#F9FAFB" Margin="6,8,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Stacked Payment Method Cards -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding AvailablePaymentMethods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosPaymentMethodRecord}">
                                <Button Command="{Binding DataContext.SelectPaymentMethodOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Height="52"
                                        Margin="0,0,0,8"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="MthBdr"
                                                    Background="#F3F4F6"
                                                    BorderBrush="{StaticResource BorderMidBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="16,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                                        <Canvas Width="24" Height="24">
                                                            <Rectangle Canvas.Left="2" Canvas.Top="5" Width="20" Height="14" RadiusX="2" RadiusY="2" Stroke="#374151" StrokeThickness="1.7"/>
                                                            <Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" Stroke="#374151" StrokeThickness="1.7"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MthBdr" Property="Background" Value="#E5E7EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- [👤 Customer] | [📄 Invoice] Row -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource CartActionButtonStyle}"
                                Command="{Binding OpenCustomerPromptCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👤 " FontSize="13"/>
                                <TextBlock Text="{Binding CurrentOrder.CustomerButtonDisplay, FallbackValue=Customer}" FontSize="13.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding ToggleInvoiceCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CartActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentOrder.IsToInvoice}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📄 " FontSize="13"/>
                                <TextBlock Text="Invoice" FontSize="13.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 4x4 Payment Numpad -->
                    <Border Grid.Row="3"
                            Margin="0,0,0,6"
                            BorderBrush="{StaticResource BorderMidBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <UniformGrid Rows="4" Columns="4" Height="196">
                            <Button Content="1" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="1"/>
                            <Button Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="2"/>
                            <Button Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="3"/>
                            <Button Content="+10" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyGreenBrush}" Command="{Binding AddQuickTenderCommand}" CommandParameter="10"/>

                            <Button Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="4"/>
                            <Button Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="5"/>
