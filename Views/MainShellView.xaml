                                            <TextBlock x:Name="TagsSyncDetailText" Text="product.tag • Product tags &amp; color badges" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="SyncTagsNowBtn" Style="{StaticResource PosTealButton}" Height="32" Padding="10,0" FontSize="12" Click="SyncTagsNowBtn_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox x:Name="SettingsTagSyncIconBox" Width="12" Height="12" Margin="0,0,5,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform><RotateTransform x:Name="SettingsTagSyncIconRotation" Angle="0"/></Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24"><Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/><Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/></Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsTagSyncButtonText" Text="Sync"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 12. Users -->
                                <Border Style="{StaticResource PosCardBorderStyle}" Padding="14,11" Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Users" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <Border Background="{StaticResource OdooPurpleSoftBrush}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="UsersCountBadgeText" Text="0 records" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/></Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,1">
                                                <TextBlock x:Name="LastSyncedStatusText" Text="Last Synced: Never" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ProgressBar x:Name="SyncProgressBar" IsIndeterminate="True" Width="64" Height="3" Visibility="Collapsed" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SyncDetailText" Text="res.users • Cashiers, avatars &amp; access" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="SyncUsersNowBtn" Style="{StaticResource PosPrimaryButton}" Height="32" Padding="10,0" FontSize="12" Click="SyncUsersNowBtn_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox x:Name="SettingsSyncIconBox" Width="12" Height="12" Margin="0,0,5,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform><RotateTransform x:Name="SettingsSyncIconRotation" Angle="0"/></Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24"><Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/><Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/></Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsSyncButtonText" Text="Sync"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 3: PRINTER -->
                    <ScrollViewer x:Name="PrinterSettingsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20,16,20,24">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Receipt Printer Hardware" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Default Printer" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Thermal or ESC/POS device" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="PrinterDeviceComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="260" SelectionChanged="PrinterDeviceComboBox_SelectionChanged"/>
                                        <Button Grid.Column="2" x:Name="RefreshPrintersBtn" Style="{StaticResource PosSecondaryButton}" Height="34" Margin="8,0,0,0" Click="RefreshPrintersBtn_Click" Content="Refresh"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Paper Width" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Roll size format" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="PrinterPaperWidthComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="260" HorizontalAlignment="Left">
                                            <ComboBoxItem x:Name="DriverPaperWidthItem" Content="Default Driver (Auto)" Tag="Driver" IsSelected="True"/>
                                            <ComboBoxItem Content="80mm (Standard POS / 48 cols)" Tag="80mm"/>
                                            <ComboBoxItem Content="72mm (Compact 80 / 42 cols)" Tag="72mm"/>
                                            <ComboBoxItem Content="58mm (Compact / 32 cols)" Tag="58mm"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Character Encoding" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Code page for Latin &amp; Arabic" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="PrinterEncodingComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="260" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="UTF-8" IsSelected="True"/>
                                            <ComboBoxItem Content="CP437 (Standard ESC/POS)"/>
                                            <ComboBoxItem Content="CP864 (Arabic ESC/POS)"/>
                                            <ComboBoxItem Content="Windows-1256 (Arabic Windows)"/>
                                            <ComboBoxItem Content="Windows-1252 (Western European)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Top Margin / Cut Mode" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Reduce top gap after cut" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="PrinterCutModeComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="280" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Standard Cut (GS V 66 0)" Tag="Standard" IsSelected="True"/>
                                            <ComboBoxItem Content="Pre-Print Backfeed — 12mm (GS P + ESC j 96)" Tag="PrePrintBackfeed"/>
                                            <ComboBoxItem Content="Pre-Print Backfeed — 15mm (GS P + ESC j 120)" Tag="PrePrintBackfeed15"/>
                                            <ComboBoxItem Content="Pre-Print Backfeed — Direct (ESC j 96)" Tag="PrePrintBackfeedDirect"/>
                                            <ComboBoxItem Content="Pre-Print Backfeed — 12mm (GS P + ESC K 96)" Tag="PrePrintBackfeedEscK"/>
                                            <ComboBoxItem Content="Epson Backfeed Cut (GS V 104 0)" Tag="BackfeedCut"/>
                                            <ComboBoxItem Content="Immediate Cut (GS V 1)" Tag="ImmediateCut"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Printing Options &amp; Drawer" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="PrinterAutoPrintCheckBox" Style="{StaticResource PosCheckBoxStyle}" Content="Automatic Receipt Printing once payment is registered" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="PrinterCashDrawerCheckBox" Style="{StaticResource PosCheckBoxStyle}" Content="Open Cash Drawer (Send kick-out pulse on print)" IsChecked="True" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="PrinterHeaderLogoCheckBox" Style="{StaticResource PosCheckBoxStyle}" Content="Print Header Logo at the top of receipts" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SavePrinterSettingsBtn" Style="{StaticResource PosPrimaryButton}" Width="170" Height="36" Margin="0,0,10,0" Click="SavePrinterSettingsBtn_Click" Content="Save Printer Settings"/>
                                <Button x:Name="PrintTestReceiptBtn" Style="{StaticResource PosTealButton}" Width="160" Height="36" Click="PrintTestReceiptBtn_Click" Content="Print Test Receipt"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 4: BACKUP & RESTORE -->
                    <ScrollViewer x:Name="BackupSettingsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20,16,20,24">
                        <StackPanel MaxWidth="840" HorizontalAlignment="Left">
                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Backup Folder &amp; Schedule" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Folder Location" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Style="{StaticResource PosInputBorderStyle}" Height="34" Margin="0,0,8,0">
                                            <TextBox x:Name="BackupFolderPathTextBox" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12.5"/>
                                        </Border>
                                        <Button Grid.Column="2" x:Name="BrowseBackupFolderBtn" Style="{StaticResource PosTealButton}" Height="34" Margin="0,0,6,0" Click="BrowseBackupFolderBtn_Click" Content="Browse..."/>
                                        <Button Grid.Column="3" x:Name="OpenBackupFolderBtn" Style="{StaticResource PosSecondaryButton}" Height="34" Click="OpenBackupFolderBtn_Click" Content="Open"/>
                                    </Grid>

                                    <CheckBox x:Name="AutoBackupEnabledCheckBox" Style="{StaticResource PosCheckBoxStyle}" Content="Enable Automatic Scheduled Backups" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Frequency &amp; Time" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="BackupFrequencyComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="150">
                                            <ComboBoxItem Content="Daily" IsSelected="True"/>
                                            <ComboBoxItem Content="Weekly"/>
                                        </ComboBox>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="BackupHourComboBox" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="76"/>
                                            <TextBlock Text=":" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                            <ComboBox x:Name="BackupMinuteComboBox" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="76"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="LAST BACKUP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock x:Name="LastBackupStatusText" Text="Never" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="NEXT SCHEDULED" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock x:Name="NextBackupStatusText" Text="Not Scheduled" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveBackupSettingsBtn" Style="{StaticResource PosPrimaryButton}" Height="36" Margin="0,0,10,0" Click="SaveBackupSettingsBtn_Click" Content="Save Backup Settings"/>
                                        <Button x:Name="BackupNowBtn" Style="{StaticResource PosTealButton}" Height="36" Click="BackupNowBtn_Click" Content="Backup Now"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="Import &amp; Restore Database" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Select a saved SQLite backup (.db) to restore all local POS data and settings." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Backup File (.db)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Style="{StaticResource PosInputBorderStyle}" Height="34" Margin="0,0,8,0">
                                            <TextBox x:Name="RestoreFilePathTextBox" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12.5"/>
                                        </Border>
                                        <Button Grid.Column="2" x:Name="BrowseRestoreFileBtn" Style="{StaticResource PosSecondaryButton}" Height="34" Click="BrowseRestoreFileBtn_Click" Content="Select .db File..."/>
                                    </Grid>

                                    <Button x:Name="ImportRestoreDbBtn" Style="{StaticResource PosPrimaryButton}" Height="36" HorizontalAlignment="Left" Click="ImportRestoreDbBtn_Click" Content="Import &amp; Restore Database"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 5: LANGUAGE -->
                    <ScrollViewer x:Name="LanguageSettingsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20,16,20,24">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="POS Terminal Language" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Applies to the POS Register, Orders, Payment, Change, Opening Control, and 3-Dot Menu." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Interface Language" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="PosLanguageComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="260" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="English" Tag="English" IsSelected="True"/>
                                            <ComboBoxItem Content="Arabic (العربية)" Tag="Arabic"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Name="SaveLanguageSettingsBtn" Style="{StaticResource PosPrimaryButton}" Width="180" Height="36" HorizontalAlignment="Left" Click="SaveLanguageSettingsBtn_Click" Content="Save Language Settings"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ==================== CHILD MODULE VIEWS ==================== -->
            <local:CompanyManagementView x:Name="CompaniesViewControl" Visibility="Collapsed"/>
            <local:PaymentMethodManagementView x:Name="PaymentMethodsViewControl" Visibility="Collapsed"/>
            <local:UserManagementView x:Name="UsersViewControl" Visibility="Collapsed"/>
            <local:PosCategoryManagementView x:Name="CategoriesViewControl" Visibility="Collapsed"/>
            <local:ProductAttributeManagementView x:Name="AttributesViewControl" Visibility="Collapsed"/>
            <local:ProductTagManagementView x:Name="TagsViewControl" Visibility="Collapsed"/>
            <local:ProductManagementView x:Name="ProductsViewControl" Visibility="Collapsed"/>
            <local:ComboChoiceManagementView x:Name="ComboChoicesViewControl" Visibility="Collapsed"/>
            <local:SessionManagementView x:Name="SessionsViewControl" Visibility="Collapsed"/>
            <local:OrderManagementView x:Name="OrdersViewControl" Visibility="Collapsed"/>
            <local:PaymentManagementView x:Name="PaymentsViewControl" Visibility="Collapsed"/>
            <local:PosSettingsView x:Name="PosSettingsViewControl" Visibility="Collapsed"/>
            <local:PosDashboardView x:Name="DashboardViewControl" Visibility="Visible"/>

            <!-- ==================== TOAST BANNER NOTIFICATION ==================== -->
            <Border x:Name="ShellToastBanner"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,22"
                    Style="{StaticResource PosToastBorderStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ShellToastDot" Width="9" Height="9" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ShellToastMessageText" Text="Settings saved successfully." Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== FULL-SCREEN POS REGISTER & SELLING VIEW ==================== -->
        <local:PosRegisterView x:Name="RegisterViewControl"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Panel.ZIndex="500"
                               Visibility="Collapsed"/>
    </Grid>
</UserControl>