<UserControl x:Class="OdooPosLogin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.DataContext>
        <vm:UserManagementViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerRedHoverBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="DangerRedSoftBrush" Color="#FEF2F2"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <DropShadowEffect x:Key="CardHoverShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#714B67"
                          Opacity="0.10"/>

        <DropShadowEffect x:Key="SheetShadow"
                          BlurRadius="24"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.06"/>

        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KanbanCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Effect="{StaticResource SubtleCardShadow}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormInputBoxBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. SHARED TOP CONTROL BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncFromOdooCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBooleanConverter}}"
                            Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToListCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText"
                                           Text="Users"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                VerticalAlignment="Center">
                        <TextBlock Text="  /  "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedUser.Name}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"/>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER SEARCH BAR -->
                <Border Grid.Column="1"
                        MinWidth="220" MaxWidth="380" Width="320"
                        Height="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F3F4F6"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="19"
                        Padding="14,0"
                        Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13"
                                         Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2.2"/>
                                <Path Data="M 13.5,13.5 L 20,20"
                                      Stroke="{StaticResource SecondaryTextBrush}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Search by name, login, or email..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     CaretBrush="{StaticResource OdooPurpleBrush}"
                                     FontSize="13"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT SAVE / DISCARD -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource OdooIconButtonStyle}"
                            BorderBrush="{StaticResource OdooTealBrush}"
                            Background="{StaticResource OdooTealSoftBrush}"
                            ToolTip="Save Local POS Credentials"
                            Command="{Binding SaveCredentialsCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 20,6 L 9,17 L 4,12"
                                          Stroke="{StaticResource OdooTealBrush}"
                                          StrokeThickness="2.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Save"
                                       Foreground="{StaticResource OdooTealBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OdooIconButtonStyle}"
                            ToolTip="Discard Changes"
                            Command="{Binding DiscardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 18,6 L 6,18 M 6,6 L 18,18"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Discard"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontWeight="Medium"
                                       FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ACTIVE VIEW AREA: KANBAN GRID VIEW -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <ItemsControl ItemsSource="{Binding FilteredUsers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource KanbanCardButtonStyle}"
                                    Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="64" Height="64"
                                            CornerRadius="8"
                                            Background="{Binding AvatarSoftBrush}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}"
                                                       Foreground="{Binding AvatarAccentBrush}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding InitialsVisibility}"/>
                                            <Image Source="{Binding AvatarBitmap}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasCustomImageVisibility}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Login}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding StatusDotBrush}"
                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="Medium"/>

                                            <Border Visibility="{Binding PosBadgeVisibility}"
                                                    Background="{StaticResource OdooTealSoftBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="12,0,0,0">
                                                <TextBlock Text="POS ACCESS"
                                                           Foreground="{StaticResource OdooTealBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- EMPTY STATE PLACEHOLDER -->
            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="36,32"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource SubtleCardShadow}"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No Users Synchronized Yet"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Click 'Sync from Odoo' to pull active users from your Odoo instance, update existing profiles, and remove deleted accounts."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,18"/>
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncFromOdooCommand}"
                            HorizontalAlignment="Center"
                            Content="Sync Users from Odoo"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ACTIVE VIEW AREA: USER DETAIL VIEW -->
        <ScrollViewer Grid.Row="1"
                      Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto"
                      Padding="28,24">
            <Border MaxWidth="920"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40,36"
                    Effect="{StaticResource SheetShadow}">
                <StackPanel>
                    <Border Background="#F3ECF1"
                            BorderBrush="#E5D6E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 Z M 11,7 L 13,7 L 13,9 L 11,9 Z M 11,11 L 13,11 L 13,17 L 11,17 Z"
                                          Fill="{StaticResource OdooPurpleBrush}"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Odoo Online Profile (Read-Only)"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           FontSize="13.5"
                                           FontWeight="Bold"/>
                                <TextBlock Text="User identity and contact details are managed exclusively in Odoo Online. You can configure local POS security PIN, password, and login screen visibility on this terminal."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="96" Height="96"
                                CornerRadius="8"
                                Background="{StaticResource OdooPurpleSoftBrush}"
                                BorderBrush="#D8C3D2"
                                BorderThickness="1.5"
                                ClipToBounds="True"
                                ToolTip="Profile avatar synced from Odoo">
                            <Grid>
                                <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Width="8" Height="8" Canvas.Left="8" Canvas.Top="3"
                                                 Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Path Data="M 4,20 C 4,15.5 7.5,14 12,14 C 16.5,14 20,15.5 20,20"
                                              Stroke="{StaticResource OdooPurpleBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <Image Source="{Binding SelectedUser.AvatarBitmap}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding SelectedUser.HasCustomImageVisibility}"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="FULL NAME"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                                <Border Background="{StaticResource OdooPurpleSoftBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="Odoo Synced"
                                               Foreground="{StaticResource OdooPurpleBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedUser.Name}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Login"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        Width="360"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="40"
                                        Padding="12,0">
                                    <TextBlock Text="{Binding SelectedUser.Login}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,28"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
                                <TextBlock Text="CONTACT INFORMATION"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                                <TextBlock Text="(Synced from Odoo)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Email Address"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Background="#F9FAFB"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="42"
                                    Padding="12,0"
                                    Margin="0,0,0,18">
                                <TextBlock Text="{Binding SelectedUser.Email}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Phone Number"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Background="#F9FAFB"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="42"
                                    Padding="12,0">
                                <TextBlock Text="{Binding SelectedUser.Phone}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
                                <TextBlock Text="LOCAL POS CREDENTIALS"
                                           Foreground="{StaticResource OdooTealBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                                <TextBlock Text="(Configured on Terminal)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Password"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}" Margin="0,0,0,18">
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource OdooPurpleBrush}"
                                         FontSize="14"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="POS Security PIN"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="Medium"/>
                                <TextBlock Text=" (Numeric digits only)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}">
                                <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="6"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource OdooTealBrush}"
                                         FontSize="14"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Background="#F9FAFB"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10">
                                <CheckBox IsChecked="{Binding IsVisibleInPos}"
                                          Cursor="Hand"
                                          VerticalContentAlignment="Center">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Visible on POS Login Screen"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="When enabled, this user appears as a touch card on the POS login screen"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- TOAST BANNER NOTIFICATION -->
        <Border Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Grid.RowSpan="2"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,32"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>