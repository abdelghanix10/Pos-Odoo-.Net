<UserControl x:Class="OdooPosLogin.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1084" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:ProductsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="OdooNotebookTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,-1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. COMPACT PRIMARY HEADER BAR (48px) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PosPrimaryButton}" Height="32" Command="{Binding SyncFromOdooCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToListCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText" Text="Products" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                        <TextBlock Text="  /  " Foreground="{StaticResource MutedTextBrush}" FontSize="15.5"/>
                        <TextBlock Text="{Binding SelectedProduct.Name}" Foreground="{StaticResource OdooPurpleBrush}" FontSize="15.5" FontWeight="Bold" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListCounterText}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding PagerText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding PreviousRecordCommand}" IsEnabled="{Binding HasPreviousRecord}" Margin="0,0,2,0" ToolTip="Previous">
                        <Viewbox Width="7" Height="11"><Path Data="M 7,1 L 1.5,6.5 L 7,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                    </Button>
                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding NextRecordCommand}" IsEnabled="{Binding HasNextRecord}" Margin="0,0,10,0" ToolTip="Next">
                        <Viewbox Width="7" Height="11"><Path Data="M 1.5,1 L 7,6.5 L 1.5,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button Command="{Binding SwitchToListCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="List">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/></Canvas></Viewbox>
                        </Button>
                        <Button Command="{Binding SwitchToKanbanCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="Kanban">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,1,1,1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKanbanView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" Fill="{StaticResource PrimaryTextBrush}"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="10" Fill="{StaticResource PrimaryTextBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. COMPACT SEARCH & SORT BAR -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,7"
                Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="250" Style="{StaticResource PosSearchBorderStyle}" Background="#FFFFFF" Margin="0,1,8,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="12" Height="12" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#64748B" StrokeThickness="2"/>
                                    <Path Data="M 14,14 L 20,20" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Search products, SKU, barcode..." Foreground="{StaticResource PlaceholderTextBrush}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0">
                                <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                              Style="{StaticResource OdooFilterComboBoxStyle}" Width="175" Margin="0,1,8,1" ToolTip="Sort products (updates POS Register order)"/>

                    <Button Command="{Binding ResetToOdooOrderCommand}" Style="{StaticResource OdooResetFilterButtonStyle}" Margin="0,1,12,1"
                            ToolTip="Restore Odoo's exact pos_sequence product ordering" Content="↺ Odoo Order"/>
                </WrapPanel>

                <TextBlock Text="Tip: Drag &amp; drop items to customize POS order"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3. WORKSPACE CONTENT -->
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <!-- KANBAN VIEW (3 Cards Per Row at 1280px, Drag & Drop Preserved) -->
                <ScrollViewer Visibility="{Binding IsKanbanView, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ProductRecord}">
                                <Border x:Name="CardBorder"
                                        Width="336"
                                        MinHeight="84"
                                        Margin="5"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Cursor="Hand"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="ProductItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="ProductItem_PreviewMouseMove"
                                        MouseLeftButtonUp="ProductItem_MouseLeftButtonUp"
                                        DragOver="ProductItem_DragOver"
                                        DragLeave="ProductItem_DragLeave"
                                        Drop="ProductItem_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Drag to reorder"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding VariantCountDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}"
                                                       Visibility="{Binding HasMultipleVariants, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PriceDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                <TextBlock Text="{Binding SkuDisplay}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"
                                                           Visibility="{Binding HasSku, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Width="56" Height="56" CornerRadius="8" Background="{StaticResource SurfaceSubtleBrush}" ClipToBounds="True" VerticalAlignment="Center"
                                                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{Binding ImageBitmap}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- LIST VIEW (Drag & Drop Preserved) -->
                <Border Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Product Name" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Internal Reference" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Sales Price" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Cost" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="On Hand" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProductRecord}">
                                        <Border x:Name="RowBdr"
                                                Background="#FFFFFF"
                                                BorderBrush="{StaticResource SubtleBorderLightBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,8"
                                                MinHeight="38"
                                                Cursor="Hand"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="ProductItem_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="ProductItem_PreviewMouseMove"
                                                MouseLeftButtonUp="ProductItem_MouseLeftButtonUp"
                                                DragOver="ProductItem_DragOver"
                                                DragLeave="ProductItem_DragLeave"
                                                Drop="ProductItem_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" ToolTip="Drag to reorder"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SkuDisplay}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PriceDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CostDisplay}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding QtyAvailableDisplay}" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- EMPTY STATE -->
                <Border Style="{StaticResource PosCardBorderStyle}" Padding="28,24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Products Synchronized Yet" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Sync product templates, prices, categories, and variants from Odoo." FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource PosPrimaryButton}" Command="{Binding SyncFromOdooCommand}" HorizontalAlignment="Center" Content="Sync Products from Odoo"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PRODUCT DETAIL VIEW -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <Border Style="{StaticResource PosCardBorderStyle}" Padding="24,20" MaxWidth="1040">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding SelectedProduct.SaleOk}" IsEnabled="False" Content="Sales" Margin="0,0,16,0"/>
                                    <CheckBox Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding SelectedProduct.PurchaseOk}" IsEnabled="False" Content="Purchase" Margin="0,0,16,0"/>
                                    <CheckBox Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding SelectedProduct.AvailableInPos}" IsEnabled="False" Content="Point of Sale"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Width="80" Height="80" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding SelectedProduct.ImageBitmap}" Stretch="Uniform" Visibility="{Binding SelectedProduct.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="No Image" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedProduct.HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Notebook Tabs -->
                        <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Margin="-24,0,-24,18" Padding="24,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="General Information" Command="{Binding SelectTabCommand}" CommandParameter="1">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTabIndex}" Value="1"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/><Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Attributes &amp; Variants" Command="{Binding SelectTabCommand}" CommandParameter="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTabIndex}" Value="2"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/><Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Sales" Command="{Binding SelectTabCommand}" CommandParameter="3">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTabIndex}" Value="3"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/><Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Point of Sale" Command="{Binding SelectTabCommand}" CommandParameter="4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                            <Style.Triggers><DataTrigger Binding="{Binding ActiveTabIndex}" Value="4"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/><Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- TAB 1: GENERAL INFORMATION -->
                        <Grid Visibility="{Binding ActiveTabIndex, Converter={StaticResource IntEqualToVisibilityConverter}, ConverterParameter=1}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Product Type" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProduct.ProductTypeDisplay}" FontSize="13" FontWeight="SemiBold"/></Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Track Inventory" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding SelectedProduct.TrackInventory}" IsEnabled="False"/></Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Category" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProduct.InternalCategoryDisplay}" FontSize="13"/></Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Reference" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProduct.SkuDisplay}" FontSize="13"/></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Barcode" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProduct.BarcodeDisplay}" FontSize="13"/></Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sales Price" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProduct.PriceDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedProduct.UomName, StringFormat='per {0}'}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sales Taxes" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="8" Padding="8,2" Margin="0,0,8,0" Visibility="{Binding SelectedProduct.SalesTaxVisibility}">
                                        <TextBlock Text="{Binding SelectedProduct.SalesTaxLabel}" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedProduct.TaxIncludedPriceDisplay}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Cost" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProduct.CostDisplay}" FontSize="13"/></Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tags" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedProduct.TagBadges}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:ProductTagBadge}"><Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="8" Padding="8,2" Margin="0,0,5,3"><TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Company" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProduct.CompanyDisplay}" FontSize="13"/></Grid>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 2: ATTRIBUTES & VARIANTS -->
                        <StackPanel Visibility="{Binding ActiveTabIndex, Converter={StaticResource IntEqualToVisibilityConverter}, ConverterParameter=2}">
                            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Attribute" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Values" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding SelectedProduct.AttributeLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProductAttributeLine}">
                                        <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding AttributeName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ValuePills}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource OdooPurpleSoftBrush}" CornerRadius="8" Padding="9,2" Margin="0,2,6,2"><TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- TAB 3: SALES & COMBOS -->
                        <StackPanel Visibility="{Binding ActiveTabIndex, Converter={StaticResource IntEqualToVisibilityConverter}, ConverterParameter=3}">
                            <TextBlock Text="COMBO CHOICES" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedProduct.ComboLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProductComboLine}">
                                        <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ComboName}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ItemsCountSummary}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No combo choices linked to this product." FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding SelectedProduct.ComboLines.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- TAB 4: POINT OF SALE -->
                        <Grid Visibility="{Binding ActiveTabIndex, Converter={StaticResource IntEqualToVisibilityConverter}, ConverterParameter=4}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="POINT OF SALE" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="To Weigh" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding SelectedProduct.ToWeight}" IsEnabled="False"/></Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PoS Category" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding SelectedProduct.CategorySoftBrush}" CornerRadius="9" Padding="10,2.5" HorizontalAlignment="Left" Visibility="{Binding SelectedProduct.PosCategoryBadgeVisibility}">
                                        <TextBlock Text="{Binding SelectedProduct.PosCategoryName}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Accent Color" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="18" Height="18" Fill="{Binding SelectedProduct.CategoryColorBrush}" HorizontalAlignment="Left"/></Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DESCRIPTION" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding SelectedProduct.PosDescriptionDisplay}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- TOAST -->
        <Border Grid.Row="2" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Style="{StaticResource PosToastBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>