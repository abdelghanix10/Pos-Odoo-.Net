                            <Button Content="." Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyPeachBrush}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="."/>
                            <Button Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyCoralBrush}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="⌫">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeThickness="1.7"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Bottom Split Row: [ Back ] | [ Cash ] -->
                    <Grid Grid.Row="4" Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Back"
                                Command="{Binding ClosePaymentViewCommand}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Height="52"
                                FontSize="15"/>

                        <Button Grid.Column="2"
                                Content="{Binding PaymentPrimaryButtonText}"
                                Command="{Binding ValidatePaymentCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="52"
                                FontSize="15"/>
                    </Grid>
                </Grid>

                <!-- RIGHT: GIANT CENTRED CURRENCY AMOUNT ($ 18.62) -->
                <Grid Grid.Column="1">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding PaymentCurrencySymbol}"
