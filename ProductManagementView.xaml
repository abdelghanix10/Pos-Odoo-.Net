<UserControl x:Class="OdooPosLogin.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Design Palette Brushes -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.05"/>

        <DropShadowEffect x:Key="CardHoverShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#714B67"
                          Opacity="0.12"/>

        <!-- Primary Purple Button Style -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Buttons -->
        <Style x:Key="OdooDetailTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Product Kanban Card Style -->
        <Style x:Key="ProductKanbanCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Effect="{StaticResource SubtleCardShadow}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FDF9FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pager Chevron Button Style -->
        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Control Bar -->
            <RowDefinition Height="64"/>
            <!-- 2. Workspace Body -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP CONTROL BAR                                                      -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Sync Button + Title / Breadcrumb -->
                    <ColumnDefinition Width="*"/>
                    <!-- Center: Search Bar -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right: Detail View Record Switcher (< >) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync from Odoo Button + Breadcrumbs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TopSyncProductsBtn"
                            Style="{StaticResource OdooPrimaryButtonStyle}"
                            Click="TopSyncProductsBtn_Click"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="TopSyncIconBox" Width="15" Height="15" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="TopSyncIconRotation" Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="SyncButtonText" Text="Sync from Odoo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumb Root: "Products" -->
                    <Button x:Name="BreadcrumbRootButton"
                            Click="BreadcrumbRoot_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText"
                                           Text="Products"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Breadcrumb Sub-Path (when viewing Detail View) -->
                    <StackPanel x:Name="BreadcrumbDetailSubPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock Text="  /  "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BreadcrumbCurrentProductName"
                                   Text="Acoustic Bloc Screens"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380"/>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: SEARCH BAR -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="360" Height="36" VerticalAlignment="Center">
                    <Border Background="#F3F4F6"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Grid Margin="12,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 15.5,14 L 14.71,14 L 14.43,13.73 C 15.41,12.59 16,11.11 16,9.5 C 16,5.91 13.09,3 9.5,3 C 5.91,3 3,5.91 3,9.5 C 3,13.09 5.91,16 9.5,16 C 11.11,16 12.59,15.41 13.73,14.43 L 14,14.71 L 14,15.5 L 19,20.49 L 20.49,19 L 15.5,14 Z M 9.5,14 C 7.01,14 5,11.99 5,9.5 C 5,7.01 7.01,5 9.5,5 C 11.99,5 14,7.01 14,9.5 C 14,11.99 11.99,14 9.5,14 Z"
                                          Fill="{StaticResource PlaceholderTextBrush}"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Grid.Column="1"
                                       x:Name="SearchPlaceholderText"
                                       Text="Search Products..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <TextBox Grid.Column="1"
                                     x:Name="SearchProductsTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchProductsTextBox_TextChanged"/>

                            <Button Grid.Column="2"
                                    x:Name="ClearSearchButton"
                                    Click="ClearSearchButton_Click"
                                    Visibility="Collapsed"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="18" Height="18"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: DETAIL RECORD SWITCHER (VISIBLE ONLY IN DETAIL VIEW) -->
                <StackPanel x:Name="DetailRecordPagerPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="DetailPagerCounterText"
                               Text="1 / 12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button x:Name="DetailPrevRecordBtn"
                            Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Click="DetailPrevRecord_Click"
                            ToolTip="Previous product"
                            Margin="0,0,4,0">
                        <Path Data="M 17,7 L 10,14 L 17,21"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="8" Height="14"
                              Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="DetailNextRecordBtn"
                            Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Click="DetailNextRecord_Click"
                            ToolTip="Next product">
                        <Path Data="M 10,7 L 17,14 L 10,21"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="8" Height="14"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. WORKSPACE CONTENT AREA                                               -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">
            <!-- =================================================================== -->
            <!-- VIEW 1: PRODUCTS KANBAN VIEW (RESPONSIVE GRID)                      -->
            <!-- =================================================================== -->
            <ScrollViewer x:Name="ProductsKanbanViewContainer"
                          Visibility="Visible"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,24,28,32">
                    <ItemsControl x:Name="ProductsKanbanItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ProductRecord}">
                                <Button Style="{StaticResource ProductKanbanCardButtonStyle}"
                                        Tag="{Binding}"
                                        Click="ProductCard_Click"
                                        Margin="6"
                                        Height="98">
                                    <Grid Margin="14,12">
                                        <Grid.ColumnDefinitions>
                                            <!-- Left Side: Name, Variant Count, Price & SKU -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Right Side: 64x64 Image Thumbnail -->
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT SIDE -->
                                        <Grid Grid.Column="0" Margin="0,0,8,0">
                                            <Grid.RowDefinitions>
                                                <!-- Top Line: Product Name -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Middle Line: Variant Count (Conditional) -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Bottom Line: Price & SKU -->
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Product Name -->
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Name}"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="36"
                                                       LineHeight="17"/>

                                            <!-- Middle: Variant Count (Conditional: visible only when VariantCount > 1) -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding VariantCountDisplay}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource OdooTealBrush}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMultipleVariants}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Bottom Line: Bold Price + SKU/Internal Reference -->
                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding PriceDisplay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Muted gray SKU -->
                                                <TextBlock Text="{Binding SkuDisplay}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSku}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <!-- RIGHT SIDE: 64x64 THUMBNAIL -->
                                        <Border Grid.Column="1"
                                                Width="64" Height="64"
                                                CornerRadius="6"
                                                Background="#F3F4F6"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <!-- If image exists -->
                                                <Image Source="{Binding ImageBitmap}"
                                                       Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <!-- Placeholder Icon if no image -->
                                                <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasNoImage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Viewbox.Style>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 21,19 V 5 C 21,3.9 20.1,3 19,3 H 5 C 3.9,3 3,3.9 3,5 V 19 C 3,20.1 3.9,21 5,21 H 19 C 20.1,21 21,20.1 21,19 Z M 8.5,13.5 L 11,16.51 L 14.5,12 L 19,18 H 5 L 8.5,13.5 Z"
                                                              Fill="{StaticResource PlaceholderTextBrush}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- =================================================================== -->
            <!-- VIEW 2: PRODUCT DETAIL / FORM VIEW (STRICTLY READ-ONLY)             -->
            <!-- =================================================================== -->
            <ScrollViewer x:Name="ProductDetailViewContainer"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,48">
                    <!-- SLEEK ODOO 20 SHEET CARD -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="36,32"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <!-- HEADER ROW: TITLE & TAGS ON LEFT, IMAGE ON RIGHT -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: PRODUCT NAME & TAG PILLS -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Product"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>

                                    <TextBlock x:Name="FormProductNameDisplay"
                                               Text="Acoustic Bloc Screens"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"/>

                                    <!-- Product Tags Pills -->
                                    <ItemsControl x:Name="FormProductTagsItemsControl" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ProductTagBadge}">
                                                <Border Background="{Binding SoftBackgroundBrush}"
                                                        BorderBrush="{Binding ColorBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="10,3"
                                                        Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding ColorBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding ColorBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- RIGHT: 88x88 IMAGE CONTAINER -->
                                <Border Grid.Column="1"
                                        Width="88" Height="88"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <Image x:Name="FormPreviewImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <Viewbox x:Name="FormPlaceholderIcon" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 4,4 H 7 L 9,2 H 15 L 17,4 H 20 C 21.1,4 22,4.9 22,6 V 18 C 22,19.1 21.1,20 20,20 H 4 C 2.9,20 2,19.1 2,18 V 6 C 2,4.9 2.9,4 4,4 Z M 12,17 C 14.76,17 17,14.76 17,12 C 17,9.24 14.76,7 12,7 C 9.24,7 7,9.24 7,12 C 7,14.76 9.24,17 12,17 Z"
                                                      Fill="{StaticResource PlaceholderTextBrush}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- HORIZONTAL TAB BAR -->
                            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TabGeneralBtn"
                                            Content="General Information"
                                            Style="{StaticResource OdooDetailTabStyle}"
                                            Click="TabGeneral_Click"
                                            BorderBrush="{StaticResource OdooPurpleBrush}"
                                            Foreground="{StaticResource OdooPurpleBrush}"/>

                                    <Button x:Name="TabAttributesBtn"
                                            Content="Attributes &amp; Variants"
                                            Style="{StaticResource OdooDetailTabStyle}"
                                            Click="TabAttributes_Click"/>

                                    <Button x:Name="TabCombosBtn"
                                            Content="Combo Choices"
                                            Style="{StaticResource OdooDetailTabStyle}"
                                            Click="TabCombos_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ==================== TAB 1 BODY: GENERAL INFORMATION ==================== -->
                            <Grid x:Name="TabGeneralContentContainer" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT COLUMN -->
                                <StackPanel Grid.Column="0">
                                    <!-- Product Type -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Product Type" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="FormProductTypeDisplay" Text="Goods" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Sales Price -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sales Price" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="FormSalesPriceDisplay" Text="$ 295.00" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Cost -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Cost" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="FormCostDisplay" Text="$ 180.00" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- RIGHT COLUMN -->
                                <StackPanel Grid.Column="2">
                                    <!-- Internal Reference -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Internal Reference" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="FormInternalRefDisplay" Text="DEMO-0008" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Barcode -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Barcode" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="FormBarcodeDisplay" Text="08472910384" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- PoS Product Category -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PoS Product Category" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="FormCategoryDisplay" Text="Desks" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- ==================== TAB 2 BODY: ATTRIBUTES & VARIANTS ==================== -->
                            <StackPanel x:Name="TabAttributesContentContainer" Visibility="Collapsed">
                                <Border Background="#F9FAFB"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,10"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Attribute" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Values" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="FormAttributesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ProductAttributeLine}">
                                            <Border BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding AttributeName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValuesSummary}" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoAttributesNoticeText"
                                           Text="No attributes configured for this product."
                                           FontSize="13"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource PlaceholderTextBrush}"
                                           Margin="16,16,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- ==================== TAB 3 BODY: COMBO CHOICES ==================== -->
                            <StackPanel x:Name="TabCombosContentContainer" Visibility="Collapsed">
                                <Border Background="#F9FAFB"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,10"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Combo Choice" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Included Items" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="FormCombosItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ProductComboLine}">
                                            <Border BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="240"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ComboName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ItemsCountSummary}" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoCombosNoticeText"
                                           Text="No combo choices linked to this product."
                                           FontSize="13"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource PlaceholderTextBrush}"
                                           Margin="16,16,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 3. TOAST NOTIFICATION BANNER                                            -->
        <!-- ======================================================================= -->
        <Border x:Name="ProductToastBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="ProductToastDot" Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="ProductToastText"
                           Text="Sync completed."
                           Foreground="#FFFFFF"
                           FontSize="13.5"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
