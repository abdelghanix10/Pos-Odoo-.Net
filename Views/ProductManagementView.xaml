                                </Grid>

                                <!-- UPSELL & CROSS-SELL -->
                                <TextBlock Text="UPSELL &amp; CROSS-SELL" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,18"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="POS Optional" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Products" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text=" ?" FontSize="11" FontWeight="Bold" Foreground="#017E84" Margin="3,-2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="Recommend when 'Adding to Cart'"
                                               FontSize="13.5"
                                               Foreground="#B0B5BD"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </StackPanel>

                            <!-- RIGHT COLUMN: DESCRIPTION -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DESCRIPTION" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,18"/>

                                <TextBlock Text="{Binding SelectedProduct.PosDescriptionDisplay}"
                                           FontSize="13.5"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IsPosDescriptionPlaceholder}" Value="True">
                                                    <Setter Property="Foreground" Value="#B0B5BD"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- TOAST NOTIFICATION BANNER -->
        <Border Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>