<UserControl x:Class="OdooPosLogin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.Resources>
        <!-- ==================== COLOR PALETTE ==================== -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>
        
        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>
        
        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>
        
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>
        
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerRedHoverBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="DangerRedSoftBrush" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ModalBackdropBrush" Color="#88111827"/>

        <!-- ==================== SHADOW EFFECTS ==================== -->
        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <DropShadowEffect x:Key="CardHoverShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#714B67"
                          Opacity="0.10"/>

        <DropShadowEffect x:Key="SheetShadow"
                          BlurRadius="24"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.06"/>

        <!-- ==================== PRIMARY PURPLE BUTTON ("New") ==================== -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ICON / SECONDARY BUTTON STYLE ==================== -->
        <Style x:Key="OdooIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== KANBAN USER CARD BUTTON STYLE ==================== -->
        <Style x:Key="KanbanCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="356"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="0,0,18,18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Effect="{StaticResource SubtleCardShadow}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== FORM INPUT CONTAINER STYLE (FOCUS HIGHLIGHT) ==================== -->
        <Style x:Key="FormInputBoxBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Shared Top Control Bar -->
            <RowDefinition Height="68"/>
            <!-- 2. Active View Area (Kanban or Form) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. SHARED TOP CONTROL BAR                                               -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: "New" Button + Breadcrumb Navigation + Save/Discard (Form View) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Primary Purple "New" Button -->
                    <Button Content="New"
                            Style="{StaticResource OdooPrimaryButtonStyle}"
                            Click="NewUserButton_Click"
                            Margin="0,0,18,0"/>

                    <!-- Breadcrumb: "Users" (Clickable in Form View) -->
                    <Button x:Name="BreadcrumbUsersButton"
                            Click="BreadcrumbUsers_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbText"
                                           Text="Users"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Breadcrumb Sub-path (" / New" or " / Edit Name") -->
                    <StackPanel x:Name="BreadcrumbFormSubPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock Text="  /  "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BreadcrumbCurrentTitle"
                                   Text="New"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Save / Discard Icon Buttons (Visible in Form View) -->
                    <StackPanel x:Name="FormSaveDiscardPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                        <!-- Save Button -->
                        <Button Style="{StaticResource OdooIconButtonStyle}"
                                BorderBrush="{StaticResource OdooTealBrush}"
                                Background="{StaticResource OdooTealSoftBrush}"
                                ToolTip="Save Changes"
                                Click="SaveUserButton_Click"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 20,6 L 9,17 L 4,12"
                                              Stroke="{StaticResource OdooTealBrush}"
                                              StrokeThickness="2.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Save"
                                           Foreground="{StaticResource OdooTealBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Discard Button -->
                        <Button Style="{StaticResource OdooIconButtonStyle}"
                                ToolTip="Discard Changes"
                                Click="DiscardUserButton_Click"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 18,6 L 6,18 M 6,6 L 18,18"
                                              Stroke="{StaticResource SecondaryTextBrush}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Discard"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontWeight="Medium"
                                           FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Delete Button (Visible when editing existing user) -->
                        <Button x:Name="DeleteUserButton"
                                Style="{StaticResource OdooIconButtonStyle}"
                                ToolTip="Delete this User"
                                Click="DeleteUserButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 3,6 L 5,6 L 21,6 M 19,6 L 19,20 C 19,21.1 18.1,22 17,22 L 7,22 C 5.9,22 5,21.1 5,20 L 5,6 M 8,6 L 8,4 C 8,2.9 8.9,2 10,2 L 14,2 C 15.1,2 16,2.9 16,4 L 16,6"
                                              Stroke="{StaticResource DangerRedBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                        <Line X1="10" Y1="11" X2="10" Y2="17" Stroke="{StaticResource DangerRedBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                        <Line X1="14" Y1="11" X2="14" Y2="17" Stroke="{StaticResource DangerRedBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Delete"
                                           Foreground="{StaticResource DangerRedBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER (KANBAN ONLY): Pill-Shaped Search Bar with Filter Tags -->
                <Border x:Name="KanbanSearchBarContainer"
                        Grid.Column="1"
                        MaxWidth="480"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F9FAFB"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,0">
                    <Grid Width="440">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Magnifying Glass Icon -->
                        <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="14" Height="14" Canvas.Left="3" Canvas.Top="3"
                                         Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2.2"/>
                                <Path Data="M 15,15 L 21,21"
                                      Stroke="{StaticResource SecondaryTextBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Search Input Box -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholderText"
                                       Text="Search users by name or login..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchUsersTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     CaretBrush="{StaticResource OdooPurpleBrush}"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchUsersTextBox_TextChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT: Back to POS Login Button (Kanban) / Record Pager (Form View) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackToPosButton"
                            Style="{StaticResource OdooIconButtonStyle}"
                            Height="36"
                            Padding="12,0"
                            ToolTip="Switch User / Back to POS Login Screen"
                            Click="BackToPosButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 17,16 L 21,12 L 17,8 M 21,12 L 9,12 M 9,21 H 5 C 3.9,21 3,20.1 3,19 V 5 C 3,3.9 3.9,3 5,3 H 9"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="POS Login"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="FormPagerContainer"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="FormPagerCountText"
                                   Text="1 / 6"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <!-- Previous User Button < -->
                        <Button x:Name="FormPrevUserButton"
                                Style="{StaticResource OdooIconButtonStyle}"
                                Width="34" Height="34" Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="Previous User"
                                Click="FormPrevUserButton_Click">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 15,19 L 8,12 L 15,5"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Next User Button > -->
                        <Button x:Name="FormNextUserButton"
                                Style="{StaticResource OdooIconButtonStyle}"
                                Width="34" Height="34" Padding="0"
                                ToolTip="Next User"
                                Click="FormNextUserButton_Click">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 9,5 L 16,12 L 9,19"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. VIEW 1: USERS KANBAN VIEW                                            -->
        <!-- ======================================================================= -->
        <ScrollViewer x:Name="KanbanViewContainer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,28,14,28">
            <ItemsControl x:Name="UsersKanbanItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource KanbanCardButtonStyle}"
                                Tag="{Binding}"
                                Click="KanbanUserCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 64x64 Rounded Square Avatar -->
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="16"/>
                                    <!-- User Name & Login -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left-aligned Rounded-Square Image (64x64) -->
                                <Grid Grid.Column="0" Width="64" Height="64" VerticalAlignment="Center">
                                    <!-- Default Avatar Placeholder -->
                                    <Border CornerRadius="8"
                                            Background="{Binding AvatarSoftBrush}"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="{Binding AvatarAccentBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Custom Uploaded Bitmap Image (When Present) -->
                                    <Rectangle RadiusX="8" RadiusY="8"
                                               Visibility="{Binding HasCustomImageVisibility}">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarBitmap}" Stretch="UniformToFill"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>

                                <!-- Right Content: Bold Name, Envelope + Login, Top-Right Green Active Dot -->
                                <Grid Grid.Column="2" VerticalAlignment="Stretch">
                                    <!-- Top-Right Status & POS Pill -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                        <!-- POS Login Visible Badge -->
                                        <Border Visibility="{Binding PosBadgeVisibility}"
                                                Background="{StaticResource OdooTealSoftBrush}"
                                                CornerRadius="4"
                                                Padding="5,1"
                                                Margin="0,0,6,0"
                                                ToolTip="Visible on POS Login screen">
                                            <TextBlock Text="POS"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource OdooTealBrush}"/>
                                        </Border>

                                        <!-- Status Dot -->
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding StatusDotBrush}"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{Binding Status}"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <!-- Bold Name -->
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,6"/>

                                        <!-- Envelope Icon + Login/Email -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Rectangle Width="20" Height="16" Canvas.Left="2" Canvas.Top="4"
                                                               RadiusX="2" RadiusY="2"
                                                               Stroke="{StaticResource SecondaryTextBrush}"
                                                               StrokeThickness="2"/>
                                                    <Path Data="M 2,6 L 12,13 L 22,6"
                                                          Stroke="{StaticResource SecondaryTextBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Login}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ======================================================================= -->
        <!-- 3. VIEW 2: USER FORM VIEW (CREATE / EDIT)                               -->
        <!-- ======================================================================= -->
        <ScrollViewer x:Name="FormViewContainer"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      Padding="32,28">
            <!-- Clean White Sheet Container Card on Light-Gray Background -->
            <Border MaxWidth="920"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40,36"
                    Effect="{StaticResource SheetShadow}">
                <StackPanel>
                    <!-- Validation Banner (Shown if required fields are missing) -->
                    <Border x:Name="ValidationBanner"
                            Visibility="Collapsed"
                            Background="{StaticResource DangerRedSoftBrush}"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource DangerRedBrush}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ValidationMessageText"
                                       Text="Please fill in all required fields: Name and Login."
                                       Foreground="{StaticResource DangerRedBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- =================================================== -->
                    <!-- HEADER SECTION: AVATAR (96x96) + NAME & LOGIN       -->
                    <!-- =================================================== -->
                    <Grid Margin="0,0,0,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Large Clickable Image Avatar Uploader (96x96, Rounded Corners) -->
                        <Button Grid.Column="0"
                                Width="96" Height="96"
                                Cursor="Hand"
                                Click="UploadAvatarButton_Click"
                                ToolTip="Click to upload user avatar photo">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="96" Height="96">
                                        <!-- Default User Vector Placeholder -->
                                        <Border x:Name="AvatarPlaceholderBorder"
                                                Background="{StaticResource OdooPurpleSoftBrush}"
                                                BorderBrush="#D8C3D2"
                                                BorderThickness="1.5"
                                                CornerRadius="8">
                                            <Viewbox Width="44" Height="44">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Width="8" Height="8" Canvas.Left="8" Canvas.Top="3"
                                                             Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                                    <Path Data="M 4,20 C 4,15.5 7.5,14 12,14 C 16.5,14 20,15.5 20,20"
                                                          Stroke="{StaticResource OdooPurpleBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>

                                        <!-- Uploaded Image Preview -->
                                        <Rectangle x:Name="FormAvatarPreviewRect"
                                                   RadiusX="8" RadiusY="8"
                                                   Visibility="Collapsed">
                                            <Rectangle.Fill>
                                                <ImageBrush x:Name="FormAvatarImageBrush" Stretch="UniformToFill"/>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <!-- Subtle Camera Hover Overlay -->
                                        <Border x:Name="CameraHoverOverlay"
                                                Background="#88111827"
                                                CornerRadius="8"
                                                Opacity="0">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Upload"
                                                           Foreground="#FFFFFF"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CameraHoverOverlay" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Right of Avatar: Large Underline Name Input + Icon-Prefixed Login Input -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- Field 1: Name Label + Required Indicator -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="FULL NAME"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                                <TextBlock Text=" *"
                                           Foreground="{StaticResource DangerRedBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                            Margin="0,-2,0,0"/>
                            </StackPanel>

                            <!-- Prominent Underline Input for Name -->
                            <Border x:Name="NameUnderlineBorder"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="0,0,0,2"
                                    Padding="0,2,0,6"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <TextBlock x:Name="NamePlaceholderText"
                                               Text="e.g. John Doe"
                                               Foreground="{StaticResource PlaceholderTextBrush}"
                                               FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="FormNameTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             CaretBrush="{StaticResource OdooPurpleBrush}"
                                             FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                             FontSize="26"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center"
                                             TextChanged="FormNameTextBox_TextChanged"
                                             GotFocus="RequiredField_GotFocus"
                                             LostFocus="RequiredField_LostFocus"/>
                                </Grid>
                            </Border>

                            <!-- Field 2: Compact Icon-Prefixed Input for Login (Required) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Login"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text=" *"
                                               Foreground="{StaticResource DangerRedBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <Border x:Name="LoginInputBorder"
                                        Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        Width="360"
                                        Style="{StaticResource FormInputBoxBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Prefix Icon (User/Envelope Badge) -->
                                        <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Rectangle Width="20" Height="16" Canvas.Left="2" Canvas.Top="4"
                                                           RadiusX="2" RadiusY="2"
                                                           Stroke="{StaticResource OdooPurpleBrush}"
                                                           StrokeThickness="2"/>
                                                <Path Data="M 2,6 L 12,13 L 22,6"
                                                      Stroke="{StaticResource OdooPurpleBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LoginPlaceholderText"
                                                       Text="e.g. john.doe@pos.com"
                                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            <TextBox x:Name="FormLoginTextBox"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource PrimaryTextBrush}"
                                                     CaretBrush="{StaticResource OdooPurpleBrush}"
                                                     FontSize="13"
                                                     VerticalAlignment="Center"
                                                     TextChanged="FormLoginTextBox_TextChanged"
                                                     GotFocus="RequiredField_GotFocus"
                                                     LostFocus="RequiredField_LostFocus"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,28"/>

                    <!-- =================================================== -->
                    <!-- DETAILS SECTION (2-COLUMN GRID BELOW HEADER)        -->
                    <!-- =================================================== -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left Column: Contact Info -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                            <!-- Right Column: POS Credentials -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: CONTACT INFO (Email & Phone) -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CONTACT INFORMATION"
                                       Foreground="{StaticResource OdooPurpleBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,18"/>

                            <!-- Email Input -->
                            <TextBlock Text="Email Address"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="20" Height="16" Canvas.Left="2" Canvas.Top="4"
                                                       RadiusX="2" RadiusY="2"
                                                       Stroke="{StaticResource SecondaryTextBrush}"
                                                       StrokeThickness="2"/>
                                            <Path Data="M 2,6 L 12,13 L 22,6"
                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                  StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="EmailPlaceholderText"
                                                   Text="john.doe@example.com"
                                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"/>
                                        <TextBox x:Name="FormEmailTextBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 CaretBrush="{StaticResource OdooPurpleBrush}"
                                                 FontSize="13"
                                                 TextChanged="FormEmailTextBox_TextChanged"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Phone Input -->
                            <TextBlock Text="Phone Number"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 6.6,10.8 C 8,13.6 10.4,15.9 13.2,17.4 L 15.4,15.2 C 15.7,14.9 16.1,14.8 16.4,14.9 C 17.5,15.3 18.7,15.5 20,15.5 C 20.6,15.5 21,15.9 21,16.5 L 21,20 C 21,20.6 20.6,21 20,21 C 10.6,21 3,13.4 3,4 C 3,3.4 3.4,3 4,3 L 7.5,3 C 8.1,3 8.5,3.4 8.5,4 C 8.5,5.2 8.7,6.4 9.1,7.6 C 9.2,7.9 9.1,8.3 8.8,8.6 L 6.6,10.8 Z"
                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PhonePlaceholderText"
                                                   Text="+1 (555) 019-2834"
                                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"/>
                                        <TextBox x:Name="FormPhoneTextBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 CaretBrush="{StaticResource OdooPurpleBrush}"
                                                 FontSize="13"
                                                 TextChanged="FormPhoneTextBox_TextChanged"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: POS CREDENTIALS (Password & Numeric PIN) -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="POS CREDENTIALS"
                                       Foreground="{StaticResource OdooTealBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,18"/>

                            <!-- Masked Password Input -->
                            <TextBlock Text="Password"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Lock Icon -->
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="18" Height="11" Canvas.Left="3" Canvas.Top="11"
                                                       RadiusX="2" RadiusY="2"
                                                       Stroke="{StaticResource SecondaryTextBrush}"
                                                       StrokeThickness="2"/>
                                            <Path Data="M 7,11 L 7,7 C 7,4.2 9.2,2 12,2 C 14.8,2 17,4.2 17,7 L 17,11"
                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                  StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PasswordPlaceholderText"
                                                   Text="••••••••"
                                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"/>
                                        <PasswordBox x:Name="FormPasswordBox"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource PrimaryTextBrush}"
                                                     CaretBrush="{StaticResource OdooPurpleBrush}"
                                                     FontSize="14"
                                                     PasswordChanged="FormPasswordBox_PasswordChanged"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Masked Numeric Security PIN Input -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="POS Security PIN"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="Medium"/>
                                <TextBlock Text=" (Numeric digits only)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Keypad / Dial Icon -->
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="5" Canvas.Top="4" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="10.2" Canvas.Top="4" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="15.5" Canvas.Top="4" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="5" Canvas.Top="9.5" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="10.2" Canvas.Top="9.5" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="15.5" Canvas.Top="9.5" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="10.2" Canvas.Top="15" Fill="{StaticResource OdooTealBrush}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PinPlaceholderText"
                                                   Text="e.g. •••• (4 to 6 digits)"
                                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"/>
                                        <PasswordBox x:Name="FormPinPasswordBox"
                                                     MaxLength="6"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource PrimaryTextBrush}"
                                                     CaretBrush="{StaticResource OdooTealBrush}"
                                                     FontSize="14"
                                                     PreviewTextInput="FormPinPasswordBox_PreviewTextInput"
                                                     DataObject.Pasting="FormPinPasswordBox_Pasting"
                                                     PasswordChanged="FormPinPasswordBox_PasswordChanged"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Visible in POS Login CheckBox -->
                            <Border Margin="0,18,0,0"
                                    Background="#F9FAFB"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10">
                                <CheckBox x:Name="FormVisibleInPosCheckBox"
                                          IsChecked="True"
                                          Cursor="Hand"
                                          VerticalContentAlignment="Center">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Visible on POS Login Screen"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="When enabled, this user appears as a touch card on the POS login screen"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ========================================================= -->
        <!-- OVERLAY: DELETE CONFIRMATION MODAL (LIKE CONFIRM SHUTDOWN)-->
        <!-- ========================================================= -->
        <Grid x:Name="DeleteConfirmModalOverlay"
              Grid.RowSpan="2"
              Background="{StaticResource ModalBackdropBrush}"
              Visibility="Collapsed">
            <Border Width="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="32,28"
                    Effect="{StaticResource SheetShadow}">
                <StackPanel>
                    <!-- Red Warning/Trash Icon in Circular Badge -->
                    <Border Width="56" Height="56"
                            CornerRadius="28"
                            Background="{StaticResource DangerRedSoftBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,6 L 5,6 L 21,6 M 19,6 L 19,20 C 19,21.1 18.1,22 17,22 L 7,22 C 5.9,22 5,21.1 5,20 L 5,6 M 8,6 L 8,4 C 8,2.9 8.9,2 10,2 L 14,2 C 15.1,2 16,2.9 16,4 L 16,6"
                                      Stroke="{StaticResource DangerRedBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                                <Line X1="10" Y1="11" X2="10" Y2="17" Stroke="{StaticResource DangerRedBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                <Line X1="14" Y1="11" X2="14" Y2="17" Stroke="{StaticResource DangerRedBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Delete User Record?"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Prompt Description -->
                    <TextBlock x:Name="DeleteModalPromptText"
                               Text="Are you sure you want to permanently delete this user? This action cannot be undone."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button -->
                        <Button Grid.Column="0"
                                Content="Cancel"
                                Height="46"
                                Style="{StaticResource OdooIconButtonStyle}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Click="CancelDeleteModal_Click"/>

                        <!-- Delete Button -->
                        <Button Grid.Column="2"
                                Content="Delete"
                                Height="46"
                                Cursor="Hand"
                                Click="ConfirmDeleteUser_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBg"
                                            Background="{StaticResource DangerRedBrush}"
                                            CornerRadius="8">
                                        <TextBlock Text="Delete"
                                                   Foreground="#FFFFFF"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource DangerRedHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BtnBg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- TOAST NOTIFICATION: USER MANAGEMENT ACTIONS               -->
        <!-- ========================================================= -->
        <Border x:Name="UserActionToastBanner"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,36"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,14"
                Effect="{StaticResource SheetShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="ToastIndicatorDot" Width="10" Height="10" Fill="{StaticResource DangerRedBrush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="UserActionToastText"
                           Text="User deleted successfully."
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>