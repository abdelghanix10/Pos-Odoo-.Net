<UserControl x:Class="OdooPosLogin.PosCategoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:PosCategoriesViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="12"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP ODOO 20 CONTROL BAR                                              -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync Button + Breadcrumbs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncFromOdooCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToListCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText"
                                           Text="PoS Product Categories"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                VerticalAlignment="Center">
                        <TextBlock Text="  /  " Foreground="{StaticResource SecondaryTextBrush}" FontSize="17"/>
                        <TextBlock Text="{Binding SelectedCategory.Name}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: PILL SEARCH BAR -->
                <Border Grid.Column="1"
                        MaxWidth="480"
                        Width="420"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#8583A8"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2"/>
                                <Path Data="M 14,14 L 20,20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Grid.Column="1"
                                   Text="Search..."
                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                   FontSize="13.5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13.5"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- RIGHT: PAGER (< >) + LIST/KANBAN SWITCHER -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListCounterText}"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding PagerText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding PreviousRecordCommand}"
                            IsEnabled="{Binding HasPreviousRecord}"
                            Margin="0,0,2,0"
                            ToolTip="Previous Category">
                        <Viewbox Width="8" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 7,1 L 1.5,6.5 L 7,12"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding NextRecordCommand}"
                            IsEnabled="{Binding HasNextRecord}"
                            Margin="0,0,10,0"
                            ToolTip="Next Category">
                        <Viewbox Width="8" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 1.5,1 L 7,6.5 L 1.5,12"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <!-- List View Button (☰) -->
                        <Button Command="{Binding SwitchToListCommand}"
                                Width="34" Height="32"
                                Cursor="Hand"
                                ToolTip="List">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="Background" Value="#E6E4F0"/>
                                            <Setter Property="BorderBrush" Value="#714B67"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Kanban View Button (⊞) -->
                        <Button Command="{Binding SwitchToKanbanCommand}"
                                Width="34" Height="32"
                                Cursor="Hand"
                                ToolTip="Kanban">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,1,1,1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKanbanView}" Value="True">
                                            <Setter Property="Background" Value="#E6E4F0"/>
                                            <Setter Property="BorderBrush" Value="#714B67"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" Fill="{StaticResource PrimaryTextBrush}"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="10" Fill="{StaticResource PrimaryTextBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. WORKSPACE CONTENT AREA                                               -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">

            <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <!-- ==================== VIEW 1A: LIST VIEW (Screenshot 17) ==================== -->
                <Border Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="PoS Product Category" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Parent Category" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Linked PoS Configurations" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Color" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosCategoryRecord}">
                                        <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder" Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10" MinHeight="44">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="2.5*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="80"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Drag Handle ⋮⋮ -->
                                                            <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ParentCategoryName}" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>

                                                            <ItemsControl Grid.Column="3" ItemsSource="{Binding LinkedShopsList}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#D8DADF" CornerRadius="10" Padding="10,2.5" Margin="0,1,6,1">
                                                                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Ellipse Grid.Column="4"
                                                                     Width="20" Height="20"
                                                                     Fill="{Binding ColorBrush}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,6,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ==================== VIEW 1B: KANBAN VIEW (Screenshot 16) ==================== -->
                <ScrollViewer Visibility="{Binding IsKanbanView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10,12">
                    <ItemsControl ItemsSource="{Binding FilteredCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosCategoryRecord}">
                                <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        Margin="6"
                                        Width="315"
                                        Height="94"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder"
                                                    Background="#FFFFFF"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="14,12">
                                                <Grid>
                                                    <!-- Top-Left: Color Circle + Bold Category Name -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                        <Ellipse Width="16" Height="16"
                                                                 Fill="{Binding ColorBrush}"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Bottom-Right: Category Image or Camera Placeholder Icon -->
                                                    <Grid Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <Image Source="{Binding ImageBitmap}"
                                                               Stretch="Uniform"
                                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Viewbox Width="42" Height="42"
                                                                 Visibility="{Binding HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M 4,6 H 7 L 9,4 H 15 L 17,6 H 20 C 21.1,6 22,6.9 22,8 V 18 C 22,19.1 21.1,20 20,20 H 4 C 2.9,20 2,19.1 2,18 V 8 C 2,6.9 2.9,6 4,6 Z M 12,17 C 14.8,17 17,14.8 17,12 C 17,9.2 14.8,7 12,7 C 9.2,7 7,9.2 7,12 C 7,14.8 9.2,17 12,17 Z"
                                                                      Fill="#C4C7CE"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE PLACEHOLDER -->
                <Border Background="#FFFFFF"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="32,28"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No PoS Categories Synchronized Yet" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Click 'Sync from Odoo' to pull PoS product categories and shop assignments." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource OdooPrimaryButtonStyle}" Command="{Binding SyncFromOdooCommand}" Content="Sync Categories from Odoo" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================================================================== -->
            <!-- VIEW 2: POS CATEGORY DETAIL VIEW + ASSOCIATED PRODUCTS              -->
            <!-- =================================================================== -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,20">
                <StackPanel>
                    <!-- CATEGORY DETAILS SHEET -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="32,26"
                            Margin="0,0,0,20"
                            Effect="{StaticResource SubtleCardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,24,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="PoS Product Category"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedCategory.Name}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Parent Category" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SelectedCategory.ParentCategoryDisplay}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Color" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="20" Height="20" Fill="{Binding SelectedCategory.ColorBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding SelectedCategory.ColorNameDisplay}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Linked PoS Configurations" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding SelectedCategory.LinkedShopsList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#D8DADF" CornerRadius="10" Padding="10,2.5" Margin="0,2,6,2">
                                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Border Grid.Column="1"
                                    Width="88" Height="88"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <Image Source="{Binding SelectedCategory.ImageBitmap}"
                                           Stretch="Uniform"
                                           Visibility="{Binding SelectedCategory.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Viewbox Width="38" Height="38"
                                             Visibility="{Binding SelectedCategory.HasNoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 4,6 H 7 L 9,4 H 15 L 17,6 H 20 C 21.1,6 22,6.9 22,8 V 18 C 22,19.1 21.1,20 20,20 H 4 C 2.9,20 2,19.1 2,18 V 8 C 2,6.9 2.9,6 4,6 Z M 12,17 C 14.8,17 17,14.8 17,12 C 17,9.2 14.8,7 12,7 C 9.2,7 7,9.2 7,12 C 7,14.8 9.2,17 12,17 Z"
                                                  Fill="#C4C7CE"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ==================== ASSOCIATED PRODUCTS IN THIS CATEGORY ==================== -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="28,22"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Products in Category" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <Border Background="{StaticResource OdooTealSoftBrush}" CornerRadius="10" Padding="10,2.5" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding AssociatedProductsCountDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OdooTealBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Product Name" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="2" Text="Internal Reference" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="3" Text="Variants" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="4" Text="Sales Price" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="Cost" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding AssociatedProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProductRecord}">
                                        <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                    <Image Source="{Binding ImageBitmap}" Stretch="Uniform"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SkuDisplay}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding VariantCountDisplay}" FontSize="12.5" Foreground="{StaticResource OdooTealBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PriceDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding CostDisplay}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No products are currently assigned to this PoS category."
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="4,14,0,4"
                                       Visibility="{Binding HasNoAssociatedProducts, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST BANNER -->
        <Border Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,28"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>