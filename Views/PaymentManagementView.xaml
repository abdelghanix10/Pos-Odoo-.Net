<UserControl x:Class="OdooPosLogin.PaymentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:PaymentsViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="ActiveGreenSoftBrush" Color="#ECFDF5"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.05"/>

        <!-- Primary Purple Button Style -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pager Chevron Button Style -->
        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group Header Button Style -->
        <Style x:Key="GroupHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table Row Button Style -->
        <Style x:Key="TableRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="28,11,16,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Standardized Control Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Content (List View or Detail View) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP STANDARDIZED CONTROL BAR                                         -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Sync Button & Breadcrumb -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Search Bar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Detail Pager (< >) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync from Odoo Button & Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncPaymentsCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                            Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStory">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStory"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Viewbox.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumbs -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Command="{Binding CloseDetailCommand}">
                            <TextBlock Text="Payments"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Filter Pill if filtered by Session -->
                        <Border Background="{StaticResource OdooPurpleSoftBrush}"
                                CornerRadius="12"
                                Margin="12,0,0,0"
                                Padding="8,3"
                                Visibility="{Binding SessionFilter, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SessionFilter}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                <Button Background="Transparent" BorderThickness="0" Padding="4,0,0,0" Cursor="Hand" Command="{Binding ClearSessionFilterCommand}">
                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Sub-title if Detail View -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text=" / "
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       Margin="6,0"/>
                            <TextBlock Text="{Binding SelectedPayment.AmountDisplay}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OdooPurpleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: Clean Search Bar -->
                <Border Grid.Column="1"
                        Background="#F3F4F6"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Height="38"
                        MaxWidth="420"
                        Margin="24,0"
                        HorizontalAlignment="Center">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13"
                                         Stroke="{StaticResource PlaceholderTextBrush}"
                                         StrokeThickness="2.2"/>
                                <Path Data="M 14,14 L 21,21"
                                      Stroke="{StaticResource PlaceholderTextBrush}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 FontSize="13.5"
                                 Foreground="{StaticResource PrimaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- RIGHT: Detail View Pager (< >) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding PagerText}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding PreviousRecordCommand}"
                            IsEnabled="{Binding HasPreviousRecord}"
                            Margin="0,0,4,0"
                            ToolTip="Previous Payment">
                        <Path Data="M 17,7 L 11,12 L 17,17"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Button>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding NextRecordCommand}"
                            IsEnabled="{Binding HasNextRecord}"
                            ToolTip="Next Payment">
                        <Path Data="M 11,7 L 17,12 L 11,17"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. MAIN WORKSPACE AREA                                                  -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">
            <!-- ==================== VIEW 1: GROUPED COLLAPSIBLE LIST VIEW ==================== -->
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"
                  Margin="24,20">
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{StaticResource SubtleCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Table Grouped Rows -->
                            <RowDefinition Height="*"/>
                            <!-- Table Footer (Grand Total) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="Payment Method" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="Order" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="Cashier" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="4" Text="Amount" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- TABLE BODY: GROUPED PAYMENTS -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GroupedPayments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Group Collapsible Header -->
                                            <Button Style="{StaticResource GroupHeaderButtonStyle}"
                                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Chevron icon -->
                                                        <TextBlock Text="{Binding HeaderChevron}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource OdooPurpleBrush}"
                                                                   Margin="0,0,8,0"/>
                                                        <!-- Group Name & Records Count -->
                                                        <TextBlock Text="{Binding HeaderLabel}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13.5"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                                    </StackPanel>

                                                    <!-- Subtotal for Group -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SubtotalDisplay}"
                                                               FontWeight="Bold"
                                                               FontSize="13.5"
                                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                                </Grid>
                                            </Button>

                                            <!-- Group Children Rows -->
                                            <ItemsControl ItemsSource="{Binding Payments}"
                                                          Visibility="{Binding IsExpanded, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource TableRowButtonStyle}"
                                                                Command="{Binding DataContext.SelectPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2.2*"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="2.5*"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="1.8*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Date -->
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding PaymentDateDisplay}"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Method -->
                                                                <Border Grid.Column="1" HorizontalAlignment="Left" Background="{StaticResource OdooTealSoftBrush}" CornerRadius="10" Padding="8,3">
                                                                    <TextBlock Text="{Binding PaymentMethodName}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource OdooTealBrush}"/>
                                                                </Border>

                                                                <!-- Order -->
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding OrderName}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13.5"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Cashier -->
                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding CashierName}"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Amount -->
                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding AmountDisplay}"
                                                                           FontWeight="Bold"
                                                                           FontSize="13.5"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           TextAlignment="Right"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- TABLE FOOTER: GRAND TOTAL -->
                        <Border Grid.Row="2"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,8,8"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FlatPayments.Count, StringFormat='Total Records: {0}'}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Total: "
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding GrandTotalText}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== VIEW 2: PAYMENT DETAIL / CARD VIEW ==================== -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                    <!-- MAIN SHEET CARD -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="36,30"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <!-- Header Title -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Payment"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedPayment.AmountDisplay}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,24"/>

                            <!-- Fields List -->
                            <StackPanel>
                                <!-- Session -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Session" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.SessionName}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                </Grid>

                                <!-- Order -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Order" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.OrderName}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <!-- Amount -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Amount" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.AmountDisplay}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <!-- Currency -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Currency" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.CurrencyName}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <!-- Amount in currency -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Amount in currency" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.AmountDisplay}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <!-- Foreign Currency -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Foreign Currency" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.ForeignCurrency}" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>

                                <!-- Payment Method -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Payment Method" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="{StaticResource OdooTealSoftBrush}" CornerRadius="12" Padding="12,4">
                                        <TextBlock Text="{Binding SelectedPayment.PaymentMethodName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- Cashier -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cashier" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.CashierName}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>

                                <!-- Payment Date -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Payment Date" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPayment.PaymentDateDisplay}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST BANNER -->
        <Border Grid.Row="1"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="14" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
