        <!-- ======================================================================= -->
        <!-- 2. MAIN CONTENT WORKSPACE                                               -->
        <!-- ======================================================================= -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">

            <!-- ==================== VIEW A: CONFIGURATION & SYNCHRONIZATION HUB ==================== -->
            <Grid x:Name="SettingsViewPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. PAGE HEADER -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceCardBrush}"
                        Padding="28,20,28,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Configuration &amp; Synchronization"
                                       FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Manage your Odoo 20 connection and synchronize all 12 POS, Catalog, Company, and User models with local SQLite."
                                       FontSize="12.5"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,3,0,14"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,6"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionStatusDot"
                                         Width="9" Height="9"
                                         Fill="{StaticResource MutedTextBrush}"
                                         Margin="0,0,8,0"/>
                                <TextBlock x:Name="ConnectionStatusText"
                                           Text="Not Tested"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. HORIZONTAL TAB BAR STRIP -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="28,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabGeneral" Style="{StaticResource OdooActiveTabButtonStyle}" Content="Odoo Connection &amp; Sync" Click="TabButton_Click" Tag="General"/>
                        <Button x:Name="TabPosSettings" Style="{StaticResource OdooTabButtonStyle}" Content="Point of Sale Settings" Click="TabButton_Click" Tag="PosSettings"/>
                        <Button x:Name="TabReceiptDesigns" Style="{StaticResource OdooTabButtonStyle}" Content="Receipt Designs" Click="TabButton_Click" Tag="ReceiptDesigns"/>
                        <Button x:Name="TabLocale" Style="{StaticResource OdooTabButtonStyle}" Content="Locale" Click="TabButton_Click" Tag="Locale"/>
                        <Button x:Name="TabPaymentMethod" Style="{StaticResource OdooTabButtonStyle}" Content="Payment Method" Click="TabButton_Click" Tag="PaymentMethod"/>
                        <Button x:Name="TabPeripherals" Style="{StaticResource OdooTabButtonStyle}" Content="Peripherals" Click="TabButton_Click" Tag="Peripherals"/>
                        <Button x:Name="TabSystemOptions" Style="{StaticResource OdooTabButtonStyle}" Content="System Options" Click="TabButton_Click" Tag="SystemOptions"/>
                    </StackPanel>
                </Border>

                <!-- 3. CONFIGURATION TAB CONTENT BODY -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="GeneralSettingsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="28,22,28,32">
                        <StackPanel HorizontalAlignment="Stretch">

                            <!-- TOP ROW: 2-COLUMN RESPONSIVE HERO (CONNECTION + MASTER SYNC HUB) -->
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="1.15*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT CARD: ODOO SERVER CONNECTION CREDENTIALS -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="24,20"
                                        Effect="{StaticResource CardShadowEffect}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource OdooPurpleSoftBrush}" Margin="0,0,12,0">
                                                <Viewbox Width="19" Height="19">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="1.8" Fill="{StaticResource OdooPurpleSoftBrush}"/>
                                                        <Path Data="M 9,13 L 12,10 L 15,13 M 12,10 L 12,17" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Odoo Server Connection" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="JSON-RPC endpoint &amp; authentication credentials." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Row="1" Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,0,0,16"/>

                                        <Grid Grid.Row="2" Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="Server URL" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,5"/>
                                                <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                    <TextBox x:Name="CfgServerUrlTextBox" Text="http://localhost:8069/" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="Database Name" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,5"/>
                                                <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                    <TextBox x:Name="CfgDatabaseTextBox" Text="" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="Username / Email" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,5"/>
                                                <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                    <TextBox x:Name="CfgUsernameTextBox" Text="" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="Password / API Key" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,5"/>
                                                <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                    <Grid>
                                                        <PasswordBox x:Name="CfgPasswordMasked" PasswordChar="●" FontSize="13.5" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Margin="0,0,32,0"/>
                                                        <TextBox x:Name="CfgPasswordRevealed" FontSize="13.5" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Margin="0,0,32,0"/>
                                                        <Button x:Name="TogglePasswordViewBtn" Click="TogglePasswordView_Click" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Show / Hide Password">
                                                            <Viewbox Width="15" Height="15">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path x:Name="EyeIconPath" Data="M 1,12 C 1,12 5,4 12,4 C 19,4 23,12 23,12 C 23,12 19,20 12,20 C 5,20 1,12 1,12 Z" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2" Fill="Transparent"/>
                                                                    <Ellipse x:Name="EyePupil" Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Fill="{StaticResource SecondaryTextBrush}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="SaveConnectionBtn" Style="{StaticResource OdooPrimaryActionButtonStyle}" Click="SaveConnectionBtn_Click" Margin="0,0,10,0">
                                                        <TextBlock Text="Save Credentials"/>
                                                    </Button>
                                                    <Button x:Name="TestConnectionBtn" Style="{StaticResource OdooTealActionButtonStyle}" Click="TestConnectionBtn_Click">
                                                        <TextBlock Text="Test Connection"/>
                                                    </Button>
                                                </StackPanel>
                                                <ProgressBar x:Name="TestConnectionProgressBar" IsIndeterminate="True" Width="80" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- RIGHT CARD: MASTER FULL SYNCHRONIZATION HUB -->
                                <Border Grid.Column="2"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource OdooPurpleBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="24,20"
                                        Effect="{StaticResource CardShadowEffect}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{StaticResource OdooTealSoftBrush}" Margin="0,0,12,0">
                                                <Viewbox Width="20" Height="20">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="{StaticResource OdooTealBrush}"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
