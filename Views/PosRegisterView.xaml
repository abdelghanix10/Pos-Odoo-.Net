              Panel.ZIndex="1000"
              Visibility="{Binding IsOpeningControlModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Border Width="720"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    Padding="32,28,32,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <TextBlock Text="Opening Control"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Opening cash"
                               FontSize="14.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="48"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource BorderMidBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
