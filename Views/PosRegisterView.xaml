                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveShopName}"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,4,0,0"/>

                <Border Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#14714B67"
                        CornerRadius="4"
                        Padding="14,8">
                    <Grid>
                        <Image Source="{Binding CompanyLogoBitmap}"
                               MaxHeight="34"
                               Stretch="Uniform"
                               Visibility="{Binding HasCompanyLogo, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasCompanyLogo, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text="📷 " FontSize="17" Foreground="#5E4760" VerticalAlignment="Center"/>
                            <TextBlock Text="Your logo" FontSize="22" FontWeight="Bold" Foreground="#5E4760" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Button Command="{Binding EnterPosFromLandingCommand}"
                    Width="156" Height="156"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBdr"
                                Background="#FFFFFF"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="42" Height="42" Margin="0,0,0,12">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 9,4 L 6,9 M 15,4 L 18,9 M 3,9 H 21 L 19,19 H 5 Z"
                                              Stroke="#1F2937"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                        <Ellipse Canvas.Left="10.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="#1F2937"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Open Register"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Command="{Binding ReturnToBackendCommand}"
                    Content="Backend"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Height="36"
                    Padding="14,0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#1F252D" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ======================================================================= -->
        <!-- MODALS & OVERLAYS                                                       -->
