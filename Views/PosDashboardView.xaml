<UserControl x:Class="OdooPosLogin.PosDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:PosDashboardViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.05"/>

        <DropShadowEffect x:Key="CardHoverShadow"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.10"/>

        <!-- Primary Purple Button Style -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shop Primary Action Button Style -->
        <Style x:Key="ShopActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Three-dot menu button style -->
        <Style x:Key="ThreeDotMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context menu style -->
        <Style x:Key="OdooContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Standardized Control Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Kanban Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP STANDARDIZED CONTROL BAR                                         -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Sync Button & Title -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Search Bar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Info stats / badges -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync from Odoo Button & Page Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncFromOdooCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                            Margin="0,0,22,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStory">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStory"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Viewbox.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Page Title / Breadcrumb: Point of Sale -->
                    <TextBlock Text="Point of Sale"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- CENTER: Centered Search Bar -->
                <Border Grid.Column="1"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Height="38"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 10,2 A 8,8 0 1 0 18,10 A 8,8 0 0 0 10,2 Z M 21,21 L 15.65,15.65"
                                      Stroke="{StaticResource PlaceholderTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13.5"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Search shops..."
                                   FontSize="13.5"
                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>

                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4"
                                Visibility="{Binding SearchText, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}">
                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource PlaceholderTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- RIGHT: Shops summary badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource OdooPurpleSoftBrush}"
                            CornerRadius="12"
                            Padding="12,5"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalShopsCount}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OdooPurpleBrush}"
                                       FontSize="12.5"/>
                            <TextBlock Text=" Shops"
                                       Foreground="{StaticResource OdooPurpleBrush}"
                                       FontSize="12.5"
                                       Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource OdooTealSoftBrush}"
                            CornerRadius="12"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource OdooTealBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ActiveSessionsCount}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OdooTealBrush}"
                                       FontSize="12.5"/>
                            <TextBlock Text=" Active"
                                       Foreground="{StaticResource OdooTealBrush}"
                                       FontSize="12.5"
                                       Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. POS DASHBOARD KANBAN GRID LAYOUT (RESPONSIVE 3-COLUMN GRID)          -->
        <!-- ======================================================================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,18,20,24">
            <ItemsControl ItemsSource="{Binding FilteredConfigs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PosConfigRecord}">
                        <!-- POS SHOP CARD (Height="260", BorderBrush="#E5E7EB", CornerRadius="6") -->
                        <Border Height="260"
                                Margin="8"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Effect="{StaticResource CardShadow}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                            <Setter Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Row 0: Card Header (Name, Badge, Menu) -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 1: Card Body (Left Action, Right Metrics) -->
                                    <RowDefinition Height="*"/>
                                    <!-- Row 2: Card Footer (Sales Sparkline Area Chart) -->
                                    <RowDefinition Height="90"/>
                                </Grid.RowDefinitions>

                                <!-- ==================== CARD HEADER ==================== -->
                                <Grid Grid.Row="0" Margin="18,14,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Bold POS Shop Name -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <!-- Center-Right: Conditional Status Badge -->
                                    <!-- Opening Control -> Teal pill (#017E84) -->
                                    <!-- To Close -> Red pill (#DC2626) -->
                                    <!-- Closed -> Collapsed -->
                                    <Border Grid.Column="1"
                                            Background="{Binding StatusBadgeBackground}"
                                            CornerRadius="10"
                                            Padding="10,2.5"
                                            Margin="8,0,8,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding StatusBadgeVisibility}">
                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                   Foreground="{Binding StatusBadgeForeground}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Far-Right: Subtle three-dot vertical menu icon (⋮) -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ThreeDotMenuButtonStyle}"
                                            Click="CardMenuButton_Click"
                                            ToolTip="Shop Options">
                                        <TextBlock Text="⋮"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource OdooContextMenuStyle}">
                                                <MenuItem Header="🛒 View Orders"
                                                          Click="MenuItem_ViewOrders_Click"
                                                          FontSize="13"/>
                                                <MenuItem Header="⏱ View Sessions"
                                                          Click="MenuItem_ViewSessions_Click"
                                                          FontSize="13"/>
                                                <MenuItem Header="💳 View Payments"
                                                          Click="MenuItem_ViewPayments_Click"
                                                          FontSize="13"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>

                                <!-- ==================== CARD BODY ==================== -->
                                <Grid Grid.Row="1" Margin="18,10,18,6" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <!-- Left Action Column -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Right Metrics Column -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT ACTION COLUMN -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <!-- Primary Action Button: "Open Register" or "Continue Selling" -->
                                        <Button Style="{StaticResource ShopActionButtonStyle}"
                                                Content="{Binding PrimaryActionButtonText}"
                                                Click="ShopActionButton_Click"/>

                                        <!-- Active User Avatar (shown directly below button, hidden when closed) -->
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="6"
                                                Background="{StaticResource OdooTealSoftBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                ToolTip="{Binding ActiveUserName}"
                                                Visibility="{Binding HasActiveUser, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                            <Grid>
                                                <!-- If user has bitmap avatar -->
                                                <Image Source="{Binding ActiveUserAvatarBitmap}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasActiveUserAvatar, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                <!-- Fallback User Initials -->
                                                <TextBlock Text="{Binding ActiveUserInitials}"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource OdooTealBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasActiveUserAvatar, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- RIGHT METRICS COLUMN (Dynamic Key-Value Pairs) -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="12,0,0,0">

                                        <!-- 1. CLOSED STATE (e.g. Furniture Shop): Closing (Date) and Balance (Currency) -->
                                        <StackPanel Visibility="{Binding ClosedMetricsVisibility}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                                <TextBlock Text="Closing"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LastClosingDateDisplay}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Balance"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LastClosingBalanceDisplay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2. OPENING CONTROL STATE (e.g. Clothes Shop): Single Row: Opening (Currency) -->
                                        <StackPanel Visibility="{Binding OpeningControlMetricsVisibility}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Opening"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding OpeningBalanceDisplay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 3. ACTIVE / TO CLOSE STATE (e.g. Bakery Shop): Date (Oct 27) and Opening (Currency) -->
                                        <StackPanel Visibility="{Binding ToCloseMetricsVisibility}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                                <TextBlock Text="Date"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ActiveSessionDateDisplay}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Opening"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding OpeningBalanceDisplay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- ==================== CARD FOOTER: SALES SPARKLINE AREA CHART ==================== -->
                                <!-- Height="90", flush against bottom edge of card -->
                                <Border Grid.Row="2"
                                        Height="90"
                                        CornerRadius="0,0,6,6"
                                        ClipToBounds="True"
                                        VerticalAlignment="Bottom">
                                    <Grid>
                                        <Viewbox Stretch="Fill" Height="90" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                            <Canvas Width="300" Height="80">
                                                <!-- Translucent Fill Underneath (only when sales exist) -->
                                                <Path Data="{Binding AreaGeometryString}"
                                                      Visibility="{Binding SparklineAreaVisibility}">
                                                    <Path.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#38714B67" Offset="0"/>
                                                            <GradientStop Color="#06714B67" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Path.Fill>
                                                </Path>

                                                <!-- Spline Line Stroke (Purple spline when sales exist, flat gray line on zero activity) -->
                                                <Path Data="{Binding StrokeGeometryString}"
                                                      Stroke="{Binding SparklineStrokeBrush}"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>

                                                <!-- Dot Markers (Circular dots at each data point) -->
                                                <Path Data="{Binding MarkerGeometryString}"
                                                      Fill="{Binding SparklineMarkerBrush}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Toast Notification Banner -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource ActiveGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Warning">
                                    <Setter Property="Fill" Value="{StaticResource WarningAmberBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Error">
                                    <Setter Property="Fill" Value="{StaticResource DangerRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ToastMessage}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
