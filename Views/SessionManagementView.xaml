<UserControl x:Class="OdooPosLogin.SessionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:SessionsViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.05"/>

        <!-- Primary Purple Button Style -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Teal Action Button Style -->
        <Style x:Key="OdooTealButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooTealBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooTealHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pager Chevron Button Style -->
        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smart Stat Button Style -->
        <Style x:Key="SmartStatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table Row Button Style -->
        <Style x:Key="TableRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Standardized Control Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Content (List View or Detail View) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP STANDARDIZED CONTROL BAR                                         -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Sync Button & Breadcrumb -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Search Bar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Detail Pager (< >) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync from Odoo Button & Title / Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncSessionsCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                            Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStory">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStory"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Viewbox.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumbs -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Command="{Binding CloseDetailCommand}">
                            <TextBlock Text="Sessions"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Sub-title if Detail View -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text=" / "
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       Margin="6,0"/>
                            <TextBlock Text="{Binding SelectedSession.Name}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OdooPurpleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: Clean Search Bar -->
                <Border Grid.Column="1"
                        Background="#F3F4F6"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Height="38"
                        MaxWidth="420"
                        Margin="24,0"
                        HorizontalAlignment="Center">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13"
                                         Stroke="{StaticResource PlaceholderTextBrush}"
                                         StrokeThickness="2.2"/>
                                <Path Data="M 14,14 L 21,21"
                                      Stroke="{StaticResource PlaceholderTextBrush}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 FontSize="13.5"
                                 Foreground="{StaticResource PrimaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- RIGHT: Detail View Pager (< >) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding PagerText}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding PreviousRecordCommand}"
                            IsEnabled="{Binding HasPreviousRecord}"
                            Margin="0,0,4,0"
                            ToolTip="Previous Session">
                        <Path Data="M 17,7 L 11,12 L 17,17"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Button>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding NextRecordCommand}"
                            IsEnabled="{Binding HasNextRecord}"
                            ToolTip="Next Session">
                        <Path Data="M 11,7 L 17,12 L 11,17"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. MAIN WORKSPACE AREA                                                  -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">
            <!-- ==================== VIEW 1: SESSIONS LIST VIEW ==================== -->
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"
                  Margin="24,20">
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{StaticResource SubtleCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Table Data Rows -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Session ID" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="Point of Sale" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="Opened By" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="Opening Date" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="4" Text="Closing Date" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- TABLE BODY -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredSessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TableRowButtonStyle}"
                                                Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2.5*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Session ID -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="13.5"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Point of Sale -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PosConfigName}"
                                                           FontSize="13.5"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Opened By (Avatar / Initials + Name) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="26" Height="26" CornerRadius="13"
                                                            Background="{StaticResource OdooPurpleSoftBrush}"
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding UserInitials}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource OdooPurpleBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding UserName}"
                                                               FontSize="13.5"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Opening Date -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding StartAtDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Closing Date -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding StopAtDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="5"
                                                        HorizontalAlignment="Right"
                                                        Background="{Binding StatusSoftBrush}"
                                                        CornerRadius="12"
                                                        Padding="10,4">
                                                    <TextBlock Text="{Binding StateDisplay}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== VIEW 2: SESSION DETAIL / FORM VIEW ==================== -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- TOP ACTION & PIPELINE SUB-HEADER BAR -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,12"
                            Margin="0,0,0,16"
                            Effect="{StaticResource SubtleCardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left Action: Continue Selling -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Spacer -->
                                <ColumnDefinition Width="*"/>
                                <!-- Right: Status Pipeline -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Continue Selling (visible when in progress or opening control) -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource OdooTealButtonStyle}"
                                    Command="{Binding ContinueSellingCommand}"
                                    Visibility="{Binding SelectedSession.CanContinueSelling, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 8,5 L 19,12 L 8,19 Z" Fill="#FFFFFF"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Continue Selling" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Right: Status Segmented Pipeline -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Opening Control -->
                                <Border Background="{Binding SelectedSession.IsStageOpeningControl, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                        Padding="10,4" CornerRadius="4,0,0,4">
                                    <TextBlock Text="Opening Control" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedSession.IsStageOpeningControl, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                </Border>
                                <TextBlock Text=" > " Foreground="{StaticResource PlaceholderTextBrush}" VerticalAlignment="Center" Margin="2,0"/>

                                <!-- In Progress -->
                                <Border Background="{Binding SelectedSession.IsStageInProgress, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                        Padding="10,4">
                                    <TextBlock Text="In Progress" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedSession.IsStageInProgress, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                </Border>
                                <TextBlock Text=" > " Foreground="{StaticResource PlaceholderTextBrush}" VerticalAlignment="Center" Margin="2,0"/>

                                <!-- Closing Control -->
                                <Border Background="{Binding SelectedSession.IsStageClosingControl, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                        Padding="10,4">
                                    <TextBlock Text="Closing Control" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedSession.IsStageClosingControl, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                </Border>
                                <TextBlock Text=" > " Foreground="{StaticResource PlaceholderTextBrush}" VerticalAlignment="Center" Margin="2,0"/>

                                <!-- Closed & Posted -->
                                <Border Background="{Binding SelectedSession.IsStageClosed, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                        Padding="10,4" CornerRadius="0,4,4,0">
                                    <TextBlock Text="Closed &amp; Posted" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedSession.IsStageClosed, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN SHEET CARD -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="32,28"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <!-- SHEET HEADER: Large Title & Smart Buttons -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Title Area -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Session"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedSession.Name}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>

                                <!-- Right: Smart Stat Buttons (Orders & Payments) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <!-- Orders Smart Button -->
                                    <Button Style="{StaticResource SmartStatButtonStyle}"
                                            Command="{Binding ViewOrdersCommand}"
                                            ToolTip="View Orders for this Session"
                                            Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Basket Icon -->
                                            <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 19,7 L 5,7 L 3,19 C 3,20.1 3.9,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 19,7 Z"
                                                          Stroke="{StaticResource OdooPurpleBrush}"
                                                          StrokeThickness="2"
                                                          Fill="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Path Data="M 16,11 C 16,13.2 14.2,15 12,15 C 9.8,15 8,13.2 8,11"
                                                          Stroke="{StaticResource OdooPurpleBrush}"
                                                          StrokeThickness="2"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedSession.OrdersCountDisplay}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Orders"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- Payments Smart Button -->
                                    <Button Style="{StaticResource SmartStatButtonStyle}"
                                            Command="{Binding ViewPaymentsCommand}"
                                            ToolTip="View Payments for this Session">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Dollar/Banknotes Icon -->
                                            <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                                                <Canvas Width="24" Height="24">
                                                    <Rectangle Canvas.Left="2" Canvas.Top="5" Width="20" Height="14" RadiusX="2" RadiusY="2"
                                                               Stroke="{StaticResource OdooTealBrush}"
                                                               StrokeThickness="2"
                                                               Fill="{StaticResource OdooTealSoftBrush}"/>
                                                    <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4"
                                                             Fill="{StaticResource OdooTealBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedSession.TotalPaymentsAmountDisplay}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Payments"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,24"/>

                            <!-- 2-COLUMN INFO GRID -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Column 0: Left Column -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Column 1: Middle Divider Spacing -->
                                    <ColumnDefinition Width="48"/>
                                    <!-- Column 2: Right Column -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT COLUMN -->
                                <StackPanel Grid.Column="0">
                                    <!-- Opened By -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Opened By" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{StaticResource OdooPurpleSoftBrush}"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding SelectedSession.UserInitials}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource OdooPurpleBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedSession.UserName}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Point of Sale Config -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Point of Sale" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.PosConfigName}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Opening Date -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Opening Date" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.StartAtDisplay}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Closing Date (Shown only when session is closed) -->
                                    <Grid Margin="0,0,0,16"
                                          Visibility="{Binding SelectedSession.ShowClosingDate, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Closing Date" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.StopAtDisplay}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Employees -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Employees" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.EmployeesDisplay}" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- RIGHT COLUMN: BALANCES & TOTALS -->
                                <StackPanel Grid.Column="2">
                                    <!-- Opening Balance -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Opening Balance" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.OpeningBalanceDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Closing Balance -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Closing Balance" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.ClosingBalanceDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Total Payments -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Total Payments" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.TotalPaymentsAmountDisplay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource OdooTealBrush}"/>
                                    </Grid>

                                    <!-- State Indicator -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Session State" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <Border Grid.Column="1" HorizontalAlignment="Left" Background="{Binding SelectedSession.StatusSoftBrush}" CornerRadius="12" Padding="12,4">
                                            <TextBlock Text="{Binding SelectedSession.StateDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding SelectedSession.StatusBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST BANNER -->
        <Border Grid.Row="1"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="14" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
