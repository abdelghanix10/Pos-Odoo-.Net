<UserControl x:Class="OdooPosLogin.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.Resources>
        <!-- ==================== COLOR PALETTE ==================== -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="ActiveGreenSoftBrush" Color="#ECFDF5"/>

        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerRedSoftBrush" Color="#FEF2F2"/>

        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="WarningAmberSoftBrush" Color="#FFFBEB"/>

        <!-- ==================== SHADOW EFFECTS ==================== -->
        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="16"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.05"/>

        <DropShadowEffect x:Key="SidebarShadowEffect"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="0"
                          Color="#111827"
                          Opacity="0.04"/>

        <!-- ==================== SIDEBAR ITEM BUTTON STYLE (INACTIVE) ==================== -->
        <Style x:Key="SidebarItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="6,2,6,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ACTIVE SIDEBAR ITEM STYLE ==================== -->
        <Style x:Key="ActiveSidebarItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="8,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="6,2,6,2"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <!-- Left Active Accent Pill Bar -->
                                <Border Width="3.5"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource OdooPurpleBrush}"
                                        CornerRadius="1.75"/>
                                <!-- Item Content -->
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBDCE6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3D1DD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== TOGGLE BAR BUTTON STYLE ==================== -->
        <Style x:Key="SidebarToggleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleStrip"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border x:Name="GripPill"
                                    Width="18"
                                    Height="54"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleStrip" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="GripPill" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                <Setter TargetName="GripPill" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GripPill" Property="Background" Value="#E3D1DD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ODOO TAB BUTTON STYLES ==================== -->
        <Style x:Key="OdooTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="BottomAccent"
                                        Height="3"
                                        Background="Transparent"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooActiveTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border Height="3"
                                        Background="{StaticResource OdooPurpleBrush}"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FAF5F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F3ECF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== FORM INPUT FIELD CONTAINER STYLE ==================== -->
        <Style x:Key="SettingsInputBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button (Purple) -->
        <Style x:Key="OdooPrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button (Teal) -->
        <Style x:Key="OdooTealActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooTealBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooTealHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ==================== MAIN APPLICATION SHELL ROOT ==================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Collapsible Navigation Shell -->
            <ColumnDefinition Width="Auto"/>
            <!-- Column 1: Main Content Workspace -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. COLLAPSIBLE LEFT SIDEBAR (KEEP USERS AND SETTINGS ONLY)              -->
        <!-- ======================================================================= -->
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Navigation Content Column -->
                <ColumnDefinition x:Name="SidebarMenuColumn" Width="180"/>
                <!-- Column 1: Slim, Touch-Friendly Collapse/Expand Toggle Bar (|<) -->
                <ColumnDefinition Width="22"/>
            </Grid.ColumnDefinitions>

            <!-- NAVIGATION CONTENT (USERS & SETTINGS ONLY) -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Effect="{StaticResource SidebarShadowEffect}">
                <Grid Margin="0,16,0,16">
                    <Grid.RowDefinitions>
                        <!-- Top Navigation Items (Users & Settings) -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Action (Logout) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- ==================== USERS ITEM ==================== -->
                        <Button x:Name="NavUsersBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavUsers_Click"
                                ToolTip="Users Management">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="6" Canvas.Top="3" Width="6" Height="6"
                                                 Stroke="{StaticResource OdooPurpleBrush}"
                                                 StrokeThickness="1.8"/>
                                        <Path Data="M 2,19 C 2,15 5,13 9,13 C 13,13 16,15 16,19"
                                              Stroke="{StaticResource OdooPurpleBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="15" Canvas.Top="5" Width="4.5" Height="4.5"
                                                 Stroke="{StaticResource OdooTealBrush}"
                                                 StrokeThickness="1.6"/>
                                        <Path Data="M 15.5,14 C 18,14.5 20.5,16 21,19"
                                              Stroke="{StaticResource OdooTealBrush}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="UsersLabel"
                                           Text="Users"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ==================== PRODUCTS ITEM ==================== -->
                        <Button x:Name="NavProductsBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavProducts_Click"
                                ToolTip="Products"
                                Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 L 21,7 L 12,12 L 3,7 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 3,7 L 12,12 L 12,22 L 3,17 Z" Fill="{StaticResource OdooPurpleBrush}" Opacity="0.85"/>
                                        <Path Data="M 12,12 L 21,7 L 21,17 L 12,22 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="ProductsLabel"
                                           Text="Products"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ==================== COMBO CHOICES ITEM ==================== -->
                        <Button x:Name="NavCombosBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavCombos_Click"
                                ToolTip="Combo Choices"
                                Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 4,8 C 4,5 7.5,3 12,3 C 16.5,3 20,5 20,8 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 3,11 H 21" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M 4,15 C 4,18 7.5,20 12,20 C 16.5,20 20,18 20,15 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                        <Ellipse Canvas.Left="15" Canvas.Top="8" Width="4" Height="4" Fill="{StaticResource ActiveGreenBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="CombosLabel"
                                           Text="Combo Choices"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ==================== POS CATEGORIES ITEM ==================== -->
                        <Button x:Name="NavCategoriesBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavCategories_Click"
                                ToolTip="PoS Product Categories"
                                Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <!-- Category tag / layers shape in Odoo Teal and Purple -->
                                        <Path Data="M 12,2 L 2,7 L 12,12 L 22,7 L 12,2 Z"
                                              Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 2,12 L 12,17 L 22,12 M 2,17 L 12,22 L 22,17"
                                              Stroke="{StaticResource OdooPurpleBrush}"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="CategoriesLabel"
                                           Text="PoS Categories"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ==================== ATTRIBUTES ITEM ==================== -->
                        <Button x:Name="NavAttributesBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavAttributes_Click"
                                ToolTip="Product Attributes"
                                Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18"
                                              Stroke="{StaticResource OdooTealBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="7" Canvas.Top="4" Width="4" Height="4" Fill="{StaticResource OdooPurpleBrush}"/>
                                        <Ellipse Canvas.Left="15" Canvas.Top="10" Width="4" Height="4" Fill="{StaticResource OdooPurpleBrush}"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="16" Width="4" Height="4" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="AttributesLabel"
                                           Text="Attributes"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ==================== PRODUCT TAGS ITEM ==================== -->
                        <Button x:Name="NavProductTagsBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavProductTags_Click"
                                ToolTip="Product Tags"
                                Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 19.5,12.5 L 12.5,19.5 C 11.7,20.3 10.4,20.3 9.6,19.5 L 3.5,13.4 C 3.2,13.1 3,12.6 3,12.2 L 3,5 C 3,3.9 3.9,3 5,3 L 12.2,3 C 12.6,3 13.1,3.2 13.4,3.5 L 19.5,9.6 C 20.3,10.4 20.3,11.7 19.5,12.5 Z"
                                              Stroke="{StaticResource OdooPurpleBrush}"
                                              StrokeThickness="1.8"
                                              Fill="{StaticResource OdooTealSoftBrush}"/>
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="3" Height="3" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="ProductTagsLabel"
                                           Text="Product Tags"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ==================== SETTINGS (CONFIGURATION) ITEM ==================== -->
                        <Button x:Name="NavSettingsBtn"
                                Style="{StaticResource ActiveSidebarItemButtonStyle}"
                                Click="NavSettings_Click"
                                ToolTip="Settings &amp; Configuration">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="11" Height="11"
                                                 Stroke="{StaticResource OdooPurpleBrush}"
                                                 StrokeThickness="2"/>
                                        <Path Data="M 12,2 L 12,5 M 12,19 L 12,22 M 2,12 L 5,12 M 19,12 L 22,12 M 4.9,4.9 L 7.1,7.1 M 16.9,16.9 L 19.1,19.1 M 4.9,19.1 L 7.1,16.9 M 16.9,7.1 L 19.1,4.9"
                                              Stroke="{StaticResource OdooTealBrush}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4"
                                                 Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="SettingsLabel"
                                           Text="Settings"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ==================== BOTTOM: LOGOUT ITEM ==================== -->
                    <Button Grid.Row="1"
                            x:Name="NavLogoutBtn"
                            Style="{StaticResource SidebarItemButtonStyle}"
                            Click="LogoutItem_Click"
                            ToolTip="Log out of current session">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 10,4 L 4,4 L 4,20 L 10,20"
                                          Stroke="{StaticResource OdooPurpleBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"/>
                                    <Path Data="M 9,12 L 20,12 M 16,8 L 20,12 L 16,16"
                                          Stroke="{StaticResource DangerRedBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="LogoutLabel"
                                       Text="Logout"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource DangerRedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== SLIM TOGGLE BAR (|<) ==================== -->
            <Border Grid.Column="1"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Button x:Name="SidebarToggleButton"
                        Style="{StaticResource SidebarToggleBarButtonStyle}"
                        Click="SidebarToggle_Click"
                        ToolTip="Toggle Navigation Sidebar (|&lt;)">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ToggleIconPath"
                                  Data="M 6,4 L 6,20 M 18,4 L 10,12 L 18,20"
                                  Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="2.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="ToggleIconScale" ScaleX="1"/>
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Border>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 2. MAIN CONTENT AREA (SWITCHES BETWEEN CONFIGURATION AND USERS)         -->
        <!-- ======================================================================= -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <!-- ==================== VIEW A: SETTINGS (CONFIGURATION) VIEW ==================== -->
            <Grid x:Name="SettingsViewPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Row 0: Page Header with Bold Title & Subtle Divider -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Horizontal Tab Bar Strip -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Content Area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. PAGE HEADER -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceCardBrush}"
                        Padding="32,24,32,0">
                    <StackPanel>
                        <TextBlock Text="Configuration"
                                   FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Margin="0,0,0,18"/>
                        <!-- Subtle divider line directly below header -->
                        <Border Height="1"
                                Background="{StaticResource SubtleBorderBrush}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- 2. HORIZONTAL TAB BAR STRIP -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="32,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 1: General (active, bold bottom accent line) -->
                        <Button x:Name="TabGeneral"
                                Style="{StaticResource OdooActiveTabButtonStyle}"
                                Content="General"
                                Click="TabButton_Click"
                                Tag="General"/>

                        <!-- Tab 2: Locale -->
                        <Button x:Name="TabLocale"
                                Style="{StaticResource OdooTabButtonStyle}"
                                Content="Locale"
                                Click="TabButton_Click"
                                Tag="Locale"/>

                        <!-- Tab 3: Payment Method -->
                        <Button x:Name="TabPaymentMethod"
                                Style="{StaticResource OdooTabButtonStyle}"
                                Content="Payment Method"
                                Click="TabButton_Click"
                                Tag="PaymentMethod"/>

                        <!-- Tab 4: Peripherals -->
                        <Button x:Name="TabPeripherals"
                                Style="{StaticResource OdooTabButtonStyle}"
                                Content="Peripherals"
                                Click="TabButton_Click"
                                Tag="Peripherals"/>

                        <!-- Tab 5: System Options -->
                        <Button x:Name="TabSystemOptions"
                                Style="{StaticResource OdooTabButtonStyle}"
                                Content="System Options"
                                Click="TabButton_Click"
                                Tag="SystemOptions"/>
                    </StackPanel>
                </Border>

                <!-- 3. CONFIGURATION TAB CONTENT BODY -->
                <Grid Grid.Row="2">
                    <!-- GENERAL TAB PANEL (ODOO CONNECTION + SYNCHRONIZATION) -->
                    <ScrollViewer x:Name="GeneralSettingsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="32,24,32,32">
                        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

                            <!-- ===================================================== -->
                            <!-- CARD 1: ODOO SERVER CONNECTION SETTINGS               -->
                            <!-- ===================================================== -->
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="28,24"
                                    Effect="{StaticResource CardShadowEffect}"
                                    Margin="0,0,0,24">
                                <StackPanel>
                                    <!-- Card Header -->
                                    <Grid Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="40" Height="40"
                                                    CornerRadius="20"
                                                    Background="{StaticResource OdooPurpleSoftBrush}"
                                                    Margin="0,0,14,0">
                                                <Viewbox Width="20" Height="20">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z"
                                                              Stroke="{StaticResource OdooPurpleBrush}"
                                                              StrokeThickness="1.8"
                                                              Fill="{StaticResource OdooPurpleSoftBrush}"/>
                                                        <Path Data="M 9,13 L 12,10 L 15,13 M 12,10 L 12,17"
                                                              Stroke="{StaticResource OdooTealBrush}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Odoo Server Connection"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Configure external Odoo instance credentials for POS master data synchronization."
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider Line -->
                                    <Border Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,0,0,20"/>

                                    <!-- Connection Form Inputs (2x2 Grid) -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0, Col 0: Server URL -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Server URL"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Margin="0,0,0,6"/>
                                            <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                <TextBox x:Name="CfgServerUrlTextBox"
                                                         Text="https://demo.odoo.com"
                                                         VerticalAlignment="Center"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="14"
                                                         Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Row 0, Col 2: Database Name -->
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Database Name"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Margin="0,0,0,6"/>
                                            <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                <TextBox x:Name="CfgDatabaseTextBox"
                                                         Text="demo"
                                                         VerticalAlignment="Center"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="14"
                                                         Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Row 2, Col 0: Username / Email -->
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Username / Email"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Margin="0,0,0,6"/>
                                            <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                <TextBox x:Name="CfgUsernameTextBox"
                                                         Text="admin"
                                                         VerticalAlignment="Center"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="14"
                                                         Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Row 2, Col 2: Password / API Key (Masked with Show/Hide Toggle) -->
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Password / API Key"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Margin="0,0,0,6"/>
                                            <Border Style="{StaticResource SettingsInputBoxStyle}">
                                                <Grid>
                                                    <PasswordBox x:Name="CfgPasswordMasked"
                                                                 PasswordChar="●"
                                                                 FontSize="14"
                                                                 VerticalAlignment="Center"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Margin="0,0,36,0"/>
                                                    <TextBox x:Name="CfgPasswordRevealed"
                                                             FontSize="14"
                                                             VerticalAlignment="Center"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Visibility="Collapsed"
                                                             Margin="0,0,36,0"/>
                                                    <Button x:Name="TogglePasswordViewBtn"
                                                            Click="TogglePasswordView_Click"
                                                            Width="32" Height="32"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Show / Hide Password">
                                                        <Viewbox Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path x:Name="EyeIconPath"
                                                                      Data="M 1,12 C 1,12 5,4 12,4 C 19,4 23,12 23,12 C 23,12 19,20 12,20 C 5,20 1,12 1,12 Z"
                                                                      Stroke="{StaticResource SecondaryTextBrush}"
                                                                      StrokeThickness="2"
                                                                      Fill="Transparent"/>
                                                                <Ellipse x:Name="EyePupil"
                                                                         Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                                                         Fill="{StaticResource SecondaryTextBrush}"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Actions & Status Indicator -->
                                    <Border Background="#F9FAFB"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Action Buttons: Save & Test Connection -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Save Button (Primary Purple) -->
                                                <Button x:Name="SaveConnectionBtn"
                                                        Style="{StaticResource OdooPrimaryActionButtonStyle}"
                                                        Click="SaveConnectionBtn_Click"
                                                        Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M 17,3 L 5,3 C 3.89,3 3,3.9 3,5 L 3,19 C 3,20.1 3.89,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,7 L 17,3 Z M 12,19 C 10.34,19 9,17.66 9,16 C 9,14.34 10.34,13 12,13 C 13.66,13 15,14.34 15,16 C 15,17.66 13.66,19 12,19 Z M 6,6 L 15,6 L 15,9 L 6,9 L 6,6 Z"
                                                                      Fill="#FFFFFF"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Test Connection Button (Secondary Teal) -->
                                                <Button x:Name="TestConnectionBtn"
                                                        Style="{StaticResource OdooTealActionButtonStyle}"
                                                        Click="TestConnectionBtn_Click"
                                                        Margin="0,0,18,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 M 12,6 L 12,12 L 16,14"
                                                                      Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Status Badge & Loading Indicator -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <!-- Loading Spinner during Verification -->
                                                <ProgressBar x:Name="TestConnectionProgressBar"
                                                             IsIndeterminate="True"
                                                             Width="70" Height="4"
                                                             Visibility="Collapsed"
                                                             Margin="0,0,12,0"/>

                                                <!-- Status Badge Container -->
                                                <Border Background="#FFFFFF"
                                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="16"
                                                        Padding="12,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Status Dot Indicator (Green / Red / Gray) -->
                                                        <Ellipse x:Name="ConnectionStatusDot"
                                                                 Width="9" Height="9"
                                                                 Fill="{StaticResource MutedTextBrush}"
                                                                 Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="ConnectionStatusText"
                                                                   Text="Not Tested"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ===================================================== -->
                            <!-- CARD 2: USER SYNCHRONIZATION SECTION                  -->
                            <!-- ===================================================== -->
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="28,24"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <!-- Section Header -->
                                    <Grid Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="40" Height="40"
                                                    CornerRadius="20"
                                                    Background="{StaticResource OdooTealSoftBrush}"
                                                    Margin="0,0,14,0">
                                                <Viewbox Width="20" Height="20">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z"
                                                              Fill="{StaticResource OdooTealBrush}"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z"
                                                              Fill="{StaticResource OdooPurpleBrush}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="User Synchronization"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Pull users from Odoo's res.users model and upsert them into local SQLite database."
                                                           FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider Line -->
                                    <Border Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,0,0,20"/>

                                    <!-- Sync Controls & Progress -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sync Users Now Button with Loading Spinner Support -->
                                        <Button Grid.Column="0"
                                                x:Name="SyncUsersNowBtn"
                                                Style="{StaticResource OdooPrimaryActionButtonStyle}"
                                                Click="SyncUsersNowBtn_Click"
                                                Height="44"
                                                Padding="22,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox x:Name="SettingsSyncIconBox" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="SettingsSyncIconRotation" Angle="0"/>
                                                    </Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z"
                                                              Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z"
                                                              Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsSyncButtonText" Text="Sync Users Now" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Progress & Sync Status Details -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Last Synced Date & Time Status Text -->
                                                <TextBlock x:Name="LastSyncedStatusText"
                                                           Text="Last Synced: Never"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>

                                                <!-- Sync Progress Bar -->
                                                <ProgressBar x:Name="SyncProgressBar"
                                                             IsIndeterminate="True"
                                                             Width="140" Height="4"
                                                             Visibility="Collapsed"
                                                             Margin="16,0,0,0"/>
                                            </StackPanel>

                                            <!-- Detail feedback / summary message -->
                                            <TextBlock x:Name="SyncDetailText"
                                                       Text="Click 'Sync Users Now' to fetch and upsert users from Odoo."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider between Users and Categories sync -->
                                    <Border Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,18,0,18"/>

                                    <!-- Sync Categories Controls & Progress -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sync Categories Now Button (Secondary Teal Action Button) -->
                                        <Button Grid.Column="0"
                                                x:Name="SyncCategoriesNowBtn"
                                                Style="{StaticResource OdooTealActionButtonStyle}"
                                                Click="SyncCategoriesNowBtn_Click"
                                                Height="44"
                                                Padding="22,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox x:Name="SettingsCatSyncIconBox" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="SettingsCatSyncIconRotation" Angle="0"/>
                                                    </Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,2 L 2,7 L 12,12 L 22,7 L 12,2 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 2,12 L 12,17 L 22,12 M 2,17 L 12,22 L 22,17" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsCatSyncButtonText" Text="Sync Categories Now" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Progress & Categories Sync Status Details -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Last Categories Synced Date & Time Status Text -->
                                                <TextBlock x:Name="LastCategoriesSyncedStatusText"
                                                           Text="Last Synced: Never"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>

                                                <!-- Categories Sync Progress Bar -->
                                                <ProgressBar x:Name="CategoriesSyncProgressBar"
                                                             IsIndeterminate="True"
                                                             Width="140" Height="4"
                                                             Visibility="Collapsed"
                                                             Margin="16,0,0,0"/>
                                            </StackPanel>

                                            <!-- Detail feedback / summary message -->
                                            <TextBlock x:Name="CategoriesSyncDetailText"
                                                       Text="Click 'Sync Categories Now' to fetch and upsert pos.category from Odoo."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================== CARD 4: PRODUCT ATTRIBUTES SYNCHRONIZATION ==================== -->
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="28,24"
                                    Margin="0,0,0,24"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource OdooPurpleSoftBrush}" Margin="0,0,16,0">
                                            <Viewbox Width="20" Height="20">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Ellipse Canvas.Left="7" Canvas.Top="4" Width="4" Height="4" Fill="{StaticResource OdooTealBrush}"/>
                                                    <Ellipse Canvas.Left="15" Canvas.Top="10" Width="4" Height="4" Fill="{StaticResource OdooTealBrush}"/>
                                                    <Ellipse Canvas.Left="10" Canvas.Top="16" Width="4" Height="4" Fill="{StaticResource OdooTealBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Product Attributes Synchronization" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Fetch attributes and attribute values from Odoo (product.attribute &amp; product.attribute.value)." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                x:Name="SyncAttributesNowBtn"
                                                Style="{StaticResource OdooPrimaryActionButtonStyle}"
                                                Click="SyncAttributesNowBtn_Click"
                                                Height="44"
                                                Padding="22,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox x:Name="SettingsAttrSyncIconBox" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="SettingsAttrSyncIconRotation" Angle="0"/>
                                                    </Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsAttrSyncButtonText" Text="Sync Attributes Now" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastAttributesSyncedStatusText"
                                                           Text="Last Synced: Never"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <ProgressBar x:Name="AttributesSyncProgressBar"
                                                             IsIndeterminate="True"
                                                             Width="140" Height="4"
                                                             Visibility="Collapsed"
                                                             Margin="16,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AttributesSyncDetailText"
                                                       Text="Click 'Sync Attributes Now' to fetch product.attribute and values from Odoo."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================== CARD 5: PRODUCT TAGS SYNCHRONIZATION ==================== -->
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="28,24"
                                    Margin="0,0,0,24"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource OdooTealSoftBrush}" Margin="0,0,16,0">
                                            <Viewbox Width="20" Height="20">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 19.5,12.5 L 12.5,19.5 C 11.7,20.3 10.4,20.3 9.6,19.5 L 3.5,13.4 C 3.2,13.1 3,12.6 3,12.2 L 3,5 C 3,3.9 3.9,3 5,3 L 12.2,3 C 12.6,3 13.1,3.2 13.4,3.5 L 19.5,9.6 C 20.3,10.4 20.3,11.7 19.5,12.5 Z"
                                                          Stroke="{StaticResource OdooTealBrush}"
                                                          StrokeThickness="1.8"
                                                          Fill="Transparent"/>
                                                    <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="3" Height="3" Fill="{StaticResource OdooTealBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Product Tags Synchronization" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Fetch product tags from Odoo's product.tag model and upsert them locally." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                x:Name="SyncTagsNowBtn"
                                                Style="{StaticResource OdooTealActionButtonStyle}"
                                                Click="SyncTagsNowBtn_Click"
                                                Height="44"
                                                Padding="22,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox x:Name="SettingsTagSyncIconBox" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="SettingsTagSyncIconRotation" Angle="0"/>
                                                    </Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsTagSyncButtonText" Text="Sync Tags Now" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastTagsSyncedStatusText"
                                                           Text="Last Synced: Never"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <ProgressBar x:Name="TagsSyncProgressBar"
                                                             IsIndeterminate="True"
                                                             Width="140" Height="4"
                                                             Visibility="Collapsed"
                                                             Margin="16,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TagsSyncDetailText"
                                                       Text="Click 'Sync Tags Now' to fetch product.tag records from Odoo."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 6. PRODUCTS SYNCHRONIZATION CARD -->
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24"
                                    Margin="0,0,0,20"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource OdooPurpleSoftBrush}" Margin="0,0,12,0">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 12,2 L 21,7 L 12,12 L 3,7 Z" Fill="{StaticResource OdooTealBrush}"/>
                                                    <Path Data="M 3,7 L 12,12 L 12,22 L 3,17 Z" Fill="{StaticResource OdooPurpleBrush}" Opacity="0.85"/>
                                                    <Path Data="M 12,12 L 21,7 L 21,17 L 12,22 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Products Synchronization"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Pull product templates and variants (product.template) into local SQLite database."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                x:Name="SyncProductsNowBtn"
                                                Style="{StaticResource OdooPrimaryActionButtonStyle}"
                                                Click="SyncProductsNowBtn_Click"
                                                Height="44"
                                                Padding="22,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox x:Name="SettingsProdSyncIconBox" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="SettingsProdSyncIconRotation" Angle="0"/>
                                                    </Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsProdSyncButtonText" Text="Sync Products Now" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastProductsSyncedStatusText"
                                                           Text="Last Synced: Never"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <ProgressBar x:Name="ProductsSyncProgressBar"
                                                             IsIndeterminate="True"
                                                             Width="140" Height="4"
                                                             Visibility="Collapsed"
                                                             Margin="16,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ProductsSyncDetailText"
                                                       Text="Click 'Sync Products Now' to fetch product.template records from Odoo."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 7. COMBO CHOICES SYNCHRONIZATION CARD -->
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24"
                                    Margin="0,0,0,24"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource OdooTealSoftBrush}" Margin="0,0,12,0">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 4,8 C 4,5 7.5,3 12,3 C 16.5,3 20,5 20,8 Z" Fill="{StaticResource OdooTealBrush}"/>
                                                    <Path Data="M 3,11 H 21" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Path Data="M 4,15 C 4,18 7.5,20 12,20 C 16.5,20 20,18 20,15 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Combo Choices Synchronization"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Pull pos.combo and pos.combo.line records from Odoo into local SQLite database."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                x:Name="SyncCombosNowBtn"
                                                Style="{StaticResource OdooTealActionButtonStyle}"
                                                Click="SyncCombosNowBtn_Click"
                                                Height="44"
                                                Padding="22,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox x:Name="SettingsComboSyncIconBox" Width="16" Height="16" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform>
                                                        <RotateTransform x:Name="SettingsComboSyncIconRotation" Angle="0"/>
                                                    </Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsComboSyncButtonText" Text="Sync Combos Now" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastCombosSyncedStatusText"
                                                           Text="Last Synced: Never"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <ProgressBar x:Name="CombosSyncProgressBar"
                                                             IsIndeterminate="True"
                                                             Width="140" Height="4"
                                                             Visibility="Collapsed"
                                                             Margin="16,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CombosSyncDetailText"
                                                       Text="Click 'Sync Combos Now' to fetch pos.combo and pos.combo.line records from Odoo."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- CLEAN EMPTY CONTAINER FOR OTHER TABS (LOCALE, PAYMENT, PERIPHERALS, SYSTEM OPTIONS) -->
                    <Border x:Name="OtherTabsEmptyContainer"
                            Visibility="Collapsed"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="32,24,32,32"
                            Effect="{StaticResource CardShadowEffect}">
                        <!-- Intentionally blank surface container for subsequent steps -->
                        <Grid x:Name="EmptySettingsContentContainer">
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== VIEW B: USERS MANAGEMENT VIEW ==================== -->
            <local:UserManagementView x:Name="UsersViewControl"
                                      Visibility="Collapsed"/>

            <!-- ==================== VIEW C: POS CATEGORIES MANAGEMENT VIEW ==================== -->
            <local:PosCategoryManagementView x:Name="CategoriesViewControl"
                                             Visibility="Collapsed"/>

            <!-- ==================== VIEW D: ATTRIBUTES MANAGEMENT VIEW ==================== -->
            <local:ProductAttributeManagementView x:Name="AttributesViewControl"
                                                  Visibility="Collapsed"/>

            <!-- ==================== VIEW E: PRODUCT TAGS MANAGEMENT VIEW ==================== -->
            <local:ProductTagManagementView x:Name="TagsViewControl"
                                            Visibility="Collapsed"/>

            <!-- ==================== VIEW F: PRODUCTS MANAGEMENT VIEW ==================== -->
            <local:ProductManagementView x:Name="ProductsViewControl"
                                         Visibility="Collapsed"/>

            <!-- ==================== VIEW G: COMBO CHOICES MANAGEMENT VIEW ==================== -->
            <local:ComboChoiceManagementView x:Name="ComboChoicesViewControl"
                                             Visibility="Collapsed"/>

            <!-- ==================== TOAST BANNER NOTIFICATION ==================== -->
            <Border x:Name="ShellToastBanner"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,32"
                    Background="{StaticResource PrimaryTextBrush}"
                    CornerRadius="8"
                    Padding="20,12"
                    Effect="{StaticResource CardShadowEffect}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ShellToastDot" Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ShellToastMessageText"
                               Text="Settings saved successfully."
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
