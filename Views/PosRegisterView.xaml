                                   FontSize="104"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding PaymentDecimalPart}"
                                   FontSize="72"
                                   FontWeight="Normal"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 5. PAYMENT CONFIRMATION SCREEN ("Amount Paid", Screenshot 8)            -->
