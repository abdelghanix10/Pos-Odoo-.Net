<UserControl x:Class="OdooPosLogin.PosDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1080" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:PosDashboardViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="PopoverMenuLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. COMPACT TOP CONTROL BAR (50px) -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title + Quick Sync Menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Point of Sale"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>

                    <Button x:Name="HeaderActionsMenuBtn"
                            Style="{StaticResource PosGhostButton}"
                            Width="28" Height="28" Padding="0"
                            Margin="6,0,0,0"
                            Click="HeaderActionsMenuBtn_Click"
                            ToolTip="Actions">
                        <TextBlock Text="⋮" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <Button.ContextMenu>
                            <ContextMenu Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" Padding="4">
                                <MenuItem Header="↻  Sync Shops from Odoo" Command="{Binding SyncFromOdooCommand}" FontSize="13"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- Center: Compact Search -->
                <Border Grid.Column="1"
                        Width="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource PosSearchBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#64748B" StrokeThickness="2"/>
                                <Path Data="M 14,14 L 20,20" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Grid.Column="1"
                                   Text="Search POS shops..."
                                   FontSize="12.5"
                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12.5"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0"
                                Visibility="{Binding SearchText, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}">
                            <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right: Counter + View Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListCounterText}"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Button Command="{Binding SwitchToKanbanCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="Kanban">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKanbanView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Viewbox Width="12" Height="12">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" Fill="{StaticResource PrimaryTextBrush}"/>
                                <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="10" Fill="{StaticResource PrimaryTextBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Command="{Binding SwitchToListCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="List">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,1,1,1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Viewbox Width="12" Height="12">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. DASHBOARD KANBAN & LIST WORKSPACE -->
        <Grid Grid.Row="1">
            <!-- KANBAN VIEW (Compact 222px Cards — Fits 2 Full Rows on 720p) -->
            <ScrollViewer Visibility="{Binding IsKanbanView, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10,10">
                <ItemsControl ItemsSource="{Binding FilteredConfigs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PosConfigRecord}">
                            <Border Height="222"
                                    Margin="5"
                                    Style="{StaticResource PosCardBorderStyle}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="72"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header -->
                                    <Grid Grid.Row="0" Margin="14,12,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Background="{Binding StatusBadgeBackground}"
                                                CornerRadius="8"
                                                Padding="8,2"
                                                Margin="6,0,6,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding StatusBadgeVisibility}">
                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                       Foreground="{Binding StatusBadgeForeground}"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"/>
                                        </Border>

                                        <!-- ⋮ Card Popover Menu -->
                                        <Grid Grid.Column="2">
                                            <ToggleButton x:Name="CardMenuToggle" Width="26" Height="26" Cursor="Hand" ToolTip="More Options">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="TglBdr" Background="Transparent" CornerRadius="6">
                                                            <TextBlock Text="⋮" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TglBdr" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="TglBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <Popup IsOpen="{Binding IsChecked, ElementName=CardMenuToggle, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=CardMenuToggle}"
                                                   Placement="Bottom"
                                                   HorizontalOffset="-140"
                                                   VerticalOffset="2"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Width="172"
                                                        Margin="6"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="6"
                                                        Effect="{StaticResource PosFloatingShadow}">
                                                    <StackPanel>
                                                        <TextBlock Text="VIEW" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,4,0,4"/>
                                                        <Button Style="{StaticResource PopoverMenuLinkStyle}" Content="Orders" Click="PopoverViewOrders_Click"/>
                                                        <Button Style="{StaticResource PopoverMenuLinkStyle}" Content="Sessions" Click="PopoverViewSessions_Click"/>
                                                        <Button Style="{StaticResource PopoverMenuLinkStyle}" Content="Payments" Click="PopoverViewPayments_Click"/>
                                                        <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="4,6"/>
                                                        <Button Style="{StaticResource PopoverMenuLinkStyle}" Content="⚙  Configure" Click="PopoverConfigure_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Grid>

                                    <!-- Card Body: Action CTA + Compact Metrics -->
                                    <Grid Grid.Row="1" Margin="14,10,14,0" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Button Style="{StaticResource PosPrimaryButton}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    FontSize="12.5"
                                                    Content="{Binding PrimaryActionButtonText}"
                                                    Click="ShopActionButton_Click"/>

                                            <Border Width="24" Height="24"
                                                    CornerRadius="6"
                                                    Background="{StaticResource OdooPurpleSoftBrush}"
                                                    Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    ClipToBounds="True"
                                                    ToolTip="{Binding ActiveUserName}"
                                                    Visibility="{Binding HasActiveUser, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                <Grid>
                                                    <Image Source="{Binding ActiveUserAvatarBitmap}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasActiveUserAvatar, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                    <TextBlock Text="{Binding ActiveUserInitials}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasActiveUserAvatar, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Grid Visibility="{Binding ClosedMetricsVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Closing" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastClosingDateDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Balance" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastClosingBalanceDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Visibility="{Binding OpeningControlMetricsVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Opening" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding OpeningBalanceDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Visibility="{Binding ToCloseMetricsVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveSessionDateDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Opening" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OpeningBalanceDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Card Footer: 7-Day Sales Sparkline -->
                                    <Border Grid.Row="2" Height="72" VerticalAlignment="Bottom">
                                        <Viewbox Stretch="Fill" Height="72" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                            <Canvas Width="300" Height="80">
                                                <Path Data="{Binding AreaGeometryString}" Visibility="{Binding SparklineAreaVisibility}" Fill="#1E6C4663"/>
                                                <Path Data="{Binding StrokeGeometryString}" Stroke="{Binding SparklineStrokeBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                <Path Data="{Binding MarkerGeometryString}" Fill="{Binding SparklineMarkerBrush}"/>

                                                <ItemsControl ItemsSource="{Binding SparklinePoints}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Width="300" Height="80"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="0"/>
                                                            <Setter Property="Canvas.Top" Value="0"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:SparklineDataPoint}">
                                                            <Canvas Width="300" Height="80">
                                                                <Ellipse x:Name="HitTarget" Canvas.Left="{Binding CanvasLeft}" Canvas.Top="{Binding CanvasTop}" Width="24" Height="24" Fill="Transparent" Cursor="Hand"/>
                                                                <Border Canvas.Left="{Binding TooltipLeft}" Canvas.Top="{Binding TooltipTop}" Panel.ZIndex="999" Background="#0F172A" CornerRadius="6" Padding="8,5" IsHitTestVisible="False"
                                                                        Visibility="{Binding IsMouseOver, ElementName=HitTarget, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding DateLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                        <TextBlock Text="{Binding ValueLabel}" FontSize="10.5" Foreground="#E2E8F0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Canvas>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- LIST VIEW -->
            <Border Visibility="{Binding IsListView, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Point of Sale" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Status" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Last Closing" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Balance" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredConfigs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosConfigRecord}">
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="18,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentSessionState}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LastClosingDateDisplay}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LastClosingBalanceDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4" Style="{StaticResource PosPrimaryButton}" Height="30" Padding="12,0" FontSize="12.5" Content="{Binding PrimaryActionButtonText}" Click="ShopActionButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- EMPTY STATE -->
            <Border Style="{StaticResource PosCardBorderStyle}"
                    Padding="28,24"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmptyStateVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No Point of Sale Shops Synchronized" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Sync your POS configurations, products, categories, and sessions from Odoo to begin." FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Button Style="{StaticResource PosPrimaryButton}" Command="{Binding SyncFromOdooCommand}" HorizontalAlignment="Center" Content="Sync POS Shops from Odoo"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast Banner -->
        <Border Grid.Row="1"
                Style="{StaticResource PosToastBorderStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource ActiveGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Warning">
                                    <Setter Property="Fill" Value="{StaticResource WarningAmberBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Error">
                                    <Setter Property="Fill" Value="{StaticResource DangerRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ToastMessage}" FontSize="13" FontWeight="Medium" Foreground="#FFFFFF"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>