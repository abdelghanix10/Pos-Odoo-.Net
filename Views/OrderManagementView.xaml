<UserControl x:Class="OdooPosLogin.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1084" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:OrdersViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="OdooNotebookTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,-1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. COMPACT PRIMARY HEADER BAR (48px)                                    -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Sync Button + Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PosPrimaryButton}"
                            Height="32"
                            Command="{Binding SyncOrdersCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CloseDetailCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText" Text="Orders" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                        <TextBlock Text="  /  " FontSize="15.5" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding SelectedOrder.Name}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Counter + Pager + List/Kanban Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListCounterText}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding PagerText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding PreviousRecordCommand}" IsEnabled="{Binding HasPreviousRecord}" Margin="0,0,2,0" ToolTip="Previous">
                        <Viewbox Width="7" Height="11">
                            <Path Data="M 7,1 L 1.5,6.5 L 7,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding NextRecordCommand}" IsEnabled="{Binding HasNextRecord}" Margin="0,0,10,0" ToolTip="Next">
                        <Viewbox Width="7" Height="11">
                            <Path Data="M 1.5,1 L 7,6.5 L 1.5,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button Command="{Binding SwitchToListCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="List">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24"><Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/></Canvas>
                            </Viewbox>
                        </Button>

                        <Button Command="{Binding SwitchToKanbanCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="Kanban">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,1,1,1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKanbanView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" Fill="{StaticResource PrimaryTextBrush}"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="10" Fill="{StaticResource PrimaryTextBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. WRAPPING FILTER BAR (Never Overflows at 1280px)                      -->
        <!-- ======================================================================= -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceSubtleBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,7"
                Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search -->
                <Border Width="220" Style="{StaticResource PosSearchBorderStyle}" Background="#FFFFFF" Margin="0,2,8,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="12" Height="12" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#64748B" StrokeThickness="2"/>
                                <Path Data="M 14,14 L 20,20" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="Search orders..." Foreground="{StaticResource PlaceholderTextBrush}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0">
                            <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Shop Filter -->
                <ComboBox ItemsSource="{Binding AvailableShops}" SelectedItem="{Binding SelectedShopFilter, Mode=TwoWay}"
                          Style="{StaticResource OdooFilterComboBoxStyle}" Width="155" Margin="0,2,8,2" ToolTip="Filter by Point of Sale Shop"/>

                <!-- Searchable Session Autocomplete -->
                <Grid x:Name="SessionFilterRoot" Width="195" Height="32" Margin="0,2,8,2">
                    <Border x:Name="SessionFilterBorder" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SessionPlaceholderText}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                       Visibility="{Binding SessionSearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <TextBox x:Name="SessionSearchInput" Grid.Column="0" Text="{Binding SessionSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12" VerticalAlignment="Center"
                                     GotFocus="SessionTextBox_GotFocus" PreviewMouseDown="SessionTextBox_PreviewMouseDown" KeyDown="SessionTextBox_KeyDown"/>
                            <Button Grid.Column="1" Command="{Binding ClearSessionFilterCommand}" Visibility="{Binding IsSessionFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Padding="3,0" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ToggleSessionDropdownCommand}" Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand">
                                <TextBlock Text="▾" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Popup PlacementTarget="{Binding ElementName=SessionFilterBorder}" Placement="Bottom" IsOpen="{Binding IsSessionDropdownOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                        <Grid SnapsToDevicePixels="True" MinWidth="250" MaxWidth="310">
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3,4" Margin="0,3,0,6" Effect="{StaticResource PosFloatingShadow}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredSessionSuggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PosSessionSuggestionItem}">
                                                <Button Command="{Binding DataContext.SelectSessionSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding IsEmptyPlaceholder, Converter={StaticResource InverseBooleanConverter}}"
                                                        Background="Transparent" BorderThickness="0" Padding="8,5" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="SuggBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SuggBorder" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/></Trigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="SuggBorder" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/></DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center" Margin="6,0,2,0"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>

                <!-- Date Preset -->
                <ComboBox ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedDatePreset, Mode=TwoWay}"
                          Style="{StaticResource OdooFilterComboBoxStyle}" Width="125" Margin="0,2,8,2" ToolTip="Filter by Date"/>

                <!-- Custom Range Pickers -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomDateRange, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,2,8,2">
                    <TextBlock Text="From:" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Style="{StaticResource OdooFilterDatePickerStyle}" Width="110" Margin="0,0,6,0"/>
                    <TextBlock Text="To:" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Style="{StaticResource OdooFilterDatePickerStyle}" Width="110"/>
                </StackPanel>

                <!-- Reset Button -->
                <Button Command="{Binding ClearFiltersCommand}" Visibility="{Binding HasActiveFilter, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource OdooResetFilterButtonStyle}" Margin="0,2,0,2" Content="✕ Reset"/>
            </WrapPanel>
        </Border>

        <!-- ======================================================================= -->
        <!-- 3. WORKSPACE CONTENT (LIST / KANBAN / DETAIL)                           -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <!-- LIST VIEW -->
                <Border Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Order Ref" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Session" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Date" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Receipt #" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Order #" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Cashier" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="Total" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="7" Text="Status" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                        <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBdr" Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,7" MinHeight="38">
                                                        <Grid Opacity="{Binding IsCancelled, Converter={x:Static local:CancelledOpacityConverter.Instance}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2.1*"/>
                                                                <ColumnDefinition Width="1.6*"/>
                                                                <ColumnDefinition Width="1.4*"/>
                                                                <ColumnDefinition Width="1.4*"/>
                                                                <ColumnDefinition Width="1.3*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="96"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SessionName}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DateShortDisplay}" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PosReference}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding TrackingNumber}" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding CashierName}" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding TotalDisplay}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <Border Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding ListStatusBackground}" CornerRadius="9" Padding="9,2">
                                                                <TextBlock Text="{Binding StateDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding ListStatusForeground}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBdr" Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Grand Total Footer -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                            <Grid>
                                <TextBlock Text="Grand Total (Non-Cancelled)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GrandTotalText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- KANBAN VIEW -->
                <ScrollViewer Visibility="{Binding IsKanbanView, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Padding="10">
                    <ItemsControl ItemsSource="{Binding FilteredOrders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Margin="5" Width="336" Height="94" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder" Style="{StaticResource PosCardBorderStyle}" Padding="14,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                                                        <TextBlock Text="{Binding TotalDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding PosReference}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding DateShortDisplay}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{Binding KanbanStatusBackground}" CornerRadius="9" Padding="9,2">
                                                            <TextBlock Text="{Binding StateDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding KanbanStatusForeground}"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <Border Style="{StaticResource PosCardBorderStyle}" Padding="28,24" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Orders Found" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Adjust your filters or sync POS orders from Odoo." FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource PosPrimaryButton}" Command="{Binding SyncOrdersCommand}" Content="Sync Orders from Odoo" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DETAIL VIEW -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">
                    <!-- Pipeline Bar -->
                    <Border Style="{StaticResource PosCardBorderStyle}" Padding="16,8" Margin="0,0,0,12">
                        <Grid>
                            <Border HorizontalAlignment="Right" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" Visibility="{Binding SelectedOrder.NormalPipelineVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}" Padding="12,4" CornerRadius="5">
                                        <TextBlock Text="New" FontSize="12.5" FontWeight="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageFontWeightConverter.Instance}}" Foreground="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                    </Border>
                                    <TextBlock Text="›" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="3,-1,3,0"/>
                                    <Border Background="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}" Padding="12,4" CornerRadius="5">
                                        <TextBlock Text="Paid" FontSize="12.5" FontWeight="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageFontWeightConverter.Instance}}" Foreground="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                    </Border>
                                    <TextBlock Text="›" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="3,-1,3,0"/>
                                    <Border Background="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}" Padding="12,4" CornerRadius="5">
                                        <TextBlock Text="Posted" FontSize="12.5" FontWeight="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageFontWeightConverter.Instance}}" Foreground="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border HorizontalAlignment="Right" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" Visibility="{Binding SelectedOrder.CancelledPipelineVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#FFFFFF" Padding="12,4" CornerRadius="5"><TextBlock Text="New" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}"/></Border>
                                    <TextBlock Text="›" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="3,-1,3,0"/>
                                    <Border Background="{StaticResource DangerRedSoftBrush}" Padding="12,4" CornerRadius="5"><TextBlock Text="Cancelled" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}"/></Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Main Order Sheet -->
                    <Border Style="{StaticResource PosCardBorderStyle}" Padding="24,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Point of Sale Order" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedOrder.Name}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" Command="{Binding OpenLinkedOrderCommand}" Visibility="{Binding SelectedOrder.LinkedRefundsVisibility}" Style="{StaticResource PosSecondaryButton}" Height="42" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↺" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedOrder.LinkedRefundCountDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                            <TextBlock Text="{Binding SelectedOrder.LinkedRefundSummary}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.DateDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fiscal Position" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.FiscalPosition}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>
                                    <Grid Visibility="{Binding SelectedOrder.LinkedRefundsVisibility}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SelectedOrder.LinkedRefundLabel}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedOrder.LinkedRefundOrders}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                                    <Button Command="{Binding DataContext.OpenLinkedOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Style="{StaticResource PosSecondaryButton}" Height="26" Padding="8,0" Margin="0,0,6,4" FontSize="11.5" Content="{Binding Name}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Served by" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource OdooPurpleSoftBrush}" Margin="0,0,8,0" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding SelectedOrder.CashierInitials}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedOrder.HasNoCashierAvatar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Image Source="{Binding SelectedOrder.CashierAvatarBitmap}" Stretch="UniformToFill" Visibility="{Binding SelectedOrder.HasCashierAvatar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedOrder.CashierName}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Session" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.SessionName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Edited" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedOrder.IsEdited}" IsEnabled="False" Style="{StaticResource PosCheckBoxStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Notebook Tabs -->
                            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Margin="-24,0,-24,16" Padding="24,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Products" Command="{Binding SelectTabCommand}" CommandParameter="Products">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProductsTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Payments" Command="{Binding SelectTabCommand}" CommandParameter="Payments">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaymentsTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Extra Info" Command="{Binding SelectTabCommand}" CommandParameter="ExtraInfo">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExtraInfoTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab 1: Products -->
                            <StackPanel Visibility="{Binding IsProductsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.8*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Product" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Qty" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="Unit Price" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="Disc.%" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="Taxes" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="Tax Excl." FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="Tax Incl." FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding SelectedOrder.Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2.8*"/>
                                                                <ColumnDefinition Width="0.9*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding QtyDisplay}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PriceUnitDisplay}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding DiscountDisplay}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="4" HorizontalAlignment="Center" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="8" Padding="7,1.5">
                                                                <TextBlock Text="{Binding Taxes}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="5" Text="{Binding PriceSubtotalDisplay}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding PriceSubtotalInclDisplay}" FontWeight="Bold" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Grid HorizontalAlignment="Right" Width="320">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Taxes:" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.TaxDisplay}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total:" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrder.TotalDisplay}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" TextAlignment="Right" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Paid:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.PaidDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Margin:" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOrder.MarginDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}" TextAlignment="Right" Margin="0,3"/>
                                </Grid>
                            </StackPanel>

                            <!-- Tab 2: Payments -->
                            <StackPanel Visibility="{Binding IsPaymentsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <StackPanel>
                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Payment Method" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="Amount" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding SelectedOrder.Payments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PaymentDateDisplay}" FontSize="12.5"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding PaymentMethodName}" FontWeight="SemiBold" FontSize="12.5"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" FontWeight="Bold" FontSize="13" TextAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tab 3: Extra Info -->
                            <StackPanel Visibility="{Binding IsExtraInfoTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.Company}" FontSize="13" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Receipt Number" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrder.PosReference}" FontSize="13" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Order Number" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.TrackingNumber}" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST -->
        <Border Grid.Row="2" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Style="{StaticResource PosToastBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>