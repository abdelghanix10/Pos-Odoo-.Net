<Window x:Class="OdooPosLogin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OdooPosLogin"
        mc:Ignorable="d"
        Title="Odoo 20 Point of Sale"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ==================== TOUCH USER CARD STYLE (Compact 3-Col Grid) ==================== -->
        <Style x:Key="UserRoleCardStyle" TargetType="Button">
            <Setter Property="Width" Value="134"/>
            <Setter Property="Height" Value="134"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== COMPACT EXIT BUTTON STYLE ==================== -->
        <Style x:Key="ExitCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ExitBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExitBorder" Property="Background" Value="{StaticResource DangerRedSoftBrush}"/>
                                <Setter TargetName="ExitBorder" Property="BorderBrush" Value="{StaticResource DangerRedBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ExitBorder" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== TOUCH PIN PAD DIGIT BUTTON STYLE ==================== -->
        <Style x:Key="PinPadKeyStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ==================== ROOT CONTAINER ==================== -->
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. COMPACT TOP HEADER BAR (54px — Visible on Login Screen Only) -->
            <Border x:Name="TopLoginHeaderBar"
                    Grid.Row="0"
                    Height="54"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Live Clock & Date -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource OdooTealSoftBrush}"
                                CornerRadius="8"
                                Width="30" Height="30"
                                Margin="0,0,10,0">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                             Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2.2"/>
                                    <Path Data="M 12,6 L 12,12 L 16,14"
                                          Stroke="{StaticResource OdooTealBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockTextBlock"
                                       Text="09:41:00 AM"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="DateTextBlock"
                                       Text="Monday, Nov 02, 2026"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Application Title -->
                    <TextBlock Grid.Column="1"
                               Text="Point of Sale"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <!-- Right: Setup Button + Live Status Pill + Brand Badge -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button x:Name="HeaderQuickSetupBtn"
                                Click="OpenSetupSettings_Click"
                                Style="{StaticResource PosSecondaryButton}"
                                Height="30"
                                Padding="11,0"
                                Margin="0,0,10,0"
                                ToolTip="Configure Odoo Connection &amp; Synchronize Data">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙" FontSize="12" Foreground="{StaticResource OdooPurpleBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Setup &amp; Sync" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="GlobalConnectionStatusBadge"
                                Background="{StaticResource WarningAmberSoftBrush}"
                                BorderBrush="{StaticResource WarningAmberBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,4"
                                Margin="0,0,12,0"
                                ToolTip="Live Odoo Online Connection Status">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="GlobalStatusDot"
                                         Width="7" Height="7"
                                         Fill="{StaticResource WarningAmberBrush}"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="GlobalStatusText"
                                           Text="Offline (Local Mode)"
                                           Foreground="#92400E"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource OdooPurpleSoftBrush}"
                                CornerRadius="7"
                                Padding="9,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource OdooPurpleBrush}" Margin="0,0,3,0"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource OdooTealBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="odoo"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Margin="0,-1,0,0"/>
                                <TextBlock Text="20"
                                           Foreground="{StaticResource OdooTealBrush}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. LOGIN WORKSPACE AREA (Balanced 2-Column Layout for 1280x720) -->
            <Grid x:Name="LoginWorkspaceGrid" Grid.Row="1" Margin="28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="468"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: CLEAN BRANDING HERO -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Border Width="92" Height="92"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Effect="{StaticResource PosSubtleShadow}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <Viewbox Width="52" Height="52">
                            <Canvas Width="64" Height="64">
                                <Rectangle Width="44" Height="34" Canvas.Left="10" Canvas.Top="8"
                                           RadiusX="6" RadiusY="6"
                                           Fill="{StaticResource OdooPurpleSoftBrush}"
                                           Stroke="{StaticResource OdooPurpleBrush}"
                                           StrokeThickness="3"/>
                                <Path Data="M 6,48 L 58,48 C 58,53 54,56 49,56 L 15,56 C 10,56 6,53 6,48 Z"
                                      Fill="{StaticResource OdooTealBrush}"/>
                                <Ellipse Width="12" Height="12" Canvas.Left="19" Canvas.Top="19"
                                         Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="3.2"/>
                                <Ellipse Width="12" Height="12" Canvas.Left="33" Canvas.Top="19"
                                         Stroke="{StaticResource OdooTealBrush}" StrokeThickness="3.2"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="odoo"
                                   Foreground="{StaticResource OdooPurpleBrush}"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="36"
                                   FontWeight="Bold"/>
                        <TextBlock Text="POS"
                                   Foreground="{StaticResource OdooTealBrush}"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="36"
                                   FontWeight="Light"
                                   Margin="6,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Touch Retail &amp; Hospitality Terminal"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14.5"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,22"/>

                    <Border Width="48" Height="2"
                            Background="{StaticResource SubtleBorderBrush}"
                            CornerRadius="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="Offline-First SQLite  •  Odoo 20 JSON-RPC Sync"
                               Foreground="{StaticResource OdooTealBrush}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="© 2026 Odoo S.A. &amp; Enterprise Retail Systems"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- RIGHT: CASHIER SELECTION PANEL + SHUTDOWN ACTION -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Framed Cashier Picker Card -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Panel Header -->
                            <StackPanel Grid.Row="0" Margin="4,0,4,12">
                                <TextBlock Text="Select Cashier"
                                           FontSize="15.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Tap your profile to sign in to the POS terminal"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- A. SYNCHRONIZED POS USER CARDS (3 per row) -->
                            <ScrollViewer x:Name="UsersScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PosLoginUsersItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource UserRoleCardStyle}"
                                                    Tag="{Binding}"
                                                    Click="PosUserCard_Click"
                                                    Margin="4">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="54" Height="54"
                                                            CornerRadius="27"
                                                            Background="{Binding AvatarSoftBrush}"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,0,0,10"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initials}"
                                                                       Foreground="{Binding AvatarAccentBrush}"
                                                                       FontSize="19"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding InitialsVisibility}"/>
                                                            <Image Source="{Binding AvatarBitmap}"
                                                                   Stretch="UniformToFill"
                                                                   Visibility="{Binding HasCustomImageVisibility}"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="116"/>
                                                    <TextBlock Text="{Binding RoleDisplay}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="116"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- B. EMPTY STATE WHEN NO USERS ARE SYNCED -->
                            <Border x:Name="NoUsersEmptyStateCard"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    Padding="16,20">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="54" Height="54"
                                            CornerRadius="27"
                                            Background="{StaticResource OdooPurpleSoftBrush}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,14">
                                        <Viewbox Width="26" Height="26">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                                <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="{StaticResource OdooTealBrush}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <TextBlock Text="No Local Users Synchronized"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>

                                    <TextBlock x:Name="NoUsersSubtitleText"
                                               Text="Connect to your Odoo server and synchronize POS, catalog, and user records to get started."
                                               FontSize="12.5"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,0,0,18"/>

                                    <Button x:Name="QuickSyncLoginBtn"
                                            Style="{StaticResource PosPrimaryButton}"
                                            Height="40"
                                            Click="QuickSyncFromLogin_Click"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,8">
                                        <TextBlock x:Name="QuickSyncLoginBtnText" Text="Sync All Data from Odoo Now"/>
                                    </Button>

                                    <Button x:Name="OpenSetupFromLoginBtn"
                                            Style="{StaticResource PosSecondaryButton}"
                                            Height="38"
                                            Click="OpenSetupSettings_Click"
                                            HorizontalAlignment="Stretch"
                                            Content="Configure Odoo Server"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- BOTTOM FOOTER ACTION: SHUT DOWN TERMINAL -->
                    <Button Grid.Row="2"
                            Style="{StaticResource ExitCardButtonStyle}"
                            Click="ExitButton_Click"
                            ToolTip="Close Point of Sale">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,3 L 12,12"
                                          Stroke="{StaticResource DangerRedBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Path Data="M 18.36,6.64 A 9,9 0 1 1 5.64,6.64"
                                          Stroke="{StaticResource DangerRedBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Shut Down Terminal"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerRedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- 3. MAIN APPLICATION SHELL -->
            <local:MainShellView x:Name="MainShellModule"
                                 Grid.Row="1"
                                 Visibility="Collapsed"/>
        </Grid>

        <!-- ========================================================= -->
        <!-- OVERLAY 1: COMPACT TOUCH PIN PAD MODAL (Fits 1280x720)    -->
        <!-- ========================================================= -->
        <Grid x:Name="PinPadModalOverlay"
              Background="{StaticResource ModalBackdropBrush}"
              Visibility="Collapsed">
            <Border Width="348"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PosModalCardStyle}"
                    Padding="22">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ModalRoleBadge"
                                    Width="38" Height="38"
                                    CornerRadius="19"
                                    Background="{StaticResource OdooPurpleSoftBrush}"
                                    Margin="0,0,10,0">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 C 9.2,2 7,4.2 7,7 L 7,10 L 5,10 C 3.9,10 3,10.9 3,12 L 3,20 C 3,21.1 3.9,22 5,22 L 19,22 C 20.1,22 21,21.1 21,20 L 21,12 C 21,10.9 20.1,10 19,10 L 17,10 L 17,7 C 17,4.2 14.8,2 12,2 Z M 9,7 C 9,5.3 10.3,4 12,4 C 13.7,4 15,5.3 15,7 L 15,10 L 9,10 L 9,7 Z"
                                              Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ModalRoleTitleText"
                                           Text="User"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="PinPromptText"
                                           Text="Enter your security PIN"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource PosModalCloseButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="ClosePinModal_Click"/>
                    </Grid>

                    <!-- PIN Dots Strip -->
                    <Border Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="48"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="PinDot1" Width="13" Height="13" Stroke="#94A3B8" StrokeThickness="2" Margin="9,0"/>
                            <Ellipse x:Name="PinDot2" Width="13" Height="13" Stroke="#94A3B8" StrokeThickness="2" Margin="9,0"/>
                            <Ellipse x:Name="PinDot3" Width="13" Height="13" Stroke="#94A3B8" StrokeThickness="2" Margin="9,0"/>
                            <Ellipse x:Name="PinDot4" Width="13" Height="13" Stroke="#94A3B8" StrokeThickness="2" Margin="9,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3x4 Touch Keypad -->
                    <UniformGrid Rows="4" Columns="3" Margin="-4">
                        <Button Content="1" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="2" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="3" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="4" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="5" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="6" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="7" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="8" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="9" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="C" Style="{StaticResource PinPadKeyStyle}" Margin="4"
                                Foreground="{StaticResource DangerRedBrush}"
                                Click="PinClear_Click"/>
                        <Button Content="0" Style="{StaticResource PinPadKeyStyle}" Margin="4" Click="PinDigit_Click"/>
                        <Button Content="⌫" Style="{StaticResource PinPadKeyStyle}" Margin="4"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Click="PinBackspace_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- OVERLAY 2: TOUCH EXIT CONFIRMATION MODAL                  -->
        <!-- ========================================================= -->
        <Grid x:Name="ExitModalOverlay"
              Background="{StaticResource ModalBackdropBrush}"
              Visibility="Collapsed">
            <Border Width="380"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PosModalCardStyle}"
                    Padding="24">
                <StackPanel>
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="{StaticResource DangerRedSoftBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 12,3 L 12,12"
                                      Stroke="{StaticResource DangerRedBrush}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                                <Path Data="M 18.36,6.64 A 9,9 0 1 1 5.64,6.64"
                                      Stroke="{StaticResource DangerRedBrush}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Text="Shut Down POS Terminal?"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Your local SQLite database and configuration settings will remain safely stored on this terminal."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Height="44"
                                Style="{StaticResource PosSecondaryButton}"
                                FontSize="14"
                                Click="CancelExitModal_Click"/>

                        <Button Grid.Column="2"
                                Content="Shut Down"
                                Style="{StaticResource PosDangerButton}"
                                Height="44"
                                FontSize="14"
                                Click="ConfirmShutdown_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- OVERLAY 3: SESSION TOAST NOTIFICATION                     -->
        <!-- ========================================================= -->
        <Border x:Name="SessionToastBanner"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Style="{StaticResource PosToastBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,10,0"/>
                <TextBlock x:Name="ToastMessageText"
                           Text="Authenticated — Loading POS..."
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>