<Window x:Class="OdooPosLogin.PendingSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OdooPosLogin"
        mc:Ignorable="d"
        Title="Unsynced POS Transactions — Odoo Sync Queue"
        Width="980" Height="620"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB"
        FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#68598A"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#584878"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>

        <Style x:Key="PrimarySyncButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bdr" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pending Odoo Synchronization Queue"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <Border x:Name="PendingCountBadge"
                                Background="#F3ECF1"
                                CornerRadius="10"
                                Padding="10,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="PendingCountText"
                                       Text="0 pending"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#714B67"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Transactions are saved locally in strict chronological sequence and uploaded to Odoo in FIFO order."
                               FontSize="12.5"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Right Controls: Connection Status + Sync Now + Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ConnectionBadge"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConnectionStatusLabel"
                                       Text="Odoo Online"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#065F46"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="RefreshBtn"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Click="RefreshBtn_Click"
                            Margin="0,0,8,0"
                            Content="Refresh"/>

                    <Button x:Name="SyncNowBtn"
                            Style="{StaticResource PrimarySyncButtonStyle}"
                            Click="SyncNowBtn_Click"
                            Content="↻  Sync All to Odoo Now"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TABLE COLUMN HEADERS -->
        <Border Grid.Row="1"
                Background="#F3F4F6"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Seq #" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Grid.Column="1" Text="Operation" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Grid.Column="2" Text="Point of Sale" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Grid.Column="3" Text="Transaction Details" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Grid.Column="4" Text="Created At" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Grid.Column="5" Text="Status" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Grid.Column="6" Text="Action" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 3. QUEUE ITEMS LIST -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="QueueItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PendingSyncDisplayItem}">
                            <Border Background="#FFFFFF"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="22,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sequence # -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SequenceDisplay}"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   Foreground="#4B5563"
                                                   VerticalAlignment="Center"/>

                                        <!-- Operation Badge -->
                                        <Border Grid.Column="1"
                                                Background="{Binding OperationBadgeBackground}"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OperationTitle}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding OperationBadgeForeground}"/>
                                        </Border>

                                        <!-- Shop Name -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ShopDisplay}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"/>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding PrimarySummary}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SecondarySummary}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Created At -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding CreatedAt}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Status Pill -->
                                        <Border Grid.Column="5"
                                                Background="{Binding StatusBadgeBackground}"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding StatusBadgeForeground}"/>
                                        </Border>

                                        <!-- Remove Action -->
                                        <Button Grid.Column="6"
                                                Tag="{Binding QueueId}"
                                                Click="RemoveQueueItem_Click"
                                                Background="#FEF2F2"
                                                BorderBrush="#FECACA"
                                                BorderThickness="1"
                                                Height="28"
                                                Padding="10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip="Remove this item from the sync queue">
                                            <TextBlock Text="Remove" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626"/>
                                        </Button>
                                    </Grid>

                                    <!-- Error Banner (Visible if LastError is present) -->
                                    <Border Background="#FEF2F2"
                                            BorderBrush="#FECACA"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="55,8,0,0"
                                            Visibility="{Binding ErrorVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠ Odoo Sync Error: "
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#B91C1C"/>
                                            <TextBlock Text="{Binding LastError}"
                                                       FontSize="12"
                                                       Foreground="#991B1B"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="720"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State when all items are synced -->
            <Border x:Name="EmptyStateCard"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="36,30"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="52" Height="52"
                            CornerRadius="26"
                            Background="#ECFDF5"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14">
                        <TextBlock Text="✓"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="All POS Transactions Are Synced!"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="There are no pending sessions, orders, or register closures waiting in the local queue."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. FOOTER STATUS BAR -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <TextBlock x:Name="FooterStatusText"
                           Text="Ready"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>

                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                        Content="Close Window"
                        Height="34"
                        HorizontalAlignment="Right"
                        Click="CloseWindow_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>