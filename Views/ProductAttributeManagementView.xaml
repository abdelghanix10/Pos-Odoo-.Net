<UserControl x:Class="OdooPosLogin.ProductAttributeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:ProductAttributesViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Design Palette Brushes -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>
        
        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>
        
        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>
        
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>
        
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="ActiveGreenSoftBrush" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="12"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <!-- Primary Purple Button Style -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pager Chevron Button Style -->
        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Control Bar -->
            <RowDefinition Height="64"/>
            <!-- Row 1: Workspace Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. STANDARDIZED TOP CONTROL BAR                                         -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: "Sync from Odoo" Button + Breadcrumb -->
                    <ColumnDefinition Width="*"/>
                    <!-- Center: Search Bar -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right: Pager -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: "Sync from Odoo" Button + Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncFromOdooCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumb Root: "Attributes" -->
                    <Button Command="{Binding BackToListCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText"
                                           Text="Attributes"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Breadcrumb Sub-Path (when viewing Detail View) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                VerticalAlignment="Center">
                        <TextBlock Text="  /  "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedAttribute.Name}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"/>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: SEARCH BAR -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" MinWidth="220" MaxWidth="380" Width="320" Height="36" VerticalAlignment="Center">
                    <Border Background="#F3F4F6"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Grid Margin="12,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 15.5,14 L 14.71,14 L 14.43,13.73 C 15.41,12.59 16,11.11 16,9.5 C 16,5.91 13.09,3 9.5,3 C 5.91,3 3,5.91 3,9.5 C 3,13.09 5.91,16 9.5,16 C 11.11,16 12.59,15.41 13.73,14.43 L 14,14.71 L 14,15.5 L 19,20.49 L 20.49,19 L 15.5,14 Z M 9.5,14 C 7.01,14 5,11.99 5,9.5 C 5,7.01 7.01,5 9.5,5 C 11.99,5 14,7.01 14,9.5 C 14,11.99 11.99,14 9.5,14 Z"
                                          Fill="{StaticResource PlaceholderTextBrush}"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Grid.Column="1"
                                       Text="Search Attributes..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="18" Height="18"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: DETAIL RECORD SWITCHER (VISIBLE ONLY IN DETAIL VIEW) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding PagerText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding PreviousRecordCommand}"
                            IsEnabled="{Binding HasPreviousRecord}"
                            ToolTip="Previous attribute"
                            Margin="0,0,4,0">
                        <Path Data="M 17,7 L 10,14 L 17,21"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="8" Height="14"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding NextRecordCommand}"
                            IsEnabled="{Binding HasNextRecord}"
                            ToolTip="Next attribute">
                        <Path Data="M 10,7 L 17,14 L 10,21"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="8" Height="14"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. WORKSPACE CONTENT AREA                                               -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">
            <!-- =================================================================== -->
            <!-- VIEW 1: PRODUCT ATTRIBUTES LIST VIEW (TABLE)                        -->
            <!-- =================================================================== -->
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                  Margin="24,20,24,28">
                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{StaticResource SubtleCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header -->
                            <RowDefinition Height="44"/>
                            <!-- Table Data Body -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="20,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Attribute" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Display Type" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Variant Creation" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- TABLE DATA ROWS -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredAttributes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProductAttributeRecord}">
                                        <Button Command="{Binding DataContext.SelectAttributeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder"
                                                            Background="#FFFFFF"
                                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="20,13"
                                                            MinHeight="48">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Col 0: Attribute Name -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Col 1: Display Type Badge -->
                                                            <Border Grid.Column="1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="#F3F4F6"
                                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="12,3">
                                                                <TextBlock Text="{Binding DisplayTypeFormatted}"
                                                                           FontSize="12.5"
                                                                           FontWeight="Medium"
                                                                           Foreground="#374151"/>
                                                            </Border>

                                                            <!-- Col 2: Variant Creation Badge -->
                                                            <Border Grid.Column="2"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="{StaticResource OdooPurpleSoftBrush}"
                                                                    CornerRadius="12"
                                                                    Padding="12,3">
                                                                <TextBlock Text="{Binding CreateVariantFormatted}"
                                                                           FontSize="12.5"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource OdooPurpleBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#F3ECF1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- =================================================================== -->
            <!-- VIEW 2: PRODUCT ATTRIBUTE DETAIL VIEW (STRICTLY READ-ONLY SHEET)    -->
            <!-- =================================================================== -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,48">
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="32,28"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <!-- TOP BAR: BREADCRUMB / TITLE + SMART PRODUCTS BADGE -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Attribute Subtitle & Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Product Attribute"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedAttribute.Name}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>

                                <!-- Right: Products Smart Badge -->
                                <Border Grid.Column="1"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 12,2 L 21,7 L 21,17 L 12,22 L 3,17 L 3,7 Z"
                                                      Stroke="{StaticResource OdooTealBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round"/>
                                                <Path Data="M 12,2 L 12,12 L 21,7 M 12,12 L 3,7 M 12,12 L 12,22"
                                                      Stroke="{StaticResource OdooTealBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding SelectedAttribute.ProductsCountDisplay}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource OdooTealBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- HEADER FIELDS: DISPLAY TYPE & VARIANT CREATION (READ-ONLY) -->
                            <Grid Margin="0,0,0,28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- DISPLAY TYPE -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Display Type"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border Background="#F9FAFB"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,8"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SelectedAttribute.DisplayTypeFormatted}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- VARIANT CREATION (READ-ONLY RADIO INDICATORS) -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Variant Creation"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Radio 1: Instantly -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                                    BorderBrush="{Binding SelectedAttribute.IsCreateInstantly, Converter={x:Null}}"
                                                    Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAttribute.IsCreateInstantly}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource OdooPurpleBrush}"
                                                         Visibility="{Binding SelectedAttribute.IsCreateInstantly, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Border>
                                            <TextBlock Text="Instantly" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Radio 2: Dynamically -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAttribute.IsCreateDynamically}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource OdooPurpleBrush}"
                                                         Visibility="{Binding SelectedAttribute.IsCreateDynamically, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Border>
                                            <TextBlock Text="Dynamically" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Radio 3: Never -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAttribute.IsCreateNever}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource OdooPurpleBrush}"
                                                         Visibility="{Binding SelectedAttribute.IsCreateNever, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Border>
                                            <TextBlock Text="Never" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- ==================== ATTRIBUTE VALUES TAB ==================== -->
                            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Border BorderBrush="{StaticResource OdooPurpleBrush}" BorderThickness="0,0,0,3" Padding="12,8">
                                        <TextBlock Text="Attribute Values" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- READ-ONLY ATTRIBUTE VALUES TABLE -->
                            <Border BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="#FFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Table Header -->
                                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Value" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Free text" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Color" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Image" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="Default Extra Price" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Table Rows -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedAttribute.Values}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ProductAttributeValueRecord}">
                                                <Border Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10" MinHeight="42">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.5*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="16" Height="16" CornerRadius="3" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Background="#FFFFFF">
                                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OdooTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CustomCheckVisibility}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="18" Height="18" Fill="{Binding ColorBrush}" Stroke="{StaticResource SubtleBorderBrush}" StrokeThickness="1" Visibility="{Binding ColorVisibility}">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.12"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>
                                                            <TextBlock Text="—" Foreground="{StaticResource PlaceholderTextBrush}" FontSize="13" Visibility="{Binding NoColorVisibility}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="24" Height="24" CornerRadius="4" Background="#F3F4F6" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" Visibility="{Binding ImageVisibility}">
                                                                <Image Source="{Binding ImageBitmap}" Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Text="—" Foreground="{StaticResource PlaceholderTextBrush}" FontSize="13" Visibility="{Binding NoImageVisibility}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="4" Text="{Binding PriceExtraDisplay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 3. TOAST BANNER NOTIFICATION                                            -->
        <!-- ======================================================================= -->
        <Border Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,32"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>