<UserControl x:Class="OdooPosLogin.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.Resources>
        <!-- ==================== SIDEBAR ITEM STYLES (Compact 34px for 720p) ==================== -->
        <Style x:Key="SidebarItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="6,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SubtleBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="6,1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border Width="3"
                                        Height="18"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource OdooPurpleBrush}"
                                        CornerRadius="2"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#ECE0EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== SETTINGS TAB BUTTON STYLES ==================== -->
        <Style x:Key="OdooActiveTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Height="2.5" Background="{StaticResource OdooPurpleBrush}" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooInactiveTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ==================== MAIN APPLICATION SHELL ROOT ==================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarMenuColumn" Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. SLIM COLLAPSIBLE LEFT SIDEBAR (196px / 58px)                         -->
        <!-- ======================================================================= -->
        <Border x:Name="SidebarContainerBorder"
                Grid.Column="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR: BRAND LABEL + COLLAPSE BUTTON -->
                <Border Grid.Row="0" BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid>
                        <StackPanel x:Name="SidebarBrandTitle" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource OdooPurpleBrush}" Margin="0,0,3,0"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource OdooTealBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="odoo POS" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <Button x:Name="SidebarToggleButton"
                                Click="SidebarToggle_Click"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource PosGhostButton}"
                                Padding="0"
                                ToolTip="Collapse / Expand Sidebar">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="ToggleIconPath"
                                          Data="M 6,4 L 6,20 M 18,5 L 11,12 L 18,19"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="ToggleIconScale" ScaleX="1"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- NAVIGATION ITEMS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,6">
                    <StackPanel>
                        <TextBlock x:Name="SectionRegisterHeader" Text="POINT OF SALE" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="14,4,0,3"/>

                        <Button x:Name="NavDashboardBtn" Style="{StaticResource ActiveSidebarItemButtonStyle}" Click="NavDashboard_Click" ToolTip="Point of Sale Dashboard">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooPurpleBrush}"/>
                                        <Rectangle Canvas.Left="13" Canvas.Top="3" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooTealBrush}"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="13" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooTealBrush}"/>
                                        <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="DashboardLabel" Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavSessionsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavSessions_Click" ToolTip="Point of Sale Sessions">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="14" RadiusX="2.5" RadiusY="2.5" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Path Data="M 8,21 H 16 M 12,17 V 21" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="7.5" Width="5" Height="5" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="SessionsLabel" Text="Sessions" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavOrdersBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavOrders_Click" ToolTip="Orders">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 6,2 L 3,6 V 20 C 3,21.1 3.9,22 5,22 H 19 C 20.1,22 21,21.1 21,20 V 6 L 18,2 H 6 Z" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2" Fill="{StaticResource OdooTealSoftBrush}" StrokeLineJoin="Round"/>
                                        <Path Data="M 3,6 H 21 M 16,10 C 16,12.2 14.2,14 12,14 C 9.8,14 8,12.2 8,10" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="OrdersLabel" Text="Orders" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavPaymentsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavPayments_Click" ToolTip="Payments">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="2" Canvas.Top="5" Width="20" Height="14" RadiusX="2.5" RadiusY="2.5" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" Fill="{StaticResource OdooPurpleSoftBrush}"/>
                                        <Line X1="2" Y1="10" X2="22" Y2="10" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Rectangle Canvas.Left="5" Canvas.Top="13" Width="5" Height="3" RadiusX="1" RadiusY="1" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="PaymentsLabel" Text="Payments" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavPaymentMethodsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavPaymentMethods_Click" ToolTip="POS Payment Methods">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="16" Height="11" RadiusX="2" RadiusY="2" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="9" Width="16" Height="11" RadiusX="2" RadiusY="2" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" Fill="#FFFFFF"/>
                                        <Ellipse Canvas.Left="12" Canvas.Top="12.5" Width="4" Height="4" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="PaymentMethodsLabel" Text="Payment Methods" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <TextBlock x:Name="SectionCatalogHeader" Text="CATALOG" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="14,10,0,3"/>

                        <Button x:Name="NavProductsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavProducts_Click" ToolTip="Products">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 L 21,7 L 12,12 L 3,7 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 3,7 L 12,12 L 12,22 L 3,17 Z" Fill="{StaticResource OdooPurpleBrush}" Opacity="0.85"/>
                                        <Path Data="M 12,12 L 21,7 L 21,17 L 12,22 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="ProductsLabel" Text="Products" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavCombosBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavCombos_Click" ToolTip="Combo Choices">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 4,9 C 4,5.5 7.5,3.5 12,3.5 C 16.5,3.5 20,5.5 20,9 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 3,12 H 21" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
                                        <Path Data="M 4,15 C 4,18.5 7.5,20.5 12,20.5 C 16.5,20.5 20,18.5 20,15 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="CombosLabel" Text="Combo Choices" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavCategoriesBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavCategories_Click" ToolTip="PoS Product Categories">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 L 2,7 L 12,12 L 22,7 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 2,12 L 12,17 L 22,12 M 2,17 L 12,22 L 22,17" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="CategoriesLabel" Text="PoS Categories" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavAttributesBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavAttributes_Click" ToolTip="Product Attributes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="7" Canvas.Top="4" Width="4" Height="4" Fill="{StaticResource OdooPurpleBrush}"/>
                                        <Ellipse Canvas.Left="14" Canvas.Top="10" Width="4" Height="4" Fill="{StaticResource OdooPurpleBrush}"/>
                                        <Ellipse Canvas.Left="9" Canvas.Top="16" Width="4" Height="4" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="AttributesLabel" Text="Attributes" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavProductTagsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavProductTags_Click" ToolTip="Product Tags">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 20.5,13.4 L 13.4,20.5 C 12.6,21.3 11.4,21.3 10.6,20.5 L 3,13 V 3 H 13 L 20.5,10.6 C 21.3,11.4 21.3,12.6 20.5,13.4 Z" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" Fill="{StaticResource OdooTealSoftBrush}" StrokeLineJoin="Round"/>
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="3" Height="3" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="ProductTagsLabel" Text="Product Tags" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <TextBlock x:Name="SectionAdminHeader" Text="ADMINISTRATION" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="14,10,0,3"/>

                        <Button x:Name="NavCompaniesBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavCompanies_Click" ToolTip="Companies">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 3,21 H 21 M 5,21 V 5 C 5,3.9 5.9,3 7,3 H 15 C 16.1,3 17,3.9 17,5 V 21 M 17,10 H 19 C 20.1,10 21,10.9 21,12 V 21" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                        <Rectangle Canvas.Left="8" Canvas.Top="7" Width="2.5" Height="2.5" Fill="{StaticResource OdooTealBrush}"/>
                                        <Rectangle Canvas.Left="12" Canvas.Top="7" Width="2.5" Height="2.5" Fill="{StaticResource OdooTealBrush}"/>
                                        <Rectangle Canvas.Left="8" Canvas.Top="11" Width="2.5" Height="2.5" Fill="{StaticResource OdooTealBrush}"/>
                                        <Rectangle Canvas.Left="12" Canvas.Top="11" Width="2.5" Height="2.5" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="CompaniesLabel" Text="Companies" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavUsersBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavUsers_Click" ToolTip="Users">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="6" Canvas.Top="3" Width="6" Height="6" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Path Data="M 2,19 C 2,15 5,13 9,13 C 13,13 16,15 16,19" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="15" Canvas.Top="5" Width="4.5" Height="4.5" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="1.8"/>
                                        <Path Data="M 15.5,14 C 18,14.5 20.5,16 21,19" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="UsersLabel" Text="Users" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavPendingSyncBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="OpenPendingSyncQueueWindow_Click" ToolTip="View Unsynced POS Transactions Queue">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="PendingSyncLabel" Text="Unsynced" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <Border Grid.Column="2" x:Name="SidebarPendingCountBadge" Background="{StaticResource WarningAmberSoftBrush}" BorderBrush="{StaticResource WarningAmberBrush}" BorderThickness="1" CornerRadius="8" Padding="6,0.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarPendingCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="NavPosSettingsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavPosSettings_Click" ToolTip="Point of Sale Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="13" Canvas.Top="3.5" Width="5" Height="5" Fill="White" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="6" Canvas.Top="9.5" Width="5" Height="5" Fill="White" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="14" Canvas.Top="15.5" Width="5" Height="5" Fill="White" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="PosSettingsLabel" Text="PoS Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavReceiptDesignsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavReceiptDesigns_Click" ToolTip="Receipt Designs">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 6,3 H 18 V 21 L 15,19 L 12,21 L 9,19 L 6,21 Z" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="{StaticResource OdooPurpleSoftBrush}"/>
                                        <Path Data="M 9,8 H 15 M 9,12 H 15 M 9,16 H 13" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="ReceiptDesignsLabel" Text="Receipt Designs" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavSettingsBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="NavSettings_Click" ToolTip="Settings &amp; Odoo Synchronization">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="11" Height="11" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Path Data="M 12,2 V 5 M 12,19 V 22 M 2,12 H 5 M 19,12 H 22 M 4.9,4.9 L 7.1,7.1 M 16.9,16.9 L 19.1,19.1 M 4.9,19.1 L 7.1,16.9 M 16.9,7.1 L 19.1,4.9" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="SettingsLabel" Text="Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- BOTTOM: LOGOUT -->
                <Border Grid.Row="2" BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                    <Button x:Name="NavLogoutBtn" Style="{StaticResource SidebarItemButtonStyle}" Click="LogoutItem_Click" ToolTip="Log out of current session">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 10,4 H 4 V 20 H 10" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M 9,12 H 20 M 16,8 L 20,12 L 16,16" Stroke="{StaticResource DangerRedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" x:Name="LogoutLabel" Text="Logout" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. MAIN CONTENT WORKSPACE                                               -->
        <!-- ======================================================================= -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">

            <!-- ==================== VIEW A: CONFIGURATION & SYNC HUB ==================== -->
            <Grid x:Name="SettingsViewPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. COMPACT PAGE HEADER -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" Padding="20,12,20,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Configuration &amp; Synchronization" FontFamily="{StaticResource DisplayFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Manage Odoo 20 connectivity, hardware printer, local backups, and terminal preferences." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="ConnectionStatusText" Text="Not Tested" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. HORIZONTAL TAB STRIP -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,1" Padding="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabGeneralSettings" Style="{StaticResource OdooActiveTabButtonStyle}" Content="General Settings" Click="TabButton_Click" Tag="GeneralSettings"/>
                        <Button x:Name="TabOdooSync" Style="{StaticResource OdooInactiveTabButtonStyle}" Content="Odoo Connection &amp; Sync" Click="TabButton_Click" Tag="OdooSync"/>
                        <Button x:Name="TabPrinter" Style="{StaticResource OdooInactiveTabButtonStyle}" Content="Printer" Click="TabButton_Click" Tag="Printer"/>
                        <Button x:Name="TabBackup" Style="{StaticResource OdooInactiveTabButtonStyle}" Content="Backup" Click="TabButton_Click" Tag="Backup"/>
                        <Button x:Name="TabLanguage" Style="{StaticResource OdooInactiveTabButtonStyle}" Content="Language" Click="TabButton_Click" Tag="Language"/>
                    </StackPanel>
                </Border>

                <!-- 3. SETTINGS TAB BODIES -->
                <Grid Grid.Row="2">

                    <!-- TAB 1: GENERAL SETTINGS -->
                    <ScrollViewer x:Name="GeneralSettingsScrollViewer" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="20,16,20,24">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Display &amp; Default Company" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Screen Mode" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Windowed or fullscreen kiosk" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GeneralScreenModeComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="260" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Window" IsSelected="True"/>
                                            <ComboBoxItem Content="Fullscreen"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Operating Company" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Default company on receipts" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GeneralCompanyComboBox" Grid.Column="1" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Currency" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Display currency across POS &amp; receipts" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GeneralCurrencyComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource OdooFilterComboBoxStyle}"
                                                  Height="34" Width="260"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Content="MAD — Moroccan Dirham (MAD)" Tag="MAD"/>
                                            <ComboBoxItem Content="DH — Dirham (DH)" Tag="DH"/>
                                            <ComboBoxItem Content="$ — US Dollar ($)" Tag="$" IsSelected="True"/>
                                            <ComboBoxItem Content="£ — British Pound (£)" Tag="£"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Interface Buttons Visibility" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="GeneralShowUnsyncedInPosCheckBox" Style="{StaticResource PosCheckBoxStyle}"
                                              Content="Show &quot;Unsynced&quot; queue button in the POS register header" IsChecked="True" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="GeneralShowSetupOnLoginCheckBox" Style="{StaticResource PosCheckBoxStyle}"
                                              Content="Show &quot;Setup &amp; Sync&quot; button on the Login screen" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="SaveGeneralSettingsBtn" Style="{StaticResource PosPrimaryButton}" Width="175" Height="36" HorizontalAlignment="Left" Click="SaveGeneralSettingsBtn_Click" Content="Save General Settings"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 2: ODOO CONNECTION & SYNC -->
                    <ScrollViewer x:Name="OdooSyncScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20,16,20,24">
                        <StackPanel HorizontalAlignment="Stretch">

                            <!-- TOP 2-COLUMN HERO -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1.15*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: SERVER CREDENTIALS -->
                                <Border Grid.Column="0" Style="{StaticResource PosCardBorderStyle}" Padding="18,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <TextBlock Text="Odoo Server Connection" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="JSON-RPC endpoint &amp; authentication credentials." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="Server URL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <Border Style="{StaticResource PosInputBorderStyle}" Height="34">
                                                    <TextBox x:Name="CfgServerUrlTextBox" Text="http://localhost:8069/" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12.5"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="Database Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <Border Style="{StaticResource PosInputBorderStyle}" Height="34">
                                                    <TextBox x:Name="CfgDatabaseTextBox" Text="" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12.5"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="Username / Email" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <Border Style="{StaticResource PosInputBorderStyle}" Height="34">
                                                    <TextBox x:Name="CfgUsernameTextBox" Text="" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12.5"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="Password / API Key" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <Border Style="{StaticResource PosInputBorderStyle}" Height="34">
                                                    <Grid>
                                                        <PasswordBox x:Name="CfgPasswordMasked" PasswordChar="●" FontSize="12.5" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Margin="0,0,28,0"/>
                                                        <TextBox x:Name="CfgPasswordRevealed" FontSize="12.5" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Margin="0,0,28,0"/>
                                                        <Button x:Name="TogglePasswordViewBtn" Click="TogglePasswordView_Click" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path x:Name="EyeIconPath" Data="M 1,12 C 1,12 5,4 12,4 C 19,4 23,12 23,12 C 23,12 19,20 12,20 C 5,20 1,12 1,12 Z" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2" Fill="Transparent"/>
                                                                    <Ellipse x:Name="EyePupil" Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Fill="{StaticResource SecondaryTextBrush}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="SaveConnectionBtn" Style="{StaticResource PosPrimaryButton}" Height="34" Click="SaveConnectionBtn_Click" Margin="0,0,8,0" Content="Save Credentials"/>
                                                <Button x:Name="TestConnectionBtn" Style="{StaticResource PosTealButton}" Height="34" Click="TestConnectionBtn_Click" Content="Test Connection"/>
                                            </StackPanel>
                                            <ProgressBar x:Name="TestConnectionProgressBar" IsIndeterminate="True" Width="68" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- RIGHT: MASTER FULL SYNC -->
                                <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource OdooPurpleBrush}" BorderThickness="1.5" CornerRadius="10" Padding="18,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Full Odoo Data Synchronization" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Upload queued POS transactions &amp; pull all 12 models." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <Button x:Name="OpenPendingQueueBtn" Style="{StaticResource PosTealButton}" Height="30" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenPendingSyncQueueWindow_Click">
                                                <TextBlock x:Name="OpenPendingQueueBtnText" Text="Unsynced (0)" FontSize="11.5"/>
                                            </Button>
                                        </Grid>

                                        <Border Grid.Row="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock x:Name="MasterSyncStepText" Text="Ready to synchronize all 12 Odoo modules" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
                                                    <TextBlock x:Name="MasterSyncPercentText" Text="0%" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar x:Name="MasterSyncProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" Background="{StaticResource SubtleBorderBrush}" Foreground="{StaticResource OdooTealBrush}" BorderThickness="0" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="MasterSyncSummaryText" Text="Flushes offline POS queue first, then synchronizes Companies, Shops, Products, Orders, and Users." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" x:Name="SyncAllNowBtn" Style="{StaticResource PosPrimaryButton}" Click="SyncAllNowBtn_Click" Height="36">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox x:Name="MasterSyncIconBox" Width="14" Height="14" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                        <Viewbox.RenderTransform><RotateTransform x:Name="MasterSyncIconRotation" Angle="0"/></Viewbox.RenderTransform>
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                            <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock x:Name="MasterSyncButtonText" Text="Sync All Data from Odoo" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="2" x:Name="ClearLocalCacheBtn" Style="{StaticResource PosDangerSoftButton}" Click="ClearLocalCacheBtn_Click" Height="36" Content="Clear Local Data"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- DATA RETRIEVAL & AUTO CLEANUP POLICY -->
                            <Border Style="{StaticResource PosCardBorderStyle}" Padding="18,14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="1.25*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Data Retrieval Window (Sessions, Orders &amp; Payments)" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Controls how far back transactional data is pulled from Odoo." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Retrieve:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="SyncDataRetrievalComboBox" Style="{StaticResource OdooFilterComboBoxStyle}" Height="32" Width="190" SelectionChanged="SyncPolicyControl_Changed">
                                                <ComboBoxItem Content="Today" Tag="Today"/>
                                                <ComboBoxItem Content="Yesterday" Tag="Yesterday"/>
                                                <ComboBoxItem Content="Week (Last 7 Days)" Tag="Week" IsSelected="True"/>
                                                <ComboBoxItem Content="Month (Last 30 Days)" Tag="Month"/>
                                                <ComboBoxItem Content="Year (Last 12 Months)" Tag="Year"/>
                                                <ComboBoxItem Content="All (Complete History)" Tag="All"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" Background="{StaticResource SubtleBorderLightBrush}" HorizontalAlignment="Center"/>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Automatic Old Data Cleanup" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                            <CheckBox x:Name="AutoPurgeOldDataCheckBox" Style="{StaticResource PosCheckBoxStyle}" Content="Auto-delete synced records older than:" IsChecked="True" Margin="0,0,10,0"
                                                      Checked="AutoPurgeOldDataCheckBox_Changed" Unchecked="AutoPurgeOldDataCheckBox_Changed"/>
                                            <ComboBox x:Name="AutoPurgePeriodComboBox" Style="{StaticResource OdooFilterComboBoxStyle}" Height="32" Width="120" SelectionChanged="SyncPolicyControl_Changed">
                                                <ComboBoxItem Content="Week" Tag="Week"/>
                                                <ComboBoxItem Content="Month" Tag="Month"/>
                                                <ComboBoxItem Content="3 Months" Tag="3Months" IsSelected="True"/>
                                                <ComboBoxItem Content="Year" Tag="Year"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Frequency & Time Controls -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                            <TextBlock Text="Frequency &amp; Time:" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="AutoPurgeFrequencyComboBox" Style="{StaticResource OdooFilterComboBoxStyle}"
                                                      Height="32" Width="110" Margin="0,0,10,0" SelectionChanged="SyncPolicyControl_Changed">
                                                <ComboBoxItem Content="Daily" Tag="Daily" IsSelected="True"/>
                                                <ComboBoxItem Content="Weekly" Tag="Weekly"/>
                                                <ComboBoxItem Content="Monthly" Tag="Monthly"/>
                                            </ComboBox>
                                            <ComboBox x:Name="AutoPurgeHourComboBox" Style="{StaticResource OdooFilterComboBoxStyle}"
                                                      Height="32" Width="68" SelectionChanged="SyncPolicyControl_Changed"/>
                                            <TextBlock Text=":" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" Margin="5,0"/>
                                            <ComboBox x:Name="AutoPurgeMinuteComboBox" Style="{StaticResource OdooFilterComboBoxStyle}"
                                                      Height="32" Width="68" SelectionChanged="SyncPolicyControl_Changed"/>
                                        </StackPanel>

                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="LastPurgeStatusText" Text="Last cleanup: Never" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock x:Name="NextPurgeStatusText" Text="Next cleanup: Not Scheduled" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button x:Name="SaveSyncPolicyBtn" Style="{StaticResource PosPrimaryButton}" Height="30" Padding="12,0" FontSize="12" Margin="0,0,8,0" Click="SaveSyncPolicyBtn_Click" Content="Save Policy"/>
                                                <Button x:Name="PurgeOldDataNowBtn" Style="{StaticResource PosDangerSoftButton}" Height="30" Padding="12,0" FontSize="12" Click="PurgeOldDataNowBtn_Click" Content="Clean Now"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 12 MODULE SYNC CARDS -->
                            <TextBlock Text="Module Synchronization Status (12 Models)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,2,0,8"/>

