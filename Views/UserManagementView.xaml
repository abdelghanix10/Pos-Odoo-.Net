<UserControl x:Class="OdooPosLogin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1084" d:DesignHeight="720"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.DataContext>
        <vm:UserManagementViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. COMPACT TOP CONTROL BAR (48px) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Sync + Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PosPrimaryButton}" Height="32" Command="{Binding SyncFromOdooCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToListCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbRootText" Text="Users" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CrumbRootText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                        <TextBlock Text="  /  " Foreground="{StaticResource MutedTextBrush}" FontSize="15.5"/>
                        <TextBlock Text="{Binding SelectedUser.Name}" Foreground="{StaticResource OdooPurpleBrush}" FontSize="15.5" FontWeight="Bold" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Search Box (Hidden inside Detail view to avoid crowding) -->
                <Border Grid.Column="1" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource PosSearchBorderStyle}"
                        Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="12" Height="12" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#64748B" StrokeThickness="2"/>
                                <Path Data="M 14,14 L 20,20" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="Search users..." Foreground="{StaticResource PlaceholderTextBrush}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0">
                            <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right: Save/Discard + Pager + View Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource PosTealButton}" Height="30" Padding="12,0" FontSize="12.5" Command="{Binding SaveCredentialsCommand}" Margin="0,0,6,0" Content="Save"/>
                        <Button Style="{StaticResource PosSecondaryButton}" Height="30" Padding="12,0" FontSize="12.5" Command="{Binding DiscardCommand}" Content="Discard"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ListCounterText}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding PagerText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding PreviousRecordCommand}" IsEnabled="{Binding HasPreviousRecord}" Margin="0,0,2,0" ToolTip="Previous">
                        <Viewbox Width="7" Height="11"><Path Data="M 7,1 L 1.5,6.5 L 7,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                    </Button>
                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}" Command="{Binding NextRecordCommand}" IsEnabled="{Binding HasNextRecord}" Margin="0,0,10,0" ToolTip="Next">
                        <Viewbox Width="7" Height="11"><Path Data="M 1.5,1 L 7,6.5 L 1.5,12" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button Command="{Binding SwitchToListCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="List">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsListView}" Value="True"><Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/></Canvas></Viewbox>
                        </Button>
                        <Button Command="{Binding SwitchToKanbanCommand}" Width="30" Height="28" Cursor="Hand" ToolTip="Kanban">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,1,1,1"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsKanbanView}" Value="True"><Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" Fill="{StaticResource PrimaryTextBrush}"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="10" Fill="{StaticResource PrimaryTextBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. WORKSPACE CONTENT -->
        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <!-- KANBAN VIEW (3 Cards Per Row at 1280px) -->
                <ScrollViewer Visibility="{Binding IsKanbanView, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Padding="10">
                    <ItemsControl ItemsSource="{Binding FilteredUsers}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosUserRecord}">
                                <Button Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Margin="5" Width="336" Height="86" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder" Style="{StaticResource PosCardBorderStyle}" Padding="11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="58" Height="58" CornerRadius="10" Background="{Binding AvatarSoftBrush}" ClipToBounds="True" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarAccentBrush}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialsVisibility}"/>
                                                            <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill" Visibility="{Binding HasCustomImageVisibility}"/>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Grid.Column="1" Margin="11,0,0,0">
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                                                            <Ellipse Width="9" Height="9" Fill="{Binding StatusDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding Login}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                            <Border Background="{Binding RoleBadgeBackground}" CornerRadius="7" Padding="7,1" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding RoleDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RoleBadgeForeground}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Language}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- LIST VIEW -->
                <Border Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Login" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Role" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosUserRecord}">
                                        <Button Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBdr" Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,7" MinHeight="40">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="24" Height="24" CornerRadius="6" Background="{Binding AvatarSoftBrush}" Margin="0,0,9,0" ClipToBounds="True">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialsVisibility}"/>
                                                                        <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill" Visibility="{Binding HasCustomImageVisibility}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Login}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="2" Background="{Binding RoleBadgeBackground}" CornerRadius="9" Padding="9,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RoleDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding RoleBadgeForeground}"/>
                                                            </Border>
                                                            <Border Grid.Column="3" Background="{Binding ListStatusBackground}" CornerRadius="9" Padding="9,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding ListStatusForeground}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBdr" Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- EMPTY STATE -->
                <Border Style="{StaticResource PosCardBorderStyle}" Padding="28,24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Users Synchronized Yet" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Sync active users from your Odoo instance to assign roles and security PINs." FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource PosPrimaryButton}" Command="{Binding SyncFromOdooCommand}" HorizontalAlignment="Center" Content="Sync Users from Odoo"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- USER DETAIL VIEW (Compact 720p Form) -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <Border Style="{StaticResource PosCardBorderStyle}" Padding="24,20" MaxWidth="1020">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="{Binding SelectedUser.RoleBadgeBackground}" CornerRadius="8" Padding="8,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedUser.RoleDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedUser.RoleBadgeForeground}"/>
                                    </Border>
                                    <Border Background="{Binding SelectedUser.ListStatusBackground}" CornerRadius="8" Padding="8,2">
                                        <TextBlock Text="{Binding SelectedUser.Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedUser.ListStatusForeground}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedUser.Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedUser.Login}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" Width="74" Height="74" CornerRadius="12" Background="{Binding SelectedUser.AvatarSoftBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding SelectedUser.Initials}" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedUser.InitialsVisibility}"/>
                                    <Image Source="{Binding SelectedUser.AvatarBitmap}" Stretch="UniformToFill" Visibility="{Binding SelectedUser.HasCustomImageVisibility}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>

                            <!-- Left: Profile Info -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ODOO PROFILE" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Email" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedUser.Email}" FontSize="13" TextTrimming="CharacterEllipsis"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Phone" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedUser.Phone}" FontSize="13"/></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Language" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedUser.Language}" FontSize="13"/></Grid>
                            </StackPanel>

                            <!-- Right: Per-User Credentials & POS Security -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PER-USER ODOO CREDENTIALS" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Server URL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource PosInputBorderStyle}" Height="34"><TextBox Text="{Binding OdooServerUrl, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Database Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource PosInputBorderStyle}" Height="34"><TextBox Text="{Binding OdooDatabase, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username / Login" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource PosInputBorderStyle}" Height="34"><TextBox Text="{Binding UserLogin, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password / API Key" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource PosInputBorderStyle}" Height="34"><TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                </Grid>

                                <Button Style="{StaticResource PosPrimaryButton}" Height="32" Command="{Binding TestUserConnectionCommand}"
                                        IsEnabled="{Binding IsTestingUserConnection, Converter={StaticResource InverseBooleanConverter}}" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding TestConnectionButtonText}" FontSize="12.5"/>
                                </Button>

                                <Border Height="1" Background="{StaticResource SubtleBorderLightBrush}" Margin="0,0,0,14"/>

                                <TextBlock Text="POS ROLES &amp; TERMINAL SECURITY" Style="{StaticResource PosSectionHeaderTextStyle}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="User Role" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Assigned POS Register" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailablePosConfigs}" SelectedItem="{Binding SelectedPosConfig, Mode=TwoWay}" DisplayMemberPath="Name" Style="{StaticResource OdooFilterComboBoxStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Security PIN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource PosInputBorderStyle}" Height="34"><TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding IsPosOnly, Mode=TwoWay}" Content="POS-Only Mode (Bypass dashboard &amp; sidebar; open register directly on login)" Margin="0,4,0,8"/>
                                <CheckBox Style="{StaticResource PosCheckBoxStyle}" IsChecked="{Binding IsVisibleInPos}" Content="Visible on POS Login Screen"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- TOAST -->
        <Border Grid.RowSpan="2" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Style="{StaticResource PosToastBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>