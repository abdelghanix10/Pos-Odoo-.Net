                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="PoS Categories (pos.category)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <Border Background="{StaticResource OdooTealSoftBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                    <TextBlock x:Name="CategoriesCountBadgeText" Text="0 records" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OdooTealBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                <TextBlock x:Name="LastCategoriesSyncedStatusText" Text="Last Synced: Never" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ProgressBar x:Name="CategoriesSyncProgressBar" IsIndeterminate="True" Width="80" Height="3" Visibility="Collapsed" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CategoriesSyncDetailText" Text="Synchronize POS categories, colors, and shop links." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="SyncCategoriesNowBtn" Style="{StaticResource OdooTealActionButtonStyle}" Click="SyncCategoriesNowBtn_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox x:Name="SettingsCatSyncIconBox" Width="13" Height="13" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform><RotateTransform x:Name="SettingsCatSyncIconRotation" Angle="0"/></Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsCatSyncButtonText" Text="Sync Categories"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 10. ATTRIBUTES (product.attribute) -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="8" Effect="{StaticResource CardShadowEffect}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Attributes (product.attribute)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <Border Background="{StaticResource OdooPurpleSoftBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                    <TextBlock x:Name="AttributesCountBadgeText" Text="0 records" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                <TextBlock x:Name="LastAttributesSyncedStatusText" Text="Last Synced: Never" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ProgressBar x:Name="AttributesSyncProgressBar" IsIndeterminate="True" Width="80" Height="3" Visibility="Collapsed" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AttributesSyncDetailText" Text="Synchronize product attributes and attribute values." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="SyncAttributesNowBtn" Style="{StaticResource OdooPrimaryActionButtonStyle}" Click="SyncAttributesNowBtn_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox x:Name="SettingsAttrSyncIconBox" Width="13" Height="13" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform><RotateTransform x:Name="SettingsAttrSyncIconRotation" Angle="0"/></Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsAttrSyncButtonText" Text="Sync Attributes"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 11. PRODUCT TAGS (product.tag) -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="8" Effect="{StaticResource CardShadowEffect}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Product Tags (product.tag)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <Border Background="{StaticResource OdooTealSoftBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                    <TextBlock x:Name="TagsCountBadgeText" Text="0 records" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OdooTealBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                <TextBlock x:Name="LastTagsSyncedStatusText" Text="Last Synced: Never" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ProgressBar x:Name="TagsSyncProgressBar" IsIndeterminate="True" Width="80" Height="3" Visibility="Collapsed" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TagsSyncDetailText" Text="Synchronize product tags and color badges." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="SyncTagsNowBtn" Style="{StaticResource OdooTealActionButtonStyle}" Click="SyncTagsNowBtn_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox x:Name="SettingsTagSyncIconBox" Width="13" Height="13" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform><RotateTransform x:Name="SettingsTagSyncIconRotation" Angle="0"/></Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsTagSyncButtonText" Text="Sync Tags"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 12. USERS (res.users) -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="8" Effect="{StaticResource CardShadowEffect}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Users (res.users)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <Border Background="{StaticResource OdooPurpleSoftBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                    <TextBlock x:Name="UsersCountBadgeText" Text="0 records" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                <TextBlock x:Name="LastSyncedStatusText" Text="Last Synced: Never" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ProgressBar x:Name="SyncProgressBar" IsIndeterminate="True" Width="80" Height="3" Visibility="Collapsed" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SyncDetailText" Text="Compare with Odoo: update existing, remove deleted." FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="SyncUsersNowBtn" Style="{StaticResource OdooPrimaryActionButtonStyle}" Click="SyncUsersNowBtn_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox x:Name="SettingsSyncIconBox" Width="13" Height="13" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                                    <Viewbox.RenderTransform><RotateTransform x:Name="SettingsSyncIconRotation" Angle="0"/></Viewbox.RenderTransform>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                                        <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="SettingsSyncButtonText" Text="Sync Users"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="OtherTabsEmptyContainer"
                            Visibility="Collapsed"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="28,22,28,32"
                            Effect="{StaticResource CardShadowEffect}">
                        <Grid x:Name="EmptySettingsContentContainer"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== CHILD MODULE VIEWS ==================== -->
            <local:CompanyManagementView x:Name="CompaniesViewControl" Visibility="Collapsed"/>
            <local:PaymentMethodManagementView x:Name="PaymentMethodsViewControl" Visibility="Collapsed"/>
            <local:UserManagementView x:Name="UsersViewControl" Visibility="Collapsed"/>
            <local:PosCategoryManagementView x:Name="CategoriesViewControl" Visibility="Collapsed"/>
            <local:ProductAttributeManagementView x:Name="AttributesViewControl" Visibility="Collapsed"/>
            <local:ProductTagManagementView x:Name="TagsViewControl" Visibility="Collapsed"/>
            <local:ProductManagementView x:Name="ProductsViewControl" Visibility="Collapsed"/>
            <local:ComboChoiceManagementView x:Name="ComboChoicesViewControl" Visibility="Collapsed"/>
            <local:SessionManagementView x:Name="SessionsViewControl" Visibility="Collapsed"/>
            <local:OrderManagementView x:Name="OrdersViewControl" Visibility="Collapsed"/>
            <local:PaymentManagementView x:Name="PaymentsViewControl" Visibility="Collapsed"/>
            <local:PosSettingsView x:Name="PosSettingsViewControl" Visibility="Collapsed"/>
            <local:PosDashboardView x:Name="DashboardViewControl" Visibility="Visible"/>

            <!-- ==================== TOAST BANNER NOTIFICATION ==================== -->
            <Border x:Name="ShellToastBanner"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,32"
                    Background="{StaticResource PrimaryTextBrush}"
                    CornerRadius="8"
                    Padding="20,12"
                    Effect="{StaticResource CardShadowEffect}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ShellToastDot" Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ShellToastMessageText"
                               Text="Settings saved successfully."
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== FULL-SCREEN POS REGISTER & SELLING VIEW ==================== -->
        <local:PosRegisterView x:Name="RegisterViewControl"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Panel.ZIndex="500"
                               Visibility="Collapsed"/>
    </Grid>
</UserControl>