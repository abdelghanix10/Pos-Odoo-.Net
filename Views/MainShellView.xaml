<UserControl x:Class="OdooPosLogin.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="820"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.Resources>
        <!-- ==================== COLOR PALETTE ==================== -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="ActiveGreenSoftBrush" Color="#ECFDF5"/>

        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerRedSoftBrush" Color="#FEF2F2"/>

        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="WarningAmberSoftBrush" Color="#FFFBEB"/>

        <!-- ==================== SHADOW EFFECTS ==================== -->
        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="16"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.05"/>

        <DropShadowEffect x:Key="SidebarShadowEffect"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="0"
                          Color="#111827"
                          Opacity="0.04"/>

        <!-- ==================== SIDEBAR ITEM BUTTON STYLE (INACTIVE) ==================== -->
        <Style x:Key="SidebarItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ACTIVE SIDEBAR ITEM STYLE ==================== -->
        <Style x:Key="ActiveSidebarItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,1.5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border Width="3.5"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource OdooPurpleBrush}"
                                        CornerRadius="2"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBDCE6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3D1DD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ODOO TAB BUTTON STYLES ==================== -->
        <Style x:Key="OdooTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border Height="3"
                                        Background="Transparent"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooActiveTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border Height="3"
                                        Background="{StaticResource OdooPurpleBrush}"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== FORM INPUT FIELD CONTAINER STYLE ==================== -->
        <Style x:Key="SettingsInputBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button (Purple) -->
        <Style x:Key="OdooPrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button (Teal) -->
        <Style x:Key="OdooTealActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooTealBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooTealHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined Neutral Action Button -->
        <Style x:Key="OdooOutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource DangerRedSoftBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FECACA"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ==================== MAIN APPLICATION SHELL ROOT ==================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarMenuColumn" Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. MODERN ODOO 20 COLLAPSIBLE LEFT SIDEBAR                              -->
        <!-- ======================================================================= -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                Effect="{StaticResource SidebarShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR: APP BRAND LABEL + COLLAPSE/EXPAND BUTTON -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource SubtleBorderLightBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,0">
                    <Grid>
                        <TextBlock x:Name="SidebarBrandTitle"
                                   Text="Navigation"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                        <Button x:Name="SidebarToggleButton"
                                Click="SidebarToggle_Click"
                                Width="30" Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Collapse / Expand Sidebar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TglBdr" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TglBdr" Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="13" Height="13">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="ToggleIconPath"
                                          Data="M 6,4 L 6,20 M 18,5 L 11,12 L 18,19"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="ToggleIconScale" ScaleX="1"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- NAVIGATION ITEMS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8">
                    <StackPanel>
                        <!-- SECTION 1: POINT OF SALE -->
                        <TextBlock x:Name="SectionRegisterHeader"
                                   Text="POINT OF SALE"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="18,6,0,4"/>

                        <!-- 1. DASHBOARD -->
                        <Button x:Name="NavDashboardBtn"
                                Style="{StaticResource ActiveSidebarItemButtonStyle}"
                                Click="NavDashboard_Click"
                                ToolTip="Point of Sale Dashboard">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooPurpleBrush}"/>
                                        <Rectangle Canvas.Left="13" Canvas.Top="3" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooTealBrush}"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="13" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooTealBrush}"/>
                                        <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="DashboardLabel" Text="Dashboard" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 2. SESSIONS -->
                        <Button x:Name="NavSessionsBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavSessions_Click"
                                ToolTip="Point of Sale Sessions">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="14" RadiusX="2.5" RadiusY="2.5" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Path Data="M 8,21 H 16 M 12,17 V 21" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="7.5" Width="5" Height="5" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="SessionsLabel" Text="Sessions" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 3. ORDERS -->
                        <Button x:Name="NavOrdersBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavOrders_Click"
                                ToolTip="Orders">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 6,2 L 3,6 V 20 C 3,21.1 3.9,22 5,22 H 19 C 20.1,22 21,21.1 21,20 V 6 L 18,2 H 6 Z" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2" Fill="{StaticResource OdooTealSoftBrush}" StrokeLineJoin="Round"/>
                                        <Path Data="M 3,6 H 21 M 16,10 C 16,12.2 14.2,14 12,14 C 9.8,14 8,12.2 8,10" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="OrdersLabel" Text="Orders" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 4. PAYMENTS -->
                        <Button x:Name="NavPaymentsBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavPayments_Click"
                                ToolTip="Payments">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="2" Canvas.Top="5" Width="20" Height="14" RadiusX="2.5" RadiusY="2.5" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" Fill="{StaticResource OdooPurpleSoftBrush}"/>
                                        <Line X1="2" Y1="10" X2="22" Y2="10" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Rectangle Canvas.Left="5" Canvas.Top="13" Width="5" Height="3" RadiusX="1" RadiusY="1" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="PaymentsLabel" Text="Payments" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 5. PAYMENT METHODS -->
                        <Button x:Name="NavPaymentMethodsBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavPaymentMethods_Click"
                                ToolTip="POS Payment Methods">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="2" Canvas.Top="4" Width="16" Height="11" RadiusX="2" RadiusY="2" Stroke="{StaticResource OdooTealBrush}" StrokeThickness="2"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="9" Width="16" Height="11" RadiusX="2" RadiusY="2" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2" Fill="#FFFFFF"/>
                                        <Ellipse Canvas.Left="12" Canvas.Top="12.5" Width="4" Height="4" Fill="{StaticResource OdooTealBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="PaymentMethodsLabel" Text="Payment Methods" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- SECTION 2: CATALOG -->
                        <TextBlock x:Name="SectionCatalogHeader"
                                   Text="CATALOG"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="18,14,0,4"/>

                        <!-- 6. PRODUCTS -->
                        <Button x:Name="NavProductsBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavProducts_Click"
                                ToolTip="Products">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 L 21,7 L 12,12 L 3,7 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 3,7 L 12,12 L 12,22 L 3,17 Z" Fill="{StaticResource OdooPurpleBrush}" Opacity="0.85"/>
                                        <Path Data="M 12,12 L 21,7 L 21,17 L 12,22 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="ProductsLabel" Text="Products" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 7. COMBO CHOICES -->
                        <Button x:Name="NavCombosBtn"
                                Style="{StaticResource SidebarItemButtonStyle}"
                                Click="NavCombos_Click"
                                ToolTip="Combo Choices">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 4,9 C 4,5.5 7.5,3.5 12,3.5 C 16.5,3.5 20,5.5 20,9 Z" Fill="{StaticResource OdooTealBrush}"/>
                                        <Path Data="M 3,12 H 21" Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
                                        <Path Data="M 4,15 C 4,18.5 7.5,20.5 12,20.5 C 16.5,20.5 20,18.5 20,15 Z" Fill="{StaticResource OdooPurpleBrush}"/>
                                    </Canvas>
                                </Viewbox>
