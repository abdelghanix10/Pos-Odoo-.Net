<UserControl x:Class="OdooPosLogin.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:OrdersViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SubtleBorderLightBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealHoverBrush" Color="#01666B"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>

        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="12"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Odoo 20 Boxed Notebook Tab Style (Matching Product Detail) -->
        <Style x:Key="OdooNotebookTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5C5B70"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,-1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OdooTabButtonStyle" TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}"/>
        <Style x:Key="OdooActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
        </Style>

        <Style x:Key="DetailPagerChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. TOP ODOO 20 CONTROL BAR                                              -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sync Button & Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OdooPrimaryButtonStyle}"
                            Command="{Binding SyncOrdersCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z" Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SyncButtonText}"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Command="{Binding CloseDetailCommand}">
                            <TextBlock Text="Orders"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Border Background="{StaticResource OdooPurpleSoftBrush}"
                                CornerRadius="10"
                                Margin="10,0,0,0"
                                Padding="8,2.5"
                                Visibility="{Binding SessionFilter, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SessionFilter}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                <Button Background="Transparent" BorderThickness="0" Padding="5,0,0,0" Cursor="Hand" Command="{Binding ClearSessionFilterCommand}">
                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text="  /  " FontSize="17" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedOrder.Name}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER: PILL SEARCH BAR -->
                <Border Grid.Column="1"
                        MaxWidth="480"
                        Width="420"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#8583A8"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2"/>
                                <Path Data="M 14,14 L 20,20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Grid.Column="1"
                                   Text="Search..."
                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                   FontSize="13.5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13.5"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- RIGHT: PAGER (< >) + LIST/KANBAN SWITCHER -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListCounterText}"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding PagerText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding PreviousRecordCommand}"
                            IsEnabled="{Binding HasPreviousRecord}"
                            Margin="0,0,2,0"
                            ToolTip="Previous Order">
                        <Viewbox Width="8" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 7,1 L 1.5,6.5 L 7,12"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource DetailPagerChevronButtonStyle}"
                            Command="{Binding NextRecordCommand}"
                            IsEnabled="{Binding HasNextRecord}"
                            Margin="0,0,10,0"
                            ToolTip="Next Order">
                        <Viewbox Width="8" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 1.5,1 L 7,6.5 L 1.5,12"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <!-- List View Button (☰) -->
                        <Button Command="{Binding SwitchToListCommand}"
                                Width="34" Height="32"
                                Cursor="Hand"
                                ToolTip="List">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="Background" Value="#E6E4F0"/>
                                            <Setter Property="BorderBrush" Value="#714B67"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Kanban View Button (⊞) -->
                        <Button Command="{Binding SwitchToKanbanCommand}"
                                Width="34" Height="32"
                                Cursor="Hand"
                                ToolTip="Kanban">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,1,1,1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKanbanView}" Value="True">
                                            <Setter Property="Background" Value="#E6E4F0"/>
                                            <Setter Property="BorderBrush" Value="#714B67"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="7" Height="16" Fill="{StaticResource PrimaryTextBrush}"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="10" Fill="{StaticResource PrimaryTextBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. MAIN WORKSPACE AREA                                                  -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="1">

            <Grid Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">

                <!-- ==================== VIEW 1A: ORDERS LIST VIEW (Screenshot 9) ==================== -->
                <Border Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="1" Text="Order Ref" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Session" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Date" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Point of Sale" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Receipt Number" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="Order Number" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="Cashier" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="Total" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="9" Text="Status" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- TABLE BODY -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                        <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBdr" Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,9" MinHeight="42">
                                                        <Grid Opacity="{Binding IsCancelled, Converter={x:Static local:CancelledOpacityConverter.Instance}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="2.1*"/>
                                                                <ColumnDefinition Width="1.8*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.4*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Drag Handle ⋮⋮ -->
                                                            <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SessionName}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding DateShortDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding PosConfigName}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding PosReference}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding TrackingNumber}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding CashierName}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="8" Text="{Binding TotalDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                            <Border Grid.Column="9"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding ListStatusBackground}"
                                                                    CornerRadius="10"
                                                                    Padding="10,2">
                                                                <TextBlock Text="{Binding StateDisplay}"
                                                                           FontSize="11.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding ListStatusForeground}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBdr" Property="Background" Value="#F9FAFB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- TABLE FOOTER: GRAND TOTAL ALIGNED UNDER TOTAL COLUMN -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="8"
                                           Text="{Binding GrandTotalText}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== VIEW 1B: ORDERS KANBAN VIEW (Screenshot 10) ==================== -->
                <ScrollViewer Visibility="{Binding IsKanbanView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10,12">
                    <ItemsControl ItemsSource="{Binding FilteredOrders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        Margin="6"
                                        Width="315"
                                        Height="100"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder"
                                                    Background="#FFFFFF"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="14,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Top Row: Order Ref + Total -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,65,0"/>
                                                        <TextBlock Text="{Binding TotalDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>

                                                    <!-- Middle Row: Receipt Number -->
                                                    <TextBlock Grid.Row="1" Text="{Binding PosReference}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>

                                                    <!-- Bottom Row: Date + Status Pill -->
                                                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding DateShortDisplay}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding KanbanStatusBackground}"
                                                                CornerRadius="10"
                                                                Padding="10,2">
                                                            <TextBlock Text="{Binding StateDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding KanbanStatusForeground}"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE PLACEHOLDER -->
                <Border Background="#FFFFFF"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="32,28"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No Orders Synchronized Yet" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Click 'Sync from Odoo' to pull POS orders and order lines." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource OdooPrimaryButtonStyle}" Command="{Binding SyncOrdersCommand}" Content="Sync Orders from Odoo" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================================================================== -->
            <!-- VIEW 2: ORDER DETAIL / FORM VIEW (Including Cancelled & Refund Link) -->
            <!-- =================================================================== -->
            <ScrollViewer Visibility="{Binding IsDetailViewVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,18">
                <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">

                    <!-- TOP ACTION & PIPELINE SUB-HEADER BAR -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20,12"
                            Margin="0,0,0,16"
                            Effect="{StaticResource SubtleCardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- A. NORMAL PIPELINE: New > Paid > Posted -->
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SelectedOrder.NormalPipelineVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                            Padding="14,5" CornerRadius="4">
                                        <TextBlock Text="New" FontSize="13"
                                                   FontWeight="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageFontWeightConverter.Instance}}"
                                                   Foreground="{Binding SelectedOrder.IsStageNew, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                    </Border>
                                    <TextBlock Text="›" FontSize="16" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="2,-2,2,0"/>

                                    <Border Background="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                            Padding="14,5" CornerRadius="4">
                                        <TextBlock Text="Paid" FontSize="13"
                                                   FontWeight="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageFontWeightConverter.Instance}}"
                                                   Foreground="{Binding SelectedOrder.IsStagePaid, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                    </Border>
                                    <TextBlock Text="›" FontSize="16" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="2,-2,2,0"/>

                                    <Border Background="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageBackgroundConverter.Instance}}"
                                            Padding="14,5" CornerRadius="4">
                                        <TextBlock Text="Posted" FontSize="13"
                                                   FontWeight="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageFontWeightConverter.Instance}}"
                                                   Foreground="{Binding SelectedOrder.IsStagePosted, Converter={x:Static local:ActiveStageForegroundConverter.Instance}}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- B. CANCELLED PIPELINE: New > Cancelled (Matching Screenshot 15) -->
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SelectedOrder.CancelledPipelineVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#FFFFFF" Padding="14,5" CornerRadius="4">
                                        <TextBlock Text="New" FontSize="13" FontWeight="Medium" Foreground="#6B7280"/>
                                    </Border>
                                    <TextBlock Text="›" FontSize="16" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="2,-2,2,0"/>
                                    <Border Background="#E6E4F0" Padding="14,5" CornerRadius="4">
                                        <TextBlock Text="Cancelled" FontSize="13" FontWeight="Bold" Foreground="#111827"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- MAIN SHEET CARD -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="32,26"
                            Effect="{StaticResource SubtleCardShadow}">
                        <StackPanel>
                            <!-- HEADER: Order Title on Left + Linked Refund Smart Button on Right -->
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Point of Sale Order"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedOrder.Name}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>

                                <!-- Smart Stat Button for Linked Refund / Original Order -->
                                <Button Grid.Column="1"
                                        Command="{Binding OpenLinkedOrderCommand}"
                                        Visibility="{Binding SelectedOrder.LinkedRefundsVisibility}"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource OdooPurpleBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Padding="16,8"
                                        VerticalAlignment="Center"
                                        ToolTip="Click to open linked Refund / Original Order">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RefBdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="↺" FontSize="18" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SelectedOrder.LinkedRefundCountDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                        <TextBlock Text="{Binding SelectedOrder.LinkedRefundSummary}" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RefBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,20"/>

                            <!-- 2-COLUMN INFO GRID -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.DateDisplay}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fiscal Position" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.FiscalPosition}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Linked Refund / Original Order Reference Row -->
                                    <Grid Margin="0,0,0,16"
                                          Visibility="{Binding SelectedOrder.LinkedRefundsVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SelectedOrder.LinkedRefundLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedOrder.LinkedRefundOrders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                                    <Button Command="{Binding DataContext.OpenLinkedOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            Background="{StaticResource OdooPurpleSoftBrush}"
                                                            BorderBrush="{StaticResource OdooPurpleBrush}"
                                                            BorderThickness="1"
                                                            Padding="10,3"
                                                            Margin="0,0,6,4">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="↺ " FontSize="12" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                                                        <TextBlock Text="{Binding TotalDisplay, StringFormat=' ({0})'}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Served by" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource OdooPurpleSoftBrush}" Margin="0,0,8,0" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding SelectedOrder.CashierInitials}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OdooPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding SelectedOrder.HasNoCashierAvatar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Image Source="{Binding SelectedOrder.CashierAvatarBitmap}" Stretch="UniformToFill"
                                                           Visibility="{Binding SelectedOrder.HasCashierAvatar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedOrder.CashierName}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Session" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.SessionName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource OdooPurpleBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Edited" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedOrder.IsEdited}" IsEnabled="False" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- BOXED NOTEBOOK TAB BAR (Products | Payments | Extra Info - Matching Product Detail) -->
                            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Margin="-32,0,-32,24" Padding="32,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Products"
                                            Command="{Binding SelectTabCommand}"
                                            CommandParameter="Products">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProductsTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Payments"
                                            Command="{Binding SelectTabCommand}"
                                            CommandParameter="Payments">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaymentsTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Extra Info"
                                            Command="{Binding SelectTabCommand}"
                                            CommandParameter="ExtraInfo">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OdooNotebookTabStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExtraInfoTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- TAB CONTENT 1: PRODUCTS -->
                            <StackPanel Visibility="{Binding IsProductsTab, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Product" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Edited" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="Quantity" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="Unit Price" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="Disc.%" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="Taxes" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="Tax Excl." FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="Tax Incl." FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedOrder.Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEdited}" IsEnabled="False" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding QtyDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PriceUnitDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding DiscountDisplay}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="5" HorizontalAlignment="Center" Background="#E5E7EB" CornerRadius="10" Padding="8,2">
                                                                <TextBlock Text="{Binding Taxes}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="6" Text="{Binding PriceSubtotalDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding PriceSubtotalInclDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- BOTTOM-RIGHT STACKED TOTALS -->
                                <Grid HorizontalAlignment="Right" Width="380" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Taxes:" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.TaxDisplay}" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrder.TotalDisplay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" Margin="0,6"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Paid (with rounding):" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.PaidDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" Margin="0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Margin:" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOrder.MarginDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OdooTealBrush}" TextAlignment="Right" Margin="0,4"/>
                                </Grid>
                            </StackPanel>

                            <!-- TAB CONTENT 2: PAYMENTS -->
                            <StackPanel Visibility="{Binding IsPaymentsTab, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Payment Method" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="Amount" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedOrder.Payments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SubtleBorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PaymentDateDisplay}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding PaymentMethodName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- TAB CONTENT 3: EXTRA INFO -->
                            <StackPanel Visibility="{Binding IsExtraInfoTab, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.Company}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Receipt Number" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrder.PosReference}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Order Number" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.TrackingNumber}" FontSize="13.5" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOAST BANNER -->
        <Border Grid.Row="1"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>