<UserControl x:Class="OdooPosLogin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F9FAFB"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.Resources>
        <!-- ==================== COLOR PALETTE ==================== -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>
        
        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#714B67"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5D3D54"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#F3ECF1"/>
        
        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>
        
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#9CA3AF"/>
        
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerRedHoverBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="DangerRedSoftBrush" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ModalBackdropBrush" Color="#88111827"/>

        <!-- ==================== SHADOW EFFECTS ==================== -->
        <DropShadowEffect x:Key="SubtleCardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.04"/>

        <DropShadowEffect x:Key="CardHoverShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#714B67"
                          Opacity="0.10"/>

        <DropShadowEffect x:Key="SheetShadow"
                          BlurRadius="24"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#111827"
                          Opacity="0.06"/>

        <!-- ==================== PRIMARY PURPLE BUTTON ("Sync from Odoo") ==================== -->
        <Style x:Key="OdooPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ICON / SECONDARY BUTTON STYLE ==================== -->
        <Style x:Key="OdooIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== KANBAN USER CARD BUTTON STYLE ==================== -->
        <Style x:Key="KanbanCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="356"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="0,0,18,18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Effect="{StaticResource SubtleCardShadow}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== FORM INPUT CONTAINER STYLE (FOCUS HIGHLIGHT) ==================== -->
        <Style x:Key="FormInputBoxBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Shared Top Control Bar -->
            <RowDefinition Height="68"/>
            <!-- 2. Active View Area (Kanban or Form) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- 1. SHARED TOP CONTROL BAR                                               -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: "Sync from Odoo" Button (Replaces "New") + Breadcrumb + Save/Discard -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Primary Purple "Sync from Odoo" Button with Loading Spinner Support -->
                    <Button x:Name="TopSyncFromOdooBtn"
                            Style="{StaticResource OdooPrimaryButtonStyle}"
                            Click="SyncUsersButton_Click"
                            ToolTip="Synchronize users from Odoo Online"
                            Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="UserSyncIconBox" Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="UserSyncIconRotation" Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,4 A 8,8 0 0 1 20,12 L 18,12 A 6,6 0 0 0 12,6 L 12,9 L 7.5,4.5 L 12,0 Z"
                                          Fill="#FFFFFF"/>
                                    <Path Data="M 12,20 A 8,8 0 0 1 4,12 L 6,12 A 6,6 0 0 0 12,18 L 12,15 L 16.5,19.5 L 12,24 Z"
                                          Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TopSyncButtonText"
                                       Text="Sync from Odoo"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Breadcrumb: "Users" (Clickable in Form View to Return to Kanban) -->
                    <Button x:Name="BreadcrumbUsersButton"
                            Click="BreadcrumbUsers_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="CrumbText"
                                           Text="Users"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CrumbText" Property="Foreground" Value="{StaticResource OdooPurpleBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Breadcrumb Sub-path (" / User Name") -->
                    <StackPanel x:Name="BreadcrumbFormSubPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock Text="  /  "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BreadcrumbCurrentTitle"
                                   Text="User Profile"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Save / Discard Icon Buttons (Visible in Form View for Local Credentials) -->
                    <StackPanel x:Name="FormSaveDiscardPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                        <!-- Save Button (Updates Local POS PIN / Password) -->
                        <Button Style="{StaticResource OdooIconButtonStyle}"
                                BorderBrush="{StaticResource OdooTealBrush}"
                                Background="{StaticResource OdooTealSoftBrush}"
                                ToolTip="Save Local POS Credentials"
                                Click="SaveUserButton_Click"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 20,6 L 9,17 L 4,12"
                                              Stroke="{StaticResource OdooTealBrush}"
                                              StrokeThickness="2.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Save"
                                           Foreground="{StaticResource OdooTealBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Discard Button -->
                        <Button Style="{StaticResource OdooIconButtonStyle}"
                                ToolTip="Discard Changes"
                                Click="DiscardUserButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 18,6 L 6,18 M 6,6 L 18,18"
                                              Stroke="{StaticResource SecondaryTextBrush}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Discard"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontWeight="Medium"
                                           FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER (KANBAN ONLY): Pill-Shaped Search Bar with Filter Tags -->
                <Border x:Name="KanbanSearchBarContainer"
                        Grid.Column="1"
                        MaxWidth="480"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F3F4F6"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Magnifier Icon -->
                        <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13"
                                         Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2.2"/>
                                <Path Data="M 13.5,13.5 L 20,20"
                                      Stroke="{StaticResource SecondaryTextBrush}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Search Text Input -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholderText"
                                       Text="Search by name, login, or email..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchUsersTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     CaretBrush="{StaticResource OdooPurpleBrush}"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchUsersTextBox_TextChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT: Standardized Clean Empty Panel -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- 2. ACTIVE VIEW AREA: KANBAN GRID VIEW                                   -->
        <!-- ======================================================================= -->
        <ScrollViewer x:Name="KanbanViewContainer"
                      Grid.Row="1"
                      Visibility="Visible"
                      VerticalScrollBarVisibility="Auto"
                      Padding="32,24">
            <ItemsControl x:Name="UsersKanbanItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource KanbanCardButtonStyle}"
                                Tag="{Binding}"
                                Click="KanbanUserCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Avatar (64x64) -->
                                    <ColumnDefinition Width="64"/>
                                    <!-- User Data Stack -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Avatar (Initials or Custom Image) -->
                                <Border Grid.Column="0"
                                        Width="64" Height="64"
                                        CornerRadius="8"
                                        Background="{Binding AvatarSoftBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="{Binding AvatarAccentBrush}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding InitialsVisibility}"/>
                                        <Image Source="{Binding AvatarBitmap}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasCustomImageVisibility}"/>
                                    </Grid>
                                </Border>

                                <!-- Right: User Information -->
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Login}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                        <!-- Status Indicator Dot -->
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding StatusDotBrush}"
                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"/>

                                        <!-- POS Access Badge -->
                                        <Border Visibility="{Binding PosBadgeVisibility}"
                                                Background="{StaticResource OdooTealSoftBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="12,0,0,0">
                                            <TextBlock Text="POS ACCESS"
                                                       Foreground="{StaticResource OdooTealBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ======================================================================= -->
        <!-- 3. ACTIVE VIEW AREA: USER DETAIL VIEW (READ-ONLY ODOO PROFILE)          -->
        <!-- ======================================================================= -->
        <ScrollViewer x:Name="FormViewContainer"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      Padding="32,28">
            <!-- Clean White Sheet Container Card on Light-Gray Background -->
            <Border MaxWidth="920"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40,36"
                    Effect="{StaticResource SheetShadow}">
                <StackPanel>
                    <!-- Odoo Synced Profile Info Banner -->
                    <Border Background="#F3ECF1"
                            BorderBrush="#E5D6E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 Z M 11,7 L 13,7 L 13,9 L 11,9 Z M 11,11 L 13,11 L 13,17 L 11,17 Z"
                                          Fill="{StaticResource OdooPurpleBrush}"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Odoo Online Profile (Read-Only)"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           FontSize="13.5"
                                           FontWeight="Bold"/>
                                <TextBlock Text="User identity and contact details are managed exclusively in Odoo Online. You can configure local POS security PIN, password, and login screen visibility on this terminal."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- =================================================== -->
                    <!-- HEADER SECTION: AVATAR (96x96) + NAME & LOGIN       -->
                    <!-- =================================================== -->
                    <Grid Margin="0,0,0,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Large Read-Only Avatar Display (96x96, Rounded Corners) -->
                        <Border Grid.Column="0"
                                Width="96" Height="96"
                                CornerRadius="8"
                                Background="{StaticResource OdooPurpleSoftBrush}"
                                BorderBrush="#D8C3D2"
                                BorderThickness="1.5"
                                ClipToBounds="True"
                                ToolTip="Profile avatar synced from Odoo">
                            <Grid>
                                <!-- Default User Vector Placeholder -->
                                <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Width="8" Height="8" Canvas.Left="8" Canvas.Top="3"
                                                 Stroke="{StaticResource OdooPurpleBrush}" StrokeThickness="2"/>
                                        <Path Data="M 4,20 C 4,15.5 7.5,14 12,14 C 16.5,14 20,15.5 20,20"
                                              Stroke="{StaticResource OdooPurpleBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <!-- Synced Avatar Image -->
                                <Image x:Name="FormAvatarImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Right of Avatar: Large Name Display + Read-Only Login -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- Field 1: Name Label + Odoo Synced Tag -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="FULL NAME"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                                <Border Background="{StaticResource OdooPurpleSoftBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="10" Height="10" Margin="0,0,4,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 12,2 C 9.24,2 7,4.24 7,7 L 7,10 L 6,10 C 4.9,10 4,10.9 4,12 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,12 C 20,10.9 19.1,10 18,10 L 17,10 L 17,7 C 17,4.24 14.76,2 12,2 Z M 9,7 C 9,5.34 10.34,4 12,4 C 13.66,4 15,5.34 15,7 L 15,10 L 9,10 L 9,7 Z"
                                                      Fill="{StaticResource OdooPurpleBrush}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Odoo Synced"
                                                   Foreground="{StaticResource OdooPurpleBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Prominent Underline Display for Name -->
                            <Border x:Name="NameUnderlineBorder"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,2,0,6"
                                    Margin="0,0,0,16">
                                <TextBox x:Name="FormNameTextBox"
                                         IsReadOnly="True"
                                         Focusable="False"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         FontFamily="Segoe UI Variable Display, Inter, Segoe UI"
                                         FontSize="26"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <!-- Field 2: Compact Read-Only Login -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Login"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Border x:Name="LoginInputBorder"
                                        Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        Width="360"
                                        Background="#F9FAFB"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="40"
                                        Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Prefix Icon (User Badge) -->
                                        <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Rectangle Width="20" Height="16" Canvas.Left="2" Canvas.Top="4"
                                                           RadiusX="2" RadiusY="2"
                                                           Stroke="{StaticResource SecondaryTextBrush}"
                                                           StrokeThickness="1.8"/>
                                                <Path Data="M 2,6 L 12,13 L 22,6"
                                                      Stroke="{StaticResource SecondaryTextBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>

                                        <TextBox Grid.Column="1"
                                                 x:Name="FormLoginTextBox"
                                                 IsReadOnly="True"
                                                 Focusable="False"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 FontSize="13"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,28"/>

                    <!-- =================================================== -->
                    <!-- DETAILS SECTION (2-COLUMN GRID BELOW HEADER)        -->
                    <!-- =================================================== -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left Column: Contact Info (Read-Only) -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                            <!-- Right Column: Local POS Credentials -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: CONTACT INFO (Email & Phone - Read-Only from Odoo) -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
                                <TextBlock Text="CONTACT INFORMATION"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                                <TextBlock Text="(Synced from Odoo)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Email Input (Read-Only) -->
                            <TextBlock Text="Email Address"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Background="#F9FAFB"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="42"
                                    Padding="12,0"
                                    Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="20" Height="16" Canvas.Left="2" Canvas.Top="4"
                                                       RadiusX="2" RadiusY="2"
                                                       Stroke="{StaticResource SecondaryTextBrush}"
                                                       StrokeThickness="1.8"/>
                                            <Path Data="M 2,6 L 12,13 L 22,6"
                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                  StrokeThickness="1.8"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBox Grid.Column="1"
                                             x:Name="FormEmailTextBox"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             FontSize="13"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Phone Input (Read-Only) -->
                            <TextBlock Text="Phone Number"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Background="#F9FAFB"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="42"
                                    Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 6.6,10.8 C 8,13.6 10.4,15.9 13.2,17.4 L 15.4,15.2 C 15.7,14.9 16.1,14.8 16.4,14.9 C 17.5,15.3 18.7,15.5 20,15.5 C 20.6,15.5 21,15.9 21,16.5 L 21,20 C 21,20.6 20.6,21 20,21 C 10.6,21 3,13.4 3,4 C 3,3.4 3.4,3 4,3 L 7.5,3 C 8.1,3 8.5,3.4 8.5,4 C 8.5,5.2 8.7,6.4 9.1,7.6 C 9.2,7.9 9.1,8.3 8.8,8.6 L 6.6,10.8 Z"
                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBox Grid.Column="1"
                                             x:Name="FormPhoneTextBox"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             FontSize="13"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: POS CREDENTIALS (Password & Numeric PIN - Configured Locally) -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
                                <TextBlock Text="LOCAL POS CREDENTIALS"
                                           Foreground="{StaticResource OdooTealBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                                <TextBlock Text="(Configured on Terminal)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Password Input (Editable Locally) -->
                            <TextBlock Text="Password"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Lock Icon -->
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="18" Height="11" Canvas.Left="3" Canvas.Top="11"
                                                       RadiusX="2" RadiusY="2"
                                                       Stroke="{StaticResource SecondaryTextBrush}"
                                                       StrokeThickness="2"/>
                                            <Path Data="M 7,11 L 7,7 C 7,4.2 9.2,2 12,2 C 14.8,2 17,4.2 17,7 L 17,11"
                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                  StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PasswordPlaceholderText"
                                                   Text="••••••••"
                                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"/>
                                        <PasswordBox x:Name="FormPasswordBox"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource PrimaryTextBrush}"
                                                     CaretBrush="{StaticResource OdooPurpleBrush}"
                                                     FontSize="14"
                                                     PasswordChanged="FormPasswordBox_PasswordChanged"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Masked Numeric Security PIN Input (Editable Locally) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="POS Security PIN"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="Medium"/>
                                <TextBlock Text=" (Numeric digits only)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource FormInputBoxBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Keypad / Dial Icon -->
                                    <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="5" Canvas.Top="4" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="10.2" Canvas.Top="4" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="15.5" Canvas.Top="4" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="5" Canvas.Top="9.5" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="10.2" Canvas.Top="9.5" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="15.5" Canvas.Top="9.5" Fill="{StaticResource OdooTealBrush}"/>
                                            <Ellipse Width="3.5" Height="3.5" Canvas.Left="10.2" Canvas.Top="15" Fill="{StaticResource OdooTealBrush}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PinPlaceholderText"
                                                   Text="e.g. •••• (4 to 6 digits)"
                                                   Foreground="{StaticResource PlaceholderTextBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"/>
                                        <PasswordBox x:Name="FormPinPasswordBox"
                                                     MaxLength="6"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource PrimaryTextBrush}"
                                                     CaretBrush="{StaticResource OdooTealBrush}"
                                                     FontSize="14"
                                                     PreviewTextInput="FormPinPasswordBox_PreviewTextInput"
                                                     DataObject.Pasting="FormPinPasswordBox_Pasting"
                                                     PasswordChanged="FormPinPasswordBox_PasswordChanged"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Visible in POS Login CheckBox -->
                            <Border Margin="0,18,0,0"
                                    Background="#F9FAFB"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10">
                                <CheckBox x:Name="FormVisibleInPosCheckBox"
                                          IsChecked="True"
                                          Cursor="Hand"
                                          VerticalContentAlignment="Center">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Visible on POS Login Screen"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="When enabled, this user appears as a touch card on the POS login screen"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ==================== TOAST BANNER NOTIFICATION ==================== -->
        <Border x:Name="UserActionToastBanner"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,32"
                Background="{StaticResource PrimaryTextBrush}"
                CornerRadius="8"
                Padding="20,12"
                Effect="{StaticResource SubtleCardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="ToastIndicatorDot" Width="10" Height="10" Fill="{StaticResource ActiveGreenBrush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="UserActionToastText"
                           Text="Sync Complete."
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
