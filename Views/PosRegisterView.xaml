<UserControl x:Class="OdooPosLogin.PosRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="732"
             Background="#F3F4F6"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.DataContext>
        <vm:PosRegisterViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BorderMidBrush" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#68598A"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#584878"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#E0DDF0"/>
        <SolidColorBrush x:Key="OdooPurpleTextBrush" Color="#2D1E40"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#017E84"/>
        <SolidColorBrush x:Key="OdooTealSoftBrush" Color="#E6F4F5"/>

        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#D92546"/>

        <SolidColorBrush x:Key="KeyAmberBrush" Color="#FCE8A6"/>
        <SolidColorBrush x:Key="KeyPeachBrush" Color="#FDD9CD"/>
        <SolidColorBrush x:Key="KeyCoralBrush" Color="#F8A2A5"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#9CA3AF"/>

        <DropShadowEffect x:Key="ModalShadow"
                          BlurRadius="24"
                          ShadowDepth="8"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.25"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.06"/>

        <!-- Numpad Key Style -->
        <Style x:Key="NumpadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Purple Action Button -->
        <Style x:Key="PosPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary White Button -->
        <Style x:Key="PosSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ======================================================================= -->
        <!-- BASE POS SCREEN (Always renders behind modal dialogs)                  -->
        <!-- ======================================================================= -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header Bar -->
                <RowDefinition Height="50"/>
                <!-- Row 1: Workspace Content (Register / Orders / Payment) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- =================================================================== -->
            <!-- 1. TOP POS HEADER BAR                                              -->
            <!-- =================================================================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Register/Orders toggle, +, Draft tabs -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center Spacer -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Search, barcode, cashier, hamburger -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Segmented Toggle & Draft Order Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Segmented Register / Orders Container -->
                        <Border Background="#F3F4F6"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <!-- Register Toggle Button -->
                                <Button Content="Register"
                                        Command="{Binding SwitchToRegisterViewCommand}"
                                        Height="32"
                                        Padding="14,0"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRegisterViewActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Orders Toggle Button -->
                                <Button Content="Orders"
                                        Command="{Binding SwitchToOrdersViewCommand}"
                                        Height="32"
                                        Padding="14,0"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOrdersViewActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- "+" Button to Create Parallel Draft Order -->
                        <Button Command="{Binding CreateNewDraftOrderCommand}"
                                Width="32"
                                Height="32"
                                Margin="8,0,0,0"
                                Background="#F3F4F6"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="New Parallel Order">
                            <TextBlock Text="⊕" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Numbered Pill Tabs for Active Draft Orders (e.g. 1002, 2001) -->
                        <ItemsControl ItemsSource="{Binding DraftOrders}" Margin="6,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosDraftOrder}">
                                    <Button Command="{Binding DataContext.SelectDraftOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="32"
                                            Padding="12,0"
                                            Margin="3,0"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource OdooPurpleTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding OrderNumber}" FontSize="13" VerticalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- RIGHT: Search, Barcode Icon, Cashier Avatar, Hamburger -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Rounded Search Input -->
                        <Border Width="240"
                                Height="34"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0"
                                Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Search products..."
                                           FontSize="13"
                                           Foreground="{StaticResource TextPlaceholderBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ProductSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>

                        <!-- Barcode Scanner Icon -->
                        <TextBlock Text="|||||||"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Barcode Scanner Ready"/>

                        <!-- Active Cashier Avatar (32x32) -->
                        <Border Width="32"
                                Height="32"
                                CornerRadius="6"
                                Background="{StaticResource OdooPurpleSoftBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                Margin="0,0,14,0"
                                ToolTip="{Binding CashierName}">
                            <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Hamburger Menu Button (☰) -->
                        <Button Command="{Binding OpenHamburgerMenuCommand}"
                                Width="36"
                                Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="POS Menu">
                            <TextBlock Text="☰" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =================================================================== -->
            <!-- 2. MAIN REGISTER CONTENT (When ActivePosView == "Register")         -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsRegisterViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <!-- Left Column: Order Cart & Touch Numpad (Width 360) -->
                    <ColumnDefinition Width="360"/>
                    <!-- Right Column: Category Strip & Product Selling Grid -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT PANEL: ORDER CART & NUMPAD ==================== -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceWhiteBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Scrollable Order Lines List -->
                            <RowDefinition Height="*"/>
                            <!-- Row 1: Totals Area (Taxes & Total) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Action Strip (Note, Park/Hold, More - No Customer) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 3: Touch Numpad & Payment Button -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ORDER LINES LIST -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CurrentOrder.CartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosCartItem}">
                                        <Border Height="36"
                                                Padding="12,0"
                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                BorderThickness="0,0,0,1"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.SelectCartLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding QuantityDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LineTotalDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- TOTALS AREA (Taxes and Total) -->
                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="16,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Taxes" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentOrder.TaxesDisplay}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Total" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentOrder.TotalDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ACTION STRIP (Note, Park/Hold, More Options - Customer removed!) -->
                        <Border Grid.Row="2"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,1,0,1"
                                Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Note Button -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Park / Hold Button (↑) -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- More Options Button (⋮) -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Note Button -->
                                <Button Grid.Column="0"
                                        Content="Note"
                                        Height="32"
                                        Margin="2,0"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Cursor="Hand"/>

                                <!-- Park / Hold Button (↑) -->
                                <Button Grid.Column="1"
                                        Command="{Binding ParkOrderCommand}"
                                        Width="38"
                                        Height="32"
                                        Margin="2,0"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="Park / Hold Order (↑)">
                                    <TextBlock Text="↑" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- More Options Button (⋮) -->
                                <Button Grid.Column="2"
                                        Width="38"
                                        Height="32"
                                        Margin="2,0"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="More Options">
                                    <TextBlock Text="⋮" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- TOUCH NUMPAD & PAYMENT BUTTON (4x4 Grid + Full-Width Payment) -->
                        <Border Grid.Row="3" Background="#F3F4F6" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: 1, 2, 3, Qty -->
                                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="1"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="2"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="3"/>
                                <Button Grid.Row="0" Grid.Column="3" Content="Qty" Command="{Binding SetNumpadModeCommand}" CommandParameter="Qty" Margin="2" Cursor="Hand" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NumpadMode}" Value="Qty">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Row 1: 4, 5, 6, % -->
                                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="4"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="5"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="6"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="%" Command="{Binding SetNumpadModeCommand}" CommandParameter="%" Margin="2" Cursor="Hand" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NumpadMode}" Value="%">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Row 2: 7, 8, 9, Price -->
                                <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="7"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="8"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="9"/>
                                <Button Grid.Row="2" Grid.Column="3" Content="Price" Command="{Binding SetNumpadModeCommand}" CommandParameter="Price" Margin="2" Cursor="Hand" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NumpadMode}" Value="Price">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OdooPurpleTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Row 3: +/- (amber), 0, . (peach), ⌫ (coral) -->
                                <Button Grid.Row="3" Grid.Column="0" Content="+/-" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyAmberBrush}" Command="{Binding NumpadKeyCommand}" CommandParameter="+/-"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="0"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="." Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyPeachBrush}" Command="{Binding NumpadKeyCommand}" CommandParameter="."/>
                                <Button Grid.Row="3" Grid.Column="3" Content="⌫" Style="{StaticResource NumpadButtonStyle}" Background="{StaticResource KeyCoralBrush}" Command="{Binding NumpadKeyCommand}" CommandParameter="⌫"/>

                                <!-- Row 4: Full-Width Purple Payment Button -->
                                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                                        Content="Payment"
                                        Command="{Binding OpenPaymentViewCommand}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Margin="2,4,2,2"
                                        Height="42"
                                        FontSize="15"
                                        FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== RIGHT PANEL: CATEGORIES & PRODUCT GRID ==================== -->
                <Grid Grid.Column="1" Background="#F9FAFB">
                    <Grid.RowDefinitions>
                        <!-- Category Strip -->
                        <RowDefinition Height="Auto"/>
                        <!-- Product Grid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CATEGORY STRIP -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceWhiteBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <!-- All Categories Pill -->
                                <Button Content="All"
                                        Command="{Binding SelectCategoryCommand}"
                                        CommandParameter="{x:Null}"
                                        Height="36"
                                        Padding="18,0"
                                        Margin="0,0,8,0"
                                        Cursor="Hand"
                                        BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                                                    <Setter Property="Background" Value="{StaticResource OdooTealBrush}"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Category List -->
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PosCategoryRecord}">
                                            <Button Content="{Binding Name}"
                                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="36"
                                                    Padding="18,0"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand"
                                                    BorderThickness="0"
                                                    FontWeight="SemiBold">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{Binding ColorBrush}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- PRODUCT SELLING GRID -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ProductRecord}">
                                    <!-- PRODUCT CARD (Square, Image, White label strip, bottom colored accent bar, black quantity badge) -->
                                    <Border Width="144"
                                            Height="144"
                                            Margin="7"
                                            Background="{StaticResource SurfaceWhiteBrush}"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Cursor="Hand"
                                            Effect="{StaticResource CardShadow}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderMidBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Image Area -->
                                                <RowDefinition Height="*"/>
                                                <!-- Bottom Label Strip -->
                                                <RowDefinition Height="32"/>
                                                <!-- Bottom Category Color Accent Bar -->
                                                <RowDefinition Height="3.5"/>
                                            </Grid.RowDefinitions>

                                            <!-- Image or Icon Placeholder -->
                                            <Grid Grid.Row="0" Margin="4">
                                                <Image Source="{Binding ImageBitmap}"
                                                       Stretch="Uniform"
                                                       Visibility="{Binding HasImage, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                <Border Background="#F9FAFB"
                                                        CornerRadius="4"
                                                        Visibility="{Binding HasImage, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="🥖"
                                                               FontSize="36"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.85"/>
                                                </Border>
                                            </Grid>

                                            <!-- Bottom White Label Strip -->
                                            <Border Grid.Row="1"
                                                    Background="#FFFFFF"
                                                    Padding="6,0"
                                                    BorderBrush="{StaticResource BorderLightBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Bottom Colored Category Accent Bar -->
                                            <Border Grid.Row="2"
                                                    Background="{Binding CategoryColorBrush}"
                                                    CornerRadius="0,0,5,5"/>

                                            <!-- Black Quantity Badge [ 1 ] (When added to current cart) -->
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,6,38"
                                                    Background="#111827"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    Visibility="{Binding HasCartQuantity, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding CartQuantity}"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- =================================================================== -->
            <!-- 3. IN-POS ORDERS VIEW (When ActivePosView == "Orders")              -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsOrdersViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <!-- Left: Orders List & Filter (Width 520) -->
                    <ColumnDefinition Width="520"/>
                    <!-- Right: Selected Order Detail & Load Order button -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT ORDERS LIST -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceWhiteBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Search & Status Filter Bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Orders Rows List -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Search & Filter Bar -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Box -->
                                <Border Grid.Column="0"
                                        Height="34"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,0"
                                        Margin="0,0,10,0">
                                    <Grid>
                                        <TextBox Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="13"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Search Orders..."
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding OrderSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                                    </Grid>
                                </Border>

                                <!-- Status Filter Dropdown -->
                                <ComboBox Grid.Column="1"
                                          Height="34"
                                          SelectedValue="{Binding OrderStatusFilter, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          FontSize="13">
                                    <ComboBoxItem Content="All Orders" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Ongoing (Draft)" Tag="Ongoing"/>
                                    <ComboBoxItem Content="Paid" Tag="Paid"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Orders List Rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredInPosOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                        <Border Height="56"
                                                Padding="14,0"
                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                BorderThickness="0,0,0,1"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.LoadOrderIntoRegisterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F9FAFB"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Info Icon -->
                                                    <ColumnDefinition Width="28"/>
                                                    <!-- Date / Order Ref -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Total -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Status Badge -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Delete Trash Icon (for draft orders) -->
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Info Icon ℹ -->
                                                <TextBlock Grid.Column="0" Text="ℹ" FontSize="14" Foreground="{StaticResource OdooTealBrush}" VerticalAlignment="Center"/>

                                                <!-- Order Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PosReference}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DateDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Total -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TotalDisplay}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="12,0"
                                                           VerticalAlignment="Center"/>

                                                <!-- Status Badge (Ongoing / Paid) -->
                                                <Border Grid.Column="3"
                                                        Background="{Binding StatusSoftBrush}"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateDisplay}"
                                                               Foreground="{Binding StatusBrush}"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <!-- Trash Delete Icon (Enabled for Draft Orders) -->
                                                <Button Grid.Column="4"
                                                        Command="{Binding DataContext.DeleteInPosOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="Delete Draft Order"
                                                        Visibility="{Binding IsDraft, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="🗑" FontSize="14" Foreground="{StaticResource DangerRedBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT ORDER DETAIL & LOAD ORDER ACTION -->
                <Grid Grid.Column="1" Background="#FFFFFF" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Order Header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedInPosOrder.PosReference, FallbackValue='Select an order'}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedInPosOrder.CashierName, FallbackValue='Cashier: Mitchell Admin'}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Items Table -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14">
                        <ItemsControl ItemsSource="{Binding SelectedInPosOrder.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosOrderLineRecord}">
                                    <Border Height="34" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding QtyDisplay}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PriceUnitDisplay}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PriceSubtotalInclDisplay}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Order Summary Totals -->
                    <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Taxes" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedInPosOrder.TaxDisplay}" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Total" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedInPosOrder.TotalDisplay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Purple Button: Load Order -->
                    <Button Grid.Row="3"
                            Content="Load Order"
                            Command="{Binding LoadOrderIntoRegisterCommand}"
                            CommandParameter="{Binding SelectedInPosOrder}"
                            Style="{StaticResource PosPrimaryButtonStyle}"
                            Height="44"
                            FontSize="15"
                            FontWeight="Bold"/>
                </Grid>
            </Grid>

            <!-- =================================================================== -->
            <!-- 4. PAYMENT SPLIT SCREEN (When IsPaymentViewOpen == true)            -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="#F3F4F6"
                  Visibility="{Binding IsPaymentViewOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <!-- Left Column: Payment Methods & Numpad -->
                    <ColumnDefinition Width="480"/>
                    <!-- Right Column: Giant Centered Currency Display -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PAYMENT COLUMN -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Payment Method Cards (Cash, Card) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Quick Tender Buttons (+10, +20, +50) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Action Buttons (< Back, Validate/Cash) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Payment Method Cards (Customer Account & Invoice REMOVED) -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Select Payment Method" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <!-- Cash Method Card -->
                                <Border Height="64"
                                        Margin="4"
                                        CornerRadius="6"
                                        BorderThickness="2"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Cash"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F9FAFB"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Cash">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💵" FontSize="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Cash" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card Method Card -->
                                <Border Height="64"
                                        Margin="4"
                                        CornerRadius="6"
                                        BorderThickness="2"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Card"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F9FAFB"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Card">
                                                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💳" FontSize="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Card" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Quick Tender Buttons (+10, +20, +50) -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,24">
                            <TextBlock Text="Quick Cash Tender" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3">
                                <Button Content="+ $ 10" Command="{Binding AddQuickTenderCommand}" CommandParameter="10" Height="42" Margin="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Foreground="#047857" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                                <Button Content="+ $ 20" Command="{Binding AddQuickTenderCommand}" CommandParameter="20" Height="42" Margin="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Foreground="#047857" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                                <Button Content="+ $ 50" Command="{Binding AddQuickTenderCommand}" CommandParameter="50" Height="42" Margin="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Foreground="#047857" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Action Buttons (< Back, Validate/Cash) -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="&lt; Back" Command="{Binding ClosePaymentViewCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="46" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Validate Payment" Command="{Binding ValidatePaymentCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Height="46" FontSize="15" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT GIANT CENTRED CURRENCY DISPLAY -->
                <Grid Grid.Column="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Total Amount Due" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding AmountDue, StringFormat='$ {0:N2}'}"
                                   FontSize="72"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- =================================================================== -->
            <!-- 5. PAYMENT CONFIRMATION SCREEN (Image 3)                           -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="#F9FAFB"
                  Visibility="{Binding IsPaymentConfirmationOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- Center Large Checkmark, Title, Giant Total -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Large Green Checkmark Circle -->
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource ActiveGreenBrush}" Margin="0,0,0,24">
                        <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Bold Title: Amount Paid -->
                    <TextBlock Text="Amount Paid" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <!-- Huge Amount -->
                    <TextBlock Text="{Binding ConfirmedPaidAmount, StringFormat='$ {0:N2}'}"
                               FontSize="84"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Bottom 4 Action Buttons (< Back, Print, Send Receipt, Continue) -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                    <Grid MaxWidth="800" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&lt; Back" Command="{Binding ContinueAfterPaymentCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Margin="6,0"/>
                        <Button Grid.Column="1" Content="🖨 Print" Command="{Binding PrintReceiptCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Margin="6,0"/>
                        <Button Grid.Column="2" Content="➤ Send Receipt" Command="{Binding SendReceiptCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Margin="6,0"/>
                        <Button Grid.Column="3" Content="Continue" Command="{Binding ContinueAfterPaymentCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Margin="6,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================================= -->
        <!-- MODALS & OVERLAYS (LAYERED ABOVE BASE SCREEN WITH DARKENED BACKDROP)    -->
        <!-- ======================================================================= -->

        <!-- ==================== MODAL 1: OPENING CONTROL MODAL (Image 1) ==================== -->
        <Grid Background="#99000000"
              Panel.ZIndex="1000"
              Visibility="{Binding IsOpeningControlModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Border Width="520"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    CornerRadius="8"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <!-- Modal Header -->
                    <TextBlock Text="Opening Control"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Opening Cash Field -->
                    <TextBlock Text="Opening cash"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <Border Height="40"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderMidBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OpeningCashInput, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding ClearOpeningCashCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="6,0">
                                <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="6,0"
                                    ToolTip="Denomination Counter">
                                <TextBlock Text="💵" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Opening Note Field -->
                    <TextBlock Text="Opening note"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <Border Height="80"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderMidBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,24">
                        <Grid>
                            <TextBox Text="{Binding OpeningNote, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="13"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Add an opening note..."
                                       FontSize="13"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding OpeningNote, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Border>

                    <!-- Footer Action Buttons (Open Register & Discard) -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Register"
                                Command="{Binding OpenRegisterSubmitCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="40"
                                Padding="20,0"
                                Margin="0,0,12,0"/>
                        <Button Content="Discard"
                                Command="{Binding DiscardOpeningControlCommand}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Height="40"
                                Padding="20,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL 2: HAMBURGER MENU MODAL (Image 4) ==================== -->
        <Grid Background="#99000000"
              Panel.ZIndex="1100"
              Visibility="{Binding IsHamburgerMenuOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Border Width="620"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    CornerRadius="8"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <!-- Header with Badge and Close ✕ -->
                    <Grid Margin="0,0,0,16">
                        <Border Background="{StaticResource OdooTealSoftBrush}"
                                CornerRadius="4"
                                Padding="8,4"
                                HorizontalAlignment="Left">
                            <TextBlock Text="⚚ LNA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OdooTealBrush}"/>
                        </Border>
                        <Button Command="{Binding CloseHamburgerMenuCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Right">
                            <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- 2x4 Action Tiles Grid -->
                    <UniformGrid Columns="4" Rows="2">
                        <!-- 1. Customer Display -->
                        <Border Height="86" Margin="4" CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding CustomerDisplayTileCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖥" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Customer Display" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Install App -->
                        <Border Height="86" Margin="4" CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding InstallAppTileCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📥" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Install App" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. Cash In/Out -->
                        <Border Height="86" Margin="4" CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding CashInOutTileCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💵" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Cash In/Out" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Reload Data -->
                        <Border Height="86" Margin="4" CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ReloadOdooDataCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Reload Data" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. Create Product -->
                        <Border Height="86" Margin="4" CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding CreateProductTileCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="➕" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Create Product" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. < Backend (Returns to Dashboard) -->
                        <Border Height="86" Margin="4" CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ReturnToBackendCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&lt;" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Backend" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 7. Close Register (Bold Red Tile #D92546) -->
                        <Border Grid.ColumnSpan="2" Height="86" Margin="4" CornerRadius="6" Background="{StaticResource DangerRedBrush}" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenClosingRegisterWorkflowCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔑" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Close Register" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL 3: CLOSING REGISTER DIALOG (Image 5) ==================== -->
        <Grid Background="#99000000"
              Panel.ZIndex="1200"
              Visibility="{Binding IsClosingRegisterModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Border Width="560"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    CornerRadius="8"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <!-- Header & Summary (e.g. 1 orders: $ 25.59) -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Closing Register" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SessionSummaryText}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Breakdown Table (Cash & Card, Customer Account removed!) -->
                    <Border Background="#F9FAFB" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Cash Breakdown -->
                            <TextBlock Text="Cash" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <TextBlock Text="Opening" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CashOpening, StringFormat='$ {0:N2}'}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Payments in Cash" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CashPayments, StringFormat='$ {0:N2}'}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Cash In / Out" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CashInOut, StringFormat='+ $ {0:N2}'}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Counted" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CashCounted, StringFormat='$ {0:N2}'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Difference" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CashDifference, StringFormat='$ {0:N2}'}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,8"/>

                            <!-- Card Breakdown -->
                            <TextBlock Text="Card" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <TextBlock Text="Counted" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CardCounted, StringFormat='$ {0:N2}'}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Difference" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CardDifference, StringFormat='$ {0:N2}'}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cash Count Input Field (with ✕ and 💵) -->
                    <TextBlock Text="Cash Count" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Border Height="38" Background="#FFFFFF" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ClosingCashCount, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ClearClosingCashCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0">
                                <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            </Button>
                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0">
                                <TextBlock Text="💵" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Closing Note Multiline Textbox -->
                    <TextBlock Text="Closing note" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Border Height="64" Background="#FFFFFF" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,20">
                        <Grid>
                            <TextBox Text="{Binding ClosingNote, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"/>
                            <TextBlock Text="Add a closing note..." FontSize="13" Foreground="{StaticResource TextPlaceholderBrush}" IsHitTestVisible="False" Visibility="{Binding ClosingNote, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Border>

                    <!-- Footer Buttons: Left (Close Register, Discard), Right (Cash In/Out, Daily Sale ⤓) -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Close Register" Command="{Binding SubmitCloseRegisterCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Discard" Command="{Binding DiscardClosingRegisterCommand}" Style="{StaticResource PosSecondaryButtonStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cash In/Out" Command="{Binding CashInOutTileCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Daily Sale ⤓" Command="{Binding PrintReceiptCommand}" Style="{StaticResource PosSecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== MODAL 4: DRAFT ORDERS WARNING ("Oh snap !") ==================== -->
            <!-- Layered directly over Closing Register modal -->
            <Grid Background="#66000000"
                  Visibility="{Binding IsDraftOrdersWarningModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Border Width="420"
                        Background="{StaticResource SurfaceWhiteBrush}"
                        CornerRadius="8"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Effect="{StaticResource ModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Oh snap !" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Command="{Binding DiscardClosingRegisterCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right">
                                <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="You cannot close the POS while there are still draft orders for the day."
                                   FontSize="13.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal">
                            <!-- Purple Review Orders Button -->
                            <Button Content="Review Orders"
                                    Command="{Binding ReviewDraftOrdersCommand}"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Margin="0,0,10,0"/>

                            <!-- White Cancel Orders Button -->
                            <Button Content="Cancel Orders"
                                    Command="{Binding CancelDraftOrdersAndCloseCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Toast Notifications in POS -->
        <Border Background="{StaticResource TextPrimaryBrush}"
                CornerRadius="8"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Panel.ZIndex="2000"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsPosToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding PosToastMessage}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Medium"/>
        </Border>
    </Grid>
</UserControl>
