<UserControl x:Class="OdooPosLogin.PosRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OdooPosLogin"
             xmlns:vm="clr-namespace:OdooPosLogin.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1366" d:DesignHeight="768"
             Background="#EFF1F5"
             FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Stylus.IsPressAndHoldEnabled="False">

    <UserControl.DataContext>
        <vm:PosRegisterViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="BorderMidBrush" Color="#CCCCCC"/>

        <SolidColorBrush x:Key="OdooPurpleBrush" Color="#71639E"/>
        <SolidColorBrush x:Key="OdooPurpleHoverBrush" Color="#5F5288"/>
        <SolidColorBrush x:Key="OdooPurpleSoftBrush" Color="#DDDBE8"/>
        <SolidColorBrush x:Key="OdooPurpleRowBrush" Color="#DDDBE8"/>

        <SolidColorBrush x:Key="OdooTealBrush" Color="#2A9D8F"/>
        <SolidColorBrush x:Key="ActiveGreenBrush" Color="#37A447"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#D62849"/>

        <SolidColorBrush x:Key="KeyAmberBrush" Color="#F7E08E"/>
        <SolidColorBrush x:Key="KeyPeachBrush" Color="#F5D7CB"/>
        <SolidColorBrush x:Key="KeyCoralBrush" Color="#FAA0A0"/>
        <SolidColorBrush x:Key="KeyGreenBrush" Color="#BEE8C8"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212529"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6C757D"/>
        <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#6C757D"/>

        <DropShadowEffect x:Key="ModalShadow"
                          BlurRadius="24"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.22"/>

        <SolidColorBrush x:Key="NumpadHoverBrush" Color="#CFD4DA"/>
        <SolidColorBrush x:Key="NumpadAmberHoverBrush" Color="#EDD376"/>
        <SolidColorBrush x:Key="NumpadPeachHoverBrush" Color="#EACBC0"/>
        <SolidColorBrush x:Key="NumpadCoralHoverBrush" Color="#F09194"/>
        <SolidColorBrush x:Key="NumpadGreenHoverBrush" Color="#A8DDB4"/>

        <!-- Modal Close Button Style: Transparent background always, ONLY icon color changes on hover -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="CloseIcon"
                                       Text="✕"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="#6C757D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseIcon" Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseIcon" Property="Foreground" Value="#495057"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Numpad Button Style (0-9) -->
        <Style x:Key="NumpadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18.2"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mode Button Style: Qty -->
        <Style x:Key="NumpadQtyButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <DataTrigger Binding="{Binding NumpadMode}" Value="Qty">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding NumpadMode}" Value="Qty"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#D4D1E2"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Mode Button Style: % -->
        <Style x:Key="NumpadDiscountButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <DataTrigger Binding="{Binding NumpadMode}" Value="%">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding NumpadMode}" Value="%"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#D4D1E2"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Mode Button Style: Price -->
        <Style x:Key="NumpadPriceButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <DataTrigger Binding="{Binding NumpadMode}" Value="Price">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding NumpadMode}" Value="Price"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#D4D1E2"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Special Key Button Style: +/- -->
        <Style x:Key="NumpadAmberButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyAmberBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadAmberHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Special Key Button Style: . -->
        <Style x:Key="NumpadPeachButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyPeachBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadPeachHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Special Key Button Style: ⌫ -->
        <Style x:Key="NumpadCoralButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyCoralBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadCoralHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quick Tender Button Style: Green (+10, +20, +50) -->
        <Style x:Key="NumpadGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource NumpadButtonStyle}">
            <Setter Property="Background" Value="{StaticResource KeyGreenBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NumpadGreenHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- =================================================================== -->
        <!-- PAYMENT NUMPAD BUTTON STYLES (Odoo POS 20: 24px/20px/22px, no radius)-->
        <!-- =================================================================== -->
        <Style x:Key="PaymentNumpadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DDDBE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#BEE8C8"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#A8DFB4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DDDBE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadAmberButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#F7E08E"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5D670"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DDDBE8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadPeachButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#F5D7CB"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEC2B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DDDBE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentNumpadCoralButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentNumpadButtonStyle}">
            <Setter Property="Background" Value="#FAA0A0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F88585"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DDDBE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Purple Action Button -->
        <Style x:Key="PosPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OdooPurpleBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource OdooPurpleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#A9A2C7"/>
                                <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outlined Button -->
        <Style x:Key="PosSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cart Action Strip Button ([Customer], [Note], [↑], [⋮]) -->
        <Style x:Key="CartActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="49"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ======================================================================= -->
        <!-- BASE POS TERMINAL WORKSPACE                                             -->
        <!-- ======================================================================= -->
        <Grid Visibility="{Binding IsPaymentConfirmationOpen, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- =================================================================== -->
            <!-- 1. TOP POS HEADER BAR (Screenshots 1, 2, 3, 4, 5, 7, 9)             -->
            <!-- =================================================================== -->
            <Border Grid.Row="0"
                    Height="66"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: [Register | Orders] + [+] + | + [2001] [2002] -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Register Button -->
                        <Button Content="Register"
                                Command="{Binding SwitchToRegisterViewCommand}"
                                Height="48"
                                Padding="16,0"
                                FontSize="16"
                                Margin="0,0,6,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr"
                                            Background="#F4F4F4"
                                            BorderBrush="{StaticResource BorderMidBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock x:Name="Txt"
                                                   Text="{TemplateBinding Content}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ActivePosView}" Value="Register">
                                            <Setter TargetName="Bdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter TargetName="Bdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#000000"/>
                                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Orders Button -->
                        <Button Content="Orders"
                                Command="{Binding SwitchToOrdersViewCommand}"
                                Height="48"
                                Padding="16,0"
                                FontSize="16"
                                Margin="0,0,8,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr"
                                            Background="#F4F4F4"
                                            BorderBrush="{StaticResource BorderMidBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock x:Name="Txt"
                                                   Text="{TemplateBinding Content}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ActivePosView}" Value="Orders">
                                            <Setter TargetName="Bdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                            <Setter TargetName="Bdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#000000"/>
                                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- [+] New Order Button with Circled Plus Icon -->
                        <Button Command="{Binding CreateNewDraftOrderCommand}"
                                Width="48" Height="48"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                ToolTip="New Order">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr" Background="#F4F4F4" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" CornerRadius="4">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="20" Height="20">
                                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="18" Height="18"
                                                         Stroke="{StaticResource TextPrimaryBrush}"
                                                         StrokeThickness="1.8"/>
                                                <Path Data="M 5.5,10 H 14.5 M 10,5.5 V 14.5"
                                                      Stroke="{StaticResource TextPrimaryBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Navbar Separator -->
                        <Border Width="1" Height="36" Background="{StaticResource BorderLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <!-- Draft Order Tabs (floating-order: height 48, min-width 52, active #DDDBE8) -->
                        <ItemsControl ItemsSource="{Binding DraftOrders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosDraftOrder}">
                                    <Button Command="{Binding DataContext.SelectDraftOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="48"
                                            MinWidth="52"
                                            Padding="14,0"
                                            Margin="0,0,6,0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TabBdr"
                                                        Background="#F4F4F4"
                                                        BorderBrush="{StaticResource BorderMidBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock x:Name="TabTxt"
                                                               Text="{Binding OrderNumber}"
                                                               FontSize="15.5"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="TabBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                        <Setter TargetName="TabBdr" Property="BorderBrush" Value="{StaticResource OdooPurpleBrush}"/>
                                                        <Setter TargetName="TabTxt" Property="Foreground" Value="#000000"/>
                                                        <Setter TargetName="TabTxt" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBdr" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- RIGHT: Pending Sync Pill + Search Bar + Barcode Icon + Cashier Avatar + Hamburger -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Live Pending Sync Queue Button (Visible when unsynced transactions exist) -->
                        <Button Command="{Binding OpenPendingSyncWindowCommand}"
                                Height="32"
                                Padding="10,0"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                ToolTip="View Unsynced POS Transactions Queue"
                                Visibility="{Binding HasPendingSync, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SyncBdr"
                                            Background="#FFFBEB"
                                            BorderBrush="#F59E0B"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↻ " FontSize="12" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendingSyncBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SyncBdr" Property="Background" Value="#FEF3C7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Search products... (form-control form-control-lg input-container: height 44, rounded 6) -->
                        <Border Width="260"
                                Height="44"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,0"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsProductSearchVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#6C757D" StrokeThickness="2"/>
                                        <Path Data="M 14,14 L 20,20" Stroke="#6C757D" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="14.5"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Search products..."
                                           FontSize="14.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ProductSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>


                        <!-- Cashier Avatar (34x34 rounded 6) -->
                        <Border Width="34" Height="34"
                                CornerRadius="6"
                                Background="{StaticResource OdooPurpleSoftBrush}"
                                Margin="0,0,10,0"
                                ClipToBounds="True"
                                ToolTip="{Binding CashierName}">
                            <Grid>
                                <Image Source="{Binding CashierAvatarBitmap}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasCashierAvatar, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                <TextBlock Text="{Binding CashierInitials}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource OdooPurpleBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasCashierAvatar, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>

                        <!-- Hamburger Menu Button (☰) (height 44, width 44) -->
                        <Button Command="{Binding OpenHamburgerMenuCommand}"
                                Width="44" Height="44"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Menu">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr" Background="Transparent" CornerRadius="4">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 4,6 H 20 M 4,12 H 20 M 4,18 H 20" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =================================================================== -->
            <!-- 2. MAIN REGISTER VIEW (Screenshots 1, 2, 5, 7, 9)                   -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsRegisterViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450" MaxWidth="450"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT CART & NUMPAD PANEL (.leftpane max-width: 450px, border-end #DEE2E6, bg #FFFFFF) -->
                <Border Grid.Column="0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ROW 0: CART ITEMS LIST (.orderlines .orderline) -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CurrentOrder.CartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosCartItem}">
                                        <Button Command="{Binding DataContext.SelectCartLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="LineBdr" Padding="12,8" Background="Transparent">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="26"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding QuantityDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding LineTotalDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding CustomerNote}"
                                                                       FontSize="12"
                                                                       FontStyle="Italic"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="26,2,0,0"
                                                                       Visibility="{Binding HasCustomerNote, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="LineBdr" Property="Background" Value="{StaticResource OdooPurpleSoftBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ROW 1: TOTAL (.order-summary p-2 border-bottom) -->
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,1,0,1"
                                Padding="12,10"
                                Visibility="{Binding HasCurrentOrderItems, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Grid>
                                <TextBlock Text="Total" FontSize="18.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CurrentOrder.TotalDisplay}" FontSize="18.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- ROW 2: 4x4 TOUCH NUMPAD (.numpad .numpad-4-cols: 216px high with 1px #DEE2E6 gap) -->
                        <Border Grid.Row="2"
                                Margin="8,8,8,6"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Visibility="{Binding ShowExpandedNumpad, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Grid Height="216" Background="{StaticResource BorderLightBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: [1] [2] [3] [Qty] -->
                                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="1"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="2"/>
                                <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="3"/>
                                <Button Grid.Row="0" Grid.Column="6" Content="Qty" Style="{StaticResource NumpadQtyButtonStyle}" Command="{Binding SetNumpadModeCommand}" CommandParameter="Qty"/>

                                <!-- Row 2: [4] [5] [6] [+] -->
                                <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="4"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="5"/>
                                <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="6"/>
                                <Button Grid.Row="2" Grid.Column="6" Content="+" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="+" FontSize="22" FontWeight="SemiBold"/>

                                <!-- Row 4: [7] [8] [9] [-] -->
                                <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="7"/>
                                <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="8"/>
                                <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="9"/>
                                <Button Grid.Row="4" Grid.Column="6" Content="-" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="-" FontSize="24" FontWeight="SemiBold"/>

                                <!-- Row 6: [Delete] [0] [.] [⌫] -->
                                <Button Grid.Row="6" Grid.Column="0" Content="Delete" Style="{StaticResource NumpadAmberButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="Delete" FontSize="13.5" FontWeight="SemiBold"/>
                                <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource NumpadButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="0"/>
                                <Button Grid.Row="6" Grid.Column="4" Content="." Style="{StaticResource NumpadPeachButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="."/>
                                <Button Grid.Row="6" Grid.Column="6" Style="{StaticResource NumpadCoralButtonStyle}" Command="{Binding NumpadKeyCommand}" CommandParameter="⌫">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ROW 3: FULL-WIDTH PURPLE PAYMENT BUTTON (.pay-order-button height: 68px) -->
                        <Button Grid.Row="3"
                                Content="Payment"
                                Command="{Binding OpenPaymentViewCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="68"
                                Margin="8,0,8,8"
                                FontSize="17.5"
                                FontWeight="Bold"
                                Visibility="{Binding HasCurrentOrderItems, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                    </Grid>
                </Border>

                <!-- RIGHT CATEGORIES & PRODUCT SELLING GRID (.rightpane bg-secondary #F4F4F4) -->
                <Grid Grid.Column="1" Background="{StaticResource AppBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Tiles (.category-list .category-button: 145x64, rounded-3) -->
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="8,8,8,4">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosCategoryRecord}">
                                    <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="145" Height="64"
                                            Margin="0,0,8,0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CatBdr"
                                                        Background="{Binding CategoryButtonBgBrush}"
                                                        CornerRadius="6"
                                                        Padding="6,4"
                                                        BorderThickness="0"
                                                        Opacity="0.75">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding CategoryButtonFgBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="CatBdr" Property="BorderThickness" Value="2"/>
                                                        <Setter TargetName="CatBdr" Property="BorderBrush" Value="{Binding CategoryActiveBorderBrush}"/>
                                                        <Setter TargetName="CatBdr" Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CatBdr" Property="Opacity" Value="0.92"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Product Cards Grid (Matching Odoo 20: 163x171, 6px bottom category accent bar, 4:3 photo ratio) -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,4,8,8">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ProductRecord}">
                                    <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="163"
                                            Height="171"
                                            Margin="4"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid x:Name="CardGrid">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="165"/>
                                                        <RowDefinition Height="6"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Top Card Area (163x165, border top/left/right 1px #CCCCCC, rounded top 6) -->
                                                    <Border Grid.Row="0"
                                                            x:Name="CardBdr"
                                                            Background="#FFFFFF"
                                                            BorderBrush="{StaticResource BorderMidBrush}"
                                                            BorderThickness="1,1,1,0"
                                                            CornerRadius="6,6,0,0"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <!-- LAYOUT WITH IMAGE -->
                                                            <Grid Visibility="{Binding HasImage, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="121"/>
                                                                    <RowDefinition Height="44"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Row 0: Image with 4:3 ratio (161x121) -->
                                                                <Border Grid.Row="0"
                                                                        Background="#E9ECEF"
                                                                        CornerRadius="5,5,0,0"
                                                                        ClipToBounds="True">
                                                                    <Grid>
                                                                        <Image Source="{Binding ImageBitmap}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                        <!-- Black Quantity Pill in Bottom-Right -->
                                                                        <Border HorizontalAlignment="Right"
                                                                                VerticalAlignment="Bottom"
                                                                                Background="#000000"
                                                                                CornerRadius="4"
                                                                                MinWidth="22"
                                                                                Height="22"
                                                                                Padding="6,2"
                                                                                Margin="0,0,6,6"
                                                                                Visibility="{Binding HasCartQuantity, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                                            <TextBlock Text="{Binding CartQuantity}"
                                                                                       FontSize="12"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#FFFFFF"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Row 1: Product Name -->
                                                                <Border Grid.Row="1" Background="#FFFFFF" Padding="8,4">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="13.5"
                                                                               FontWeight="Medium"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center"
                                                                               HorizontalAlignment="Left"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- LAYOUT WITHOUT IMAGE (Centered Name, Full Card) -->
                                                            <Border Visibility="{Binding HasImage, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"
                                                                    Background="#FFFFFF"
                                                                    Padding="10">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="Normal"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           TextAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Bottom Category Accent Bar (6px, rounded bottom 6) -->
                                                    <Border Grid.Row="1"
                                                            Background="{Binding CategoryColorBrush}"
                                                            CornerRadius="0,0,6,6"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBdr" Property="BorderBrush" Value="#9CA3AF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CardGrid" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- =================================================================== -->
            <!-- 3. IN-POS ORDERS VIEW (Screenshot 3)                                -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="#FFFFFF"
                  Visibility="{Binding IsOrdersViewActive, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="450" MaxWidth="450"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: ORDERS LIST & SEARCH/FILTER TOOLBAR -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Search + "Active ▾" + Pager Bar -->
                    <Border Grid.Row="0" Padding="8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Height="36"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource BorderMidBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                                        <Viewbox Width="13" Height="13">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                                <Path Data="M 14,14 L 20,20" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="13.5"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Search Orders..."
                                               FontSize="13.5"
                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding OrderSearchText, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>

                                    <Button Grid.Column="2"
                                            Command="{Binding CycleOrderStatusFilterCommand}"
                                            Background="#F3F4F6"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1,0,0,0"
                                            Padding="12,0"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OrderStatusFilter}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" ▾" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrdersPagerText}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <Button Width="32" Height="34" Background="#F3F4F6" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" Margin="0,0,2,0">
                                    <TextBlock Text="◀" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Width="32" Height="34" Background="#F3F4F6" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1">
                                    <TextBlock Text="▶" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Orders List Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredInPosOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PosOrderRecord}">
                                    <Button Command="{Binding DataContext.SelectInPosOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="OrdRowBdr"
                                                        Height="54"
                                                        Padding="12,0"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{StaticResource BorderLightBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="260"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InPosDayDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#4C4268"/>
                                                            <TextBlock Text="{Binding InPosTimeDisplay}" FontSize="11.5" Foreground="#6B7280"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TrackingNumberDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#4C4268"/>
                                                            <TextBlock Text="{Binding PosReference}" FontSize="11.5" Foreground="#6B7280"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding TotalDisplay}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="#4C4268"
                                                                   VerticalAlignment="Center"/>

                                                        <Border Grid.Column="4"
                                                                Background="{Binding InPosStatusBackground}"
                                                                CornerRadius="9"
                                                                Padding="12,2.5"
                                                                Margin="0,0,18,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InPosStatusText}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FFFFFF"/>
                                                        </Border>

                                                        <Border Grid.Column="5"
                                                                Width="18" Height="18"
                                                                CornerRadius="9"
                                                                Background="#212529"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Button Grid.Column="6"
                                                                Command="{Binding DataContext.DeleteInPosOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                ToolTip="Delete Ongoing Order"
                                                                Visibility="{Binding IsDraft, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                            <Viewbox Width="15" Height="15">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M 4,7 H 20 M 9,7 V 4 H 15 V 7 M 6,7 L 7,20 H 17 L 18,7 M 10,11 V 17 M 14,11 V 17"
                                                                          Stroke="#212529"
                                                                          StrokeThickness="2"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedInPos}" Value="True">
                                                        <Setter TargetName="OrdRowBdr" Property="Background" Value="{StaticResource OdooPurpleRowBrush}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- RIGHT: SELECTED ORDER CART PREVIEW & [Load Order] BUTTON -->
                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10,8">
                            <ItemsControl ItemsSource="{Binding SelectedInPosOrder.Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosOrderLineRecord}">
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding QtyShortDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PriceSubtotalInclDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Taxes" FontSize="12.5" Foreground="#4B5563"/>
                                    <TextBlock Text="{Binding SelectedInPosOrder.TaxDisplay, FallbackValue='$ 0.00'}" FontSize="12.5" Foreground="#4B5563" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Total" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInPosOrder.TotalDisplay, FallbackValue='$ 0.00'}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="2"
                                Content="Load Order"
                                Command="{Binding LoadOrderIntoRegisterCommand}"
                                CommandParameter="{Binding SelectedInPosOrder}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="58"
                                Margin="6"
                                FontSize="15"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- =================================================================== -->
            <!-- 4. PAYMENT VIEW (Cloned from Odoo pos payment.html)                  -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1"
                  Background="#F8F9FA"
                  Visibility="{Binding IsPaymentViewOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450" MaxWidth="450"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: PAYMENT METHODS + NUMPAD + BACK/VALIDATE (Width: 434px) -->
                <Grid Grid.Column="0" Background="#F8F9FA" Margin="8,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="69"/>
                    </Grid.RowDefinitions>

                    <!-- Payment Methods List -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding AvailablePaymentMethods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PosPaymentMethodRecord}">
                                <Button Command="{Binding DataContext.SelectPaymentMethodOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Height="54"
                                        Margin="0,0,0,8"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="MthBdr"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="16,0">
                                                <Grid VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Image Source="{Binding IconSource}"
                                                               Height="24"
                                                               Width="32"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="17.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="#212529"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="MthBdr" Property="Background" Value="#DDDBE8"/>
                                                    <Setter TargetName="MthBdr" Property="BorderBrush" Value="#71639E"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MthBdr" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Spacer Row 1: Height="*" -->

                    <!-- 4x4 Numpad (height 210, width 434, 1px dividers #DEE2E6) -->
                    <Border Grid.Row="2"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Grid Background="#DEE2E6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: [1] [2] [3] [+10] -->
                            <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="1"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="2"/>
                            <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="3"/>
                            <Button Grid.Row="0" Grid.Column="6" Content="+10" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="10"/>

                            <!-- Row 2: [4] [5] [6] [+20] -->
                            <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="4"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="5"/>
                            <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="6"/>
                            <Button Grid.Row="2" Grid.Column="6" Content="+20" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="20"/>

                            <!-- Row 4: [7] [8] [9] [+50] -->
                            <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="7"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="8"/>
                            <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="9"/>
                            <Button Grid.Row="4" Grid.Column="6" Content="+50" Style="{StaticResource PaymentNumpadGreenButtonStyle}" Command="{Binding AddQuickTenderCommand}" CommandParameter="50"/>

                            <!-- Row 6: [+/-] [0] [.] [⌫] -->
                            <Button Grid.Row="6" Grid.Column="0" Content="+/-" Style="{StaticResource PaymentNumpadAmberButtonStyle}" IsEnabled="False"/>
                            <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource PaymentNumpadButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="0"/>
                            <Button Grid.Row="6" Grid.Column="4" Content="." Style="{StaticResource PaymentNumpadPeachButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="."/>
                            <Button Grid.Row="6" Grid.Column="6" Style="{StaticResource PaymentNumpadCoralButtonStyle}" Command="{Binding PaymentNumpadKeyCommand}" CommandParameter="⌫">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 21,6 H 9 L 3,12 L 9,18 H 21 Z M 12,9 L 17,15 M 17,9 L 12,15"
                                              Stroke="#212529"
                                              StrokeThickness="1.8"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 4: Action Buttons [ Back ] | [ Validate ] (Height: 69px) -->
                    <Grid Grid.Row="4" Height="69">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button -->
                        <Button Grid.Column="0"
                                Command="{Binding ClosePaymentViewCommand}"
                                Height="69"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr"
                                            Background="#F4F4F4"
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Text="Back"
                                                   FontSize="17.5"
                                                   FontWeight="Medium"
                                                   Foreground="#212529"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#E2E6EA"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#DAE0E5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Validate Button (Disabled opacity: 0.5 when CanValidatePayment is false) -->
                        <Button Grid.Column="2"
                                Command="{Binding ValidatePaymentCommand}"
                                IsEnabled="{Binding CanValidatePayment}"
                                Height="69"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr"
                                            Background="#71639E"
                                            BorderBrush="#71639E"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Text="Validate"
                                                   FontSize="17.5"
                                                   FontWeight="Medium"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#5E5285"/>
                                            <Setter TargetName="Bdr" Property="BorderBrush" Value="#5E5285"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#4F4470"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bdr" Property="Opacity" Value="0.5"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- RIGHT/CENTER PANEL: TOP TOTAL + PAYMENT SUMMARY -->
                <Grid Grid.Column="1" Background="#F8F9FA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="188"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Gigantic Total ($ 1,066.58) -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding OrderTotalDisplay}"
                               FontSize="115"
                               FontWeight="Medium"
                               Foreground="#212529"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Payment Summary Container (Indented, matching Odoo padding: 16px 150px) -->
                    <Grid Grid.Row="1"
                          MaxWidth="904"
                          Margin="32,0,32,24"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Active Payment Line (.paymentline) -->
                        <Border Grid.Row="0"
                                Height="64"
                                Background="#DDDBE8"
                                BorderBrush="#71639E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="24,0"
                                Visibility="{Binding HasPaymentTendered, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <Grid>
                                <TextBlock Text="{Binding SelectedPaymentMethod, FallbackValue=Cash}"
                                           FontSize="21"
                                           FontWeight="Medium"
                                           Foreground="#000000"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PaymentLineAmountDisplay}"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#000000"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <Button Command="{Binding ClearPaymentLineCommand}"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            ToolTip="Delete tender">
                                        <TextBlock Text="×"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="#DC3545"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Spacer Row 1: Height="*" -->

                        <!-- Bottom Status Bar (.payment-screen-status) -->
                        <Border Grid.Row="2"
                                BorderBrush="#DEE2E6"
                                BorderThickness="0,1,0,0"
                                Padding="4,16,4,0">
                            <Grid>
                                <!-- Underpaid: Show REMAINING in RED (#D23F3A) -->
                                <Grid Visibility="{Binding IsPaymentUnderpaid, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                    <TextBlock Text="Remaining"
                                               FontSize="21"
                                               FontWeight="Normal"
                                               Foreground="#D23F3A"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RemainingDisplay}"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#D23F3A"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Overpaid / Exact: Show CHANGE in GREEN (#28A745) -->
                                <Grid Visibility="{Binding IsPaymentUnderpaid, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                                    <TextBlock Text="Change"
                                               FontSize="21"
                                               FontWeight="Normal"
                                               Foreground="#28A745"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChangeDisplay}"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#28A745"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 5. PAYMENT CONFIRMATION SCREEN ("Change", Cloned from pos Validate payement.html) -->
        <!-- ======================================================================= -->
        <Grid Background="#F8F9FA"
              Visibility="{Binding IsPaymentConfirmationOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Center Summary Content -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- Checkmark Circle (Odoo svg 115x115 #28a745) -->
                <Viewbox Width="100" Height="100" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Canvas Width="133" Height="133">
                        <Ellipse Canvas.Left="12" Canvas.Top="12" Width="109" Height="109" Fill="#28A745"/>
                        <Polyline Points="41,70 56,85 92,49"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>

                <!-- Title: "Change" -->
                <TextBlock Text="Change"
                           FontSize="96"
                           FontWeight="Bold"
                           Foreground="#212529"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Big Change Amount -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="$"
                               FontSize="128"
                               FontWeight="Normal"
                               Foreground="#6B7280"
                               VerticalAlignment="Bottom"
                               Margin="0,0,14,16"/>
                    <TextBlock Text="{Binding ConfirmedChangeIntegerPart}"
                               FontSize="256"
                               FontWeight="Bold"
                               Foreground="#212529"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding ConfirmedChangeDecimalPart}"
                               FontSize="160"
                               FontWeight="Normal"
                               Foreground="#6B7280"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,14"/>
                </StackPanel>

                <!-- In bottom in small size: "Cash" & "Amount Paid" -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,36,0">
                        <TextBlock Text="{Binding ConfirmedTenderMethodLabel, StringFormat='{}{0}: '}"
                                   FontSize="32"
                                   FontWeight="Medium"
                                   Foreground="#6C757D"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfirmedCashDisplay}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="#212529"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Amount Paid: "
                                   FontSize="32"
                                   FontWeight="Medium"
                                   Foreground="#6C757D"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfirmedPaidDisplay}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="#212529"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Buttons: Print & Continue (Removed Back & Send Receipt) -->
            <Grid Grid.Row="1" Width="580" Height="70" Margin="0,0,0,40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Print Button -->
                <Button Grid.Column="0"
                        Command="{Binding PrintReceiptCommand}"
                        Height="70"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bdr"
                                    Background="#F4F4F4"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 19,8 H 5 C 3.34,8 2,9.34 2,11 V 17 H 6 V 21 H 18 V 17 H 22 V 11 C 22,9.34 20.66,8 19,8 Z M 16,19 H 8 V 15 H 16 V 19 Z M 19,12 C 18.45,12 18,11.55 18,11 C 18,10.45 18.45,10 19,10 C 19.55,10 20,10.45 20,11 C 20,11.55 19.55,12 19,12 Z M 18,3 H 6 V 7 H 18 V 3 Z"
                                                  Fill="#212529"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Print"
                                               FontSize="17.5"
                                               FontWeight="Medium"
                                               Foreground="#212529"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bdr" Property="Background" Value="#E2E6EA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bdr" Property="Background" Value="#DAE0E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Continue Button -->
                <Button Grid.Column="2"
                        Command="{Binding ContinueAfterPaymentCommand}"
                        Height="70"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bdr"
                                    Background="#71639E"
                                    BorderBrush="#71639E"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock Text="Continue"
                                           FontSize="17.5"
                                           FontWeight="Medium"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bdr" Property="Background" Value="#5E5285"/>
                                    <Setter TargetName="Bdr" Property="BorderBrush" Value="#5E5285"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bdr" Property="Background" Value="#4F4470"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>

        <!-- ======================================================================= -->
        <!-- 6. POS LANDING SCREEN ("Open Register" / Opening Control)               -->
        <!-- ======================================================================= -->
        <Grid Panel.ZIndex="900"
              Visibility="{Binding IsPosLandingScreenOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6E4F0" Offset="0.0"/>
                    <GradientStop Color="#EBE9F2" Offset="0.48"/>
                    <GradientStop Color="#DDD9E8" Offset="0.49"/>
                    <GradientStop Color="#E5E2EE" Offset="0.82"/>
                    <GradientStop Color="#D7D3E4" Offset="0.83"/>
                    <GradientStop Color="#DEDAE9" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Top Row: Time/Date | Shop Name | Logo (Scaled 3x) -->
            <Grid VerticalAlignment="Top" Margin="36,28,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Clock + Day/Date -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding LandingClockText}"
                               FontSize="56"
                               FontWeight="Light"
                               Foreground="#1F2937"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LandingDayNameText}" FontSize="20" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding LandingFullDateText}" FontSize="18" FontWeight="Normal" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Shop Name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveShopName}"
                           FontSize="52"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Right: Logo or "Your logo" -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Image Source="{Binding CompanyLogoBitmap}"
                           MaxHeight="80"
                           Stretch="Uniform"
                           Visibility="{Binding HasCompanyLogo, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasCompanyLogo, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}">
                        <!-- Camera Icon -->
                        <Viewbox Width="50" Height="50" Margin="0,0,12,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 4,7 H 8 L 9.5,4.5 H 14.5 L 16,7 H 20 C 21.1,7 22,7.9 22,9 V 19 C 22,20.1 21.1,21 20,21 H 4 C 2.9,21 2,20.1 2,19 V 9 C 2,7.9 2.9,7 4,7 Z"
                                      Stroke="#714B67" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="10" Width="8" Height="8" Stroke="#714B67" StrokeThickness="1.8"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Your logo"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="#714B67"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Center Content: Action Card + Last Session Info -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Center: "Open Register" / "Continue" Card -->
                <Button Command="{Binding EnterPosFromLandingCommand}"
                        Width="180" Height="180"
                        HorizontalAlignment="Center"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBdr"
                                    Background="#FFFFFF"
                                    CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Shopping Basket Icon (exact match to reference image) -->
                                    <Viewbox Width="46" Height="46" Margin="0,0,0,14">
                                        <Canvas Width="24" Height="24">
                                            <!-- Handle -->
                                            <Path Data="M 8.5,9 L 10.5,3.5 H 13.5 L 15.5,9"
                                                  Stroke="#212529"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                            <!-- Basket Body -->
                                            <Path Data="M 3,9 H 21 L 18.5,20 H 5.5 Z"
                                                  Stroke="#212529"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                            <!-- Center dot -->
                                            <Ellipse Canvas.Left="10.5" Canvas.Top="13" Width="3" Height="3" Fill="#212529"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding LandingActionButtonText}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#212529"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBdr" Property="Background" Value="#F8F9FA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardBdr" Property="Background" Value="#F1F3F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Last Session Information (Visible only when register is closed) -->
                <Border Visibility="{Binding IsRegisterClosedForLanding, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                        Background="#FFFFFF"
                        CornerRadius="14"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Margin="0,26,0,0"
                        Width="560"
                        Padding="24,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 12,6 V 12 L 16,14.5"
                                                  Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="LAST SESSION DETAILS"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,3">
                                    <TextBlock Text="{Binding LastSessionTitle}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Info Grid: 2 columns x 3 rows -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Point of Sale & Title -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Point of Sale" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding LastSessionPosName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Session Title" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding LastSessionTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Row 1: Opening Date & Closing Date -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Opening Date" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding LastSessionOpeningDateDisplay}" FontSize="13" FontWeight="Normal" Foreground="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Closing Date" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding LastSessionClosingDateDisplay}" FontSize="13" FontWeight="Normal" Foreground="#334155"/>
                            </StackPanel>

                            <!-- Row 2: Orders & Total -->
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Orders" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding LastSessionOrdersCountDisplay}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Total" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding LastSessionTotalDisplay}" FontSize="15" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom: "Backend" Button -->
            <Button Command="{Binding ReturnToBackendCommand}"
                    Content="Backend"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Height="34"
                    Padding="16,0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="#212529" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#343A40"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bdr" Property="Background" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ======================================================================= -->
        <!-- MODALS & OVERLAYS                                                       -->
        <!-- ======================================================================= -->

        <!-- ==================== MODAL 1: OPENING CONTROL (Screenshot 5 / Image 3) ==================== -->
        <Grid Background="#66000000"
              Panel.ZIndex="1000"
              Visibility="{Binding IsOpeningControlModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Border Width="720"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    Padding="32,28,32,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,24">
                        <TextBlock Text="Opening Control"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Command="{Binding DiscardOpeningControlCommand}"
                                Style="{StaticResource ModalCloseButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Opening cash"
                               FontSize="14.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="48"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource BorderMidBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OpeningCashTextBox"
                                         Grid.Column="0"
                                         Text="{Binding OpeningCashInput, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         FontSize="16"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding ClearOpeningCashCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="6,0">
                                    <TextBlock Text="✕" FontSize="14" Foreground="#6C757D"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2"
                                Style="{StaticResource CartActionButtonStyle}"
                                Height="48"
                                Padding="0"
                                ToolTip="Coins / Bills">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="6" Width="18" Height="12" RadiusX="2" RadiusY="2" Stroke="#212529" StrokeThickness="1.8"/>
                                    <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#212529"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <TextBlock Text="Opening note"
                               FontSize="14.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <Border Height="140"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderMidBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,12"
                            Margin="0,0,0,24">
                        <Grid>
                            <TextBox Text="{Binding OpeningNote, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="15"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Add an opening note..."
                                       FontSize="15"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding OpeningNote, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Register"
                                Command="{Binding OpenRegisterSubmitCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="48"
                                Padding="24,0"
                                FontSize="15.5"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"/>
                        <Button Content="Discard"
                                Command="{Binding DiscardOpeningControlCommand}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Height="48"
                                Padding="24,0"
                                FontSize="15.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL 2: 3-DOTS POPUP (Odoo Hamburger Menu) ==================== -->
        <Grid Background="#66000000"
              Panel.ZIndex="1100"
              Visibility="{Binding IsHamburgerMenuOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Border Width="460"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <!-- Header: Title + Close Button -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Session Information"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#212529"
                                   VerticalAlignment="Center"/>

                        <Button Command="{Binding CloseHamburgerMenuCommand}"
                                Style="{StaticResource ModalCloseButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Session Stats Card -->
                    <Border Background="#F8F9FA"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="18,16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Session Name -->
                            <TextBlock Text="SESSION"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#6C757D"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentSessionDisplayName}"
                                       FontSize="16.5"
                                       FontWeight="SemiBold"
                                       Foreground="#212529"
                                       TextTrimming="CharacterEllipsis"/>

                            <Border Height="1" Background="#DEE2E6" Margin="0,14"/>

                            <!-- Orders & Payments Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Total Orders -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOTAL ORDERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#6C757D"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SessionTotalOrdersDisplay}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#212529"/>
                                </StackPanel>

                                <!-- Column 1: Total Payment -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TOTAL PAYMENT"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#6C757D"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SessionTotalPaymentsDisplay}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#71639E"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Opening Control Action -->
                    <Button Command="{Binding OpenOpeningControlModalCommand}"
                            Height="48"
                            Margin="0,0,0,10"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bdr"
                                        Background="#F8F9FA"
                                        BorderBrush="#DEE2E6"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Basket / Register Icon (matches Opening Control landing screen) -->
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 8.5,9 L 10.5,3.5 H 13.5 L 15.5,9 M 3,9 H 21 L 18.5,20 H 5.5 Z"
                                                      Stroke="#212529" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                                <Ellipse Canvas.Left="10.5" Canvas.Top="13" Width="3" Height="3" Fill="#212529"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Opening Control"
                                                   FontSize="14.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#212529"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bdr" Property="Background" Value="#E9ECEF"/>
                                        <Setter TargetName="Bdr" Property="BorderBrush" Value="#CED4DA"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bdr" Property="Background" Value="#DEE2E6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close Register Action -->
                    <Button Command="{Binding OpenClosingRegisterWorkflowCommand}"
                            Height="50"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bdr"
                                        Background="#DC3545"
                                        CornerRadius="6"
                                        Padding="16,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Key Icon -->
                                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="3" Canvas.Top="8" Width="7" Height="7" Stroke="#FFFFFF" StrokeThickness="1.8"/>
                                                <Path Data="M 10,11.5 H 21 M 17,11.5 V 15 M 20,11.5 V 15" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Close Register"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bdr" Property="Background" Value="#BD2130"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bdr" Property="Background" Value="#B21F2D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL 3 & 4: CLOSING REGISTER + "Oh snap !" (Screenshots 1 & 2) ==================== -->
        <Grid Background="#66000000"
              Panel.ZIndex="1200"
              Visibility="{Binding IsClosingRegisterModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">

            <!-- CLOSING REGISTER CARD -->
            <Border Width="590"
                    Background="#FFFFFF"
                    CornerRadius="6"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Closing Register" FontSize="18.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SessionSummaryText}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="-20,0,-20,14"/>

                    <!-- Payment Methods Breakdown: Cash, Card, Customer Account -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Cash" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CashCounted, StringFormat='$ {0:N2}'}" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border BorderBrush="#D1D5DB" BorderThickness="1.5,0,0,0" Margin="4,0,0,12" Padding="8,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Opening" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CashOpening, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Payments in Cash" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CashPayments, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="▸  Cash In / Out" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CashInOut, StringFormat='+ $ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Counted" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CashCounted, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Difference" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CashDifference, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Card" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CardTotal, StringFormat='$ {0:N2}'}" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border BorderBrush="#D1D5DB" BorderThickness="1.5,0,0,0" Margin="4,0,0,12" Padding="8,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Counted" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CardCounted, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Difference" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CardDifference, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Customer Account" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CustomerAccountTotal, StringFormat='$ {0:N2}'}" FontSize="14.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border BorderBrush="#D1D5DB" BorderThickness="1.5,0,0,0" Margin="4,0,0,4" Padding="8,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Counted" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CustomerAccountCounted, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Difference" FontSize="12.5" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding CustomerAccountDifference, StringFormat='$ {0:N2}'}" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,14"/>

                    <!-- Cash Count Input -->
                    <TextBlock Text="Cash Count" FontSize="12.5" Foreground="#374151" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="38"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource BorderMidBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ClosingCashCount, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding ClearClosingCashCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="4,0">
                                    <TextBlock Text="✕" FontSize="12" Foreground="#374151"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Style="{StaticResource CartActionButtonStyle}" Height="38" Padding="0">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="6" Width="18" Height="12" RadiusX="2" RadiusY="2" Stroke="#111827" StrokeThickness="1.8"/>
                                    <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#111827"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- Closing Note -->
                    <TextBlock Text="Closing note" FontSize="12.5" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border Height="68"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderMidBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,18">
                        <Grid>
                            <TextBox Text="{Binding ClosingNote, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="12.5"/>
                            <TextBlock Text="Add a closing note..."
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding ClosingNote, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Close Register"
                                    Command="{Binding SubmitCloseRegisterCommand}"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Discard"
                                    Command="{Binding DiscardClosingRegisterCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cash In/Out"
                                    Command="{Binding CashInOutTileCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Daily Sale ⤓"
                                    Command="{Binding PrintReceiptCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- LAYERED "Oh snap !" DRAFT ORDERS WARNING MODAL (Screenshot 1) -->
            <Grid Background="#55000000"
                  Visibility="{Binding IsDraftOrdersWarningModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                <Border Width="346"
                        Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Effect="{StaticResource ModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Oh snap !"
                                       FontSize="17.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Command="{Binding DismissDraftOrdersWarningCommand}"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="You cannot close the POS while there are still draft orders for the day."
                                   FontSize="12.5"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="0,0,0,22"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Review Orders"
                                    Command="{Binding ReviewDraftOrdersCommand}"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Cancel Orders"
                                    Command="{Binding CancelDraftOrdersAndCloseCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Background="#FFFFFF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== MODAL 5: CUSTOMER NOTE DIALOG ==================== -->
        <Grid Background="#66000000"
              Panel.ZIndex="1300"
              Visibility="{Binding IsNoteModalOpen, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <Border Width="420"
                    Background="#FFFFFF"
                    CornerRadius="6"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <TextBlock Text="Add Note" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                    <Border Height="88" BorderBrush="{StaticResource BorderMidBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
                        <TextBox Text="{Binding NoteInputText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontSize="13.5"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply" Command="{Binding SaveNoteModalCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Discard" Command="{Binding CloseNoteModalCommand}" Style="{StaticResource PosSecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- POS Toast Notification -->
        <Border Background="{StaticResource TextPrimaryBrush}"
                CornerRadius="6"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Panel.ZIndex="2000"
                Visibility="{Binding IsPosToastVisible, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding PosToastMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
        </Border>
    </Grid>
</UserControl>